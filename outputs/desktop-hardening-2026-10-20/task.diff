+nativeTheme.themeSource = "light";
+app.on("quit", () => { rmSync(profile, { recursive: true, force: true }); });
+const out = process.argv[2] ? resolve(process.argv[2]) : mkdtempSync(join(tmpdir(), "cairn-state-"));
