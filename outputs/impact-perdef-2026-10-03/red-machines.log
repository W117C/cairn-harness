[31m+ // ---- B1：把影响面从「回注给模型看的提示」升级成 spawn 准入判据 ----[39m
[31m+ // 依据：多 agent 最大的未解项不是行冲突而是**写时语义冲突**（worktree 只解决物理层）。[39m
[31m+ // 两个 worker 各改各的文件、glob 不相交，却都波及同一批调用点 ⇒ 合并时照样打架。[39m
[31m+ // 这份数据在 M7 只用了一次（写后回注摘要），这里让它第二次变现。[39m
[31m+[39m
[31m+ /** glob → 仓库相对路径匹配（`**` 跨目录、`*` 段内、`?` 单字符）。 */[39m
[31m+ export function globMatchesPath(glob: string, path: string): boolean {[39m
[31m+   const g = glob.replace(/\\/g, "/");[39m
[31m+   const p = path.replace(/\\/g, "/");[39m
[31m+   let re = "";[39m
[31m+   for (let i = 0; i < g.length; i++) {[39m
[31m+     const c = g[i];[39m
[31m+     if (c === "*") {[39m
[31m+       if (g[i + 1] === "*") {[39m
[31m+         re += ".*";[39m
[31m+         i++;[39m
[31m+         if (g[i + 1] === "/") i++; // `**/` 允许匹配零段目录[39m
[31m+       } else re += "[^/]*";[39m
[31m+     } else if (c === "?") re += "[^/]";[39m
[31m+     else if ("\\^$.|+()[]{}".includes(c)) re += "\\" + c;[39m
[31m+     else re += c;[39m
[31m+   }[39m
[31m+   return new RegExp("^" + re + "$").test(p);[39m
[31m+ }[39m
[31m+[39m
[31m+ /** 一批（已在图内的）文件 ⇒ 它们的波及闭包（含自身，排序去重）。[39m
[31m+  *  抽出来的理由：租约那条支以前把这段循环写在 `affectedFilesOf` 体内，判卷与探针要量它只能**自己再算一遍**[39m
[31m+  *  ——第 305 页的归属判据接进 `upward` 之后，闭包跟着变窄，而当时没有任何一个观测者走的是生产那一条[39m
[31m+  *  （第十三族③：同一位置双向偏差）。收成一处，两臂（宽/窄）与真仓读数都从这一个函数取。 */[39m
[31m+ export function closureFilesOf(graph: ImpactGraph, files: readonly string[]): string[] {[39m
[31m+   const out = new Set<string>();[39m
[31m+   for (const file of files) {[39m
[31m+     out.add(file);[39m
[31m+     for (const sym of graph.defs.keys()) {[39m
[31m+       if (!(graph.defs.get(sym) ?? []).some((d) => d.file === file)) continue;[39m
[31m+       for (const site of upward(graph, sym)) out.add(site.file);[39m
[31m+     }[39m
[31m+   }[39m
[31m+   return [...out].sort();[39m
[31m+ }[39m
[31m+[39m
[31m+ /** 声明「要写这些 glob」⇒ 实际会波及哪些文件（含被声明文件自身，排序去重）。[39m
[31m+  *  grammar/索引不可用 ⇒ 抛 ImpactUnavailableError（调用方按降级处理，不静默返回空集）。[39m
[31m+  *[39m
[31m+  *  「图非全量」必须**出声**（09-30 补，第 201 页的实测）：这一支的返回值直接进 spawn 准入——[39m
[31m+  *  `semanticConflictsVia` 见空波及就 `return []`，其理由「无跨文件调用点，宁漏不误伤」**默认图是全的**，[39m
[31m+  *  而 orchestrator 冲突 0 条时连审批卡都不发。从前钩子抛错会 `console.warn`、缺料什么都不说[39m
[31m+  *  ⇒ 故障出声、缺料不出声。`maxFiles` 是给读端/判卷留的透传位（同 `fileImpact`）：生产缺省已是[39m
[31m+  *  安全阀上限，正常仓库不会走到那句出声。 */[39m
[31m+ export async function affectedFilesOf([39m
[31m+   workspace: string,[39m
[31m+   globs: readonly string[],[39m
[31m+   cacheDir?: string,[39m
[31m+   maxFiles?: number,[39m
[31m+ ): Promise<string[]> {[39m
[31m+   if (globs.length === 0) return [];[39m
[31m+   const graph = await buildImpact({ workspace, cacheDir, maxFiles });[39m
[31m+   if (graphIsPartial(graph.files.length, graph.candidates)) {[39m
[31m+     console.warn([39m
[31m+       `[impact] 语义租约：本图收录 ${String(graph.files.length)} 个文件＝帽 ${String(graph.cap)}，` +[39m
[31m+         `另有 ${String(graph.candidates - graph.files.length)} 个候选没进这张图（非全量）` +[39m
[31m+         "⇒ 下面的波及闭包可能不完整，**空波及不等于无冲突**",[39m
[31m+     );[39m
[31m+   }[39m
[31m+   const declared = graph.files.filter((file) => globs.some((g) => globMatchesPath(g, file)));[39m
[31m+   return closureFilesOf(graph, declared);[39m
[31m+ }[39m
[31m+[39m

