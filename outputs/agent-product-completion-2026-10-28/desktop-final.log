.th-why { padding: 7px var(--space-md) 2px; }
.th-info {
  list-style: none; display: flex; align-items: center; gap: 5px;
  font-size: var(--fs-caption-xs); color: hsl(var(--text-400)); cursor: pointer;
}
.th-info::-webkit-details-marker { display: none; }
.th-info .th-info-ico { flex: none; color: hsl(var(--text-400)); }
