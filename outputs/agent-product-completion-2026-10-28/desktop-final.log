}
.th-row button:hover:not(:disabled) { background: hsl(from hsl(var(--text-000)) h s l / var(--alpha-hover)); color: hsl(var(--text-000)); }
/* 选中段 = elevated 背景 + primary 文字（批 5 细则 §五；未选 = secondary，不再用近隐灰）。
   注意：--bg-elevated 是 HSL 三元组，必须 hsl() 包裹（裸 var() 是无效值）。 */
.th-row button[aria-pressed=\"true\"] {
  background: hsl(var(--bg-elevated)); border-color: var(--hairline-strong);
