.pv-item { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: var(--radius-sm); font-size: var(--fs-body-sm); color: hsl(var(--text-200)); text-align: left; }
.pv-item:hover { background: hsl(from hsl(var(--text-000)) h s l / var(--alpha-hover)); }
.pv-item.on { background: hsl(from hsl(var(--text-000)) h s l / var(--alpha-selected)); color: hsl(var(--text-000)); }
