.ss-field-block { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.ss-flabel { font-size: var(--fs-caption-sm); color: hsl(var(--text-400)); }
.ss-fstack .ss-field[data-w=\"full\"] { flex: none; width: 100%; max-width: 560px; } /* 纵向容器里别吃 flex-basis（否则字段被撑成 240px 高） */
