}

/* 空态：垂直居中；图标 + 标题 + 说明 + 主按钮；不摆统计卡 */
.ss-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 4px; padding: 48px var(--space-lg); }
