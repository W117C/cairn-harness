+
+
+ declare global { interface Window { agent: import("../../../../../src/main/ipc-protocol").AgentApi } }
+
+ // SEMA §3.5/§12：构建期注入的期望协议版本（vite define 换字面量——产物零运行时 import src）。
+ declare const __IPC_PROTOCOL_VERSION__: number;
