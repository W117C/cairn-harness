+       )}
+       {/* 归档必问闸（§3.3 硬闸：所有权限模式下都问；取消归档不问）。 */}
+       {archiveConfirm !== null && (
+         <ModalSurface className="confirm-scrim" label="归档确认" onClose={() => setArchiveConfirm(null)}>
