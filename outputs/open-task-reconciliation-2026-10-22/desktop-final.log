+  *  id 与 tokens.css 的 `html[data-ui-size="…"]` 逐字对应。 */
+ const UI_SIZE_OPTIONS: readonly { id: UiSizeSetting; label: string }[] = [
+   { id: "1", label: "紧凑" },
+   { id: "2", label: "标准" },
+   { id: "3", label: "宽松" },
+   { id: "4", label: "舒适" },
+   { id: "5", label: "超大" },
