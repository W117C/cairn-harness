+ const BUCKET_LABEL: Record<TimeBucket, string> = {
+   today: STR.sidebar.bucketToday,
+   yesterday: STR.sidebar.bucketYesterday,
+   past7: STR.sidebar.bucketPast7,
+   earlier: STR.sidebar.bucketEarlier,
