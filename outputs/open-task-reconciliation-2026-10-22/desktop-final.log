+     onOpenInCli: () => void;
+     /** 会话级 worktree 隔离（§3.7 · G4）：隔离 / 合并回主工作区 / 丢弃。 */
+     onWorktree: (kind: "create" | "merge" | "discard") => void;
+     /** 归到某个项目 / 取消归属（null = 取消）。主进程校验项目 id 存在。 */
