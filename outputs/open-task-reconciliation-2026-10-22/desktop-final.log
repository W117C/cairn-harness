+     : props.status === "done" ? `${STR.sidebar.sessionDone}：${title}`
+     : `${STR.sidebar.sessionFailed}：${title}`;
+   return (
+     <div
+       ref={rowRef}
+       className={"session" + (s.id === props.activeId ? " active" : "")}
+       data-active={s.id === props.activeId}
