+     if (tab === undefined) return;
+     void window.agent.browserClose(tab.viewId);
+     setTabStates((prev) => { const next = { ...prev }; delete next[key]; return next; });
+     const rest = tabsRef.current.filter((x) => x.key !== key);
+     if (rest.length === 0) {
+       // 常留至少一个标签（浏览器式习惯）：关掉最后一个 = 换成一张空白页
+       const nk = nextKeyRef.current++;
+       setTabs([{ key: nk, viewId: `${base}-t${nk}` }]);
+       setActiveKey(nk);
+       setUrlDraft("");
+       return;
+     }
+     setTabs(rest);
+     if (key === activeKeyRef.current) {
+       const idx = tabsRef.current.findIndex((x) => x.key === key);
+       const neighbor = rest[Math.max(0, idx - 1)] ?? rest[0];
+       setActiveKey(neighbor.key);
+       setUrlDraft(tabStatesRef.current[neighbor.key]?.url ?? "");
+     }
+   };
+   const titleOf = (t: BpTab): string => {
+     const s = tabStates[t.key];
+     if (s === undefined) return "新标签页";
+     return s.title !== "" ? s.title : (s.url !== "" ? s.url : "新标签页");
+   };
+   const actState = tabStates[activeKey] ?? null;
+   const nav = (action: "back" | "forward" | "reload"): void => {
+     const vid = activeViewRef.current;
+     if (vid !== null) void window.agent.browserNav(vid, action);
+   };
+
+   return (
+     <div className="browser-pane">
+       <div className="bp-tabs" role="tablist" aria-label="浏览器标签页">
+         {tabs.map((t) => (
+           <div key={t.key} className={`bp-tab${t.key === activeKey ? " on" : ""}`}>
+             <button
+               className="bp-tab-main"
+               role="tab"
+               aria-selected={t.key === activeKey}
+               title={tabStates[t.key]?.url ?? ""}
+               onClick={() => switchTab(t.key)}
+             >
+               <span className="bp-tab-title">{titleOf(t)}</span>
+             </button>
+             <button className="bp-tab-x" aria-label="关闭标签页" title="关闭标签页" onClick={() => closeTab(t.key)}>
+               <X size={10} />
+             </button>
+           </div>
+         ))}
+         <button className="bp-tab-add" aria-label="新标签页" title="新标签页" onClick={addTab}>
+           <Plus size={12} />
+         </button>
+       </div>
+       <div className="bp-toolbar">
+         <button className="iconbtn sm" aria-label="后退" disabled={actState?.canGoBack !== true} onClick={() => nav("back")}>←</button>
+         <button className="iconbtn sm" aria-label="前进" disabled={actState?.canGoForward !== true} onClick={() => nav("forward")}>→</button>
+         <button className="iconbtn sm" aria-label="刷新" onClick={() => nav("reload")}>⟳</button>
+         <input
+           ref={addrRef}
+           className="bp-url"
+           aria-label="地址"
+           placeholder="localhost:5173 或 https://…"
+           value={urlDraft}
+           onChange={(e) => setUrlDraft(e.target.value)}
+           onKeyDown={(e) => { if (e.key === "Enter") go(activeKey, urlDraft); }}
+         />
+         <button className="mini-btn" onClick={() => go(activeKey, urlDraft)}>打开</button>
+         <button
+           className="iconbtn sm"
+           data-on={picking}
+           aria-label="选择页面元素"
+           title="选择页面元素（⌘⇧S）"
+           onClick={doPick}
+         >
+           <Crosshair size={13} />
+         </button>
+         <DropdownMenu.Root>
+           <DropdownMenu.Trigger asChild>
+             <button className="iconbtn sm" aria-label="浏览器菜单" title="浏览器菜单"><MoreHorizontal size={13} /></button>
+           </DropdownMenu.Trigger>
+           <DropdownMenu.Content className="pop-rd" side="bottom" align="end" sideOffset={4}>
+             <DropdownMenu.Item className="menu-item" onSelect={toggleKeepCookies}>
+               <span className="fl-row">
+                 <span className="fl-label">保留 cookies（登录态）</span>
+                 {keepCookies && <span className="fl-check" aria-hidden="true">✓</span>}
+               </span>
+             </DropdownMenu.Item>
+             <DropdownMenu.Item className="menu-item" onSelect={() => { setConfirmClear(true); }}>清除浏览数据…</DropdownMenu.Item>
+             <DropdownMenu.Separator className="menu-sep" />
+             <DropdownMenu.Item className="menu-item" disabled>
+               <span className="menu-note">已授权站点（{String(allowedHosts.length)}）</span>
+             </DropdownMenu.Item>
+             {allowedHosts.map((host) => (
+               <DropdownMenu.Item
+                 key={host}
+                 className="menu-item"
+                 onSelect={() => {
+                   const next = new Set(allowedRef.current);
+                   next.delete(host);
+                   allowedRef.current = next;
+                   setAllowedHosts([...next]);
+                   void window.agent.browserSetAllowedHosts([...next]).catch(() => undefined);
+                   try {
+                     if (next.size === 0) window.localStorage.removeItem(BROWSER_ALLOW_KEY);
+                     else window.localStorage.setItem(BROWSER_ALLOW_KEY, JSON.stringify([...next]));
+                   } catch { /* 存不下则仅本窗格生效 */ }
+                   setNotice(`已移除 ${host} 的授权（下次访问会重新询问）`);
+                 }}
+               >移除 {host}</DropdownMenu.Item>
+             ))}
+             <DropdownMenu.Item
+               className="menu-item"
+               disabled={allowedHosts.length === 0}
+               onSelect={() => {
+                 try { window.localStorage.removeItem(BROWSER_ALLOW_KEY); } catch { /* 同上 */ }
+                 allowedRef.current = new Set();
+                 setAllowedHosts([]);
+                 void window.agent.browserSetAllowedHosts([]).catch(() => undefined);
+                 setNotice("已清除全部已授权站点（下次访问会重新询问）");
+               }}
+             >忘记全部已授权站点</DropdownMenu.Item>
+             <DropdownMenu.Separator className="menu-sep" />
+             <DropdownMenu.Item className="menu-item" disabled>
+               <span className="menu-note">清除只及本窗格的独立 profile（persist:cairn-browser），不动你的个人浏览器</span>
+             </DropdownMenu.Item>
+           </DropdownMenu.Content>
+         </DropdownMenu.Root>
+       </div>
+       {pending !== null && (
+         <div
+           className="bp-permit"
+           role="alertdialog"
+           aria-label="站点授权"
+           onKeyDown={(e) => {
+             if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); setPending(null); }
+           }}
+         >
+           <div className="bp-permit-text">要打开外部站点 <b>{pending.url}</b> 吗？（本地 dev server 与项目文件免授权）</div>
+           <div className="bp-permit-actions">
+             <button ref={permitFirstRef} className="mini-btn primary" onClick={() => allowAndGo(false)}>允许本次</button>
+             <button className="mini-btn" onClick={() => allowAndGo(true)}>记住该域</button>
+             <button className="mini-btn danger-text" onClick={() => setPending(null)}>拒绝</button>
+           </div>
+         </div>
+       )}
+       {confirmClear && (
+         <div className="bp-permit" role="alertdialog" aria-label="清除浏览数据">
+           <div className="bp-permit-text">
+             清除本窗格的浏览数据{keepCookies ? "（保留 cookies）" : "（含 cookies）"}？此操作不可撤销。
+           </div>
+           <div className="bp-permit-actions">
+             <button className="mini-btn danger-text" onClick={() => { setConfirmClear(false); doClear(); }}>清除</button>
+             <button className="mini-btn" onClick={() => { setConfirmClear(false); }}>取消</button>
+           </div>
+         </div>
+       )}
+       {notice !== null && <div className="bp-status" role="status">{notice}</div>}
+       {actState !== null && (actState.title !== "" || actState.loading) && (
+         <div className="bp-status">{actState.loading ? "加载中…" : actState.title}</div>
+       )}
+       <div className="bp-view" ref={containerRef} aria-label="网页视图（原生视图叠放区）" />
+     </div>
+   );
+ }
+
+ declare const __IPC_PROTOCOL_VERSION__: number;
+
+ /** 终端窗格（macOS）：xterm.js 渲染 + Python PTY 宿主，行列随面板尺寸同步。
+  *  xterm 动态 import（SSR/判卷环境不加载 DOM 依赖）；卸载即 kill 终端（不留孤儿 shell）。 */
+ function TerminalPane(): React.JSX.Element {
+   const hostRef = useRef<HTMLDivElement | null>(null);
+   const [notice, setNotice] = useState<{ message: string; canRetry: boolean } | null>(null);
+   // 退出后可就地重启（2026-10-18）：此前只把“已退出”写进终端，唯一出路是关窗格再开。
+   // gen 递增触发 effect 重跑：旧 xterm 在 cleanup 里 dispose + kill，新会话接在同一 host 上。
+   const [exited, setExited] = useState<string | null>(null);
+   const [gen, setGen] = useState(0);
+   useEffect(() => {
+     const host = hostRef.current;
+     if (host === null) return;
+     let alive = true;
+     const showError = (message: string, canRetry = true): void => { if (alive) setNotice({ message, canRetry }); };
+     let term: import("@xterm/xterm").Terminal | null = null;
+     let termId: string | null = null;
+     let offData: (() => void) | null = null;
+     let offExit: (() => void) | null = null;
+     let dataSub: { dispose: () => void } | null = null;
+     let resizeSub: { dispose: () => void } | null = null;
+     let resizeObserver: ResizeObserver | null = null;
+     void Promise.all([window.agent.protocolVersion(), import("@xterm/xterm"), import("@xterm/addon-fit")]).then(([version, { Terminal }, { FitAddon }]) => {
+       if (!alive) return;
+       if (version !== __IPC_PROTOCOL_VERSION__) { showError("桌面协议版本不一致，请关闭并重新打开应用", false); return; }
+       const t = new Terminal({
+         fontSize: 12,
+         cursorBlink: true,
+         fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
+         scrollback: 4000,
+       });
+       const fit = new FitAddon();
+       t.loadAddon(fit);
+       // 复制/粘贴/全选（2026-10-18）：xterm 默认不把选区写进系统剪贴板，Ctrl/Cmd+V 也不归它管——
+       // 终端里选中的文字复制不出来、粘贴不进去，是“按键功能缺失”最典型的一处。只在“主修饰键”上拦：
+       // macOS 用 ⌘；其他平台用 Ctrl+Shift（裸 Ctrl+C 必须留给 SIGINT）。
+       t.attachCustomKeyEventHandler((e) => {
+         if (e.type !== "keydown") return true;
+         const primary = e.metaKey || (e.ctrlKey && e.shiftKey);
+         if (!primary) return true;
+         const k = e.key.toLowerCase();
+         if (k === "a" && !e.shiftKey) { t.selectAll(); return false; }
+         if (k === "c") {
+           const sel = t.getSelection();
+           if (sel !== "") void navigator.clipboard.writeText(sel).catch(() => undefined);
+           return false;
+         }
+         if (k === "v") {
+           void navigator.clipboard.readText().then(
+             (text) => { if (text !== "") t.paste(text); },
+             () => undefined,
+           );
+           return false;
+         }
+         return true;
+       });
+       term = t;
+       t.open(host);
+       const syncSize = (): void => {
+         const id = termId;
+         if (!alive || id === null || host.clientWidth === 0 || host.clientHeight === 0) return;
+         void window.agent.terminalResize(id, t.cols, t.rows).then((ok) => {
+           if (alive && termId === id && !ok) showError("终端尺寸未能同步，请重新启动终端");
+         }, (error: unknown) => {
+           if (alive && termId === id) showError(`终端尺寸同步失败：${error instanceof Error ? error.message : String(error)}`);
+         });
+       };
+       resizeSub = t.onResize(syncSize);
+       // 列数自适应容器宽（此前固定 80 列在窄格被右缘裁切）；容器尺寸变化跟随。
+       try { fit.fit(); } catch { /* 容器尺寸为 0 时忽略 */ }
+       resizeObserver = new ResizeObserver(() => { try { fit.fit(); } catch { /* 同上 */ } });
+       resizeObserver.observe(host);
+       offData = window.agent.onTerminalData((e) => { if (termId !== null && e.id === termId) t.write(e.data); });
+       offExit = window.agent.onTerminalExit((e) => {
+         if (termId !== null && e.id === termId) {
+           const why = e.code === null ? "信号终止" : `code ${String(e.code)}`;
+           t.write(`\r\n[terminal] 已退出（${why}）——点上方「重新启动」或重开窗格\r\n`);
+           termId = null;
+           setExited(why);
+         }
+       });
+       dataSub = t.onData((d) => {
+         const id = termId;
+         if (id === null) return;
+         void window.agent.terminalWrite(id, d).then((ok) => {
+           if (alive && termId === id && !ok) showError("终端已不可写，请重新启动终端");
+         }, (error: unknown) => {
+           if (alive && termId === id) showError(`终端输入失败：${error instanceof Error ? error.message : String(error)}`);
+         });
+       });
+       void window.agent.terminalStart().then((r) => {
+         if (r === undefined) { showError("通道无应答（主进程未返回终端）"); return; }
+         if (!alive) { if (r.ok) void window.agent.terminalKill(r.id); return; }
+         if (!r.ok) { showError(r.error); t.write(`[terminal] ${r.error}\r\n`); return; }
+         termId = r.id;
+         syncSize(); // fit 可能早于 IPC 返回 id；创建完成后必须补初次同步。
+       }).catch((err: unknown) => {
+         showError(err instanceof Error ? err.message : String(err));
+       });
+     }).catch((err: unknown) => {
+       if (alive) showError(`终端无法启动：${err instanceof Error ? err.message : String(err)}`);
+     });
+     return () => {
+       alive = false;
+       offData?.(); offExit?.(); dataSub?.dispose(); resizeSub?.dispose();
+       resizeObserver?.disconnect();
+       if (termId !== null) void window.agent.terminalKill(termId);
+       term?.dispose();
+     };
+   }, [gen]);
+   return (
+     <div className="term-pane">
+       {notice !== null && <div className="fp-note err" role="alert">{notice.message}</div>}
+       {(exited !== null || notice?.canRetry === true) && (
+         <div className="fp-note" role="status">
+           {exited !== null && <span>终端已退出（{exited}）</span>}
+           <button
+             className="mini-btn ghost"
+             onClick={() => { setExited(null); setNotice(null); setGen((g) => g + 1); }}
+           >重新启动</button>
+         </div>
+       )}
+       <div className="term-host" ref={hostRef} aria-label="终端会话" />
+     </div>
+   );
+ }
+
+ /** 变更窗格（diff 审阅面）：按轮列改动清单与验证凭据；点文件行懒加载逐 hunk diff（v4 通道）；
+  *  行级评注（蓝本 §3.6）：多处评论汇总为一条消息，⌘Enter 一次性提交（复用 send → 新一轮）。 */
+ function ChangesPane(props: {
+   events: readonly AgentEvent[];
+   onReview?: (text: string) => void;
+   onPathMenu?: (rel: string, kind: "file" | "directory", x: number, y: number) => void;
+ }): React.JSX.Element {
+   const turns = turnDelivery(props.events).filter((t) => t.files.length > 0);
+   // 展开位（一次一个文件）；diff 懒加载与请求守卫收口在 change-diff-state.ts
+   //（与 Inspector 同一实现；点开才要数据，不预取整会话的全部差异）。
+   const { openKey, diff, toggle } = useLazyChangeDiff();
+   // 每轮一张卡，但默认只展开最新一轮（2026-10-18 与交付卡同一批：23 轮全展开会把检查器塞满）。
+   const [openRound, setOpenRound] = useState<number | null>(() => (turns.length > 0 ? turns[turns.length - 1]!.round : null));
+   // 行级评注（行键 `<path>|<line>` → 文本）；提交后清空。
+   const [comments, setComments] = useState<ReadonlyMap<string, string>>(new Map());
+   const submitReview = (): void => {
+     if (comments.size === 0 || props.onReview === undefined) return;
+     props.onReview(composeReviewMessage(comments));
+     setComments(new Map());
+   };
+   if (turns.length === 0) {
+     return <div className="pane-empty">本会话还没有文件改动。<br />agent 写盘后会在这里按轮列出。</div>;
+   }
+   const verifyWord = (status: string): string =>
+     status === "verified" ? "验证通过"
+     : status === "failed" ? "验证失败"
+     : status === "stale" ? "验证已过期"
+     : status === "absent" ? "未验证"
+     : "无需验证";
+   const verifyCls = (status: string): string =>
+     status === "verified" ? "ok" : status === "failed" ? "bad" : status === "absent" ? "warn" : "dim";
+   return (
+     <div
+       className="changes-pane"
+       onKeyDown={(e) => { if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) { e.preventDefault(); submitReview(); } }}
+     >
+       {comments.size > 0 && props.onReview !== undefined && (
+         <div className="review-bar" role="status">
+           <span className="rb-count num">{String(comments.size)} 条评注待提交</span>
+           <button className="mini-btn primary" onClick={submitReview}>提交评论（⌘Enter）</button>
+           <button className="mini-btn" onClick={() => setComments(new Map())}>清除</button>
+         </div>
+       )}
+       <div className="pane-list">
+       {turns.map((t) => (
+         <section className="pane-card" key={t.round}>
+           <div className="pane-card-head">
+             <span className="pc-title">第 {String(t.round)} 轮</span>
+             <span className="chip">{String(t.files.length)} 个文件</span>
+             <span className={"chip " + verifyCls(t.verification.status)}>{verifyWord(t.verification.status)}</span>
+             <button
+               type="button"
+               className={"pane-card-toggle" + (openRound === t.round ? " on" : "")}
+               aria-expanded={openRound === t.round}
+               aria-label={openRound === t.round ? "收起这一轮的改动" : "展开这一轮的改动"}
+               onClick={() => { setOpenRound(openRound === t.round ? null : t.round); }}
+             ><ChevronRight size={11} /></button>
+           </div>
+           {openRound === t.round && (
+           <>
+           <ul className="changes-list">
+             {t.files.map((f) => {
+               const key = `${String(t.round)}:${f.path}`;
+               const open = openKey === key;
+               return (
+                 <li className="change-item-wrap" key={`${f.path}:${f.change}`}>
+                   <button
+                     className={"change-item" + (open ? " open" : "")}
+                     aria-expanded={open}
+                     onClick={() => toggle(key, f.path, f.snapshotId)}
+                     onContextMenu={(e) => { e.preventDefault(); props.onPathMenu?.(f.path, "file", e.clientX, e.clientY); }}
+                   >
+                     <span className="chev" aria-hidden="true"><ChevronRight size={10} /></span>
+                     <span className={"act " + f.change}>
+                       {f.change === "created" ? "新建" : f.change === "modified" ? "修改" : "变更"}
+                     </span>
+                     <span className="path">{f.path}</span>
+                     {f.snapshotId !== undefined && (
+                       <span className="snap" title="覆盖前快照已保留（.agent/snapshots）">快照</span>
+                     )}
+                   </button>
+                   {open && (
+                     <div className="change-diff-zone">
+                       {diff.loading && <div className="pane-empty">正在读快照与当前文件…</div>}
+                       {!diff.loading && diff.payload !== null && (
+                         diff.payload.ok
+                           ? (
+                             <>
+                               <div className="change-diff-stat num">{`+${String(diffCount(diff.payload.hunks).add)} −${String(diffCount(diff.payload.hunks).del)}`}</div>
+                               <DiffView
+                                 hunks={diff.payload.hunks}
+                                 truncated={diff.payload.truncated}
+                                 {...(props.onReview !== undefined
+                                   ? {
+                                       comment: {
+                                         comments,
+                                         keyPrefix: `${f.path}|`,
+                                         onComment: (lineKey: string, text: string) => {
+                                           setComments((prev) => {
+                                             const next = new Map(prev);
+                                             if (text === "") next.delete(lineKey); else next.set(lineKey, text);
+                                             return next;
+                                           });
+                                         },
+                                       },
+                                     }
+                                   : {})}
+                               />
+                             </>
+                           )
+                           : <div className="ap-notice err" role="alert">{diff.payload.error}</div>
+                       )}
+                     </div>
+                   )}
+                 </li>
+               );
+             })}
+           </ul>
+           {t.unverifiedFiles.length > 0 && (
+             <div className="consequence">未验证：{t.unverifiedFiles.join("、")}</div>
+           )}
+           {t.nextAction !== "" && <div className="consequence">→ {t.nextAction}</div>}
+           </>
+           )}
+         </section>
+       ))}
+       </div>
+     </div>
+   );
+ }
+
+ /** 方案窗格：全部方案（提交序）+ 决议状态。 */
+ function PlanPane(props: { events: readonly AgentEvent[] }): React.JSX.Element {
+   const plans = projectPlans(props.events);
+   if (plans.length === 0) {
+     return <div className="pane-empty">本会话还没有提交过方案。<br />模型提请计划后会在审核后留档在这里。</div>;
+   }
+   const stateWord = (s: string): string => (s === "approved" ? "已批准" : s === "rejected" ? "已拒绝" : "待决");
+   const stateCls = (s: string): string => (s === "approved" ? "ok" : s === "rejected" ? "bad" : "warn");
+   return (
+     <div className="pane-list">
+       {plans.map((p) => (
+         <section className="pane-card" key={p.callId}>
+           <div className="pane-card-head">
+             <span className={"chip " + stateCls(p.state)}>{stateWord(p.state)}</span>
+             <span className="pc-goal" title={p.goal}>{p.goal}</span>
+           </div>
+           <ul className="changes-list">
+             {p.files.map((f) => (
+               <li className="change-item" key={`${f.action}:${f.path}`}>
+                 <span className={"act " + (f.action === "delete" ? "delete" : f.action === "create" ? "created" : "modified")}>
+                   {f.action === "create" ? "新建" : f.action === "delete" ? "删除" : "修改"}
+                 </span>
+                 <span className="path">{f.path}</span>
+               </li>
+             ))}
+           </ul>
+           {p.approach !== undefined && (
+             <details className="delivery-evidence">
+               <summary>做法说明</summary>
+               <div className="evidence-body">{p.approach}</div>
+             </details>
+           )}
+           {p.verify !== undefined && (
+             <div className="consequence">
+               验证面：{p.verify.lint ?? "未声明 lint"}{" / "}{p.verify.test ?? "未声明 test"}
+             </div>
+           )}
+         </section>
+       ))}
+     </div>
+   );
+ }
+
+ /** 任务窗格：多 agent 状态（worker 簇）。 */
+ function TasksPane(props: { events: readonly AgentEvent[] }): React.JSX.Element {
+   const workers = projectWorkers(props.events);
+   if (workers.length === 0) {
+     return <div className="pane-empty">本会话还没有派过子任务。<br />agent 派出 worker 后会在这里列出。</div>;
+   }
+   const statusWord = (s: WorkerPaneItem["status"]): string =>
+     s === "running" ? "运行中"
+     : s === "waiting_approval" ? "等待审批"
+     : s === "waiting_input" ? "等待输入"
+     : s === "done" ? "完成"
+     : s === "failed" ? "失败"
+     : "已取消";
+   const verifiedWord = (v: NonNullable<WorkerPaneItem["verified"]>): string =>
+     v === "verified" ? "验证通过" : v === "failed" ? "验证失败" : v === "stale" ? "证据过期" : "无验证";
+   return (
+     <div className="pane-list">
+       {workers.map((w) => (
+         <section className="pane-card" key={w.agentId} data-status={w.status}>
+           <div className="pane-card-head">
+             <span className={"wk-dot " + w.status} aria-hidden="true">
+               {w.status === "running" ? <Loader2 size={12} /> : w.status === "done" ? <Check size={12} /> : w.status === "failed" ? <X size={12} /> : <AlertTriangle size={12} />}
+             </span>
+             <span className="wk-task" title={w.task}>{w.task}</span>
+           </div>
+           <div className="wk-meta">
+             {w.role !== undefined && <span className="vchip">{w.role}</span>}
+             <span className="vchip">{w.mode}</span>
+             <span className="vchip">{statusWord(w.status)}</span>
+             {w.durationSec !== undefined && <span className="vchip num">{String(w.durationSec)}s</span>}
+             {w.verified !== undefined && <span className="vchip">证据：{verifiedWord(w.verified)}</span>}
+             {w.status !== "running" && w.status !== "waiting_approval" && w.status !== "waiting_input" && (
+               w.spentUsd !== undefined
+                 ? <span className="vchip num">${w.spentUsd.toFixed(4)}</span>
+                 : <span className="vchip">价格不可知</span>
+             )}
+           </div>
+           {w.progress.length > 0 && (
+             <details className="delivery-evidence">
+               <summary>进度 · {String(w.progress.length)} 条</summary>
+               <div className="evidence-body">
+                 {w.progress.map((line, i) => <p className="wk-line" key={i}>{line}</p>)}
+               </div>
+             </details>
+           )}
+           {w.summary !== undefined && w.summary !== "" && (
+             <div className="evidence-body wk-summary">{w.summary}</div>
+           )}
+           {w.reason !== undefined && <div className="consequence danger-text">{w.reason}</div>}
+         </section>
+       ))}
+     </div>
+   );
+ }
+
+ /** 窗格容器（网格化）：tabs 里的每个窗格各占一格、纵向堆叠，格间分割线可拖行高。
+  *  tabs 为空时给空态说明（罕见路径——App 侧 tabs 空即整列收起）。 */
+ export function PaneDock(props: {
+   tabs: readonly PaneKind[];
+   events: readonly AgentEvent[];
+   onClose: (kind: PaneKind) => void;
+   onOpen?: (kind: PaneKind) => void;
+   /** 行级评注一次性提交的去处（App 传 send → 新一轮/入队）；缺省 = 评注 UI 不出现。 */
+   onReview?: (text: string) => void;
+   /** 拖标题栏换位（from/to 为 tabs 下标）；缺省 = 不可拖。 */
+   onReorder?: (from: number, to: number) => void;
+   /** 弹出为独立窗口（缺省 = 无弹出入口）。 */
+   onPopout?: (kind: PaneKind) => void;
+   /** 独立窗格窗口（弹出的单窗格，PopoutApp 传）：**没有多面板可导航/可恢复**
+    *  ⇒ 面板导航行（聚焦某窗格 / 恢复多面板布局）在那里是**死按钮**，
+    *  且和窗格自己的标题行叠成两行同样的字（真机截图：弹出窗里两行「终端」）。
+    *  ⇒ 独立窗格窗口不渲染那一行。 */
+   inPopout?: boolean;
+   /** v6 预览地址：browser 窗格就绪后自动导航到这里（缺省 = 只显示手动地址栏）。 */
+   browserUrl?: string;
+   /** v7 当前会话 id（sidechat 窗格的父会话面；缺省 = 旁路空态提示先开会话）。 */
+   sessionId?: string | null;
+   /** v7 附为上下文（§2.3 右键菜单）：工作区相对路径 → App 解析绝对路径后进 composer 附件。 */
+   onAttach?: (rel: string, kind: "file" | "directory") => void;
+   /** v7 元素选择信号（§3.6 ⌘⇧S，App 递增 seq）：browser 窗格据此对活动标签发起一次选择。 */
+   pickSignal?: number;
+   /** v7 元素选择结果（选择器/片段/页面 URL）→ App 拼文进输入框。 */
+   onPickResult?: (r: { selector: string; snippet: string; url: string }) => void;
+ }): React.JSX.Element {
+   // 拖拽换位状态（HTML5 DnD；拖动中的格子给视觉反馈）。
+   const [dragIndex, setDragIndex] = useState<number | null>(null);
+   const [focusedPane, setFocusedPane] = useState<PaneKind | null>(null);
+   const focused = focusedPane !== null && props.tabs.includes(focusedPane) ? focusedPane : null;
+   const previousTabs = useRef(props.tabs);
+   const navRef = useRef<HTMLElement | null>(null);
+   const closePane = (kind: PaneKind): void => {
+     props.onClose(kind);
+     // 关闭按钮卸载后将焦点交给剩余窗格，避免键盘用户掉回文档起点。
+     window.requestAnimationFrame(() => {
+       navRef.current?.querySelector<HTMLButtonElement>(".pane-nav-item")?.focus();
+     });
+   };
+   useEffect(() => {
+     const added = props.tabs.find((kind) => !previousTabs.current.includes(kind));
+     if (focusedPane !== null) setFocusedPane(added ?? (props.tabs.includes(focusedPane) ? focusedPane : null));
+     previousTabs.current = props.tabs;
+   }, [props.tabs, focusedPane]);
+   // 右键路径菜单（§2.3）：窗格内坐标 + 目标；渲染层自绘（见 PathMenu）。
+   const [pathMenu, setPathMenu] = useState<{ x: number; y: number; rel: string; kind: "file" | "directory" } | null>(null);
+   const openPathMenu = (rel: string, kind: "file" | "directory", x: number, y: number): void => {
+     setPathMenu({ x, y, rel, kind });
+   };
+   // 行高记忆：Grid 的行轨 id 用窗格 kind（不是行下标），重排/关开后尺寸跟着窗格走。
+   const gridRef = useGridRef();
+   const tabsSig = props.tabs.join("\u0001");
+   const rowTracks = useMemo(
+     () => props.tabs.map((kind) => ({ id: kind, minSize: `${MIN_PANE_PCT}%` })),
+     // 数组每次渲染都是新引用；tabsSig 是内容签名，等价于「窗格集变了没有」。
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+     [tabsSig],
+   );
+   const defaultRows = useMemo(
+     () => paneRowLayout(props.tabs, loadPaneRows()),
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+     [tabsSig],
+   );
+   // 窗格集变化（恢复上次布局 / 新开 / 关闭）时把记下的行高放回去。
+   // setLayout 触发的 onLayoutChanged 带 isUserInteraction=false，不会回写存储。
+   useEffect(() => {
+     const grid = gridRef.current;
+     if (grid === null || props.tabs.length === 0) return;
+     grid.setLayout({ rows: paneRowLayout(props.tabs, loadPaneRows()) });
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+   }, [tabsSig]);
+   if (props.tabs.length === 0) {
+     return (
+       <aside className="pane-dock" aria-label="窗格区">
+         <div className="pane-empty">没有打开的窗格。<br />顶栏「变更」或 ⋮ 菜单可开。</div>
+       </aside>
+     );
+   }
+   return (
+     <div className="pane-workbench">
+     {/* 面板导航行只对「多窗格同屏」有意义：独立窗格窗口里它是死按钮（见 inPopout 注释）。 */}
+     {props.inPopout !== true && (
+     <nav className="pane-nav" aria-label="面板导航" ref={navRef}>
+       <div className="pane-nav-items">
+         {props.tabs.map((kind) => <button key={kind} className="pane-nav-item"
+           aria-label={`聚焦${PANE_META[kind].label}窗格`} aria-pressed={focused === kind}
+           onClick={() => setFocusedPane(kind)}>{PANE_META[kind].label}</button>)}
+       </div>
+       <button className="iconbtn sm" aria-label="恢复多面板布局" title="恢复多面板布局" aria-pressed={focused === null}
+         onClick={() => setFocusedPane(null)}><PanelsTopLeft size={15} /></button>
+       {props.onOpen !== undefined && <DropdownMenu.Root>
+         <DropdownMenu.Trigger asChild><button className="iconbtn sm" aria-label="添加面板" title="添加面板"><Plus size={15} /></button></DropdownMenu.Trigger>
+         <DropdownMenu.Portal><DropdownMenu.Content className="pop-rd" sideOffset={5} align="end">
+           {PANE_OPENABLE.map((kind) => <DropdownMenu.Item key={kind} className="menu-item"
+             onSelect={() => { if (!props.tabs.includes(kind)) props.onOpen?.(kind); setFocusedPane(kind); }}>
+             <span>{PANE_META[kind].label}</span>{props.tabs.includes(kind) && <Check size={12} />}
+           </DropdownMenu.Item>)}
+         </DropdownMenu.Content></DropdownMenu.Portal>
+       </DropdownMenu.Root>}
+     </nav>
+     )}
+     <Grid
+       gridRef={gridRef}
+       columns={1}
+       rows={rowTracks}
+       defaultLayout={{ rows: defaultRows }}
+       onLayoutChanged={(layout, meta) => {
+         if (focused !== null) return;
+         if (!meta.isUserInteraction) return;
+         savePaneRows(mergePaneRows(loadPaneRows(), layout.rows, props.tabs));
+       }}
+       className="pane-grid"
+       id="cairn-panes"
+       data-focused={focused ?? undefined}
+     >
+       {props.tabs.map((kind, i) => (
+         <Fragment key={kind}>
+           {i > 0 && <Gridline type="row" row={i} className="pane-gridline" />}
+           <Cell column={0} row={i} className="pane-cell" data-pane={kind} data-focused={focused === kind}>
+             <section className="pane-chunk" aria-label={`${PANE_META[kind].label}窗格`}>
+               <div
+                 className="pane-chunk-head"
+                 draggable={props.onReorder !== undefined}
+                 data-dragging={dragIndex === i}
+                 onDragStart={(e) => {
+                   if (props.onReorder === undefined) return;
+                   setDragIndex(i);
+                   e.dataTransfer.effectAllowed = "move";
+                 }}
+                 onDragOver={(e) => {
+                   if (dragIndex !== null && dragIndex !== i) e.preventDefault();
+                 }}
+                 onDrop={(e) => {
+                   e.preventDefault();
+                   if (dragIndex !== null && dragIndex !== i) props.onReorder?.(dragIndex, i);
+                   setDragIndex(null);
+                 }}
+                 onDragEnd={() => setDragIndex(null)}
+                 // 键盘换位（2026-10-18）：拖拽此前是唯一的换位路径，键盘用户够不着「⋮⋮」。
+                 // 焦点在窗格头本身时 ⌥↑/⌥↓ 与拖拽同语义（共用 movePane）；方向键留给内部控件。
+                 tabIndex={props.onReorder !== undefined ? 0 : undefined}
+                 onKeyDown={(e) => {
+                   if (props.onReorder === undefined || e.target !== e.currentTarget) return;
+                   if (!e.altKey || (e.key !== "ArrowUp" && e.key !== "ArrowDown")) return;
+                   const to = reorderTarget(i, e.key, props.tabs.length);
+                   if (to === null) return;
+                   e.preventDefault();
+                   props.onReorder(i, to);
+                 }}
+                 title={props.onReorder !== undefined ? "拖动换位（键盘：⌥↑ / ⌥↓）" : undefined}
+               >
+                 {props.onReorder !== undefined && <span className="pc-grip" aria-hidden="true"><GripVertical size={12} /></span>}
+                 <span className="pc-label">{PANE_META[kind].label}</span>
+                 {props.onPopout !== undefined && (
+                   <button
+                     className="pt-x"
+                     aria-label={`弹出${PANE_META[kind].label}窗格`}
+                     title="弹出为独立窗口"
+                     onClick={() => { props.onPopout?.(kind); }}
+                   ><ExternalLink size={12} /></button>
+                 )}
+                 <button
+                   className="pt-x"
+                   aria-label={`关闭${PANE_META[kind].label}窗格`}
+                   onClick={() => { closePane(kind); }}
+                 ><X size={11} /></button>
+               </div>
+               <div className="pane-chunk-body">
+                 {kind === "changes" && (
+                   <ChangesPane
+                     events={props.events}
+                     {...(props.onReview !== undefined ? { onReview: props.onReview } : {})}
+                     onPathMenu={openPathMenu}
+                   />
+                 )}
+                 {kind === "plan" && <PlanPane events={props.events} />}
+                 {kind === "tasks" && <TasksPane events={props.events} />}
+                 {kind === "file" && <FilePane onPathMenu={openPathMenu} />}
+                 {kind === "terminal" && <TerminalPane />}
+                 {kind === "browser" && (
+                   <BrowserPane
+                     {...(props.browserUrl !== undefined ? { initialUrl: props.browserUrl } : {})}
+                     {...(props.pickSignal !== undefined ? { pickSignal: props.pickSignal } : {})}
+                     {...(props.onPickResult !== undefined ? { onPickResult: props.onPickResult } : {})}
+                   />
+                 )}
+                 {kind === "sidechat" && <SidechatPane sessionId={props.sessionId ?? null} />}
+                 {kind === "plugins" && <PluginSurface />}
+               </div>
+             </section>
+           </Cell>
+         </Fragment>
+       ))}
+     </Grid>
+     {pathMenu !== null && (
+       <PathMenu
+         x={pathMenu.x}
+         y={pathMenu.y}
+         relPath={pathMenu.rel}
+         kind={pathMenu.kind}
+         onClose={() => setPathMenu(null)}
+         {...(props.onAttach !== undefined ? { onAttach: props.onAttach } : {})}
+       />
+     )}
+     </div>
+   );
+ }
+
+
+ // 文件路径右键菜单（§2.3）：复制路径（绝对）/ 在 Finder 中显示 / 用默认应用打开 / 附为上下文。
+ // 渲染层自绘菜单（不走原生 Menu——与设计体系同皮；动作面走 v7 workspacePathAction 通道，
+ // 路径越界在 main 侧会被 resolveEntry 拒绝）。Esc/点外关闭；data-state="open" 参与全局「浮层优先」判据。
+ import { useEffect, useRef, useState } from "react";
+
+ export function PathMenu(props: {
+   x: number;
+   y: number;
+   relPath: string;
+   kind: "file" | "directory";
+   onClose: () => void;
+   /** 附为上下文（App 解析成绝对路径后塞进 composer 附件）；缺省 = 不显示该行。 */
+   onAttach?: (rel: string, kind: "file" | "directory") => void;
+ }): React.JSX.Element {
+   const ref = useRef<HTMLDivElement | null>(null);
+   const [notice, setNotice] = useState<string | null>(null);
+   const first = useRef<HTMLButtonElement | null>(null);
+
+   useEffect(() => {
+     first.current?.focus();
+     const onDoc = (e: MouseEvent): void => {
+       if (ref.current !== null && e.target instanceof Node && ref.current.contains(e.target)) return;
+       props.onClose();
+     };
+     const onKey = (e: KeyboardEvent): void => {
+       if (e.key === "Escape") { e.stopPropagation(); props.onClose(); }
+     };
+     document.addEventListener("mousedown", onDoc, true);
+     document.addEventListener("keydown", onKey, true);
+     return () => {
+       document.removeEventListener("mousedown", onDoc, true);
+       document.removeEventListener("keydown", onKey, true);
+     };
+   }, [props]);
+
+   const act = (action: "abs" | "reveal" | "open"): void => {
+     void window.agent.workspacePathAction(props.relPath, action).then((r) => {
+       if (!r.ok) { setNotice(r.error ?? "操作失败"); return; }
+       if (action === "abs") {
+         void navigator.clipboard.writeText(r.path ?? "").then(() => props.onClose(), (err: unknown) => {
+           setNotice(`复制失败：${err instanceof Error ? err.message : String(err)}`);
+         });
+         return;
+       }
+       props.onClose();
+     }, (err: unknown) => {
+       setNotice(`操作失败：${err instanceof Error ? err.message : String(err)}`);
+     });
+   };
+
+   const x = Math.min(props.x, Math.max(8, window.innerWidth - 232));
+   const y = Math.min(props.y, Math.max(8, window.innerHeight - 176));
+   return (
+     <div className="path-menu" role="menu" data-state="open" aria-label="路径操作" ref={ref} style={{ left: x, top: y }}>
+       <div className="pm-head" title={props.relPath}>{props.relPath}</div>
+       <button ref={first} className="menu-item" role="menuitem" onClick={() => { act("abs"); }}>复制路径（绝对）</button>
+       <button className="menu-item" role="menuitem" onClick={() => { act("reveal"); }}>在 Finder 中显示</button>
+       <button className="menu-item" role="menuitem" onClick={() => { act("open"); }}>用默认应用打开</button>
+       {props.onAttach !== undefined && (
+         <button className="menu-item" role="menuitem" onClick={() => { props.onAttach?.(props.relPath, props.kind); props.onClose(); }}>附为上下文</button>
+       )}
+       {notice !== null && <div className="pm-note" role="alert">{notice}</div>}
+     </div>
+   );
+ }
+
+ // C-20 权限档菜单（批 5 · 细则 §五「弹层与菜单（统一组件）」；P2-2 迁移 STR + 档位色点）。
+ // 列表态 = 每项色点 + 图标 + 标题 + 副标题两行；「自动」行 warning 图标 +「危险」小标签（不整行变色）；
+ // 选「自动」先走二次确认（PermissionConfirm）——确认前绝不调 onModeChange（危险动作不静默）。
+ // 词表（MODE_LABEL / MODE_DOT）与触发器共用，单一事实源在本文件；值全出处 STR（本文件零裸中文）。
+ import { Shield,ShieldAlert,ShieldCheck,ShieldOff } from "lucide-react";
+ import { useState } from "react";
+ import type { PermissionMode } from "../../../../../src/main/ipc-protocol";
+ import { STR } from "../strings";
+
+ /** 权限档词表：label 短词（触发器与条目共用）、desc 一句人话说明、warn = 危险档标记。 */
+ import { MODE_LABEL } from "../permission-labels";
+ export { MODE_LABEL } from "../permission-labels";
+
+ /** 档位色点（P2-2 · brief 三节：只读=灰绿 / 默认=蓝灰 / 引导=黄 / 自动=红）。
+  *  值 = tokens.css 四枚语义变量的引用（亮暗双主题各给值，组件零字面色值纪律不破）。 */
+ export const MODE_DOT: Record<PermissionMode, string> = {
+   "read-only": "var(--mode-readonly)",
+   default: "var(--mode-default)",
+   guided: "var(--mode-guided)",
+   auto: "var(--mode-auto)",
+ };
+
+ /** 条目图标族（盾形谱：拒写 / 默认 / 引导 / 全放行）。 */
+ const MODE_ICON: Record<PermissionMode, typeof Shield> = {
+   "read-only": ShieldOff,
+   default: Shield,
+   guided: ShieldCheck,
+   auto: ShieldAlert,
+ };
+
+ const MODE_ORDER: readonly PermissionMode[] = ["read-only", "default", "guided", "auto"];
+
+ /** 色点展示件（触发器与菜单条目共用同一枚，几何/色值分主题由 tokens 定）。 */
+ export function ModeDot(props: { mode: PermissionMode }): React.JSX.Element {
+   return (
+     <span
+       className="mode-dot"
+       data-mode={props.mode}
+       style={{ background: MODE_DOT[props.mode] }}
+       aria-hidden="true"
+     />
+   );
+ }
+
+ export function PermissionMenu(props: {
+   mode: PermissionMode;
+   onModeChange: (m: PermissionMode) => void;
+   onClose: () => void;
+ }) {
+   const [confirming, setConfirming] = useState(false);
+   if (confirming) {
+     return (
+       <PermissionConfirm
+         onCancel={() => setConfirming(false)}
+         onConfirm={() => {
+           // 先清确认态再落档（防御：将来若改回常驻挂载，state 也不残留——真机实证过）。
+           setConfirming(false);
+           props.onModeChange("auto");
+           props.onClose();
+         }}
+       />
+     );
+   }
+   return (
+     <>
+       <div className="pop-label">{STR.permissionMenu.label}</div>
+       {MODE_ORDER.map((m) => {
+         const info = MODE_LABEL[m];
+         const Ico = MODE_ICON[m];
+         return (
+           <button
+             key={m}
+             type="button"
+             className="menu-item perm-item"
+             role="menuitem"
+             data-mode={m}
+             onClick={() => {
+               // 「自动」= 全部放行：没确认过就先出确认卡；确认前不动权限（危险不静默）。
+               if (m === "auto" && props.mode !== "auto") {
+                 setConfirming(true);
+                 return;
+               }
+               props.onModeChange(m);
+               props.onClose();
+             }}
+           >
+             <ModeDot mode={m} />
+             <span className={info.warn === true ? "perm-ico warn" : "perm-ico"}>
+               <Ico size={13} aria-hidden="true" />
+             </span>
+             <span className="perm-text">
+               <span className="perm-label">
+                 {info.label}
+                 {info.warn === true && <span className="tag-warn">{STR.permissionMenu.warnTag}</span>}
+               </span>
+               <span className="perm-desc">{info.desc}</span>
+             </span>
+             {m === props.mode && <span className="check">✓</span>}
+           </button>
+         );
+       })}
+     </>
+   );
+ }
+
+ /** 「自动」二次确认卡（危险动作显式确认；确认按钮才是真切换）。 */
+ export function PermissionConfirm(props: { onCancel: () => void; onConfirm: () => void }) {
+   return (
+     <div className="perm-confirm" role="alertdialog" aria-label={STR.permissionMenu.confirmAria}>
+       <div className="perm-confirm-title">{STR.permissionMenu.confirmTitle}</div>
+       <div className="perm-confirm-desc">{STR.permissionMenu.confirmDesc}</div>
+       <div className="perm-confirm-actions">
+         <button type="button" className="mini-btn" onClick={props.onCancel}>{STR.common.cancel}</button>
+         <button type="button" className="mini-btn danger" onClick={props.onConfirm}>{STR.permissionMenu.confirmOk}</button>
+       </div>
+     </div>
+   );
+ }
+
+ // C-16 PlanCard（v2.9 紧凑态）：头行（标题+wait chip+详情▾）→ 目标行 → 动作行（含文件数/验证面）。
+ // 展开详情 = approach 段 / 文件清单（action 徽标）/ 验证面 chips / 后果行（拒绝 = 写禁维持、模型须修订）。
+ import { useState } from "react";
+ import type { PlanProposal } from "../../../../../src/events";
+
+ const ACTION_LABEL: Record<string, string> = { create: "新建", edit: "修改", delete: "删除" };
+
+ export function PlanCard(props: {
+   callId: string;
+   plan: PlanProposal;
+   onDecide: (approved: boolean, callId: string) => void;
+ }) {
+   const [expanded, setExpanded] = useState(false);
+   const verify = props.plan.verify;
+   const verifyChips = [
+     ...(verify?.lint?.length ?? 0) > 0 ? [`lint: ${verify?.lint?.join(" && ")}`] : [],
+     ...(verify?.test?.length ?? 0) > 0 ? [`test: ${verify?.test?.join(" && ")}`] : [],
+   ];
+   return (
+     <div className="card" data-exp={expanded ? "true" : "false"}>
+       <div className="card-head">
+         <span className="ico-wait" aria-hidden="true">
+           <svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round"><circle cx="7" cy="7" r="5.2"/><path d="M7 4.2V7l2 1.2"/></svg>
+         </span>
+         <h3>模型提交了方案</h3>
+         <span className="chip wait">待批</span>
+         <span className="spacer" />
+         <button className="iconbtn sm" data-card-exp aria-label={expanded ? "收起详情" : "展开详情"} onClick={() => setExpanded(!expanded)}>
+           <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" style={{ transform: expanded ? "rotate(180deg)" : undefined, transition: "transform var(--t-fast)" }}><path d="m3.5 5.5 3.5 3.5 3.5-3.5"/></svg>
+         </button>
+       </div>
+       <div className="oneline" title={props.plan.goal}>{props.plan.goal}</div>
+       {expanded && (
+         <>
+           {props.plan.approach && <div className="plan-approach">{props.plan.approach}</div>}
+           <div className="file-list">
+             {props.plan.files.map((f, i) => (
+               <div className="file-item" key={i}>
+                 <span className={`chip ${f.action === "create" ? "ok" : f.action === "delete" ? "danger" : ""}`}>{ACTION_LABEL[f.action] ?? f.action}</span>
+                 <span className="path">{f.path}</span>
+                 {"summary" in f && typeof f.summary === "string" && <span className="sum">{f.summary}</span>}
+               </div>
+             ))}
+           </div>
+           <div className="verify-line">
+             {verifyChips.length > 0
+               ? verifyChips.map((v, i) => <span className="vchip" key={i}>{v}</span>)
+               : <span>未声明验证面</span>}
+           </div>
+         </>
+       )}
+       <div className="card-actions">
+         <button className="btn primary" onClick={() => props.onDecide(true, props.callId)}>批准方案</button>
+         <button className="btn secondary" onClick={() => props.onDecide(false, props.callId)}>拒绝</button>
+         <span className="spacer" />
+         <span className="consequence">
+           {String(props.plan.files.length)} 个文件{verifyChips.length > 0 ? ` · 验证面 ${String(verifyChips.length)} 项` : ""}
+           {" · 批准解除写禁；拒绝 = 写禁维持、模型须修订重提"}
+         </span>
+       </div>
+     </div>
+   );
+ }
+
+ // mod 侧栏（G1 布局挤窄版，2026-10-21）：右侧 280–420px，复用 PluginSurface。
+ // 拖动/方向键改宽并持久化；主栏被挤窄，不是覆盖层。
+ import { useEffect, useRef } from "react";
+ import { X } from "lucide-react";
+ import { STR } from "../strings";
+ import { PluginSurface } from "./PluginSurface";
+
+ export function PluginSidebar(props: { width: number; onWidth: (width: number) => void; onClose: () => void; onInvoke: (invoke: string) => void }): React.JSX.Element {
+   const closeRef = useRef<HTMLButtonElement>(null);
+   const rootRef = useRef<HTMLElement>(null);
+   const dragRef = useRef<{ x: number; width: number } | null>(null);
+   const clampWidth = (n: number): number => Math.max(280, Math.min(420, n));
+   useEffect(() => { closeRef.current?.focus(); }, []);
+   // 窄窗覆盖层：点侧栏以外的地方收起；宽窗是布局列，不抢点击。
+   useEffect(() => {
+     const onDown = (e: PointerEvent): void => {
+       if (window.innerWidth > 1120) return;
+       const target = e.target;
+       if (!(target instanceof Node)) return;
+       if (rootRef.current?.contains(target)) return;
+       if (target instanceof Element && target.closest('[aria-label="插件侧栏"]') !== null) return;
+       props.onClose();
+     };
+     document.addEventListener("pointerdown", onDown, true);
+     return () => { document.removeEventListener("pointerdown", onDown, true); };
+   }, [props.onClose]);
+   return (
+     <aside ref={rootRef} id="mod-sidebar" className="mod-sidebar" aria-label={STR.pluginSidebar.aria} style={{ width: props.width }}>
+       <div
+         className="mod-sidebar-resize"
+         role="separator"
+         aria-orientation="vertical"
+         aria-label={STR.pluginSidebar.resize}
+         aria-valuemin={280}
+         aria-valuemax={420}
+         aria-valuenow={Math.round(props.width)}
+         tabIndex={0}
+         title={STR.pluginSidebar.resize}
+         onPointerDown={(e) => {
+           dragRef.current = { x: e.clientX, width: props.width };
+           e.currentTarget.setPointerCapture(e.pointerId);
+         }}
+         onPointerMove={(e) => {
+           const start = dragRef.current;
+           if (start === null) return;
+           props.onWidth(clampWidth(start.width + (start.x - e.clientX)));
+         }}
+         onPointerUp={(e) => {
+           dragRef.current = null;
+           e.currentTarget.releasePointerCapture(e.pointerId);
+         }}
+         onDoubleClick={() => { props.onWidth(340); }}
+         onKeyDown={(e) => {
+           if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
+             e.preventDefault();
+             props.onWidth(clampWidth(props.width + (e.key === "ArrowLeft" ? 10 : -10)));
+           } else if (e.key === "Home") {
+             e.preventDefault();
+             props.onWidth(280);
+           } else if (e.key === "End") {
+             e.preventDefault();
+             props.onWidth(420);
+           }
+         }}
+       />
+       <div className="mod-sidebar-head">
+         <span className="mod-sidebar-title">{STR.pluginSidebar.title}</span>
+         <button ref={closeRef} className="iconbtn sm" aria-label={STR.pluginSidebar.close} title={STR.pluginSidebar.close} onClick={props.onClose}>
+           <X size={14} />
+         </button>
+       </div>
+       <div className="mod-sidebar-body"><PluginSurface className="mod-plugin-surface" onInvoke={props.onInvoke} /></div>
+     </aside>
+   );
+ }
+
+ // 插件快照的共用读取面（2026-10-21）：右列插件窗格与 mod 侧栏共用同一份
+ // getState().plugins 读取/错误/重试逻辑，避免两处各自实现后口径漂移。
+ import { lazy, Suspense, useEffect, useRef, useState } from "react";
+ import type { PluginPanelSnapshot } from "../../../../../src/agent/plugins";
+ import { STR } from "../strings";
+
+ // 插件面板体（AppPage 的 PluginsPane）**按需加载**（2026-10-22 体积面）：
+ // AppPage 连同 radix-menu / floating-ui 一族约 130KB，只有真的打开插件面板才值得付。
+ // 此前它是**静态**依赖 ⇒ 弹出窗（只渲染一个窗格的小窗口）也把整页工作台拖进来，
+ // 路由 JS 顶破 bundle 闸门（popout 423,130B > 400,000B 帽）。
+ // 懒加载边界放在**本文件内部**（不是调用方）：窗格与 mod 侧栏的接线一行未改，
+ // 加载占位也只有插件面板那一格会亮，不牵连同屏其它窗格。
+ const PluginsPane = lazy(() => import("./AppPage").then((m) => ({ default: m.PluginsPane })));
+
+ export function PluginSurface(props: { className?: string; onInvoke?: (invoke: string) => void }): React.JSX.Element {
+   const [snap, setSnap] = useState<PluginPanelSnapshot | null>(null);
+   const [error, setError] = useState<string | null>(null);
+   const seq = useRef(0);
+   const load = (): void => {
+     const id = ++seq.current;
+     setError(null);
+     void window.agent.getState().then((s) => {
+       if (id !== seq.current) return; // 重试/刷新期间旧响应不覆盖新结果
+       if (s.plugins === undefined) setError(STR.pluginSurface.missing);
+       else setSnap(s.plugins);
+     }).catch((err: unknown) => {
+       if (id !== seq.current) return;
+       setError(err instanceof Error ? err.message : String(err));
+     });
+   };
+   useEffect(load, []);
+   const cls = props.className === undefined ? "plugin-pane" : `plugin-pane ${props.className}`;
+   if (error !== null) {
+     return (
+       <div className={cls}>
+         <div className="fp-note err" role="alert">{error}</div>
+         <button className="mini-btn" onClick={load}>{STR.pluginSurface.retry}</button>
+       </div>
+     );
+   }
+   if (snap === null) return <div className={cls}><div className="fp-note">{STR.pluginSurface.loading}</div></div>;
+   return (
+     <div className={cls}>
+       <Suspense fallback={<div className="fp-note">{STR.pluginSurface.paneLoading}</div>}>
+         <PluginsPane snap={snap} onError={setError} refresh={load} {...(props.onInvoke !== undefined ? { onInvoke: props.onInvoke } : {})} />
+       </Suspense>
+     </div>
+   );
+ }
+
+ // 独立窗格窗口（#pane=<kind>[&session=<id>] 路由，蓝本 §3.4 弹出）：
+ // 只渲染一个窗格 + 主题跟随；数据面自拉（openSession 历史 + onEvent 增量——推送已广播所有窗口）。
+ // 与主窗口共用同一 preload/AgentApi；不嵌套弹出（onPopout 不传）；关闭钮 = 关窗。
+ import { useEffect, useState } from "react";
+ import type { AgentEvent } from "../../../../../src/events";
+ import { applyTheme, browserThemeEnv, type ThemePref } from "../theme";
+ import { mergeSessionSnapshot, popoutEventBelongsTo } from "../projections";
+ import { PaneDock, type PaneKind } from "./PaneDock";
+ import { PANE_META } from "./panes";
+
+ export function PopoutApp(props: { kind: PaneKind; sessionId: string | null }): React.JSX.Element {
+   const [events, setEvents] = useState<AgentEvent[]>([]);
+   const [themePref, setThemePref] = useState<ThemePref>("system");
+   useEffect(() => {
+     void window.agent.getSettings().then((s) => { setThemePref(s.theme); }).catch(() => undefined);
+   }, []);
+   useEffect(() => applyTheme(themePref, browserThemeEnv()), [themePref]);
+   // 独立窗口的标题（2026-10-18）：此前和主窗口一样叫「Cairn」，多开时在窗口列表里分不清谁是谁；
+   // 再把会话名带上（同一窗格类型开两个会话时也能分）。
+   useEffect(() => {
+     const sid = props.sessionId === null ? ""
+       : ` · ${props.sessionId.length > 24 ? `${props.sessionId.slice(0, 24)}…` : props.sessionId}`;
+     document.title = `Cairn · ${PANE_META[props.kind].label}${sid}`;
+   }, [props.kind, props.sessionId]);
+   useEffect(() => {
+     // 没有 sessionId 的弹出窗**不收任何事件**：旧实现 `props.sessionId === null || …` 让第一个
+     // 析取项把后面两项都变成废话 ⇒ 弹出窗会把**所有会话**的事件都吸进来（⌘N 回首页时 paneTabs
+     // 不清、⧉ 传的是 undefined）。用户在这个只有「变更」两个字、空态还写着"本会话还没有文件改动"
+     // 的窗格里，看到的是**另一个会话**的轮次、文件与验证状态。没有归属就不显示，不是全都显示。
+     if (props.sessionId === null) return;
+     void window.agent.openSession(props.sessionId).then((r) => {
+       // 读盘期间到达的增量不能丢：openSession 回的是**读之前**的快照，直接 setEvents 会把
+       // 这窗口注册 onEvent 之后收到的那些事件盖掉（主窗口同款缺陷，那边用 openPending +
+       // mergeSessionSnapshot 修过，见 App.tsx 与 projections.ts；弹出窗漏了这一手）。
+       setEvents((prev) => mergeSessionSnapshot(r.events, prev));
+     }).catch(() => undefined);
+     const off = window.agent.onEvent((e) => {
+       if (popoutEventBelongsTo(e, props.sessionId)) setEvents((prev) => [...prev, e]);
+     });
+     return off;
+   }, [props.sessionId]);
+   return (
+     <div className="popout-app">
+       <PaneDock
+         tabs={[props.kind]}
+         events={events}
+         sessionId={props.sessionId}
+         onClose={() => { window.close(); }}
+         inPopout
+       />
+     </div>
+   );
+ }
+
+ // 共享弹层基座（《全局 UI 视觉重构》brief 交付方式 2「通用组件先行」· 阶段 1）：
+ // ① <Popover> 展示件——从 Composer 内联 Pop + ModelPicker 自带容器收编而来，类族逐字节
+ //    同形（`pop {up|down} [show] [className]`），role / style / onKeyDown 等经 rest 透传；
+ //    视觉统一（surface + 描边 + 14 圆角 + 8px 内距 + 轻阴影）留到阶段 5 在本文件单点改。
+ // ② usePopoverDismiss——「外点关闭 + Esc 关闭」的单源实现（原 ModelPicker 内联逻辑上移，
+ //    行为不变：mousedown 冒泡相位、Esc 全局 keydown）。
+ // ③ useMenuKeyboard——自绘菜单的 WAI-ARIA 方向键导航（↑↓ 环形 / Home / End），
+ //    以及关闭后把焦点还给触发按钮（键盘用户 Esc 后不再掉到 body）。
+ // 纪律：弹层开合状态仍归各消费组件（受控）；这里只提供基座与关闭监听，不持有状态。
+ import { useCallback,type HTMLAttributes,type KeyboardEvent as ReactKeyboardEvent,type ReactNode,type RefObject } from "react";
+ import { menuNavIndex } from "./popover-keys";
+
+ export function Popover(props: {
+   open: boolean;
+   up?: boolean;
+   className?: string;
+   children: ReactNode;
+ } & HTMLAttributes<HTMLDivElement>) {
+   const { open, up, className, children, ...rest } = props;
+   return (
+     <div
+       className={`pop${up === true ? " up" : " down"}${open ? " show" : ""}${className !== undefined ? ` ${className}` : ""}`}
+       {...rest}
+     >
+       {children}
+     </div>
+   );
+ }
+
+ /** 外点 / Esc 关闭（open=false 时不挂监听；close 须稳定——用 useCallback 包）。
+  *  Radix 门户豁免（P2-1）：触发源在 `[data-radix-popper-content-wrapper]`（Radix 弹层门户，
+  *  挂在 body 上）里时不算「外点」——弹层内嵌的 Radix 子菜单（如空屏 chip 复用 AddProjectMenu）
+  *  点选时 mousedown 落在门户里，若照判 contains 会把宿主弹层一起关掉、点选落空。
+  *  关闭后焦点归还（2026-10-18）：Esc / 键盘选中让焦点离开被卸载的菜单时回到打开前的元素；
+  *  外点关闭不抢焦点（用户点哪儿焦点就该在哪儿）。 */
+ export { usePopoverDismiss } from "../usePopoverDismiss";
+
+ /** 自绘菜单的方向键导航（菜单按钮 + 菜单同一容器上挂 onKeyDown）：
+  *  - 关着时 ↓/↑ 打开菜单并聚焦首/末项（菜单项在关态仍挂 DOM，等开态渲染后下一帧再聚焦）；
+  *  - 开着时 ↓/↑ 环形移动、Home/End 直达两端；不处理 Enter/Space（原生 button 自己触发）。
+  *  Esc 仍由 usePopoverDismiss 负责，此处不重复。 */
+ export function useMenuKeyboard(
+   open: boolean,
+   setOpen: (open: boolean) => void,
+   ref: RefObject<HTMLElement | null>,
+ ): (e: ReactKeyboardEvent<HTMLElement>) => void {
+   return useCallback((e: ReactKeyboardEvent<HTMLElement>) => {
+     const itemsOf = (): HTMLElement[] =>
+       Array.from(ref.current?.querySelectorAll<HTMLElement>(".menu-item:not(:disabled)") ?? []);
+     if (!open) {
+       if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
+       e.preventDefault();
+       setOpen(true);
+       const up = e.key === "ArrowUp";
+       requestAnimationFrame(() => {
+         const items = itemsOf();
+         (up ? items[items.length - 1] : items[0])?.focus();
+       });
+       return;
+     }
+     const items = itemsOf();
+     if (items.length === 0) return;
+     const current = items.indexOf(document.activeElement as HTMLElement);
+     const next = menuNavIndex(e.key, current, items.length);
+     if (next === null) return;
+     e.preventDefault();
+     items[next]?.focus();
+   }, [open, setOpen, ref]);
+ }
+
+ // 模型服务未配置横幅（2026-10-18 对照 Claude 桌面端的黄色告警条）：空屏顶层一条可操作的提示，
+ // 而不是等用户写完任务、按下发送才在错误行里说「没有 key」。只在 providerOk === false 时出现；
+ // 未知（还在读）不出——不拿「不知道」冒充「坏了」。
+ import { AlertTriangle } from "lucide-react";
+
+ export function ProviderBanner(props: { onOpenSettings: () => void }): React.JSX.Element {
+   return (
+     <div className="home-banner" role="status">
+       <AlertTriangle size={15} className="home-banner-ico" aria-hidden="true" />
+       <div className="home-banner-text">
+         <strong>模型服务还没配好</strong>
+         <span>没找到可用的 API Key，现在发送会失败。去设置里选一家服务，或填一把 key。</span>
+       </div>
+       <button className="mini-btn" onClick={props.onOpenSettings}>去设置</button>
+     </div>
+   );
+ }
+
+ // P2-1 空屏建议行（小块组件；独立成件是为了 SSR 判卷——建议行在场、文案出处、副标题条件）。
+ // 纪律：点击 = 把建议文本交给调用方（App 走 injectedText 填入输入框，**不自动发送**——C-24 语义）。
+ // 文本一律来自 STR / quick-starts 纯函数，本文件零裸中文。
+ // 2026-10-20（frontend-design 重构）：三枚胶囊换成编号起手行——更像工作台索引，不抢 composer；
+ // 进入时逐行错峰上浮，hover 才露出右上箭头（低噪音）。
+ import { ArrowUpRight } from "lucide-react";
+
+ export function QuickStarts(props: {
+   /** 建议文本（buildQuickStarts 装配，3–4 条；空数组 = 数据未就绪，行不渲染内容）。 */
+   items: readonly string[];
+   /** 首启副标题（onboarded !== true 才由 App 传入；null = 不显示）。 */
+   firstRunSub: string | null;
+   /** 点击一条建议：填入输入框不发送（由 App 注入 injectedText）。 */
+   onPick: (text: string) => void;
+ }): React.JSX.Element {
+   return (
+     <div className="empty-below">
+       <div className="starts">
+         {props.items.map((q, i) => (
+           <button
+             key={q}
+             className="start"
+             style={{ animationDelay: `${90 + i * 45}ms` }}
+             onClick={() => { props.onPick(q); }}
+           >
+             <span className="start-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
+             <span className="start-q">{q}</span>
+             <ArrowUpRight size={14} strokeWidth={1.8} className="start-go" aria-hidden="true" />
+           </button>
+         ))}
+       </div>
+       {props.firstRunSub !== null && <div className="empty-sub">{props.firstRunSub}</div>}
+     </div>
+   );
+ }
+
+ // v2.17 运行中可沟通：排队条（挂在 ComposerCard 上沿）。
+ // 只做展示与转发——队列状态在 App（按会话），语义在 send-queue.ts；本组件零逻辑。
+ import type { QueuedSend } from "../send-queue";
+ import { Clock, X } from "lucide-react";
+
+ export function SendQueueStrip(props: {
+   items: readonly QueuedSend[];
+   /** 运行中才有「打断并发送」（不运行时队列自行出队，没有可打断的对象）。 */
+   running: boolean;
+   onInterruptSend: (index: number) => void;
+   onRemove: (index: number) => void;
+   /** 重启恢复入口：不运行时显式继续发送队列头；缺省 = 不显示入口。 */
+   onResume?: () => void;
+ }) {
+   if (props.items.length === 0) return null;
+   return (
+     <div className="queue-strip" role="list" aria-label="待发送队列">
+       <span className="queue-head">
+         <Clock size={11} />
+         {props.running ? "排队中 · 本轮结束后自动发送" : "排队中 · 等待恢复发送"}
+         {!props.running && props.onResume !== undefined && (
+           <button className="btn-ghost queue-resume" aria-label="继续发送队列" onClick={props.onResume}>
+             继续发送
+           </button>
+         )}
+       </span>
+       {props.items.map((item, index) => (
+         <div className="queue-item" role="listitem" key={item.id}>
+           <span className="q-text" title={item.text}>{item.text}</span>
+           {item.attachments.length > 0 && (
+             <span
+               className="q-sub"
+               title={item.attachments.map((a) => a.path.split("/").filter(Boolean).pop() ?? a.path).join("\n")}
+             >{String(item.attachments.length)} 引用</span>
+           )}
+           {props.running && (
+             <button className="btn-ghost" onClick={() => { props.onInterruptSend(index); }}>打断并发送</button>
+           )}
+           <button
+             className="btn-ghost"
+             aria-label={`移出队列：${item.text}`}
+             onClick={() => { props.onRemove(index); }}
+           ><X size={10} /></button>
+         </div>
+       ))}
+     </div>
+   );
+ }
+
+ // 会话日志查看器（2026-10-21 批 132）：错误条 / 命令面板的「查看日志」落点。
+ // 只读尾部：主进程按会话归属解析路径后读最近 400 行（≤256 KiB），渲染层不传路径。
+ import { useCallback, useEffect, useRef, useState } from "react";
+ import { AlertTriangle, Copy, Loader2, RefreshCw, X } from "lucide-react";
+ import type { SessionLogPayload } from "../../../../../src/main/ipc-protocol";
+ import { STR } from "../strings";
+ import { toast } from "../toast";
+ import { ModalSurface } from "./ModalSurface";
+
+ export type SessionLogState =
+   | { status: "loading" }
+   | { status: "error"; error: string }
+   | { status: "ready"; data: Extract<SessionLogPayload, { ok: true }> };
+
+ function formatBytes(n: number): string {
+   if (n < 1024) return `${n} B`;
+   if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
+   return `${(n / 1024 / 1024).toFixed(1)} MB`;
+ }
+
+ function copyText(text: string, okMessage: string): void {
+   if (typeof navigator === "undefined" || navigator.clipboard === undefined) {
+     toast.error(STR.logViewer.copyFailed);
+     return;
+   }
+   void navigator.clipboard.writeText(text).then(
+     () => { toast.success(okMessage); },
+     () => { toast.error(STR.logViewer.copyFailed); },
+   );
+ }
+
+ /** 内容面（判卷可单独渲染三态，不必真开 IPC）。 */
+ export function SessionLogBody(props: {
+   state: SessionLogState;
+   onRetry: () => void;
+   onCopyPath: (path: string) => void;
+ }): React.JSX.Element {
+   if (props.state.status === "loading") {
+     return (
+       <p className="session-log-empty" role="status">
+         <Loader2 size={13} className="s-spin" aria-hidden="true" /> {STR.logViewer.loading}
+       </p>
+     );
+   }
+   if (props.state.status === "error") {
+     return (
+       <div className="session-log-fail" role="alert">
+         <p className="session-log-empty"><AlertTriangle size={13} aria-hidden="true" /> {STR.logViewer.failed}：{props.state.error}</p>
+         <button className="mini-btn" title={STR.common.retry} onClick={props.onRetry}>{STR.common.retry}</button>
+       </div>
+     );
+   }
+   const data = props.state.data;
+   return (
+     <>
+       <div className="session-log-meta">
+         <code className="session-log-path" title={data.path} aria-label={STR.logViewer.pathAria}>{data.path}</code>
+         <button className="mini-btn" title={STR.logViewer.copyPath} onClick={() => { props.onCopyPath(data.path); }}>{STR.logViewer.copyPath}</button>
+       </div>
+       {data.lines === 0
+         ? <p className="session-log-empty">{STR.logViewer.empty}</p>
+         : <pre className="session-log-pre" tabIndex={0} aria-label={STR.logViewer.logAria}>{data.text}</pre>}
+       <div className="session-log-note">
+         {data.truncated ? (data.lines === 1 && data.text.length > 100_000 ? STR.logViewer.singleLine : STR.logViewer.truncated) : null}
+         <span className="num">{data.lines} {STR.logViewer.lines} · {STR.logViewer.size} {formatBytes(data.bytes)}</span>
+       </div>
+     </>
+   );
+ }
+
+ export function SessionLogDialog(props: { id: string; title: string; onClose: () => void }): React.JSX.Element {
+   const [state, setState] = useState<SessionLogState>({ status: "loading" });
+   const seqRef = useRef(0);
+
+   const load = useCallback(() => {
+     const seq = ++seqRef.current;
+     setState((prev) => (prev.status === "ready" ? prev : { status: "loading" }));
+     void Promise.resolve()
+       .then(() => window.agent.sessionLog(props.id, 400))
+       .then(
+         (r) => {
+           if (seq !== seqRef.current) return;
+           setState(r.ok ? { status: "ready", data: r } : { status: "error", error: r.error });
+         },
+         (e: unknown) => {
+           if (seq !== seqRef.current) return;
+           setState({ status: "error", error: e instanceof Error ? e.message : String(e) });
+         },
+       );
+   }, [props.id]);
+
+   useEffect(() => { load(); }, [load]);
+
+   return (
+     <div className="modal-backdrop" role="presentation" onClick={props.onClose}>
+       <ModalSurface
+         className="modal-card modal-wide session-log-modal"
+         label={`${STR.logViewer.title} · ${props.title}`}
+         onClose={props.onClose}
+         onClick={(e) => { e.stopPropagation(); }}
+       >
+         <div className="modal-head">
+           <span>{STR.logViewer.title} <span className="session-log-target">{props.title}</span></span>
+           <button className="iconbtn sm" aria-label={STR.logViewer.close} title={STR.logViewer.close} onClick={props.onClose}>
+             <X size={13} />
+           </button>
+         </div>
+         <SessionLogBody
+           state={state}
+           onRetry={load}
+           onCopyPath={(path) => { copyText(path, STR.logViewer.copiedPath); }}
+         />
+         <div className="modal-foot">
+           <button className="mini-btn" title={STR.logViewer.refresh} onClick={load} disabled={state.status === "loading"}>
+             <RefreshCw size={12} aria-hidden="true" /> {STR.logViewer.refresh}
+           </button>
+           <button className="mini-btn" title={STR.logViewer.copyLog} onClick={() => {
+             if (state.status === "ready") copyText(state.data.text, STR.logViewer.copiedLog);
+           }} disabled={state.status !== "ready"}>
+             <Copy size={12} aria-hidden="true" /> {STR.logViewer.copyLog}
+           </button>
+           <button className="mini-btn primary" title={STR.logViewer.close} onClick={props.onClose}>{STR.logViewer.close}</button>
+         </div>
+       </ModalSurface>
+     </div>
+   );
+ }
+
+ import { Command } from "cmdk";
+ import { MessageSquare } from "lucide-react";
+ import type { SessionSearchResult } from "../../../../../src/main/ipc-protocol";
+
+ export type SessionSearchState =
+   | { status: "idle" | "loading" }
+   | { status: "ready"; result: SessionSearchResult }
+   | { status: "error"; error: string };
+
+ export function SessionSearchResults(props: {
+   state: SessionSearchState;
+   workspace: string;
+   onOpenSession: (id: string, workspace?: string) => void;
+   onRetry: () => void;
+ }): React.JSX.Element | null {
+   const { state, workspace } = props;
+   if (state.status === "idle") return null;
+   if (state.status === "loading") return <div className="cp-empty" role="status">正在搜索当前项目的对话正文…</div>;
+   let error: string | null = null;
+   if (state.status === "error") error = state.error;
+   else if (state.status === "ready" && state.result.kind === "unavailable") {
+     error = ["当前项目的对话正文暂时无法搜索", state.result.detail].filter(Boolean).join("：");
+   }
+   if (error !== null) return (
+     <div className="cp-empty" role="status">
+       <span>{error}</span>{" "}
+       <button type="button" className="mini-btn" onClick={props.onRetry}>重试搜索</button>
+     </div>
+   );
+   if (state.status !== "ready" || state.result.kind === "unavailable") return null;
+   const result = state.result;
+   return (
+     <Command.Group forceMount heading="当前项目正文" className="cp-group cp-body-search">
+       {result.kind === "partial" && <div className="cp-empty" role="status">搜索尚未完成，可能还有结果</div>}
+       {result.kind === "ok" && result.matches.length === 0 && <div className="cp-empty" role="status">正文中没有匹配</div>}
+       {result.matches.map((match) => (
+         <Command.Item
+           key={match.sessionId}
+           forceMount
+           className="cp-item"
+           data-session-search-result={match.sessionId}
+           value={`正文 ${workspace} ${match.sessionId}`}
+           onSelect={() => props.onOpenSession(match.sessionId, workspace)}
+         >
+           <span className="cp-ico" aria-hidden="true"><MessageSquare size={14} /></span>
+           <span className="cp-stack">
+             <span className="cp-label">{match.title ?? match.sessionId}</span>
+             <span className="cp-sub" title={match.snippets[0]?.excerpt}>{match.snippets[0]?.excerpt}</span>
+           </span>
+           <span className="cp-at num">{match.matchCount}{match.complete && match.badLines === 0 ? "" : "+"} 条</span>
+         </Command.Item>
+       ))}
+     </Command.Group>
+   );
+ }
+
+ // 设置页（批 6 换壳 · 总纲阶段 2-3 + 改动清单阶段 6）：
+ //   壳只留三件事：左导航（settings-nav 是唯一事实源，渲染锚不动）+ 状态管理（settings/status/cap/回执）+
+ //   工作台四分区接线（AppPageBody；导航元数据已抽到轻量 settings-nav，避免命令面板拉入整页）。
+ //   正文四段全在 settings-sections.tsx（通用 / 模型与 Provider / 权限与安全 / 关于与更新），
+ //   公共件走 settings-ui（SettingsPage/SettingsSection/SettingsRow）。
+ //   「修改即保存」静态行 → 右下「已保存 ✓」短暂指示（清单阶段 6）；
+ //   字段级保存（无全局保存键，SettingsStore patch 语义）；校验失败行内红字，不静默。
+ // 纯函数资产（panelPatch / providerStatusLabel / …）随迁 settings-sections，
+ // 本文件重导出保旧 import 面（settings-panel.test 判卷锚不动）。
+ import { Fragment, useEffect, useMemo, useRef, useState } from "react";
+ import { ChevronLeft, Search, X } from "lucide-react";
+ import type { AgentApi, AppSettings, CapabilityReadout, ProviderInfo } from "../../../../../src/main/ipc-protocol";
+ import type { TextSizeSetting, UiSizeSetting } from "../../../../../src/main/settings";
+ import { SettingsPage, SettingsRow, SettingsSection } from "./settings-ui";
+ import {
+   AboutSection,
+   AdvancedSection,
+   GeneralSection,
+   PermissionsSection,
+   ProviderSection,
+   SEARCH_CONFIG_HINT,
+   ShortcutsSection,
+   defaultKeyProvider,
+   panelPatch,
+ } from "./settings-sections";
+ import { AppPageBody, type PageId } from "./AppPage";
+ import { ModalSurface } from "./ModalSurface";
+ import { PAGE_ORDER, SECTIONS, filterSections, type SectionId } from "./settings-nav";
+
+ export { SECTIONS, type SectionId };
+
+ // 纯函数资产重导出（原在壳内定义；判卷 import 面不动）。
+ export {
+   PANEL_PATCH_KEYS,
+   panelPatch,
+   PANEL_PROVIDER_KINDS,
+   providerNeedsKey,
+   defaultKeyProvider,
+   providerStatusLabel,
+   searchCapabilityLabel,
+   SEARCH_CONFIG_HINT,
+ } from "./settings-sections";
+
+ const PAGE_SECTION_IDS = new Set<string>(PAGE_ORDER);
+
+ /* ── 更新区（P1 修复 · 2026-10-22）：「发现新版本」不能是一句死胡同 ────────────────
+    实测缺陷：旧实现只把检查结果的 version 拼成「发现新版本 X」⇒ manifest 里的下载页
+    URL 与更新说明被静默丢掉；渲染层对 openExternal 零调用点 ⇒ 用户看到"有新版"却无处可去。
+    现在：available 态带出版本 + 更新说明 + 一个可点动作，动作**只**走主进程通道
+    agent.openExternal（http(s) 白名单在主进程，manifest 注入协议进不来）。 */
+
+ /** 主进程检查结果（从 AgentApi 派生——渲染层不直接引 updater 模块）。 */
+ type UpdateCheckResult = Awaited<ReturnType<AgentApi["checkUpdate"]>>;
+
+ /** 更新区读数。available 变体必须带 url/notes：丢掉它们＝把"有新版"变成死胡同。 */
+ export type UpdateState =
+   | { kind: "idle" }
+   | { kind: "checking" }
+   | { kind: "unconfigured" }
+   | { kind: "error"; message: string }
+   | { kind: "up-to-date" }
+   | { kind: "available"; version: string; url: string; notes?: string; openError: string | null };
+
+ /** 检查结果 → 读数（url/notes 原样带出，不在这一步丢）。 */
+ export function updateStateOf(r: UpdateCheckResult): UpdateState {
+   if (r.state === "available") return { kind: "available", version: r.version, url: r.url, notes: r.notes, openError: null };
+   if (r.state === "error") return { kind: "error", message: r.message };
+   if (r.state === "unconfigured") return { kind: "unconfigured" };
+   return { kind: "up-to-date" };
+ }
+
+ /** 「检查更新」→ 读数（网络失败也是显式态，绝不静默）。 */
+ export async function checkUpdateState(): Promise<UpdateState> {
+   try {
+     return updateStateOf(await window.agent.checkUpdate());
+   } catch (err) {
+     return { kind: "error", message: err instanceof Error ? err.message : String(err) };
+   }
+ }
+
+ /** 主进程拒绝打开时把原因并进读数（错误面要看得见，不能吞）。 */
+ export function withOpenError(state: UpdateState, message: string): UpdateState {
+   return state.kind === "available" ? { ...state, openError: message } : state;
+ }
+
+ /** 打开下载页：只走主进程通道 agent.openExternal（http(s) 白名单在主进程）。
+  *  外链不经渲染层——渲染层不自己开浏览器、也不改地址栏。 */
+ export async function openUpdateUrl(url: string, onError: (message: string) => void): Promise<void> {
+   let message: string | null = null;
+   try {
+     const r = await window.agent.openExternal(url);
+     if (!r.ok) message = r.error ?? "打开下载页失败";
+   } catch (err) {
+     message = `打开下载页失败：${err instanceof Error ? err.message : String(err)}`;
+   }
+   if (message !== null) onError(message);
+ }
+
+ /** 「发现新版本」卡：版本 + 更新说明 + 一个可点动作（打开下载页）。 */
+ export function UpdateOffer(props: {
+   version: string;
+   url: string;
+   notes?: string;
+   /** 主进程拒绝时的错误文案；null = 无。 */
+   error: string | null;
+   /** 打开失败回调（面板接自己的读数）。 */
+   onError: (message: string) => void;
+ }): React.JSX.Element {
+   return (
+     <SettingsSection title="新版本">
+       <SettingsRow label={`发现新版本 ${props.version}`} desc={props.notes}>
+         <button type="button" className="mini-btn" title={props.url} onClick={() => openUpdateUrl(props.url, props.onError)}>
+           打开下载页
+         </button>
+       </SettingsRow>
+       {props.error !== null && <div className="sp-note err" role="alert">{props.error}</div>}
+     </SettingsSection>
+   );
+ }
+
+ export function SettingsPanel(props: {
+   onClose: () => void;
+   initialSection?: SectionId;
+   onSettingsSaved?: () => void;
+ }): React.JSX.Element {
+   const [section, setSection] = useState<SectionId>(props.initialSection ?? "general");
+   const [settings, setS] = useState<AppSettings | null>(null);
+   const [status, setStatus] = useState<{ available: boolean; stored: string[]; envActive: boolean }>({ available: true, stored: [], envActive: false });
+   const [about, setAbout] = useState<{ version: string } | null>(null);
+   // 能力在场性读数（搜索端点配没配）。null = 还没问到 / 问失败——那一格显示「读不到」，
+   // 不显示「已配」：把读不到当成配好，正是这个面板要修的那类假象。
+   const [cap, setCap] = useState<CapabilityReadout | null>(null);
+   const [update, setUpdate] = useState<UpdateState>({ kind: "idle" });
+   const [keyProvider, setKeyProvider] = useState(defaultKeyProvider);
+   // 「检查连接」的三态回执：保存成功 ≠ 服务可用，两件事分开显示（主进程只 GET 模型清单，不耗额度）。
+   const [checkMsg, setCheckMsg] = useState<{ tone: "wait" | "ok" | "err"; text: string; hint?: string } | null>(null);
+   // 右下保存状态指示（替换原「修改即保存」静态行）：短暂显示后淡出，不占版式。
+   const [flash, setFlash] = useState<string | null>(null);
+   const flashTimer = useRef<number | null>(null);
+   const [error, setError] = useState<string | null>(null);
+   const [busy, setBusy] = useState(false);
+   // key 明文零进 React state：输入框非受控，用 ref 取值（与旧实现同一条纪律）。
+   const keyInput = useRef<HTMLInputElement | null>(null);
+   // 字号档（2026-10-18）：与 App 的 live state 同源，但设置页自己持一份初值，
+   // 保存后立刻回灌（不等 App 的 getSettings 回流）——点下去就要看见变化。
+   const [textSize, setTextSize] = useState<TextSizeSetting>("md");
+   const [uiSize, setUiSize] = useState<UiSizeSetting>("2");
+   // 分区搜索（2026-10-18）：收窄左栏九个分区；Esc 两级（有字先清空，空着才失焦）。
+   const [navQuery, setNavQuery] = useState("");
+   const navSearchRef = useRef<HTMLInputElement | null>(null);
+   const visibleSections = useMemo(() => filterSections(navQuery), [navQuery]);
+
+   const pulse = (msg: string) => {
+     setFlash(msg);
+     if (flashTimer.current !== null) window.clearTimeout(flashTimer.current);
+     flashTimer.current = window.setTimeout(() => setFlash(null), 2200);
+   };
+
+   useEffect(() => () => {
+     if (flashTimer.current !== null) window.clearTimeout(flashTimer.current);
+   }, []);
+
+   const refresh = () => {
+     void window.agent.getSettings().then((s) => { setS(s); setTextSize(s.textSize); setUiSize(s.uiSize); }).catch((err: unknown) => {
+       setError(err instanceof Error ? err.message : String(err));
+     });
+     void window.agent.providerKeyStatus().then((s) => setStatus({ available: s.available, stored: s.stored, envActive: s.envActive })).catch(() => undefined);
+   };
+
+   useEffect(() => {
+     refresh();
+     void window.agent.getState().then((s) => setAbout(s.about ?? null)).catch(() => setAbout(null));
+     void window.agent.capabilities().then(setCap).catch(() => setCap(null));
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+   }, []);
+
+   const save = async (patch: Record<string, unknown>) => {
+     setError(null);
+     try {
+       const next = await window.agent.setSettings(panelPatch(patch));
+       setS(next);
+       pulse("已保存 ✓");
+       props.onSettingsSaved?.();
+     } catch (err) {
+       setError(`保存失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   };
+
+   /** Ctrl+Tab 会话循环（§3.6/§7.3.3）：不走 panelPatch（那份白名单与其判卷口径保持原样），单键直调同一条通道。 */
+   const saveCtrlTab = (next: boolean) => {
+     setError(null);
+     void window.agent.setSettings({ ctrlTabCycle: next }).then((updated) => {
+       setS(updated);
+       pulse("已保存 ✓");
+       props.onSettingsSaved?.();
+     }, (err: unknown) => {
+       setError(`保存失败：${err instanceof Error ? err.message : String(err)}`);
+     });
+   };
+
+   /** 单键直写（2026-10-18 高级段用）：与 saveCtrlTab 同一条路——不进 panelPatch 白名单。
+    *  为什么不开白名单：那份白名单被判卷钉成六键，且它存在的理由（locale 曾被静默丢成 {}）
+    *  仍然成立；把新键塞进去等于改判据来迁就实现。单键直调是仓里已有的正解。
+    *  校验在调用方（AdvancedSection 的 parseBudgetField）——后端对非法值静默回退默认，
+    *  界面必须先拦住并说清，否则「已保存」与实际存的值不符。 */
+   const saveSettingKey = async (key: string, value: boolean | number | string): Promise<void> => {
+     setError(null);
