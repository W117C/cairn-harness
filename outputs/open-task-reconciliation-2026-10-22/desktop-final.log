+   return (
+     <>
+       {/* 回滚轮次 / 移除项目的确认卡（2026-10-17：原生 confirm → 产品自绘）。 */}
+       {revertConfirm !== null && (
+         <ConfirmDialog
+           title={`还原第 ${String(revertConfirm)} 轮的改动？`}
+           note={"本轮新建的文件会删除；本轮之后又被改过的文件不会动，会列进「需手动处理」。"}
