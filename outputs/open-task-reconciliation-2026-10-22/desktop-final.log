+                 <span className="cp-ico" aria-hidden="true"><MessageSquare size={14} /></span>
+                 <span className="cp-label">{s.title ?? s.id}</span>
+                 <span className="cp-at num">{relativeTime(now, sessionTime(s))}</span>
