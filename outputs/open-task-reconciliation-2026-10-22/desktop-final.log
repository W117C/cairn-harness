+       { keys: "Ctrl+Tab / Ctrl+⇧+Tab", what: "下一个 / 上一个会话（可在设置里关）" },
+       { keys: "⌘⇧] / ⌘⇧[", what: "下一个 / 上一个会话" },
+       { keys: "⌘B", what: "开关侧栏" },
+       { keys: "⌘⌥B", what: "开合插件侧栏（右侧：插件/技能/命令）" },
+       { keys: "⌘⌥I", what: "开合检查器（右侧：改动 / 计划 / 时间线）" },
+       { keys: "⌘⌥M", what: "开合插件侧栏（覆盖式首版）" },
