+                     : <><FileCode2 size={11} /> 看源码</>}
+               </button>
+               <code className="artifact-path" title={r.artifact.path}>{r.artifact.path}</code>
+             </div>
+           </div>
+         )}
+         </div>
+       )}
+     </div>
+   );
+ });
