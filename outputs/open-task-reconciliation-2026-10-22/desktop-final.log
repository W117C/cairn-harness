+ // 派生层·用量面（纯投影）：事件流 → 用量读数。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { usageTotals } from "../../../../../src/main/usage-ledger";
