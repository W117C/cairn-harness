+ /** 摘录只关心的行型（收窄用）：用户行 + 已成终稿的助手行。 */
+ type SuggestRow = Extract<StreamRow, { kind: "user" } | { kind: "assistant" }>;
+
+ /** 拼「用户：…／助手：…」摘录；没有可用的行 ⇒ null（调用方给「先聊两句」提示，不硬编）。 */
+ export function buildSuggestContext(rows: readonly StreamRow[]): string | null {
+   const picked = rows
+     .filter((r): r is SuggestRow => r.kind === "user" || (r.kind === "assistant" && r.live !== true))
+     .filter((r) => r.text.trim() !== "")
+     .slice(-SUGGEST_CONTEXT_MESSAGES);
+   if (picked.length === 0) return null;
+   const lines = picked.map((r) => {
+     const t = r.text.trim();
+     const cut = t.length > SUGGEST_CONTEXT_PER_MESSAGE ? `${t.slice(0, SUGGEST_CONTEXT_PER_MESSAGE)}…` : t;
+     return `${r.kind === "user" ? "用户：" : "助手："}${cut}`;
+   });
+   while (lines.length > 1 && lines.join("\n").length > SUGGEST_CONTEXT_TOTAL) lines.shift();
+   return lines.join("\n");
+ }
+
+ /* 主题应用（设计规范 §4.6，Claude 蓝本）：
+    settings.theme（system / light / dark）→ 文档 data-theme 属性（data 属性切换，
+    非两套 class）。system 模式跟随系统并监听变化（matchMedia）。
+    结构与 DOM 壳分离——决策是纯函数（判卷面），壳是可注入环境
+    （产品取浏览器 document/matchMedia；判卷注入 stub，本仓无 jsdom）。 */
+
+ export type ThemePref = "system" | "light" | "dark";
+ export type ActualTheme = "light" | "dark";
+
+ /** 偏好 + 系统暗色事实 → 实际主题（纯函数，唯一决策点）。 */
+ export function actualThemeOf(pref: ThemePref, systemDark: boolean): ActualTheme {
+   if (pref === "system") return systemDark ? "dark" : "light";
+   return pref;
+ }
+
+ /** 壳环境：写属性 / 读系统值 / 订阅系统变化（返回解除函数）。 */
+ export interface ThemeEnv {
+   setDataTheme(value: ActualTheme): void;
+   systemDark(): boolean;
+   watchSystemDark(onChange: () => void): () => void;
+ }
+
+ /** 产品环境：document + matchMedia。 */
+ export function browserThemeEnv(): ThemeEnv {
+   const mq = window.matchMedia("(prefers-color-scheme: dark)");
+   return {
+     setDataTheme: (v) => {
+       document.documentElement.setAttribute("data-theme", v);
+       document.body.toggleAttribute("data-ds-dark-theme", v === "dark");
+     },
+     systemDark: () => mq.matches,
+     watchSystemDark: (onChange) => {
+       mq.addEventListener("change", onChange);
+       return () => { mq.removeEventListener("change", onChange); };
+     },
+   };
+ }
+
+ /** 应用主题偏好；返回清理函数（切偏好/卸载时调用，解除系统监听）。
+    非 system 偏好不订阅（固定主题下系统翻转与我们无关）。 */
+ export function applyTheme(pref: ThemePref, env: ThemeEnv): () => void {
+   const apply = (): void => { env.setDataTheme(actualThemeOf(pref, env.systemDark())); };
+   apply();
+   if (pref !== "system") return () => undefined;
+   return env.watchSystemDark(apply);
+ }
+
+ type SonnerModule = typeof import("sonner");
+ type ToastKind = "default" | "success" | "error";
+
+ let modulePromise: Promise<SonnerModule> | null = null;
+ let loadedModule: SonnerModule | null = null;
+ let requested = false;
+ const listeners = new Set<(module: SonnerModule) => void>();
+
+ function loadSonner(): Promise<SonnerModule> {
+   if (loadedModule !== null) return Promise.resolve(loadedModule);
+   modulePromise ??= import("sonner").then(
+     (module) => {
+       loadedModule = module;
+       for (const listener of listeners) listener(module);
+       return module;
+     },
+     (err: unknown) => {
+       // 瞬时读取失败不能让本轮进程永久失去提示能力；下一次请求重新试。
+       modulePromise = null;
+       throw err;
+     },
+   );
+   return modulePromise;
+ }
+
+ function show(kind: ToastKind, message: string): void {
+   requested = true;
+   void loadSonner().then(
+     (mod) => {
+       if (kind === "default") mod.toast(message);
+       else mod.toast[kind](message);
+     },
+     (err: unknown) => { console.error("[toast] 提示组件加载失败:", err instanceof Error ? err.message : String(err)); },
+   );
+ }
+
+ /** 轻量提示入口：首次调用时才加载 sonner；调用点不依赖返回 id。 */
+ export const toast = Object.assign(
+   (message: string): void => { show("default", message); },
+   {
+     success: (message: string): void => show("success", message),
+     error: (message: string): void => show("error", message),
+   },
+ );
+
+ /** ToastHost 订阅首次请求；早于订阅发生的请求也会在订阅时立即补触发。 */
+ export function subscribeToastHost(listener: (module: SonnerModule) => void): () => void {
+   listeners.add(listener);
+   if (requested) {
+     if (loadedModule !== null) listener(loadedModule);
+     else void loadSonner().catch(() => undefined);
+   }
+   return () => { listeners.delete(listener); };
+ }
+
+ // 对话导出（2026-10-18，命令面板「复制整段对话」）：把当前会话的用户/助手正文按序拼成
+ // Markdown。只收这两类——工具调用参数、思考正文、元信息不进导出（它们是过程，不是对话；
+ // 需要证据时看交付卡/检查器）。纯函数，无 DOM/IPC，判卷直接钉。
+ import type { AgentEvent } from "../../../../src/main/ipc-protocol";
+ import { isWorkerSubflowEvent, userVisibleText } from "./projections";
+
+ type CopyAttachment = { readonly path: string; readonly kind: "file" | "directory" };
+
+ /** 用户消息的复制文本（2026-10-18）：正文 + 附件清单。整段转录与行级「复制这条消息」
+  *  共用这一份格式——此前行级复制只抄正文，粘出去就不知道这条消息带过哪些文件。 */
+ export function userMessageCopy(text: string, attachments?: readonly CopyAttachment[]): string {
+   const body = text.trim();
+   const files = (attachments ?? []).map((a) => `- ${a.kind === "directory" ? "目录" : "文件"}：\`${a.path}\``);
+   return [body, files.length > 0 ? `附件：\n${files.join("\n")}` : ""].filter((p) => p !== "").join("\n\n");
+ }
+
+ /** 空标题回落到「未命名会话」（导出面不摆空 `#`）。
+  *
+  *  为什么必须收 `assistant_delta`：真实 provider（openai.ts / anthropic.ts）**一轮只发 delta**，
+  *  `assistant_message` 终稿是 mock/demo 通道才有的东西（projections.ts 的 projectStream 早就按
+  *  这个口径分桶）。只认终稿的旧实现在每一个真会话上都会导出一份**只有用户消息**的对话——
+  *  助手的回答整段消失。判据因此走 delta 分桶：同 callId 的 delta 按序拼成一段，
+  *  落定点与 projectStream 同口径（轮界 = 下一条 user_message，停转 = 事件流结束）。
+  *
+  *  思考正文**不进导出**（thinking_delta 是模型自言自语，与导出面"只收对话正文"的既定口径一致）。 */
+ export function transcriptMarkdown(events: readonly AgentEvent[], title: string): string {
+   const head = title.trim() === "" ? "未命名会话" : title.trim();
+   const parts: string[] = [`# ${head}`];
+   // 未结的 delta 桶：callId → 累计正文。落定时才决定要不要成段（空文本 = 只想过没说，不出段）。
+   let pending = new Map<string, string>();
+   const flush = (): void => {
+     for (const text of pending.values()) {
+       const body = text.trim();
+       if (body !== "") parts.push(`## Cairn\n\n${body}`);
+     }
+     pending = new Map();
+   };
+   for (const e of events) {
+     if (isWorkerSubflowEvent(e)) continue;
+     switch (e.type) {
+       case "user_message":
+         flush(); // 轮界：上一轮没被终稿收走的桶在此落定
+         {
+           const block = userMessageCopy(userVisibleText(e), e.attachments);
+           if (block !== "") parts.push(`## 你\n\n${block}`);
+         }
+         break;
+       case "assistant_message":
+         // 终稿到达即取代所有未结桶（它无 callId，无法按桶匹配——与 projectStream 同口径）。
+         pending = new Map();
+         {
+           const body = e.content.trim();
+           if (body !== "") parts.push(`## Cairn\n\n${body}`);
+         }
+         break;
+       case "assistant_delta":
+         pending.set(e.callId, (pending.get(e.callId) ?? "") + e.text);
+         break;
+       default:
+         break; // 工具/思考/元信息：过程，不是对话
+     }
+   }
+   flush(); // 停转：最后一段没被终稿收走的桶在此落定
+   // 每段之间空一行；末尾补一个换行（粘贴进 Markdown 编辑器不会与下一段粘连）。
+   return parts.join("\n\n") + "\n";
+ }
+
+ /** 文件名清洗（导出用）：去掉路径分隔符与 macOS/Windows 非法字符，压掉连续空白，截断 80 字符。
+  *  空标题 → 会话。扩展名由调用方/主进程负责（这里只给 stem）。 */
+ export function transcriptFileName(title: string): string {
+   const cleaned = title
+     .replace(/[\\/:*?"<>|\u0000-\u001f]/g, " ")
+     .replace(/\s+/g, " ")
+     .trim()
+     .slice(0, 80)
+     .trim();
+   return `${cleaned === "" ? "会话" : cleaned}.md`;
+ }
+
+ import type { UsageLedgerPayload } from "../../../../src/main/ipc-protocol";
+ export type UsageAllState =
+   | { status: "idle" }
+   | { status: "loading" }
+   | { status: "ready"; data: Extract<UsageLedgerPayload, { ok: true }> }
+   | { status: "error"; error: string };
+
+ import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+
+ type MarkState<Value> = {
+   sessionId: string | null;
+   values: ReadonlyMap<number, Value>;
+   pending: ReadonlySet<number>;
+   loading: boolean;
+ };
+ type MarkSource<Value> = {
+   label: string;
+   load: (sessionId: string) => Promise<ReadonlyMap<number, Value>>;
+   save: (sessionId: string, eventId: number, value: Value | undefined) => Promise<{ ok: boolean; error?: string }>;
+ };
+ type ReportError = (message: string, sessionId?: string) => void;
+
+ /** 两类消息标记共用归属、读写与逐条回滚；同一条标记有请求时禁止重复提交。 */
+ function useSessionMarks<Value>(sessionId: string | null, source: MarkSource<Value>, onError: ReportError) {
+   const [state, setState] = useState<MarkState<Value>>({ sessionId: null, values: new Map(), pending: new Set(), loading: true });
+   const generation = useRef(0);
+   const locks = useRef(new Set<number>());
+   useEffect(() => {
+     const version = ++generation.current;
+     locks.current.clear();
+     setState({ sessionId, values: new Map(), pending: new Set(), loading: sessionId !== null });
+     if (sessionId !== null) {
+       void source.load(sessionId).then((values) => {
+         if (generation.current === version) setState({ sessionId, values, pending: new Set(), loading: false });
+       }).catch((error: unknown) => {
+         if (generation.current !== version) return;
+         setState({ sessionId, values: new Map(), pending: new Set(), loading: false });
+         onError(`${source.label}读取失败：${error instanceof Error ? error.message : String(error)}。请刷新后重试。`, sessionId);
+       });
+     }
+     return () => { generation.current += 1; };
+   }, [sessionId, source, onError]);
+
+   const set = useCallback(async (eventId: number, value: Value | undefined): Promise<void> => {
+     if (sessionId === null || state.sessionId !== sessionId || state.loading || locks.current.has(eventId)) return;
+     locks.current.add(eventId); // 同帧连点也只发一次，不依赖 React 下一帧的 disabled。
+     const version = generation.current;
+     const previous = state.values.get(eventId);
+     const update = (nextValue: Value | undefined, pending: boolean) => {
+       setState((current) => {
+         if (current.sessionId !== sessionId) return current;
+         const values = new Map(current.values);
+         if (nextValue === undefined) values.delete(eventId); else values.set(eventId, nextValue);
+         const nextPending = new Set(current.pending);
+         if (pending) nextPending.add(eventId); else nextPending.delete(eventId);
+         return { ...current, values, pending: nextPending };
+       });
+     };
+     update(value, true);
+     try {
+       const result = await source.save(sessionId, eventId, value);
+       if (!result.ok) throw new Error(result.error ?? "未知错误");
+       if (generation.current === version) update(value, false);
+     } catch (error: unknown) {
+       if (generation.current !== version) return;
+       update(previous, false);
+       onError(`${source.label}提交失败：${error instanceof Error ? error.message : String(error)}`, sessionId);
+     } finally {
+       if (generation.current === version) locks.current.delete(eventId);
+     }
+   }, [sessionId, state, source, onError]);
+   const current = state.sessionId === sessionId;
+   return useMemo(() => ({
+     values: current ? state.values : new Map<number, Value>(),
+     busy: (eventId: number) => !current || state.loading || state.pending.has(eventId),
+     pending: (eventId: number) => current && state.pending.has(eventId),
+     set,
+   }), [current, state, set]);
+ }
+
+ const feedbackSource: MarkSource<"up" | "down"> = {
+   label: "反馈",
+   load: async (sid) => new Map((await window.agent.listFeedback(sid)).map((item) => [item.eventId, item.rating])),
+   save: (sid, eventId, value) => window.agent.submitFeedback({ sessionId: sid, eventId, rating: value ?? "none" }),
+ };
+ const pinSource: MarkSource<true> = {
+   label: "置顶",
+   load: async (sid) => new Map((await window.agent.listMessagePins(sid)).map((id) => [id, true as const])),
+   save: (sid, eventId, value) => window.agent.setMessagePinned({ sessionId: sid, eventId, pinned: value === true }),
+ };
+
+ export function useMessageAnnotations(sessionId: string | null, onError: ReportError) {
+   const feedback = useSessionMarks(sessionId, feedbackSource, onError);
+   const pins = useSessionMarks(sessionId, pinSource, onError);
+   return useMemo(() => ({
+     feedback: feedback.values,
+     feedbackBusy: feedback.busy,
+     onFeedback: (eventId: number, rating: "up" | "down" | null) => { void feedback.set(eventId, rating ?? undefined); },
+     pinnedEventIds: new Set(pins.values.keys()),
+     pinBusy: pins.busy,
+     annotationPending: (eventId: number) => feedback.pending(eventId) || pins.pending(eventId),
+     onPin: (eventId: number, pinned: boolean) => { void pins.set(eventId, pinned ? true : undefined); },
+   }), [feedback, pins]);
+ }
+
+ // 「N 分钟前」的活时钟（2026-10-18）：页面停留时相对时间不再冻结。
+ // 共用一条 interval + 订阅集合——每个相对时间标签各自开一条 setInterval 会变成 N 条定时器；
+ // 这里 N 个订阅者只共享一条，最后一个订阅者卸载时清掉。
+ // 60s 一档足够：文案最细粒度就是分钟（<60s 才显示「刚刚」）。
+ import { useEffect, useState } from "react";
+
+ type Listener = (nowMs: number) => void;
+ const listeners = new Set<Listener>();
+ let timer: number | null = null;
+
+ function tick(): void {
+   const now = Date.now();
+   for (const l of listeners) l(now);
+ }
+
+ /** 订阅共享时钟；返回当前毫秒。组件真正用到它才会重渲染（60s 一次，成本可忽略）。 */
+ export function useNow(intervalMs = 60_000): number {
+   const [now, setNow] = useState(() => Date.now());
+   useEffect(() => {
+     const listener: Listener = (n) => setNow(n);
+     listeners.add(listener);
+     if (timer === null) {
+       timer = window.setInterval(tick, intervalMs);
+       // 回到前台立即对一次表：后台标签被系统节流时，回来不该还显示「刚刚」。
+       document.addEventListener("visibilitychange", onVisible);
+     }
+     return () => {
+       listeners.delete(listener);
+       if (listeners.size === 0 && timer !== null) {
+         window.clearInterval(timer);
+         timer = null;
+         document.removeEventListener("visibilitychange", onVisible);
+       }
+     };
+   }, [intervalMs]);
+   return now;
+ }
+
+ function onVisible(): void {
+   if (!document.hidden) tick();
+ }
+
+ import { useRef, useEffect, type RefObject } from "react";
+ export function usePopoverDismiss(open: boolean, close: () => void, ref: RefObject<HTMLElement | null>): void {
+   const returnTo = useRef<HTMLElement | null>(null);
+   useEffect(() => {
+     if (!open) return;
+     const active = document.activeElement;
+     returnTo.current = active instanceof HTMLElement ? active : null;
+     const onDoc = (e: MouseEvent): void => {
+       const target = e.target as Element | null;
+       if (target !== null && target.closest?.("[data-radix-popper-content-wrapper]") !== null) return;
+       if (ref.current !== null && !ref.current.contains(e.target as Node)) close();
+     };
+     const onKey = (e: KeyboardEvent): void => {
+       if (e.key === "Escape") close();
+     };
+     document.addEventListener("mousedown", onDoc);
+     document.addEventListener("keydown", onKey);
+     return () => {
+       document.removeEventListener("mousedown", onDoc);
+       document.removeEventListener("keydown", onKey);
+       const prev = returnTo.current;
+       const cur = document.activeElement;
+       const lost = cur === null || cur === document.body || (ref.current !== null && ref.current.contains(cur));
+       if (lost && prev !== null && prev.isConnected) prev.focus();
+     };
+   }, [open, close, ref]);
+ }
+
+ // 粘底滚动（spec ③）：流式输出时用户"贴着最新内容"是聊天产品的默认体感。
+ // 规则（审查修订 ③）：
+ //   · .stream 有 scroll-behavior:smooth —— 程序化滚动一律 behavior:"instant"，
+ //     否则高频 scrollTop 写入会排队成动画（掉帧＋"近底"判定抖动）；
+ //   · 只有滚动位置真的离开底部（用户上滚/跳轮）才解除粘底，浮钮出现；
+ //   · 用户点浮钮回底用 smooth（人手点的动作允许动画）。
+ // 2026-10-16（阶段 2 · 回底钮真机复检抓到的挂载竞态）：旧签名收 RefObject，空态启动时 .stream
+ //   未挂载 ⇒ effect 以 ref.current=null 跑完一次，依赖 [ref] 不变便永不再跑 ⇒ 滚动监听恒未接上、
+ //   回底钮永不出现（真机实证：scrollTop=120 后 DOM 里没有 .jump-latest）。修复 = 改收**元素本身**
+ //   （App 以 callback ref 把元素放进 state）：元素一出现 effect 即重跑，监听即接。
+ // 2026-10-16（P3-1 滚动记忆真机竞态）：新增 restoreTo(记忆位)——会话切回的实例落点：instant 落位
+ //   后按真实位置重判 pinned/stuck（不在底部即解除粘底），跟底观察器（RO）不再把回场视口拽回底部。
+ import { useCallback, useEffect, useRef, useState } from "react";
+
+ const NEAR_BOTTOM_PX = 48;
+
+ /** 视口是否贴底（纯函数，判卷锚）。 */
+ export function isNearBottom(m: { scrollTop: number; scrollHeight: number; clientHeight: number }): boolean {
+   return m.scrollHeight - m.scrollTop - m.clientHeight <= NEAR_BOTTOM_PX;
+ }
+
+ export interface StickyScroll {
+   /** true = 视口贴底（此时不显示浮钮）。 */
+   stuck: boolean;
+   /** true = 视口在顶部（滚离顶部后顶栏渐隐显形）。 */
+   atTop: boolean;
+   /** 回到底部；behavior 缺省 instant（人手点击请传 "smooth"）。 */
+   scrollToBottom: (behavior?: ScrollBehavior) => void;
+   /** 回到顶部（⌘↑）；脱离贴底（浮钮随之出现）。 */
+   scrollToTop: (behavior?: ScrollBehavior) => void;
+   /** 落到任意记忆位（会话切换回场用）：按落点真实位置重判贴底——不在底部即解除粘底，
+    *  跟底观察器（RO）不会再把视口拽回底部。 */
+   restoreTo: (top: number, behavior?: ScrollBehavior) => void;
+ }
+
+ /** 减少动态时把显式 smooth 降级为 auto（2026-10-18）：CSS 的 scroll-behavior 管不到
+  *  `scrollTo({behavior:"smooth"})` 这类 JS 显式请求——入场动效让路了，滚动也得让。
+  *  非浏览器/无 matchMedia（判卷 node 环境）→ 原样返回。 */
+ export function scrollBehavior(wanted: ScrollBehavior): ScrollBehavior {
+   if (wanted !== "smooth") return wanted;
+   try {
+     return window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
+   } catch {
+     return wanted;
+   }
+ }
+
+ export function useStickyScroll(el: HTMLDivElement | null): StickyScroll {
+   const [stuck, setStuck] = useState(true);
+   const [atTop, setAtTop] = useState(true);
+   const pinned = useRef(true);
+   const scrollToBottom = useCallback((behavior: ScrollBehavior = "instant") => {
+     if (el === null) return;
+     pinned.current = true;
+     el.scrollTo({ top: el.scrollHeight, behavior: scrollBehavior(behavior) });
+     setStuck(true);
+     setAtTop(el.scrollTop <= 1);
+   }, [el]);
+   const scrollToTop = useCallback((behavior: ScrollBehavior = "instant") => {
+     if (el === null) return;
+     pinned.current = false;
+     el.scrollTo({ top: 0, behavior: scrollBehavior(behavior) });
+     // 内容不足一屏时顶部即底部——按真实位置判，不盲目离开贴底。
+     setStuck(isNearBottom(el));
+     setAtTop(true);
+   }, [el]);
+   const restoreTo = useCallback((top: number, behavior: ScrollBehavior = "instant") => {
+     if (el === null) return;
+     el.scrollTo({ top, behavior: scrollBehavior(behavior) });
+     // instant 落位后 scrollTop 已同步——按真实落点判贴底（clamp 到上限时即贴底，正确）。
+     pinned.current = isNearBottom(el);
+     setStuck(pinned.current);
+     setAtTop(el.scrollTop <= 1);
+   }, [el]);
+
+   useEffect(() => {
+     if (el === null) return;
+     const onScroll = (): void => {
+       pinned.current = isNearBottom(el);
+       setStuck(pinned.current);
+       setAtTop(el.scrollTop <= 1);
+     };
+     el.addEventListener("scroll", onScroll, { passive: true });
+     return () => el.removeEventListener("scroll", onScroll);
+   }, [el]);
+
+   // 内容长高（流式新行、代码块展开）且仍粘底 ⇒ 跟到底。观察内容包裹层（.reading）。
+   useEffect(() => {
+     if (el === null) return;
+     const content = el.firstElementChild;
+     if (!content) return;
+     const follow = () => {
+       if (!pinned.current) return;
+       el.scrollTo({ top: el.scrollHeight, behavior: "instant" });
+     };
+     const ro = new ResizeObserver(follow);
+     ro.observe(content);
+     return () => ro.disconnect();
+   }, [el]);
+
+   return { stuck, atTop, scrollToBottom, scrollToTop, restoreTo };
+ }
+
+ // 视图三档（蓝本 §3.4，必抄 #4：同一份工具调用痕迹，按信任程度分级展示）。
+ //   Normal   工具调用折叠为摘要，完整文字回复
+ //   Thinking 折叠的工具调用 + Claude 的思考（**仅在本会话产出过思考后才进环**——蓝本原文）
+ //   Verbose  每次工具调用、中间步骤全展开 + 思考
+ // Ctrl+O 循环；本模块是环的唯一事实源（App 的快捷键与 Stream 的默认展开态共用）。
+ export type ViewMode = "normal" | "thinking" | "verbose";
+
+ /** 环的构成：没产出过思考就没有 Thinking 档（不摆一个永远空的档位）。 */
+ export function viewModesFor(hasThinking: boolean): readonly ViewMode[] {
+   return hasThinking ? (["normal", "thinking", "verbose"] as const) : (["normal", "verbose"] as const);
+ }
+
+ /** 下一个档位（Ctrl+O）。cur 不在当前环里（如思考被清掉后停在 thinking）⇒ 收敛到环首的下一档，不卡死。 */
+ export function nextViewMode(cur: ViewMode, hasThinking: boolean): ViewMode {
+   const modes = viewModesFor(hasThinking);
+   const i = modes.indexOf(cur);
+   return modes[(i + 1) % modes.length] ?? "normal";
+ }
+
+ /** toast 文案（单一源；切换时闪一条，不留常驻态）。 */
+ export const VIEW_LABEL: Record<ViewMode, string> = {
+   normal: "Normal · 工具折叠为摘要",
+   thinking: "Thinking · 附思考正文",
+   verbose: "Verbose · 工具全展开",
+ };
+
+ // 事件里的绝对路径 → 工作区相对路径（2026-10-18）。
+ // 为什么需要：附件芯片要调 workspacePathAction（只收相对路径），而真机上复现过
+ // /tmp/…（事件）与 /private/tmp/…（项目记录）的同一处路径前缀不等 ⇒ 误判「不在工作区内」。
+ // 归一口径：反斜杠统一、盘符小写、去掉同一个 macOS /private 前缀；越界返回 null。
+ export function relInWorkspace(workspace: string | null, path: string): string | null {
+   if (workspace === null || workspace.trim() === "") return null;
+   const norm = (p: string): string => {
+     let q = p.replace(/\\/g, "/");
+     q = q.length > 1 ? q.replace(/\/+$/, "") : q;
+     if (/^[A-Za-z]:/.test(q)) q = q[0]!.toLowerCase() + q.slice(1);
+     return q.startsWith("/private/") ? q.slice("/private".length) : q;
+   };
+   const nw = norm(workspace);
+   const np = norm(path);
+   if (np === nw) return ".";
+   if (!np.startsWith(nw + "/")) return null;
+   return np.slice(nw.length + 1);
+ }
