+     setKeyEnv(suggestApiKeyEnv(id.id));
+     if (id.note !== undefined) setNotice(id.note);
+   }, [baseURL, keyEnv]);
+
+   const refresh = useCallback(async () => {
+     setError(null);
+     setNotice(null);
+     setDiscovered(null);
+     if (baseURL.trim() === "") {
+       setError("先填接口地址（如 https://api.deepseek.com/v1）");
+       return;
+     }
+     if (keyEnv.trim() === "") {
+       setError("先填 key 的环境变量名（如 DEEPSEEK_API_KEY）——我们按变量名读，不把钥匙写进配置文件");
+       return;
+     }
+     setBusy(true);
+     try {
+       const keyValue = keyInput.current?.value ?? "";
+       const r = await window.agent.providerDiscover({
+         baseURL: baseURL.trim(),
+         protocol,
+         keyEnv: keyEnv.trim(),
+         ...(keyValue !== "" ? { keyValue } : {}),
+         ...(isLocalEndpointURL(baseURL.trim()) ? { allowLocal: true } : {}),
+       });
+       if (!r.ok) {
+         setError(r.message);
+         return;
+       }
+       setDiscovered({ ...r, baseURL: baseURL.trim(), keyEnv: keyEnv.trim(), protocol });
+       const all: Record<string, boolean> = {};
+       for (const row of r.rows) all[row.id] = true;
+       setSelected(all);
+       setPickerOpen(true); // 拉到清单直接弹选择窗，别让用户在表单里翻一整面墙
+     } catch (err) {
+       setError(err instanceof Error ? err.message : String(err));
+     } finally {
+       setBusy(false);
+     }
+   }, [baseURL, keyEnv, protocol]);
+
+   const save = useCallback(async () => {
+     if (discovered === null) return;
+     const models = discovered.rows
+       .filter((row) => selected[row.id] === true)
+       .map((row) => ({
+         id: row.id,
+         ...(row.contextWindow !== undefined ? { contextWindow: row.contextWindow } : {}),
+         ...(row.maxOutputTokens !== undefined ? { maxOutputTokens: row.maxOutputTokens } : {}),
+         ...(row.price !== undefined ? { price: row.price } : {}),
+         ...(row.reasoningEfforts !== undefined ? { reasoningEfforts: [...row.reasoningEfforts] } : {}),
+         ...(row.inputModalities !== undefined ? { inputModalities: [...row.inputModalities] } : {}),
+       }));
+     if (models.length === 0) {
+       setError("一条都没勾：至少选一个模型再存");
+       return;
+     }
+     setBusy(true);
+     setError(null);
+     try {
+       const keyValue = keyInput.current?.value ?? "";
+       const r = await window.agent.providerSave({
+         providerId: suggestProviderId(discovered.baseURL).id,
+         label: suggestProviderId(discovered.baseURL).id,
+         protocol: discovered.protocol,
+         baseURL: discovered.baseURL,
+         apiKeyEnv: discovered.keyEnv,
+         // 拉取那一步用过的同一个判定，必须也在保存时说一遍：漏了它就等于"能探测、存不进"。
+         ...(isLocalEndpointURL(discovered.baseURL) ? { allowLocalEndpoint: true } : {}),
+         models,
+         ...(keyValue !== "" ? { keyValue } : {}),
+       });
+       if (!r.ok) {
+         const detail = (r.problems ?? []).map((p) => `${p.where === "" ? "(顶层)" : p.where}：${p.message}`).join("；");
+         setError(detail === "" ? r.error : `${r.error}——${detail}`);
+         return;
+       }
+       // 保存完直接把它设成当前通道；但这一步必须与"保存"分开报（保存已落盘，只是切没切过去是两件事）。
+       const providerId = suggestProviderId(discovered.baseURL).id;
+       const firstModel = models[0]?.id ?? "";
+       let switchNote = "，并已设为当前通道";
+       try {
+         await window.agent.setSettings({ provider: providerId, ...(firstModel !== "" ? { model: firstModel } : {}) });
+       } catch (err) {
+         switchNote = `。但**没能自动切过去**（${err instanceof Error ? err.message : String(err)}）——可以在模型菜单里手动选它`;
+       }
+       setNotice(
+         `已保存：${providerId}（文件 ${r.path}，${String(r.providers.length)} 家，本次装上 ${String(r.installed)} 家；默认模型 ${firstModel === "" ? "未指定" : firstModel}）${switchNote}。key 走 safeStorage，明文不落盘。`,
+       );
+       props.onSaved?.();
+       // 保存成功 = 这一家的事办完了，整份表单归零（地址/变量名尤其不能留给下一家——两家共用一个 env 会互相覆盖）。
+       if (keyInput.current) keyInput.current.value = "";
+       setBaseURL("");
+       setKeyEnv("");
+       setProtocol("openai");
+       setDiscovered(null);
+       setSelected({});
+     } catch (err) {
+       setError(err instanceof Error ? err.message : String(err));
+     } finally {
+       setBusy(false);
+     }
+   }, [discovered, selected, props]);
+
+   const localHint = baseURL.trim() !== "" && isLocalEndpointURL(baseURL.trim());
+   // 2026-10-16（模型/通道页重做）：行改 SettingsRow（220px 标签列，卡内距与其余卡一致）、
+   // 控件走 Field（36px/8px/统一宽 ≤420、select 自绘箭头）；顶部说明压一行、全文收进「帮助」。
+   const step = (n: number, text: string): React.JSX.Element => (
+     <><span className="ss-step">{String(n)}</span>{text}</>
+   );
+   return (
+     <section className="ap-sec">
+       <div className="cp-intro">
+         <p className="cp-intro-line">填地址与 key 的环境变量名 → 拉取模型 → 勾选要用的 → 保存。</p>
+         <details className="ss-help">
+           <summary>帮助</summary>
+           <div className="ss-help-body">
+             表单会写进本工作区的 <code>.agent/providers.json</code>；「拉取」不改任何文件（要存必须再点「保存」）。
+             生成的接口可直接接自己的模型，不改源码；key 只存本机钥匙串，明文不落盘。
+           </div>
+         </details>
+       </div>
+       <SettingsRow label={step(1, "接口地址")}>
+         <Field width="full">
+           <input
+             type="text"
+             aria-label="自定义接口地址"
+             value={baseURL}
+             placeholder="https://api.deepseek.com/v1"
+             disabled={busy}
+             onChange={(e) => setBaseURL(e.target.value)}
+             onBlur={onUrlBlur}
+           />
+         </Field>
+         {localHint && <span className="sp-tag">本地端点 · 保存时将带 allowLocalEndpoint</span>}
+       </SettingsRow>
+       <SettingsRow label={step(2, "协议")}>
+         <Field width="full" select>
+           <select aria-label="自定义接口协议" value={protocol} disabled={busy} onChange={(e) => setProtocol(e.target.value as Protocol)}>
+             <option value="openai">openai（含 DeepSeek / GLM / 中转）</option>
+             <option value="anthropic">anthropic</option>
+             <option value="gemini">gemini</option>
+           </select>
+         </Field>
+       </SettingsRow>
+       <SettingsRow label={step(3, "key 环境变量名")}>
+         <Field width="full">
+           <input
+             type="text"
+             aria-label="自定义接口 key 环境变量名"
+             value={keyEnv}
+             placeholder="DEEPSEEK_API_KEY"
+             disabled={busy}
+             onChange={(e) => setKeyEnv(e.target.value)}
+           />
+         </Field>
+         {envNameHint(keyEnv) !== null && <span className="sp-note warn">{envNameHint(keyEnv)}</span>}
+       </SettingsRow>
+       <SettingsRow label={step(4, "自定义接口密钥")}>
+         <Field width="full">
+           <input ref={keyInput} type="password" aria-label="自定义接口 API key" placeholder="粘贴 API key（可选）" disabled={busy} />
+         </Field>
+         <button className="mini-btn" disabled={busy} onClick={() => void refresh()}>拉取模型</button>
+         <span className="ss-hint">只存本机钥匙串；本地端点多数不校验，也可留空只设环境变量。</span>
+       </SettingsRow>
+
+       {discovered !== null && (
+         <>
+           <div className="sp-note">
+             探测到 {String(discovered.rows.length)} 条
+             {discovered.matchedProviderId !== undefined ? `｜目录认出：${discovered.matchedProviderId}` : ""}
+             ｜目录来源：{discovered.catalogOrigin === "live" ? "刚拉到的" : discovered.catalogOrigin === "cache" ? "本地缓存" : "内置快照"}
+             {discovered.truncated > 0 ? `｜另有 ${String(discovered.truncated)} 条未列出` : ""}
+           </div>
+           {discovered.catalogNote !== undefined && <div className="sp-note">目录：{discovered.catalogNote}</div>}
+           <SettingsRow label={step(5, "启用模型")}>
+             <button ref={pickerButton} className="mini-btn" disabled={busy} onClick={() => setPickerOpen(true)}>选择模型…</button>
+             <span className="ss-hint">
+               已选 {String(discovered.rows.filter((row) => selected[row.id] === true).length)} / {String(discovered.rows.length)}
+             </span>
+           </SettingsRow>
+           {discovered.missing.length > 0 && (
+             <div className="sp-note">这几项目录也查不到，存下来之后得你自己补：{discovered.missing.join(" / ")}</div>
+           )}
+           {discovered.warnings.map((w) => (
+             <div key={w} className="sp-note">注意：{w}</div>
+           ))}
+           <SettingsRow label="保存">
+             <button className="mini-btn primary" disabled={busy} onClick={() => void save()}>保存到工作区</button>
+           </SettingsRow>
+           {pickerOpen && (
+             <ModelPickModal
+               rows={discovered.rows}
+               selected={selected}
+               {...(busy ? { busy: true } : {})}
+               onChange={setSelected}
+               onDone={() => setPickerOpen(false)}
+               returnFocusRef={pickerButton}
+             />
+           )}
+         </>
+       )}
+       {error !== null && <div className="sp-note err" role="alert">{error}</div>}
+       {notice !== null && <div className="sp-note" role="status">{notice}</div>}
+     </section>
+   );
+ }
+
+ // DiffView：unified hunks 渲染（变更窗格的逐 hunk 展开区）+ 行级评注（蓝本 §3.6）。
+ // 渲染契约：hunk 头 `@@ -a,b +c,d @@`；每行 = 旧行号 · 新行号 · 符号（+ / − / 空格）· 文本。
+ // 色盲冗余：着色之外，符号与前缀始终在场（不只靠颜色表达增删——同仓 diff 纪律）。
+ // 截断如实标注（超字节/行数帽时不假装完整）。
+ // 评注：仅当传 onComment 时行 hover 出「＋」；已评注的行常显 💬（title 带评论原文）。
+ //   行键 = `<path>|<newNo ?? oldNo>`——评审对象是"现在的这一行"（del 行用旧行号回指）。
+ import { useState, type KeyboardEvent } from "react";
+ import type { DiffHunkView } from "../../../../../src/main/change-diff";
+
+ export interface DiffViewCommentApi {
+   /** 行键 → 评论文本。 */
+   comments: ReadonlyMap<string, string>;
+   /** 行键前缀（`<path>|`）。 */
+   keyPrefix: string;
+   onComment: (lineKey: string, text: string) => void;
+ }
+
+ export function DiffView(props: {
+   hunks: readonly DiffHunkView[];
+   truncated?: boolean;
+   comment?: DiffViewCommentApi;
+ }): React.JSX.Element {
+   const [editing, setEditing] = useState<string | null>(null);
+   const [draft, setDraft] = useState("");
+   if (props.hunks.length === 0) {
+     // 截断态不能说「没有差异」：那会把「没比完」说成「比完了且一样」（真机：大文件超帽）。
+     return props.truncated === true
+       ? <div className="diff-note">已截断比对：显示帽内的内容未发现不同，超出部分未比对。</div>
+       : <div className="diff-empty">没有差异（与快照逐行一致）</div>;
+   }
+   const api = props.comment;
+   const openEditor = (key: string): void => {
+     setEditing(key);
+     setDraft(api?.comments.get(key) ?? "");
+   };
+   const commit = (): void => {
+     if (editing === null) return;
+     const text = draft.trim();
+     if (text !== "") api?.onComment(editing, text);
+     setEditing(null);
+     setDraft("");
+   };
+   const onEditorKey = (e: KeyboardEvent<HTMLTextAreaElement>): void => {
+     if (e.key === "Escape") { setEditing(null); setDraft(""); }
+     if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) { e.preventDefault(); commit(); }
+   };
+   return (
+     <div className="diff-view" aria-label="文件差异">
+       {props.hunks.map((h, i) => (
+         <div className="diff-hunk" key={`${h.header}:${String(i)}`}>
+           <div className="diff-hunk-head num">{h.header}</div>
+           {h.lines.map((l, j) => {
+             const lineNo = l.newNo ?? l.oldNo ?? 0;
+             const key = api === undefined ? "" : `${api.keyPrefix}${String(lineNo)}`;
+             const has = api !== undefined && api.comments.has(key);
+             return (
+               <div key={j}>
+                 <div className={`diff-line ${l.kind}`}>
+                   <span className="ln num" aria-hidden="true">{l.oldNo === null ? "" : String(l.oldNo)}</span>
+                   <span className="ln num" aria-hidden="true">{l.newNo === null ? "" : String(l.newNo)}</span>
+                   <span className="sign" aria-hidden="true">{l.kind === "add" ? "+" : l.kind === "del" ? "−" : " "}</span>
+                   <span className="txt">{l.text}</span>
+                   {api !== undefined && (
+                     <span className="dl-actions">
+                       {has && (
+                         <span className="dl-has-comment" title={api.comments.get(key)} aria-label="该行有评注">💬</span>
+                       )}
+                       <button
+                         className="dl-comment"
+                         aria-label={`评论第 ${String(lineNo)} 行`}
+                         onClick={() => { openEditor(key); }}
+                       >＋</button>
+                     </span>
+                   )}
+                 </div>
+                 {editing === key && (
+                   <div className="dl-editor">
+                     <textarea
+                       autoFocus
+                       rows={2}
+                       value={draft}
+                       aria-label={`第 ${String(lineNo)} 行评注`}
+                       placeholder="写评论（⌘Enter 保存 · Esc 取消）"
+                       onChange={(e) => setDraft(e.target.value)}
+                       onKeyDown={onEditorKey}
+                     />
+                     <button className="mini-btn primary" onClick={commit}>保存评论</button>
+                   </div>
+                 )}
+               </div>
+             );
+           })}
+         </div>
+       ))}
+       {props.truncated === true && (
+         <div className="diff-note">已截断（超字节 / 行数帽）——完整差异请用本地工具查看。</div>
+       )}
+     </div>
+   );
+ }
+
+ // C-17 ErrorStrip（产品化形态）：danger 左条 + alert 图标 + 消息 + 关闭钮（只由用户关闭，不自动消失）。
+ // role="alert"；App 持 lastError state（会话键控 Map），切会话各看各的。
+ import { AlertTriangle, FileText, X } from "lucide-react";
+ import { STR } from "../strings";
+
+ export function ErrorStrip(props: { message: string; onDismiss: () => void; onViewLog?: () => void }) {
+   return (
+     <div className="error-strip" role="alert" style={{ display: "flex" }}>
+       <span className="ico" aria-hidden="true">
+         <AlertTriangle size={14} />
+       </span>
+       <span className="msg">{props.message}</span>
+       {props.onViewLog !== undefined && (
+         <button className="btn-ghost error-log" title={STR.logViewer.openTip} onClick={props.onViewLog}>
+           <FileText size={12} aria-hidden="true" /> {STR.logViewer.open}
+         </button>
+       )}
+       <button className="x" onClick={props.onDismiss} aria-label={STR.logViewer.errorDismiss}>
+         <X size={12} />
+       </button>
+     </div>
+   );
+ }
+
+ import { Fragment, useEffect, useRef, useState } from "react";
+ import { ChevronRight, FileText, Folder } from "lucide-react";
+ import type { DirEntryView } from "../../../../../src/main/workspace-fs";
+
+ /** 文件窗格（v5 只读浏览）：左树懒加载 + 下方文本预览（帽/二进制由通道侧拒，界面如实呈现）。 */
+ export function FilePane(props: {
+   onPathMenu?: (rel: string, kind: "file" | "directory", x: number, y: number) => void;
+ }): React.JSX.Element {
+   type DirNode = { entries: DirEntryView[]; truncated: boolean } | { error: string };
+   const [dirs, setDirs] = useState<Record<string, DirNode>>({});
+   const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set([""]));
+   const [preview, setPreview] = useState<{ path: string; loading: boolean; text?: string; truncated?: boolean; error?: string } | null>(null);
+   const [focusPath, setFocusPath] = useState<string | null>(null);
+   // 请求归属（2026-10-21）：同一目录/预览的旧响应晚到，不能覆盖新请求的结果。
+   const dirSeq = useRef(new Map<string, number>());
+   const previewSeq = useRef(0);
+   const root = dirs[""];
+   const firstPath = root !== undefined && "entries" in root ? root.entries[0]?.name : undefined;
+
+   const loadDir = (rel: string): void => {
+     const seq = (dirSeq.current.get(rel) ?? 0) + 1;
+     dirSeq.current.set(rel, seq);
+     setDirs((prev) => {
+       const next = { ...prev };
+       delete next[rel];
+       return next;
+     });
+     void window.agent.workspaceListDir(rel).then((r) => {
+       if (dirSeq.current.get(rel) !== seq) return;
+       setDirs((prev) => ({
+         ...prev,
+         [rel]: r === undefined
+           ? { error: "通道无应答" }
+           : r.ok
+             ? { entries: r.entries, truncated: r.truncated }
+             : { error: r.error },
+       }));
+     }).catch((err: unknown) => {
+       if (dirSeq.current.get(rel) !== seq) return;
+       setDirs((prev) => ({ ...prev, [rel]: { error: err instanceof Error ? err.message : String(err) } }));
+     });
+   };
+   // 首次挂载拉根目录（懒加载树的唯一根；子层展开时才拉）。
+   useEffect(() => { loadDir(""); }, []);
+
+   const child = (rel: string, name: string): string => (rel === "" ? name : `${rel}/${name}`);
+   const toggleDir = (rel: string): void => {
+     setExpanded((prev) => {
+       const next = new Set(prev);
+       if (next.has(rel)) {
+         next.delete(rel);
+       } else { next.add(rel); if (dirs[rel] === undefined) loadDir(rel); }
+       return next;
+     });
+   };
+   const openFile = (rel: string): void => {
+     const seq = previewSeq.current + 1;
+     previewSeq.current = seq;
+     setPreview({ path: rel, loading: true });
+     void window.agent.workspaceReadText(rel).then((r) => {
+       if (previewSeq.current !== seq) return;
+       setPreview(r === undefined
+         ? { path: rel, loading: false, error: "通道无应答" }
+         : r.ok
+           ? { path: rel, loading: false, text: r.text, truncated: r.truncated }
+           : { path: rel, loading: false, error: r.error });
+     }).catch((err: unknown) => {
+       if (previewSeq.current !== seq) return;
+       setPreview({ path: rel, loading: false, error: err instanceof Error ? err.message : String(err) });
+     });
+   };
+
+   // 树键盘（2026-10-21）：↑/↓ 行间移动，Home/End 首尾，→ 展开/进子行，← 收起/回父行；
+   // Enter/Space 交给原生 button，避免双触发。roving tabindex 只保留一个 Tab 停点。
+   const onTreeKeyDown = (e: React.KeyboardEvent<HTMLDivElement>): void => {
+     if (e.metaKey || e.ctrlKey || e.altKey) return;
+     const rows = [...e.currentTarget.querySelectorAll<HTMLElement>(".fp-row")];
+     const active = document.activeElement;
+     const idx = active instanceof HTMLElement ? rows.indexOf(active) : -1;
+     if (idx < 0) return;
+     const row = rows[idx];
+     if (row === undefined) return;
+     if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Home" || e.key === "End") {
+       e.preventDefault();
+       const target = e.key === "Home" ? rows[0]
+         : e.key === "End" ? rows[rows.length - 1]
+         : e.key === "ArrowDown" ? rows[idx + 1]
+         : rows[idx - 1];
+       target?.focus();
+       return;
+     }
+     if (e.key === "ArrowRight" && row.dataset.kind === "dir") {
+       e.preventDefault();
+       if (row.getAttribute("aria-expanded") !== "true") row.click();
+       // 空、加载中或失败目录没有子行；右键只能进入它自己的直属子行。
+       else if (rows[idx + 1]?.dataset.parent === row.dataset.path) rows[idx + 1]?.focus();
+       return;
+     }
+     if (e.key === "ArrowLeft") {
+       e.preventDefault();
+       if (row.dataset.kind === "dir" && row.getAttribute("aria-expanded") === "true") {
+         row.click();
+         return;
+       }
+       rows.find((r) => r.dataset.path === row.dataset.parent)?.focus();
+     }
+   };
+
+   const renderDir = (rel: string, depth: number): React.ReactNode => {
+     const node = dirs[rel];
+     if (node === undefined) return <div className="fp-note">读取中…</div>;
+     if ("error" in node) {
+       return (
+         <div className="fp-note err" role="alert">
+           <span>{node.error}</span>
+           <button className="mini-btn" onClick={() => { loadDir(rel); }}>重试</button>
+         </div>
+       );
+     }
+     return (
+       <>
+         {node.truncated && (
+           <div className="fp-note warn" role="status">
+             目录过大，已截断：只显示前 {String(node.entries.length)} 项
+           </div>
+         )}
+         {node.entries.length === 0
+           ? <div className="fp-note">{rel === "" ? "工作区为空" : "空目录"}</div>
+           : node.entries.map((e) => {
+             const p = child(rel, e.name);
+             if (e.kind === "dir") {
+               const open = expanded.has(p);
+               return (
+                 <Fragment key={p}>
+                   <button
+                     className={"fp-row dir" + (open ? " open" : "")}
+                     style={{ paddingLeft: 6 + depth * 13 }}
+                     role="treeitem"
+                     aria-level={depth + 1}
+                     aria-expanded={open}
+                     data-path={p}
+                     data-parent={rel}
+                     data-kind="dir"
+                     tabIndex={focusPath === p || (focusPath === null && p === firstPath) ? 0 : -1}
+                     onFocus={() => { setFocusPath(p); }}
+                     onClick={(ev) => { ev.currentTarget.focus(); toggleDir(p); }}
+                     onContextMenu={(ev) => { ev.preventDefault(); props.onPathMenu?.(p, "directory", ev.clientX, ev.clientY); }}
+                   >
+                     <ChevronRight size={10} className="fp-chev" aria-hidden="true" />
+                     <Folder size={12} aria-hidden="true" />
+                     <span className="fp-name">{e.name}</span>
+                   </button>
+                   {open && renderDir(p, depth + 1)}
+                 </Fragment>
+               );
+             }
+             return (
+               <button
+                 key={p}
+                 className={"fp-row file" + (preview?.path === p ? " on" : "")}
+                 style={{ paddingLeft: 6 + depth * 13 + 13 }}
+                 role="treeitem"
+                 aria-level={depth + 1}
+                 aria-selected={preview?.path === p}
+                 data-path={p}
+                 data-parent={rel}
+                 data-kind="file"
+                 tabIndex={focusPath === p || (focusPath === null && p === firstPath) ? 0 : -1}
+                 onFocus={() => { setFocusPath(p); }}
+                 onClick={(ev) => { ev.currentTarget.focus(); openFile(p); }}
+                 onContextMenu={(ev) => { ev.preventDefault(); props.onPathMenu?.(p, "file", ev.clientX, ev.clientY); }}
+               >
+                 <FileText size={12} aria-hidden="true" />
+                 <span className="fp-name">{e.name}</span>
+                 {e.size !== null && <span className="fp-size num">{e.size}</span>}
+               </button>
+             );
+           })}
+       </>
+     );
+   };
+
+   return (
+     <div className="file-pane">
+       <div className="file-tree" role="tree" aria-label="文件树" onKeyDown={onTreeKeyDown}>{renderDir("", 0)}</div>
+       <div className="file-preview">
+         {preview === null && <div className="fp-note">点文件预览（只读；写入由 agent 走审批）</div>}
+         {preview !== null && (
+           <div className="fp-preview-head">
+             <div className="fp-preview-path" title={preview.path}>{preview.path}</div>
+             <span className="fp-readonly">只读</span>
+           </div>
+         )}
+         {preview !== null && preview.loading && <div className="fp-note">读取中…</div>}
+         {preview !== null && !preview.loading && preview.error !== undefined && (
+           <div className="fp-note err" role="alert">
+             <span>{preview.error}</span>
+             <button className="mini-btn" onClick={() => { openFile(preview.path); }}>重试</button>
+           </div>
+         )}
+         {preview !== null && !preview.loading && preview.text !== undefined && (
+           <>
+             {preview.truncated === true && <div className="fp-note warn">已截断（超 512 KiB 帽）</div>}
+             <pre className="fp-text">{preview.text}</pre>
+           </>
+         )}
+       </div>
+     </div>
+   );
+ }
+
+
+ // 对话内查找（⌘F，2026-10-18 对照 Claude 桌面端 Edit > Find…）：在已渲染的用户/助手正文里找文本。
+ // 交互：⏎ / ↓ 下一个、⇧⏎ / ↑ 上一个、Esc 关闭。只搜「看得见的正文」（.row .t）——工具行、元信息、
+ // 折叠摘要不参与；高亮用瞬态 class（900ms 自清），不往 Stream 塞匹配态（查找是读面，不改数据）。
+ import { scrollBehavior } from "../useStickyScroll";
+ import { forwardRef, useEffect, useImperativeHandle, useRef, useState } from "react";
+ import { ChevronDown, ChevronUp, Search, X } from "lucide-react";
+
+ /** 命令式入口：⌘G / ⇧⌘G 在输入框失去焦点后也要能步进（Claude Edit > Find Next/Previous 的标准键）。 */
+ import type { FindBarHandle } from "../app-controls";
+ export type { FindBarHandle } from "../app-controls";
+
+ export interface FindBarProps {
+   open: boolean;
+   /** 搜索范围：流的滚动容器（streamEl）。null = 还没有会话，只渲染不搜。 */
+   container: HTMLElement | null;
+   onClose: () => void;
+ }
+
+ /** 每次查询/步进都重新取一遍 DOM：流式追加或重渲染会换掉旧节点，缓存 Element 会指向已卸载的树。 */
+ function collect(container: HTMLElement | null, query: string): HTMLElement[] {
+   const q = query.trim().toLowerCase();
+   if (q === "" || container === null) return [];
+   return [...container.querySelectorAll<HTMLElement>(".row.user .t, .row.assistant .t")]
+     .filter((el) => (el.textContent ?? "").toLowerCase().includes(q));
+ }
+
+ function flash(el: HTMLElement): void {
+   el.scrollIntoView({ block: "center", behavior: scrollBehavior("smooth") });
+   const row = el.closest(".row");
+   if (!(row instanceof HTMLElement)) return;
+   row.classList.remove("find-hit");
+   void row.offsetWidth; // 强制重排，让同一个匹配再次跳转也能重播动画
+   row.classList.add("find-hit");
+   window.setTimeout(() => row.classList.remove("find-hit"), 900);
+ }
+
+ export const FindBar = forwardRef<FindBarHandle, FindBarProps>(function FindBar(props, ref): React.JSX.Element | null {
+   const [query, setQuery] = useState("");
+   const [count, setCount] = useState(0);
+   const [index, setIndex] = useState(0);
+   const inputRef = useRef<HTMLInputElement | null>(null);
+
+   useEffect(() => {
+     if (!props.open) return;
+     setQuery("");
+     setCount(0);
+     setIndex(0);
+     // 打开即聚焦：面板刚挂载时 autofocus 偶尔被标题栏抢走，延一帧再聚焦（原生查找也是打开即可输）。
+     const t = window.setTimeout(() => inputRef.current?.focus(), 0);
+     return () => window.clearTimeout(t);
+   }, [props.open]);
+
+   const search = (value: string): void => {
+     setQuery(value);
+     const hits = collect(props.container, value);
+     setCount(hits.length);
+     setIndex(0);
+     if (hits[0] !== undefined) flash(hits[0]);
+   };
+
+   /** 用最新 DOM 重算再走位：计数与位置始终对得上当前流（流式期间也能用）。 */
+   const step = (dir: 1 | -1): void => {
+     const hits = collect(props.container, query);
+     if (hits.length === 0) {
+       setCount(0);
+       setIndex(0);
+       return;
+     }
+     const next = (index + dir + hits.length) % hits.length;
+     setCount(hits.length);
+     setIndex(next);
+     flash(hits[next]!);
+   };
+
+   // 钩子必须在早退之前调用（关闭态也要保持 hook 顺序）。
+   useImperativeHandle(ref, () => ({ step, focus: () => inputRef.current?.focus() }));
+
+   if (!props.open) return null;
+
+   return (
+     <div className="find-bar" role="search" aria-label="在对话中查找">
+       <Search size={13} className="find-ico" aria-hidden="true" />
+       <input
+         ref={inputRef}
+         className="find-input"
+         value={query}
+         placeholder="在对话中查找"
+         aria-label="查找内容"
+         onChange={(e) => search(e.target.value)}
+         onKeyDown={(e) => {
+           if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); props.onClose(); return; }
+           if (e.key === "Enter") { e.preventDefault(); e.stopPropagation(); step(e.shiftKey ? -1 : 1); return; }
+           if (e.key === "ArrowDown") { e.preventDefault(); e.stopPropagation(); step(1); return; }
+           if (e.key === "ArrowUp") { e.preventDefault(); e.stopPropagation(); step(-1); }
+         }}
+       />
+       <span className="find-count num" aria-live="polite">
+         {query.trim() === "" ? "" : `${String(count === 0 ? 0 : index + 1)}/${String(count)}`}
+       </span>
+       <button className="find-btn" aria-label="上一个匹配" title="上一个（⇧⏎）" disabled={count === 0} onClick={() => step(-1)}>
+         <ChevronUp size={13} />
+       </button>
+       <button className="find-btn" aria-label="下一个匹配" title="下一个（⏎）" disabled={count === 0} onClick={() => step(1)}>
+         <ChevronDown size={13} />
+       </button>
+       <button className="find-btn" aria-label="关闭查找" title="关闭（Esc）" onClick={props.onClose}>
+         <X size={13} />
+       </button>
+     </div>
+   );
+ });
+
+ // 目标芯片（2026-10-18）：桌面此前根本没有 goal 的可视面——/goal 斜杠项只是往输入框塞字，
+ // 协议里的 setGoal 渲染层一次都没调过。芯片读 core 的 traceGoal（与主进程续跑判据同一份 reduce），
+ // 展示目标原文/轮次/暂停态，并提供暂停/继续/清除三个动作（都走 setGoal IPC，事件回流后自更新）。
+ import * as DropdownMenu from "@radix-ui/react-dropdown-menu";
+ import { ChevronDown, Target } from "lucide-react";
+ import type { GoalTrace } from "../../../../../src/agent/goal-trace";
+ import { STR } from "../strings";
+
+ export function GoalChip(props: {
+   trace: GoalTrace;
+   onPause: () => void;
+   onResume: () => void;
+   onClear: () => void;
+   /** 已停止的目标：核心的 clear 幂等（不再落事件），所以这里是纯本地隐藏。 */
+   onDismiss: () => void;
+ }): React.JSX.Element {
+   const { spec, turn, paused, stopped } = props.trace;
+   const usd = spec.maxUsd > 0 ? `$${spec.maxUsd.toFixed(2)}` : STR.goal.noUsd;
+   return (
+     <span
+       className="goal-chip"
+       data-paused={paused !== null || stopped !== null}
+       title={stopped !== null ? `${STR.goal.stopped}：${stopped}` : spec.objective}
+     >
+       <Target size={11} aria-hidden="true" />
+       <span className="gc-text" title={spec.objective}>{spec.objective}</span>
+       <span className="gc-turn num">{STR.goal.turns.replace("{turn}", String(turn)).replace("{max}", String(spec.maxTurns))}</span>
+       {stopped !== null && <span className="gc-state">{STR.goal.stopped}</span>}
+       {stopped === null && paused !== null && <span className="gc-state">{STR.goal.paused}</span>}
+       <DropdownMenu.Root>
+         <DropdownMenu.Trigger asChild>
+           <button className="gc-more" aria-label={STR.goal.actions} title={STR.goal.actions}>
+             <ChevronDown size={11} />
+           </button>
+         </DropdownMenu.Trigger>
+         <DropdownMenu.Content className="pop-rd" side="bottom" align="end" sideOffset={4}>
+           {stopped === null && paused === null && (
+             <DropdownMenu.Item className="menu-item" onSelect={props.onPause}>{STR.goal.pause}</DropdownMenu.Item>
+           )}
+           {stopped === null && paused !== null && (
+             <DropdownMenu.Item className="menu-item" onSelect={props.onResume}>{STR.goal.resume}</DropdownMenu.Item>
+           )}
+           {stopped === null ? (
+             <DropdownMenu.Item className="menu-item danger-text" onSelect={props.onClear}>{STR.goal.clear}</DropdownMenu.Item>
+           ) : (
+             <DropdownMenu.Item className="menu-item" onSelect={props.onDismiss}>{STR.goal.dismiss}</DropdownMenu.Item>
+           )}
+           <DropdownMenu.Item className="menu-item" disabled>
+             {STR.goal.budget.replace("{turns}", String(spec.maxTurns)).replace("{usd}", usd)}
+           </DropdownMenu.Item>
+         </DropdownMenu.Content>
+       </DropdownMenu.Root>
+     </span>
+   );
+ }
+
+ // v12 导入诊断卡（ADR 0004 §4）：导入已有文件夹 / 克隆之后，先把这个目录的三态诊断摆上屏——
+ // 支持 / 需要补充信息 / 当前不支持（badge 用 ADR 原话），配判定依据与下一步。
+ // 非阻断：只提示，不拦着登记项目、不拦着开会话；点「知道了」才收。判定文案来自 main 侧同一事实源
+ //（project-templates.diagnoseProjectDirectory），渲染层不另编一套结论。
+ import { AlertTriangle, Check, Info, X } from "lucide-react";
+ import type { ProjectDiagnosis, ProjectDiagnosisVerdict } from "../../../../../src/main/ipc-protocol";
+ import { STR } from "../strings";
+
+ const VERDICT_LABEL: Record<ProjectDiagnosisVerdict, string> = {
+   supported: STR.importDiagnosis.verdict.supported,
+   "needs-info": STR.importDiagnosis.verdict.needsInfo,
+   unsupported: STR.importDiagnosis.verdict.unsupported,
+ };
+
+ const VERDICT_TONE: Record<ProjectDiagnosisVerdict, string> = {
+   supported: "is-ok",
+   "needs-info": "is-warn",
+   unsupported: "is-no",
+ };
+
+ export function ImportDiagnosisCard(props: { name: string; diagnosis: ProjectDiagnosis; onDismiss: () => void }) {
+   const { diagnosis } = props;
+   const tone = VERDICT_TONE[diagnosis.verdict];
+   return (
+     <div className={`diagnosis-card ${tone}`} role="status" aria-label={STR.importDiagnosis.aria} data-verdict={diagnosis.verdict}>
+       <div className="diagnosis-head">
+         <span className="diagnosis-badge">
+           <span className="ico" aria-hidden="true">
+             {diagnosis.verdict === "supported" ? <Check size={12} /> : diagnosis.verdict === "needs-info" ? <Info size={12} /> : <AlertTriangle size={12} />}
+           </span>
+           {VERDICT_LABEL[diagnosis.verdict]}
+         </span>
+         <span className="name">{props.name}</span>
+         <span className="msg">{diagnosis.summary}</span>
+         <button className="x" onClick={props.onDismiss} aria-label={STR.importDiagnosis.dismiss}>
+           <X size={12} />
+         </button>
+       </div>
+       {diagnosis.reasons.length > 0 && (
+         <div className="diagnosis-row">
+           <span className="tag">{STR.importDiagnosis.why}</span>
+           <ul className="diagnosis-list">
+             {diagnosis.reasons.map((reason) => (
+               <li key={reason}>{reason}</li>
+             ))}
+           </ul>
+         </div>
+       )}
+       {diagnosis.hint !== undefined && (
+         <div className="diagnosis-row">
+           <span className="tag">{STR.importDiagnosis.next}</span>
+           <span className="msg">{diagnosis.hint}</span>
+         </div>
+       )}
+     </div>
+   );
+ }
+
+ // 右侧检查器（P3-2 · brief 七）：三 Tab——改动 / 计划 / 时间线；**没有对应数据的 Tab 一律隐藏**
+ //（不放占位假数据）。「＋」菜单打开既有七种窗格（文件/终端/浏览器/旁路…；组件与数据面不动，
+ // 只换一个入口）。改动行点击懒加载逐 hunk diff（v4 changeDiff 通道，复用既有 DiffView）；
+ // 有快照的行提供「撤销此文件改动」（snapshotRestore，v11 通道在渲染层的消费者）。
+ // 宽度与开合收口在 App 的右 Panel（320–420，默认收起，⌘⌥I 开合）——本组件只管内容。
+ import { useEffect, useRef, useState } from "react";
+ import * as DropdownMenu from "@radix-ui/react-dropdown-menu";
+ import { ChevronRight, Plus, X } from "lucide-react";
+ import type { AgentEvent } from "../../../../../src/events";
+ import { timelineItems } from "../projections";
+ import { diffCount, useLazyChangeDiff } from "../change-diff-state";
+ import { changedFilesOf, PANE_META, PANE_OPENABLE, projectPlans, type PaneKind } from "./panes";
+ import { usageSummary } from "../projections";
+ import { formatTokens } from "./format-tokens";
+ import { DiffView } from "./DiffView";
+ import { TimelinePane } from "./TimelinePane";
+
+ const CHANGE_WORD: Record<"created" | "modified" | "unknown", string> = {
+   created: "新建",
+   modified: "修改",
+   unknown: "变更",
+ };
+
+ /** 概览里的一个数字：值变了就闪一下（2026-10-22 动效面）。
+  *
+  *  为什么是这里：概览是运行中**盯着看**的面，数字自己在变；此前只有"变了"这一事实、
+  *  没有"刚刚变"的提示 ⇒ 数字悄悄跳一下，人得自己前后对比才发现。闪一下就是那句提示。
+  *  克制：只闪**数值本身**（颜色一闪，不位移、不放大）；标签不动；页面不可见时不闪。
+  *  降级：`prefers-reduced-motion: reduce` 下全局把动画时长压到 0.01ms ⇒ 自然不闪。
+  */
+ function StatValue(props: { value: string }): React.JSX.Element {
+   const [flash, setFlash] = useState(false);
+   const prev = useRef(props.value);
+   useEffect(() => {
+     if (prev.current === props.value) return;
+     prev.current = props.value;
+     setFlash(true);
+     // 闪烁时长跟 CSS 的 --t-slow（300ms）对齐：这里多留一点余量再摘掉类名。
+     const id = setTimeout(() => setFlash(false), 420);
+     return () => { clearTimeout(id); };
+   }, [props.value]);
+   return <dd className={"num" + (flash ? " isp-ov-value-flash" : "")}>{props.value}</dd>;
+ }
+
+ /** 改动 Tab：文件行（点击展开 diff；有快照的行可撤销——撤销后收起旧 diff，下次点开重新拉）。 */
+ function ChangesTab(props: {
+   items: ReturnType<typeof changedFilesOf>;
+   onRestore?: (path: string, snapshotId: string) => void;
+ }): React.JSX.Element {
+   // 懒加载与两处共用的请求守卫（2026-10-18）：不再自己写一份 changeDiff。
+   const { openKey, diff, toggle, close } = useLazyChangeDiff();
+   return (
+     <ul className="isp-list">
+       {props.items.map((f) => {
+         const open = openKey === f.path;
+         return (
+           <li className="isp-file-wrap" key={f.path}>
+             <div className="isp-file">
+               <button className={"isp-file-main" + (open ? " open" : "")} aria-expanded={open} title={f.path} onClick={() => toggle(f.path, f.path, f.snapshotId)}>
+                 <span className="chev" aria-hidden="true"><ChevronRight size={10} /></span>
+                 <span className={"act " + f.change}>{CHANGE_WORD[f.change]}</span>
+                 <span className="path">{f.path}</span>
+               </button>
+               {f.snapshotId !== undefined && props.onRestore !== undefined && (
+                 <button
+                   className="isp-undo"
+                   aria-label="撤销此文件改动"
+                   title={`把「${f.path}」还原到这次改动前的版本`}
+                   onClick={() => {
+                     const snap = f.snapshotId;
+                     if (snap === undefined) return;
+                     props.onRestore?.(f.path, snap);
+                     close(); // 还原后旧 diff 已无效：收起，下次点开重新拉
+                   }}
+                 >撤销</button>
+               )}
+             </div>
+             {open && (
+               <div className="isp-diff-zone">
+                 {diff.loading && <div className="isp-empty">正在读快照与当前文件…</div>}
+                 {!diff.loading && diff.payload !== null && (
+                   diff.payload.ok ? (
+                     <>
+                       <div className="isp-diff-stat num">{`+${String(diffCount(diff.payload.hunks).add)} −${String(diffCount(diff.payload.hunks).del)}`}</div>
+                       <DiffView hunks={diff.payload.hunks} truncated={diff.payload.truncated} />
+                     </>
+                   ) : (
+                     <div className="ap-notice err" role="alert">{diff.payload.error}</div>
+                   )
+                 )}
+               </div>
+             )}
+           </li>
+         );
+       })}
+     </ul>
+   );
+ }
+
+ export interface InspectorProps {
+   events: readonly AgentEvent[];
+   /** 时间线/改动跳转：跳到对话中的对应事件位置（App 经 data-event-id 锚）。 */
+   onJump?: (eventId: number) => void;
+   /** 「＋」菜单：打开既有七种窗格（App 侧 togglePane/openPane）。 */
+   onOpenPane?: (kind: PaneKind) => void;
+   /** 「撤销此文件改动」（snapshotRestore；成功/失败面在 App）。 */
+   onRestore?: (path: string, snapshotId: string) => void;
+   /** 判卷/深链预留：强制初始 Tab（缺省 = 概览）。 */
+   initialTab?: "overview" | "changes" | "plan" | "timeline";
+   /** 概览页的会话事实（可选；判卷/嵌用面没有就不摆）。 */
+   sessionTitle?: string;
+   workspacePath?: string;
+   modelLabel?: string;
+   modeLabel?: string;
+   running?: boolean;
+   /** 关闭检查器（App 的 toggleInspector：开合 + 跨重启记忆同一出口）。
+    *  缺省不摆按钮——判卷/嵌用面没有右 Panel 可关，摆一枚点了没反应的 × 更糟。 */
+   onClose?: () => void;
+ }
+
+ /** 概览页（2026-10-21）：右栏的「现在在哪」——会话/工作区/状态 + 六格用量。
+  *  全部从 AgentEvent 与 App 传入的事实投影，不另存一份；空会话不摆假数据。 */
+ function OverviewTab(props: {
+   events: readonly AgentEvent[];
+   usage: ReturnType<typeof usageSummary>;
+   fileCount: number;
+   planCount: number;
+   sessionTitle?: string;
+   workspacePath?: string;
+   modelLabel?: string;
+   modeLabel?: string;
+   running?: boolean;
+ }): React.JSX.Element {
+   const wsName = props.workspacePath !== undefined && props.workspacePath !== ""
+     ? props.workspacePath.slice(props.workspacePath.lastIndexOf("/") + 1)
+     : null;
+   const rows: readonly (readonly [string, string])[] = [
+     ["输入", props.usage.usageCount > 0 ? formatTokens(props.usage.inputTokens) : "未返回"],
+     ["输出", props.usage.usageCount > 0 ? formatTokens(props.usage.outputTokens) : "未返回"],
+     ["工具步数", String(props.usage.toolSteps)],
+     ["对话轮数", String(props.usage.rounds)],
+     ["文件改动", String(props.fileCount)],
+     ["用量次数", String(props.usage.usageCount)],
+   ];
+   return (
+     <div className="isp-ov">
+       <div className="isp-ov-head">
+         <div className="isp-ov-title">
+           <span className="isp-ov-name" title={props.sessionTitle ?? undefined}>{props.sessionTitle ?? "当前会话"}</span>
+           {props.running !== undefined && (
+             <span className="isp-ov-status" data-running={props.running ? "true" : "false"}>
+               {props.running ? "运行中" : "空闲"}
+             </span>
+           )}
+         </div>
+         {wsName !== null && (
+           <div className="isp-ov-path" title={props.workspacePath}>{wsName}</div>
+         )}
+       </div>
+       <dl className="isp-ov-stats">
+         {rows.map(([label, value]) => (
+           <div className="isp-ov-stat" key={label}>
+             <dt>{label}</dt>
+             <StatValue value={value} />
+           </div>
+         ))}
+       </dl>
+       {(props.modelLabel !== undefined || props.modeLabel !== undefined || props.planCount > 0) && (
+         <div className="isp-ov-meta">
+           {props.modelLabel !== undefined && <span className="chip">{props.modelLabel}</span>}
+           {props.modeLabel !== undefined && <span className="chip">{props.modeLabel}</span>}
+           {props.planCount > 0 && <span className="chip num">{props.planCount} 份计划</span>}
+         </div>
+       )}
+       {props.events.length === 0 && (
+         <div className="isp-empty">还没有活动——对话开始后，用量、改动、计划与时间线会在这里长出来。</div>
+       )}
+     </div>
+   );
+ }
+
+ export function Inspector(props: InspectorProps): React.JSX.Element {
+   const changes = changedFilesOf(props.events);
+   const plans = projectPlans(props.events);
+   const items = timelineItems(props.events);
+   const usage = usageSummary(props.events);
+   // 概览恒在（2026-10-21 三栏工作台）：它是右栏的「现在在哪」，不是假占位——
+   // 空会话给 0 与一句诚实的「还没开始」，有数据时给输入/输出/步数/轮数/文件/用量。
+   const available = [
+     { id: "overview" as const, label: "概览" },
+     ...(changes.length > 0 ? [{ id: "changes" as const, label: "改动" }] : []),
+     ...(plans.length > 0 ? [{ id: "plan" as const, label: "计划" }] : []),
+     ...(items.length > 0 ? [{ id: "timeline" as const, label: "时间线" }] : []),
+   ];
+   const [tab, setTab] = useState<InspectorProps["initialTab"] | null>(
+     props.initialTab !== undefined && available.some((t) => t.id === props.initialTab) ? props.initialTab : "overview",
+   );
+   // 渲染期回落：数据面变化（切会话/数据消失）致选中项失效时，自动回到第一个可用——不留死选中。
+   const selected = tab !== null && available.some((t) => t.id === tab) ? tab : (available[0]?.id ?? null);
+   return (
+     <div className="isp">
+       <div className="isp-head">
+         <div className="isp-tabs" role="tablist" aria-label="检查器">
+           {available.map((t) => (
+             <button
+               key={t.id}
+               role="tab"
+               aria-selected={selected === t.id}
+               className={"isp-tab" + (selected === t.id ? " active" : "")}
+               onClick={() => setTab(t.id)}
+             >{t.label}</button>
+           ))}
+         </div>
+         <DropdownMenu.Root>
+           <DropdownMenu.Trigger asChild>
+             <button className="isp-add" aria-label="打开窗格" title="打开窗格（文件 / 终端 / 浏览器 / 旁路…）"><Plus size={13} /></button>
+           </DropdownMenu.Trigger>
+           <DropdownMenu.Content className="pop-rd" side="bottom" align="end" sideOffset={4}>
+             {PANE_OPENABLE.map((k) => (
+               <DropdownMenu.Item key={k} className="menu-item" onSelect={() => props.onOpenPane?.(k)}>
+                 {PANE_META[k].label}
+               </DropdownMenu.Item>
+             ))}
+           </DropdownMenu.Content>
+         </DropdownMenu.Root>
+         {/* 关闭钮（2026-10-20 真机：「右边侧栏打开就没有关闭」）：此前只有 ⌘⌥I 一条路，
+             鼠标用户把面板打开了却找不到出口。复用 .isp-add 的图标钮样式——同排同形，不新造一套。 */}
+         {props.onClose !== undefined && (
+           <button className="isp-add isp-close" aria-label="关闭检查器" title="关闭检查器（⌘⌥I）" onClick={() => { props.onClose?.(); }}>
+             <X size={13} />
+           </button>
+         )}
+       </div>
+       <div className="isp-body">
+         {selected === "overview" && (
+           <OverviewTab
+             events={props.events}
+             usage={usage}
+             fileCount={changes.length}
+             planCount={plans.length}
+             sessionTitle={props.sessionTitle}
+             workspacePath={props.workspacePath}
+             modelLabel={props.modelLabel}
+             modeLabel={props.modeLabel}
+             running={props.running}
+           />
+         )}
+         {selected === "changes" && <ChangesTab items={changes} onRestore={props.onRestore} />}
+         {selected === "plan" && (
+           <div className="isp-plan">
+             {plans.map((p) => (
+               <div className="isp-plan-item" key={p.callId}>
+                 <div className="isp-plan-goal">{p.goal}</div>
+                 <div className="isp-plan-meta">
+                   <span className={"chip " + (p.state === "approved" ? "ok" : p.state === "rejected" ? "bad" : "warn")}>
+                     {p.state === "approved" ? "已批准" : p.state === "rejected" ? "已拒绝" : "待决"}
+                   </span>
+                   <span className="chip num">{String(p.files.length)} 个文件</span>
+                 </div>
+               </div>
+             ))}
+           </div>
+         )}
+         {selected === "timeline" && <TimelinePane items={items} onJump={props.onJump} />}
+         {selected === null && (
+           <div className="isp-empty">本会话还没有可检查的内容——改动、计划与时间线会随对话在这里长出来。</div>
+         )}
+       </div>
+     </div>
+   );
+ }
+
+ import { useEffect, useRef, type HTMLAttributes, type RefObject } from "react";
+
+ const FOCUSABLE_SELECTOR =
+   "button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [contenteditable='true'], [tabindex]:not([tabindex='-1'])";
+
+ const MODAL_STACK: HTMLElement[] = [];
+
+ interface HiddenState {
+   el: HTMLElement;
+   inert: boolean;
+   ariaHidden: string | null;
+ }
+
+ /** 只隔离弹层之外的兄弟子树，不把弹层自身或祖先设成 inert。 */
+ function isolateOutside(surface: HTMLElement): HiddenState[] {
+   const states = new Map<HTMLElement, HiddenState>();
+   let child = surface;
+   while (child.parentElement !== null) {
+     const parent = child.parentElement;
+     for (const sibling of [...parent.children]) {
+       if (sibling === child || !(sibling instanceof HTMLElement)) continue;
+       if (["SCRIPT", "STYLE", "LINK", "TEMPLATE"].includes(sibling.tagName)) continue;
+       if (states.has(sibling)) continue;
+       const state = {
+         el: sibling,
+         inert: sibling.hasAttribute("inert"),
+         ariaHidden: sibling.getAttribute("aria-hidden"),
+       };
+       states.set(sibling, state);
+       sibling.setAttribute("inert", "");
+       sibling.setAttribute("aria-hidden", "true");
+     }
+     if (parent === document.body) break;
+     child = parent;
+   }
+   return [...states.values()];
+ }
+
+ function focusableWithin(surface: HTMLElement): HTMLElement[] {
+   return [...surface.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR)]
+     .filter((el) => el.getClientRects().length > 0);
+ }
+
+ type ModalSurfaceProps = Omit<HTMLAttributes<HTMLDivElement>, "role" | "aria-modal" | "aria-label" | "tabIndex"> & {
+   label: string;
+   onClose: () => void;
+   initialFocusRef?: RefObject<HTMLElement | null>;
+   returnFocusRef?: RefObject<HTMLElement | null>;
+ };
+
+ export function ModalSurface(props: ModalSurfaceProps): React.JSX.Element {
+   const { label, onClose, initialFocusRef, returnFocusRef, className, children, ...rest } = props;
+   const surfaceRef = useRef<HTMLDivElement | null>(null);
+   const closeRef = useRef(onClose);
+   const initialRef = useRef(initialFocusRef);
+   const returnRef = useRef(returnFocusRef);
+   closeRef.current = onClose;
+   initialRef.current = initialFocusRef;
+   returnRef.current = returnFocusRef;
+
+   useEffect(() => {
+     const surface = surfaceRef.current;
+     if (surface === null) return;
+     MODAL_STACK.push(surface);
+
+     let previousFocus: HTMLElement | null = null;
+     let hidden: HiddenState[] = [];
+
+     const onKey = (e: KeyboardEvent): void => {
+       if (MODAL_STACK[MODAL_STACK.length - 1] !== surface) return;
+       if (e.key === "Escape") {
+         e.preventDefault();
+         e.stopPropagation();
+         e.stopImmediatePropagation();
+         closeRef.current();
+         return;
+       }
+       if (e.key !== "Tab") return;
+       const items = focusableWithin(surface);
+       if (items.length === 0) {
+         e.preventDefault();
+         surface.focus();
+         return;
+       }
+       const first = items[0];
+       const last = items[items.length - 1];
+       if (first === undefined || last === undefined) return;
+       const active = document.activeElement;
+       if (e.shiftKey && (active === first || active === surface || !surface.contains(active))) {
+         e.preventDefault();
+         last.focus();
+       } else if (!e.shiftKey && (active === last || active === surface || !surface.contains(active))) {
+         e.preventDefault();
+         first.focus();
+       }
+     };
+
+     window.addEventListener("keydown", onKey, true);
+     const activate = (): void => {
+       const explicitReturn = returnRef.current?.current;
+       previousFocus = explicitReturn !== null && explicitReturn !== undefined && explicitReturn.isConnected
+         ? explicitReturn
+         : document.activeElement instanceof HTMLElement ? document.activeElement : null;
+       hidden = isolateOutside(surface);
+       const preferred = initialRef.current?.current;
+       const first = preferred !== null && preferred !== undefined && surface.contains(preferred) && preferred.getClientRects().length > 0
+         ? preferred
+         : focusableWithin(surface)[0];
+       if (first !== undefined) first.focus(); else surface.focus();
+     };
+     // Radix 在关闭菜单时会用 setTimeout(0) 把焦点还给触发器，并清理自己的
+     // aria-hidden。第一轮等待它入队，第二轮等它完成后再采集真实状态。
+     let init = window.setTimeout(() => {
+       init = window.setTimeout(activate, 0);
+     }, 0);
+
+     return () => {
+       window.clearTimeout(init);
+       window.removeEventListener("keydown", onKey, true);
+       const stackIndex = MODAL_STACK.lastIndexOf(surface);
+       if (stackIndex >= 0) MODAL_STACK.splice(stackIndex, 1);
+       for (const state of hidden.reverse()) {
+         if (!state.inert) state.el.removeAttribute("inert");
+         if (state.ariaHidden === null) state.el.removeAttribute("aria-hidden");
+         else state.el.setAttribute("aria-hidden", state.ariaHidden);
+       }
+       previousFocus?.focus();
+     };
+   }, []);
+
+   return (
+     <div
+       {...rest}
+       ref={surfaceRef}
+       className={className}
+       role="dialog"
+       aria-modal="true"
+       aria-label={label}
+       tabIndex={-1}
+       data-modal-surface="true"
+     >
+       {children}
+     </div>
+   );
+ }
+
+ // C-21 `ModelPicker`（§5.4 Row3）——P2-2 合并单面（brief 三节：模型 chip「模型名 · 思考强度」，
+ // 点击一个弹窗：搜索 + 模型列表（上下文长度 / 思考 / 图片能力）+ 下半区思考强度 Segmented）。
+ // 旧两视图（思考面 × 换模型面）作废：一屏说全——上列表、下思考段，少一次翻面。
+ // 触发条 = 单芯片形态：`deepseek-chat · 思考 关 ⌄`（档词 = 关/低/中/强；未声明支持不带思考段）。
+ // 数据面不变（唯一事实源仍是 `getProviderInfo()`，本层不造第二份）；文案全出处 STR。
+ import { useCallback, useEffect, useRef, useState } from "react";
+ import { ChevronDown, Eye, Info, Settings } from "lucide-react";
+ import type { ProviderInfo } from "../../../../../src/main/ipc-protocol";
+ import { STR } from "../strings";
+ import { Popover, usePopoverDismiss } from "./Popover";
+
+ /** 菜单项：registryId = null 即「演示」（run 时不透传 model，走 settings 缺省）。 */
+ export interface ModelOption {
+   registryId: string | null;
+   label: string;
+   provider: string | null;
+   tier?: string;
+   ctxWindow?: number;
+   /** 识图能力（能力在菜单里可见，用户不用去猜模型名）。 */
+   vision?: boolean;
+ }
+
+ /** 档位徽标文字。**必须有文字**：只靠颜色的徽标对色觉障碍用户等于没有（规范 a11y 条）。 */
+ export function tierBadge(tier: string | undefined): string {
+   switch (tier) {
+     case "cheap":
+       return STR.modelPicker.tierCheap;
+     case "standard":
+       return STR.modelPicker.tierStandard;
+     case "strong":
+       return STR.modelPicker.tierStrong;
+     default:
+       return STR.modelPicker.tierUndefined;
+   }
+ }
+
+ /** 上下文窗口的人话写法（12000 → 12k，1_000_000 → 1M）。缺省给「—」而不是 0。 */
+ export function formatCtxWindow(n: number | undefined): string {
+   if (n === undefined || !Number.isFinite(n) || n <= 0) return STR.composer.dash;
+   if (n >= 1_000_000) {
+     const m = n / 1_000_000;
+     return `${Number.isInteger(m) ? String(m) : m.toFixed(1)}M`;
+   }
+   if (n >= 1000) return `${Math.round(n / 1000)}k`;
+   return String(n);
+ }
+
+ /** demo 常驻首项「演示」，其余按 spec 铺平（provider 分组交给菜单的分节）。
+  *  多个 ProviderInfo 会重复铺同一行 ⇒ 按 spec.id 去重，顺序保持首见。 */
+ export function flattenModels(infos: readonly ProviderInfo[]): ModelOption[] {
+   const options: ModelOption[] = [{ registryId: null, label: STR.modelPicker.demo, provider: null }];
+   const seen = new Set<string>();
+   for (const info of infos) {
+     for (const spec of info.models) {
+       if (seen.has(spec.id)) continue;
+       seen.add(spec.id);
+       options.push({
+         registryId: spec.id,
+         label: spec.model,
+         provider: spec.provider,
+         tier: spec.tier,
+         ctxWindow: spec.ctxWindow,
+         ...(spec.capability.attachments.image === true ? { vision: true } : {}),
+       });
+     }
+   }
+   return options;
+ }
+
+ export interface ModelGroup {
+   provider: string;
+   models: ModelOption[];
+ }
+
+ /** 按 provider 分组（保持首见顺序）。「演示」不归组 —— 它不是某个 provider 的档位。 */
+ export function groupModels(options: readonly ModelOption[]): ModelGroup[] {
+   const groups: ModelGroup[] = [];
+   const index = new Map<string, ModelGroup>();
+   for (const o of options) {
+     if (o.provider === null) continue;
+     const hit = index.get(o.provider);
+     if (hit) hit.models.push(o);
+     else {
+       const g: ModelGroup = { provider: o.provider, models: [o] };
+       index.set(o.provider, g);
+       groups.push(g);
+     }
+   }
+   return groups;
+ }
+
+ /** 菜单搜索（纯函数判卷）。子序列模糊匹配（"ds" 命中 deepseek——fuzzy finder 惯例），
+  *  大小写不敏感，命中 label 或 provider；「演示」只在空查询时出现——它不是被搜的对象。 */
+ export function filterModelOptions(options: readonly ModelOption[], query: string): ModelOption[] {
+   const q = query.trim().toLowerCase();
+   if (q === "") return [...options];
+   const fuzzy = (hay: string): boolean => {
+     const h = hay.toLowerCase();
+     let i = 0;
+     for (const ch of h) {
+       if (ch === q[i]) i += 1;
+       if (i === q.length) return true;
+     }
+     return false;
+   };
+   return options.filter((o) =>
+     o.provider !== null && (fuzzy(o.label) || fuzzy(o.provider)),
+   );
+ }
+
+ /** 触发条上的短名（规范：截断 140）。 */
+ export function shortModelName(value: string | null, options: readonly ModelOption[]): string {
+   const raw = value === null ? STR.modelPicker.demo : (options.find((o) => o.registryId === value)?.label ?? value);
+   return raw.length > 140 ? `${raw.slice(0, 139)}…` : raw;
+ }
+
+ /** key 未配置时的置顶提示（fail-visible）。配好了就返回 null。
+  *  demo 不算「未配置」—— 它按设计不需要 key（规范里单列一条）。 */
+ export function pickerKeyNotice(info: ProviderInfo | null): string | null {
+   if (info === null || info.kind === "demo") return null;
+   if (info.keyConfigured) return null;
+   return STR.modelPicker.unconfiguredKey.replace("{provider}", info.provider);
+ }
+
+ /** 选中项描述（触发条的 title 唯一事实源；三态都说人话）。 */
+ export function describeSelection(value: string | null, options: readonly ModelOption[]): string {
+   if (value === null) return STR.modelPicker.demoDesc;
+   const hit = options.find((o) => o.registryId === value);
+   if (!hit) return STR.modelPicker.fallbackDesc.replace("{value}", value);
+   const provider = hit.provider ? STR.modelPicker.descProvider.replace("{provider}", hit.provider) : "";
+   const tier = hit.tier !== undefined ? STR.modelPicker.descTier.replace("{tier}", tierBadge(hit.tier)) : "";
+   const ctx = hit.ctxWindow !== undefined ? STR.modelPicker.descCtx.replace("{ctx}", formatCtxWindow(hit.ctxWindow)) : "";
+   return STR.modelPicker.descName.replace("{name}", hit.label) + provider + tier + ctx;
+ }
+
+ /** 思考档位词表（分段短词族：关/低/中/强；id 即请求侧字面量，不动；文案出处 STR）。 */
+ export const THINKING_LEVELS = [
+   { id: "off", short: STR.modelPicker.thinkOff, hint: STR.modelPicker.thinkOffHint },
+   { id: "low", short: STR.modelPicker.thinkLow, hint: STR.modelPicker.thinkLowHint },
+   { id: "medium", short: STR.modelPicker.thinkMedium, hint: STR.modelPicker.thinkMediumHint },
+   { id: "high", short: STR.modelPicker.thinkHigh, hint: STR.modelPicker.thinkHighHint },
+ ] as const;
+
+ /** 「信号开菜单」这一步的判据（纯函数）：seq 前进一次 = 开一次。
+  *
+  *  `prev === null` 是**首帧**（含重挂后的首帧）：那时只对齐基线、不开。
+  *  这一支是修的那一格：ModelPicker 按 `key={draftKey}` 在切会话时重挂，重挂把「上一次见过的 seq」
+  *  这个 ref 复位掉了，而 Composer 那边的 seq 不会复位、还留着上一次 ⌘⇧I 的值 ⇒ 重挂后的 picker
+  *  以为"seq 前进了一大截"⇒ **切会话时菜单自己弹开**，悬在新会话的输入框上抢焦点。
+  *  语义不变：「seq 前进一次 = 开一次」，而**重挂不算前进**。
+  *
+  *  seq 回退（< prev）也不开：基线不倒退，避免下一次前进被算成"连跳两格"而开两次。 */
+ export function nextOpenSeqState(
+   prev: number | null,
+   incoming: number | undefined,
+ ): { open: boolean; baseline: number | null } {
+   if (incoming === undefined) return { open: false, baseline: prev };
+   if (prev === null) return { open: false, baseline: incoming };
+   if (incoming <= prev) return { open: false, baseline: prev };
+   return { open: true, baseline: incoming };
+ }
+
+ export function ModelPicker(props: {
+   infos: readonly ProviderInfo[];
+   value: string | null;
+   onChange: (registryId: string | null) => void;
+   disabled?: boolean;
+   /** 运行中（v7.2 业主裁）：模型档位照旧锁定，但**触发器不灰、菜单照开**——思考程度是
+    *  「下一轮派活」的旋钮，跑着也能拧（透传给 ModelMenu 做「模型行禁用」）。 */
+   running?: boolean;
+   /** 「去设置配置」/「管理模型」的入口。 */
+   onOpenSettings?: () => void;
+   /** 这是**会话内**显式选择（与全局缺省不同）：触发条上点一个小圆点，规范要求可区分。 */
+   sessionOverride?: boolean;
+   /** 当前思考档位（缺省 off）；给了就在触发条上显示「· 思考 关」并在菜单里出思考强度区。 */
+   thinking?: string;
+   /** 当前模型是否声明支持思考档位。未声明 ⇒ 触发条不带「· 思考」段；菜单思考段整区禁用 +
+    *  注「当前模型不支持思考强度」（brief 三节；不摆空壳也不噤声——为什么+怎么解锁在折叠里）。 */
+   thinkingSupported?: boolean;
+   onThinkingChange?: (level: string) => void;
+   /** 已配置 key 的 provider id 集合（stored ∪ env 在场）。给了之后：列表里**只保留**该集合内
+    *  provider 的真模型；未给 = 不过滤（测试/只读场景）。 */
+   configuredProviders?: ReadonlySet<string>;
+   /** 快捷键开菜单信号（蓝本 §3.6 ⌘⇧I/⌘⇧E）：seq 递增即开一次；不给 = 不响应。 */
+   openSeq?: number;
+   /** 打开落点（2026-10-18）：model = 聚焦搜索框（⌘⇧I / 点击）；effort = 滚到并聚焦思考档（⌘⇧E）。
+    *  两者开的是同一个菜单，但快捷键的承诺不同，落点必须不同。 */
+   initialFocus?: "model" | "effort";
+   /** 用户自己点开触发器（2026-10-18）：让上层把落点复位成 model，避免上一次 ⌘⇧E 的焦点意图残留。 */
+   onUserOpen?: () => void;
+ }) {
+   const [open, setOpen] = useState(false);
+   const box = useRef<HTMLDivElement>(null);
+   // 信号开菜单：seq 前进且未被**硬锁**（disabled：门槛/排队读回）才开。
+   // v7.2 业主裁后 running 不再折进 disabled ⇒ ⌘⇧E 运行中也能开（思考档要能调）。
+   //
+   // 首帧只**对齐**、不开（2026-10-19 独立评审追出）：ModelPicker 按 `key={draftKey}` 在切会话时
+   // 重挂（见 Composer.tsx 的注释），重挂会把 `lastOpenSeq` 这个 ref 复位成 0；而 Composer 那边的
+   // `pickerOpenSeq` 不会重挂、还留着上一次 ⌘⇧I 的值（3 之类）⇒ 重挂后的 picker 看到
+   // "openSeq(3) > lastOpenSeq(0)" ⇒ **切会话时菜单自己弹开**，悬在新会话的输入框上抢焦点——
+   // 正是那个 key 原本要防的症状（"模型搜索框还开着"）。
+   // 修法：首帧把基线对齐到当前 openSeq（此后只在它**真的前进**时开），语义不变：
+   // "seq 前进一次 = 开一次"，重挂不算前进。
+   const lastOpenSeq = useRef<number | null>(null);
+   useEffect(() => {
+     if (props.openSeq === undefined) return;
+     const step = nextOpenSeqState(lastOpenSeq.current, props.openSeq);
+     lastOpenSeq.current = step.baseline;
+     if (step.open && props.disabled !== true) setOpen(true);
+   }, [props.openSeq, props.disabled]);
+   const allOptions = flattenModels(props.infos);
+   const options = props.configuredProviders === undefined
+     ? allOptions
+     : allOptions.filter((o) => o.provider === null || props.configuredProviders!.has(o.provider));
+   const info = props.infos[0] ?? null;
+   const notice = pickerKeyNotice(info);
+   const level = props.thinking ?? "off";
+   const levelLabel = THINKING_LEVELS.find((l) => l.id === level)?.short ?? STR.modelPicker.thinkOff;
+
+   const close = useCallback(() => setOpen(false), []);
+   // 外点 / Esc 关闭：单源在 Popover（阶段 1 共享化；行为与旧内联监听逐条同构）。
+   usePopoverDismiss(open, close, box);
+
+   const pick = (registryId: string | null): void => {
+     props.onChange(registryId);
+     close();
+   };
+
+   return (
+     <div className="mp" ref={box}>
+       <button
+         type="button"
+         className="mp-trigger"
+         aria-label={STR.modelPicker.triggerAria}
+         aria-haspopup="listbox"
+         aria-expanded={open}
+         title={describeSelection(props.value, options)}
+         disabled={props.disabled}
+         onClick={() => { props.onUserOpen?.(); setOpen((v) => !v); }}
+       >
+         <span className="mp-name">
+           {shortModelName(props.value, options)}
+           {/* 「· 思考 X」段只在模型真声明支持时出现——没能力的模型不带这个按键面（业主 22.01 裁）。 */}
+           {props.onThinkingChange !== undefined && props.thinkingSupported === true
+             ? STR.modelPicker.thinkingChip.replace("{level}", levelLabel)
+             : ""}
+         </span>
+         {props.sessionOverride === true && <span className="mp-dot" aria-label={STR.modelPicker.sessionDotAria} />}
+         <span className="mp-caret" aria-hidden="true"><ChevronDown size={10} /></span>
+       </button>
+       {open && (
+         <ModelMenu
+           options={options}
+           value={props.value}
+           {...(props.disabled === true || props.running === true ? { running: true } : {})}
+           initialFocus={props.initialFocus ?? "model"}
+           keyNotice={notice}
+           {...(props.onOpenSettings !== undefined ? { onOpenSettings: props.onOpenSettings } : {})}
+           {...(props.onThinkingChange !== undefined
+             ? {
+                 thinking: level,
+                 thinkingSupported: props.thinkingSupported === true,
+                 onThinkingChange: props.onThinkingChange,
+               }
+             : {})}
+           onPick={pick}
+         />
+       )}
+     </div>
+   );
+ }
+
+ /** 菜单本体（P2-2 合并单面）：搜索 + 模型列表 + 下半区思考强度 Segmented。
+  *  纯展示、可服务端渲染。
+  *
+  *  判卷约束（render-structure.test.tsx 钉住的序列不许变形）：分组头 `>openai<`、
+  *  子行 `标准 · 窗口 128k`、勾 `class="check">✓<`、`⚠ OpenAI 未配置 key · 去设置配置`
+  *  （⚠ 字面量**豁免**于全局 emoji 清理）、空目录两串、aria-selected 计数、running disabled 计数；
+  *  思考段钉分段 aria-pressed / title 逐档说明 / 未声明整段禁用数。 */
+ export function ModelMenu(props: {
+   options: readonly ModelOption[];
+   value: string | null;
+   /** 运行中：模型列表整列禁用（规范「运行中 disabled」）；**思考强度不在此列**——
+    *  v7.2 业主裁：思考档是「下一轮派活」的旋钮，跑着也能拧（只随 capability 锁）。 */
+   running?: boolean;
+   /** key 未配置时的置顶提示行；undefined / null = 不显示。 */
+   keyNotice?: string | null;
+   onPick: (registryId: string | null) => void;
+   onOpenSettings?: () => void;
+   /** 当前思考档位（缺省 off）。 */
+   thinking?: string;
+   /** 当前模型是否**声明**支持思考档位；未声明 ⇒ 整区禁用 + 注记 + 配置折叠（fail-visible）。 */
+   thinkingSupported?: boolean;
+   onThinkingChange?: (level: string) => void;
+   /** 打开落点（2026-10-18）：effort = 首帧把焦点送进思考档分段（⌘⇧E）；
+    *  model = 保持搜索框 autofocus（⌘⇧I / 点击）。 */
+   initialFocus?: "model" | "effort";
+ }): React.JSX.Element {
+   const wantEffort = props.onThinkingChange !== undefined;
+   const [query, setQuery] = useState("");
+   const [hl, setHl] = useState(0);
+   const filtered = filterModelOptions(props.options, query);
+   const groups = groupModels(filtered);
+   const demoVisible = query.trim() === "";
+   const flat: ModelOption[] = [
+     ...groups.flatMap((g) => g.models),
+     ...(demoVisible ? [{ registryId: null, label: STR.modelPicker.demo, provider: null } as ModelOption] : []),
+   ];
+   const warn = props.keyNotice !== undefined && props.keyNotice !== null;
+   const modelsDisabled = props.running === true;
+   const supported = props.thinkingSupported === true;
+   const level = props.thinking ?? "off";
+   const currentLevel = THINKING_LEVELS.find((l) => l.id === level) ?? THINKING_LEVELS[0];
+   // ⌘⇧E 的落点（2026-10-18）：首帧滚到思考分段并聚焦当前档按钮；模型不声明思考时
+   // 分段整区禁用——聚焦分组本身（读屏仍报「思考强度，不可用」+ 下方说明），不静默。
+   const effortRef = useRef<HTMLDivElement | null>(null);
+   const searchRef = useRef<HTMLInputElement | null>(null);
+   useEffect(() => {
+     if (props.initialFocus !== "effort") { searchRef.current?.focus(); return; }
+     const box = effortRef.current;
+     if (box === null) return;
+     const target = box.querySelector<HTMLButtonElement>("button:not(:disabled)") ?? box;
+     target.focus({ preventScroll: true });
+     target.scrollIntoView({ block: "nearest" });
+   }, [props.initialFocus]);
+
+   const onKeyNav = (e: React.KeyboardEvent): void => {
+     // 蓝本 §3.6：在打开的列表里 1–9 选第 N 项。搜索框里的数字是**输入**不是选择——先让路。
+     if (/^[1-9]$/.test(e.key) && !(e.target instanceof HTMLInputElement)) {
+       const target = flat[Number(e.key) - 1];
+       if (target !== undefined) { e.preventDefault(); props.onPick(target.registryId); }
+       return;
+     }
+     if (e.key === "ArrowDown") { e.preventDefault(); setHl((h) => Math.min(h + 1, flat.length - 1)); }
+     else if (e.key === "ArrowUp") { e.preventDefault(); setHl((h) => Math.max(h - 1, 0)); }
+     else if (e.key === "Enter") {
+       const target = flat[hl];
+       if (target !== undefined) { e.preventDefault(); props.onPick(target.registryId); }
+     }
+   };
+
+   return (
+     <Popover open up className="mp-pop" role="listbox" aria-label={STR.modelPicker.menuAria} onKeyDown={onKeyNav}>
+       <div className="mp-search">
+         <input
+           ref={searchRef}
+           type="text"
+           aria-label={STR.modelPicker.searchAria}
+           placeholder={STR.modelPicker.searchPlaceholder}
+           value={query}
+           autoFocus
+           onChange={(e) => { setQuery(e.target.value); setHl(0); }}
+         />
+       </div>
+       {warn && (
+         <button type="button" className="menu-item mp-warn" onClick={() => props.onOpenSettings?.()}>
+           <span>⚠ {props.keyNotice}</span>
+           <span className="sub">{STR.modelPicker.goSettings}</span>
+         </button>
+       )}
+       {groups.map((g) => (
+         <div key={g.provider}>
+           <div className="mp-group-label">
+             {/* 分组圆点：中性灰（v7.1 业主裁——按 provider 名取色相是装饰性用色，会被误读成状态点）。 */}
+             <span className="g-dot" aria-hidden="true" />
+             <span>{g.provider}</span>
+           </div>
+           {g.models.map((m) => (
+             <button
+               key={m.registryId ?? "demo"}
+               type="button"
+               role="option"
+               aria-selected={m.registryId === props.value}
+               className="menu-item"
+               disabled={modelsDisabled}
+               onClick={() => props.onPick(m.registryId)}
+             >
+               <span className="mi-name">{m.label}</span>
+               <span className="sub">
+                 {STR.modelPicker.tierMeta.replace("{tier}", tierBadge(m.tier)).replace("{ctx}", formatCtxWindow(m.ctxWindow))}
+               </span>
+               {m.vision === true && <span className="v-badge" title={STR.modelPicker.visionTip}><Eye size={11} /></span>}
+               {m.registryId === props.value && <span className="check">✓</span>}
+             </button>
+           ))}
+         </div>
+       ))}
+       {groups.length === 0 && !demoVisible && (
+         <div className="pop-label">{STR.modelPicker.noMatch.replace("{q}", query.trim())}</div>
+       )}
+       {groups.length === 0 && demoVisible && (
+         <div className="pop-label">{STR.modelPicker.noModels}</div>
+       )}
+       {demoVisible && (
+         <button
+           type="button"
+           role="option"
+           aria-selected={props.value === null}
+           className="menu-item"
+           disabled={props.running === true}
+           // 行副文案放短词（长句在 300px 菜单里折成两行、行高翻倍）；完整免责句进 title 与触发条。
+           title={STR.modelPicker.demoTitle}
+           onClick={() => props.onPick(null)}
+         >
+           <span className="mi-name">{STR.modelPicker.demo}</span>
+           <span className="sub">{STR.modelPicker.demoSub}</span>
+           {props.value === null && <span className="check">✓</span>}
+         </button>
+       )}
+       {wantEffort && (
+         <>
+           <div className="menu-sep" />
+           {/* 运行中注记只在真有可调的东西时出现（未声明支持的模型不谎称「思考程度可调」）。 */}
+           {modelsDisabled && supported && <div className="menu-note">{STR.modelPicker.runningNote}</div>}
+           <div className="pop-label">{STR.modelPicker.effortLabel}</div>
+           <div className="th-row" role="group" aria-label={STR.modelPicker.effortGroupAria} ref={effortRef} tabIndex={-1} data-effort-anchor="true">
+             {THINKING_LEVELS.map((lv) => (
+               <button
+                 key={lv.id}
+                 type="button"
+                 data-e={lv.id}
+                 title={lv.hint}
+                 aria-pressed={level === lv.id}
+                 disabled={!supported}
+                 onClick={() => { props.onThinkingChange?.(lv.id); }}
+               >{lv.short}</button>
+             ))}
+           </div>
+           {supported ? (
+             <div className="th-hint">{currentLevel.hint}</div>
+           ) : (
+             <>
+               <div className="th-off" role="status">{STR.modelPicker.unsupportedNote}</div>
+               <details className="th-why">
+                 <summary className="th-info">
+                   <Info size={12} className="th-info-ico" aria-hidden="true" />
+                   <span>{STR.modelPicker.whySummary}</span>
+                   <span className="th-info-link">{STR.modelPicker.whyLink}</span>
+                 </summary>
+                 <div className="th-why-body">{STR.modelPicker.whyBody}</div>
+               </details>
+             </>
+           )}
+         </>
+       )}
+       {props.onOpenSettings !== undefined && (
+         <div className="mp-foot">
+           <button type="button" className="menu-item" onClick={() => props.onOpenSettings?.()}>
+             <Settings size={12} />
+             <span>{STR.modelPicker.manage}</span>
+           </button>
+         </div>
+       )}
+     </Popover>
+   );
+ }
+
+ // 新建项目 Dialog（brief 第四节）：居中弹窗，取代侧栏内联表单。
+ // 同屏三步：选模板（卡片网格，清单以现有 projectTemplates 为准）→ 填名字（实时校验）→ 选位置
+ // （默认 ~/Cairn Projects，「更改…」走系统选择器；显示「将创建在：」预览）。
+ // 全程零路径手输（原则 1）；文案走 STR。
+ import { useRef, useState } from "react";
+ import { Atom, BarChart3, ClipboardList, FolderPlus, LayoutTemplate, X } from "lucide-react";
+ import { STR } from "../strings";
+ import { ModalSurface } from "./ModalSurface";
+
+ export interface TemplateCard {
+   id: string;
+   name: string;
+   description: string;
+ }
+
+ /** 模板 → 图标（未知模板兜底 FolderPlus——不因模板目录扩项而空图标）。 */
+ function templateIcon(id: string): React.JSX.Element {
+   if (id === "static-site") return <LayoutTemplate size={16} />;
+   if (id === "form-widget") return <ClipboardList size={16} />;
+   if (id === "data-panel") return <BarChart3 size={16} />;
+   if (id === "react-vite") return <Atom size={16} />;
+   return <FolderPlus size={16} />;
+ }
+
+ /** 单选组键盘目标：方向键循环，Home/End 到首尾；其他键留给控件本身。 */
+ export function templateNavigationTarget(key: string, current: number, count: number): number | null {
+   if (count <= 0) return null;
+   const at = current >= 0 && current < count ? current : 0;
+   if (key === "ArrowRight" || key === "ArrowDown") return (at + 1) % count;
+   if (key === "ArrowLeft" || key === "ArrowUp") return (at - 1 + count) % count;
+   if (key === "Home") return 0;
+   if (key === "End") return count - 1;
+   return null;
+ }
+
+ /** 名字实时校验（纯判据内联；返回错误文案或 null）。 */
+ export function validateProjectName(name: string, existingNames: readonly string[]): string | null {
+   const trimmed = name.trim();
+   if (trimmed === "") return STR.newProject.nameEmpty;
+   if (/[\\/\u0000-\u001f]/.test(trimmed)) return STR.newProject.nameInvalid;
+   if (existingNames.includes(trimmed)) return STR.newProject.nameTaken;
+   return null;
+ }
+
+ export function NewProjectDialog(props: {
+   templates: readonly TemplateCard[];
+   /** 已在场项目名（重名校验）。 */
+   existingNames: readonly string[];
+   onClose: () => void;
+   onPickDirectory: () => Promise<string | null>;
+   /** 成功后由 App 关窗/刷新/聚焦输入框；reject ⇒ 错误行内 fail-visible。 */
+   onCreate: (input: { name: string; templateId: string; parentDir?: string }) => Promise<void>;
+ }): React.JSX.Element {
+   const [templateId, setTemplateId] = useState(props.templates[0]?.id ?? "");
+   const [name, setName] = useState("");
+   const [parentDir, setParentDir] = useState<string | null>(null);
+   const [busy, setBusy] = useState(false);
+   const [error, setError] = useState<string | null>(null);
+   const nameInput = useRef<HTMLInputElement | null>(null);
+   const nameError = validateProjectName(name, props.existingNames);
+   const showNameError = name.trim() !== "" && nameError !== null;
+   const previewParent = parentDir ?? STR.newProject.defaultParent;
+   return (
+     <div className="modal-backdrop" role="presentation" onClick={props.onClose}>
+       <ModalSurface
+         className="modal-card modal-wide"
+         label={STR.newProject.title}
+         onClose={props.onClose}
+         initialFocusRef={nameInput}
+         onClick={(e) => { e.stopPropagation(); }}
+       >
+         <div className="modal-head">
+           <span>{STR.newProject.title}</span>
+           <button className="iconbtn sm" aria-label={STR.common.cancel} title={STR.common.cancel} onClick={props.onClose}>
+             <X size={13} />
+           </button>
+         </div>
+
+         <div className="modal-field">
+           <span>{STR.newProject.templateLabel}</span>
+           <div className="tpl-grid" role="radiogroup" aria-label={STR.newProject.templateLabel}>
+             {props.templates.map((t) => (
+               <button
+                 key={t.id}
+                 type="button"
+                 className="tpl-card"
+                 role="radio"
+                 aria-checked={templateId === t.id}
+                 tabIndex={templateId === t.id ? 0 : -1}
+                 data-on={templateId === t.id}
+                 title={t.description}
+                 onClick={() => { setTemplateId(t.id); }}
+                 onKeyDown={(e) => {
+                   const current = props.templates.findIndex((template) => template.id === templateId);
+                   const next = templateNavigationTarget(e.key, current, props.templates.length);
+                   if (next === null) return;
+                   const target = props.templates[next];
+                   if (target === undefined) return;
+                   e.preventDefault();
+                   setTemplateId(target.id);
+                   e.currentTarget.parentElement
+                     ?.querySelectorAll<HTMLButtonElement>('[role="radio"]')
+                     [next]?.focus();
+                 }}
+               >
+                 <span className="tpl-ico" aria-hidden="true">{templateIcon(t.id)}</span>
+                 <span className="tpl-name">{t.name}</span>
+                 <span className="tpl-desc">{t.description}</span>
+               </button>
+             ))}
+           </div>
+         </div>
+
+         <label className="modal-field">
+           <span>{STR.newProject.nameLabel}</span>
+           <input
+             ref={nameInput}
+             aria-label={STR.newProject.nameLabel}
+             placeholder={STR.newProject.namePlaceholder}
+             value={name}
+             onChange={(e) => { setName(e.target.value); setError(null); }}
+           />
+           {showNameError && <span className="form-error" role="alert">{nameError}</span>}
+         </label>
+
+         <div className="modal-field">
+           <span>{STR.newProject.locationLabel}</span>
+           <div className="modal-row">
+             <code className="modal-path" title={previewParent}>{previewParent}</code>
+             <button
+               type="button"
+               className="mini-btn"
+               title={STR.newProject.locationHint}
+               onClick={() => {
+                 void props.onPickDirectory().then((picked) => { if (picked !== null) setParentDir(picked); });
+               }}
+             >
+               {STR.newProject.locationChange}
+             </button>
+           </div>
+           <span className="sp-dim">{STR.newProject.locationHint}</span>
+           <span className="sp-dim">{STR.newProject.preview.replace("{path}", `${previewParent}/${name.trim() !== "" ? name.trim() : "…"}`)}</span>
+         </div>
+
+         {error !== null && <div className="form-error" role="alert">{error}</div>}
+         <div className="modal-foot">
+           <button className="mini-btn" title={STR.common.cancel} onClick={props.onClose}>{STR.common.cancel}</button>
+           <button
+             className="mini-btn primary"
+             title={STR.newProject.title}
+             disabled={busy || nameError !== null || templateId === ""}
+             onClick={() => {
+               const trimmed = name.trim();
+               const invalid = validateProjectName(trimmed, props.existingNames);
+               if (invalid !== null) { setError(invalid); return; }
+               setBusy(true);
+               setError(null);
+               void props.onCreate({
+                 name: trimmed,
+                 templateId,
+                 ...(parentDir !== null ? { parentDir } : {}),
+               }).then(
+                 () => { props.onClose(); },
+                 (err: unknown) => { setError(STR.newProject.failed.replace("{reason}", err instanceof Error ? err.message : String(err))); setBusy(false); },
+               );
+             }}
+           >
+             {busy ? STR.common.creating : STR.common.create}
+           </button>
+         </div>
+       </ModalSurface>
+     </div>
+   );
+ }
+
+ // 首启空屏的「设置检查」：七组覆盖面**来自主进程**（唯一事实源 `src/main/onboarding-groups.ts`），
+ // 渲染层不抄那份清单——只把它按步号摆开，并给出到设置页的入口。
+ //
+ // 为什么是「检查」而不是「向导」：向导要记进度、要能跳过、要有下一步按钮；本仓的首启面是一屏空态，
+ // 用户要的是「我该看哪几格」——四行步号，七格都有落点。做得比需要的多，就是噪音。
+ //
+ // 纪律：组 id → 设置分区是**唯一一份**映射（七组全有落点 ⇒ 没有一格是「点不动的死行」）。
+ // 清单本身由服务端给，渲染层只负责排版与导航——抄一份清单就多一份会各自漂的决策点。
+ import type { OnboardingGroup } from "../../../../../src/main/onboarding-groups";
+ import type { SectionId } from "../app-controls";
+ import { STR } from "../strings";
+
+ /** 组 id → 设置分区。**七组全有落点**：没有落点的那一格会被读成「点不动」，
+  * 而「点不动」比「不列它」更糟——用户以为坏了。 */
+ export const ONBOARDING_TARGET: Readonly<Record<OnboardingGroup["id"], SectionId>> = {
+   provider: "provider",
+   permission: "permissions",
+   ui: "general",
+   schedule: "automation",
+   memory: "memory",
+   telemetry: "advanced",
+   about: "about",
+ };
+
+ /** 按步号摆开（步号域是 1..4，服务端给的事实；这里只排版）。 */
+ export function groupByStep(
+   groups: readonly OnboardingGroup[],
+ ): { step: number; groups: OnboardingGroup[] }[] {
+   const byStep = new Map<number, OnboardingGroup[]>();
+   for (const g of groups) {
+     byStep.set(g.step, [...(byStep.get(g.step) ?? []), g]);
+   }
+   return [...byStep.entries()]
+     .sort((a, b) => a[0] - b[0])
+     .map(([step, items]) => ({ step, groups: items }));
+ }
+
+ /** 这一组的落点分区；**没有落点就返回 undefined**。
