+       props.onSettingsSaved?.();
+     } catch (err) {
+       setError(`key 删除失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   };
+
+   const runCheck = () => {
+     setCheckMsg({ tone: "wait", text: `正在检查 ${keyProvider} 连接…` });
