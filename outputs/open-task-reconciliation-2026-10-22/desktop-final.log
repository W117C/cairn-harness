+           </SettingsRow>
+         ) : (
+           <SettingsRow label="状态" desc={visionCapabilityLabel(props.cap)}>
+             <span className="sp-tag">{props.cap.vision.state === "declared" ? "已声明" : "未验证"}</span>
+           </SettingsRow>
+         )}
+       </SettingsSection>
+     </>
+   );
+ }
