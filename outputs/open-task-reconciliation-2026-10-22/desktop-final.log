+     setInjectedText,
+     setInjectedTextSeq,
+     draftRemap,
+     draftRemapSeq,
+     setDraftRemap,
+     draftRestore,
+     draftRestoreSeq,
+     setDraftRestore,
+     draftIds,
+     noteDraft,
+     editCtx,
+     editCtxRef,
+     setEditCtx,
+     injectedAttachment,
+     attachFromPane,
+     pickSignal,
+     setPickSignal,
+     injectedAppend,
+     handlePickResult,
+     composerMenuSignal,
+     openComposerMenu,
