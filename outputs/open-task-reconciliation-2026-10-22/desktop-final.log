+       <div className="ol-head">
+         <span className="ol-title">对话目录</span>
+         <button className="iconbtn sm" aria-label="关闭目录" onClick={props.onClose}><X size={12} /></button>
+       </div>
+       <button className="ol-fold" onClick={props.onToggleAllFold}>
