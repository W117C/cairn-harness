+           <input
+             ref={cloneInput}
+             aria-label={STR.addProject.cloneUrlLabel}
+             placeholder={STR.addProject.cloneUrlPlaceholder}
+             value={cloneUrl}
+             onChange={(e) => { setCloneUrl(e.target.value); }}
+           />
+           <div className="clone-row">
+             <button
+               type="button"
+               className="mini-btn"
