+         {r.artifact !== undefined && props.onOpenArtifact !== undefined && (
+           <div className="kv">
+             <span className="k">产物</span>
+             <div className="artifact-actions">
+               <button className="mini-btn" onClick={() => props.onOpenArtifact!(r.artifact!)}>
