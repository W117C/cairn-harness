+ const FENCE = /^\s*```(.*)$/;
+ const HEADING = /^ {0,3}(#{1,4})\s+(.+?)\s*#*\s*$/;
+ const HR = /^ {0,3}(?:-{3,}|\*{3,}|_{3,})\s*$/;
+ const UL = /^ {0,3}[-*+]\s+(.+)$/;
+ const OL = /^ {0,3}\d{1,9}[.)]\s+(.+)$/;
+ const QUOTE = /^ {0,3}>\s?(.*)$/;
