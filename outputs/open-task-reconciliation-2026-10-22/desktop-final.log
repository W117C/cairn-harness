+       props.onSettingsSaved?.();
+     } catch (err) {
+       setError(`key 保存失败：${err instanceof Error ? err.message : String(err)}`);
+     } finally {
+       setBusy(false);
+     }
+   };
+
+   const deleteKey = async (provider: string) => {
+     setError(null);
