+     setUpdate((prev) => withOpenError(prev, message));
+   };
+
+   // 「更新」行的文案（读数的唯一出口；措辞与旧实现逐字不变）。
+   const updateMsg =
+     update.kind === "idle" ? null
+     : update.kind === "checking" ? "检查中…"
+     : update.kind === "unconfigured" ? "未配置更新端点"
