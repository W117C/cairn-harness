+ // 文案全出处 STR（本文件零裸中文）；副作用全在 App（send/cancel/setSettings/compact）。
+ import { useCallback, useEffect, useRef, useState } from "react";
+ import { toast } from "../toast";
+ import { relInWorkspace } from "../workspace-rel";
