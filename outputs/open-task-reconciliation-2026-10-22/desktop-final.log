+     rows: [
+       { keys: "⌘\\", what: "关闭最近打开的窗格" },
+       ...PANE_SHORTCUTS.map((s) => ({ keys: s.keys, what: s.what })),
+       { keys: "⌘⇧S", what: "浏览器：选择页面元素（结果进输入框）" },
+     ],
+   },
+   {
+     title: "视图与输入",
+     rows: [
+       { keys: "Ctrl+O", what: "循环视图：Normal / Thinking / Verbose" },
+       { keys: "⌘⇧I", what: "模型菜单（含思考档）" },
