+       </Command.List>
+       {/* 键盘可发现性（Claude 形制）：↑↓ 选择 / ⏎ 打开 / esc 关闭。纯提示，不进 a11y 树。 */}
+       <div className="cp-foot" aria-hidden="true">
+         <span><kbd>↑</kbd> <kbd>↓</kbd> 选择</span>
+         <span><kbd>⏎</kbd> 打开</span>
+         <span className="cp-foot-hint"><kbd>esc</kbd> 关闭</span>
+       </div>
+     </>
+   );
+ }
