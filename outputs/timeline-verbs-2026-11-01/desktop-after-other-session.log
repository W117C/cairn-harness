+
+       <SettingsSection title="快环提醒" hint="Episode 证据">
+         <SettingsRow label={`${String(report.nudges.episodes)} 场 · ${String(report.nudges.ids)} 条经验`}>
+           <Badge tone={report.nudges.episodes === 0 ? "neutral" : "ok"}>
