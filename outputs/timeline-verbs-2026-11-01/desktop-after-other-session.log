+
+   // 会话循环（§3.6：⌘⇧] / ⌘⇧[，以及可关的 Ctrl+Tab）。返回是否真的切了——
+   // 快捷键层据此决定「消费按键」还是「给一句回执」，不再出现空列表时静默吞键。
+   const cycleSession = useCallback((dir: 1 | -1): boolean => {
+     const list = sessions;
+     if (list.length === 0) return false;
+     const i = list.findIndex((s) => s.id === activeId && s.workspace === activeWorkspaceRef.current);
+     const idx = i < 0 ? (dir === 1 ? 0 : list.length - 1) : (i + dir + list.length) % list.length;
+     const target = list[idx];
+     if (target === undefined) return false;
+     openSession(target.id, target.workspace);
+     return true;
+   }, [sessions, activeId, activeWorkspaceRef, openSession]);
+   /** 切换会话（键位双入口与菜单共用一处出口）：无会话时给回执——静默无响应会被读成「键坏了」。
+    *  这条回执此前在三个键位里各抄一份；菜单再抄两份就是五份，改口径时必然漏。 */
+   const cycleSessionOrToast = useCallback((dir: 1 | -1): void => {
+     if (!cycleSession(dir)) toast(STR.shortcut.noSession);
+   }, [cycleSession]);
+   /** 关闭当前会话回主页（⌘W 与菜单「关闭会话」同一出口）：主页按 = 可见回执；
+    *  在跑的一轮回主页后仍在后台，也要说清楚（否则用户以为它被关掉了）。 */
+   const closeSessionToHome = useCallback((): void => {
+     const sid = activeIdRef.current;
+     if (sid !== null) {
+       const wasRunning = runningSet.current.has(runKey(activeWorkspaceRef.current, sid));
+       newSession();
+       if (wasRunning) toast(STR.shortcut.leftRunning);
+     } else {
+       toast(STR.shortcut.alreadyHome);
+     }
+   }, [newSession]);
+
+   // 行级会话操作（蓝本 §2.1）：重命名 / 置顶 / 分叉 / 归档——通道已存在，这里只做编排与 fail-visible。
+   const renameSessionById = useCallback(async (id: string, name: string) => {
+     try {
+       const r = await window.agent.renameSession(id, name);
+       if (activeIdRef.current === id) {
+         if (r.id !== id) setDraftRemap({ from: id, to: r.id, seq: ++draftRemapSeq.current });
+         activate(r.id); // 改名换 id：当前会话与新 id 同步（含 ref）
+       }
+       void refreshSessions();
+     } catch (err) {
+       setLastError(`重命名失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   }, [refreshSessions, activate]);
+   const pinSessionById = useCallback(async (id: string, pinned: boolean) => {
+     try {
+       await window.agent.setSessionPinned(id, pinned);
+       void refreshSessions();
+     } catch (err) {
+       setLastError(`置顶失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   }, [refreshSessions]);
+   /** 对话菜单「分叉…」（第十四遍对齐原型 v3-lite 五项菜单）：全量分叉——round=0 是 desktop 侧
+    *  「保留到最后一轮」的哨兵（main 按实际轮数命名 <id>-f<总>，与 CLI --from <总> 同源）；
+    *  分叉成功即切过去继续干活。这里走 openSession 而非动作条的裸 activate：菜单能分**非当前**会话，
+    *  只切 activeId 会把上一个会话的流留在屏上（显示与会话错位）；openSession = 切 + 载转录 + 载队列。 */
+   const forkSessionFromMenu = useCallback(async (s: WorkspaceSession) => {
+     try {
+       const r = await window.agent.forkSession(s.id, 0, true);
+       if (r.ok !== true || r.id === undefined) {
+         setLastError(`分叉失败：${r.error ?? "未知原因"}`, s.id);
+         return;
+       }
+       void refreshSessions();
+       openSession(r.id);
+     } catch (err) {
+       setLastError(`分叉失败：${err instanceof Error ? err.message : String(err)}`, s.id);
+     }
+   }, [refreshSessions, openSession]);
+   /** 跨面接力（规范 §3.9 · 必抄 #6）：桌面与 CLI 是**同一个 sessions 存储的两个面**。
+    *  这里给出等价命令并复制到剪贴板——不假装能拉起终端（桌面没有那条通道，设了就是占位）。
+    *  反向那一面由 CLI 收尾时打印「在桌面打开：<id>」接回来。 */
+   const openSessionInCli = useCallback((s: WorkspaceSession) => {
+     const cmd = `cairn --session ${s.id}`;
+     void navigator.clipboard.writeText(cmd).then(
+       () => { setLastNotice(`已复制：${cmd}——在终端粘贴后续跑（CLI 还需要一句任务描述）`); },
+       (err: unknown) => { setLastError(`复制失败：${err instanceof Error ? err.message : String(err)}`); },
+     );
+   }, []);
+   /** 会话级 worktree 隔离（§3.7 · G4）：三个动作共用一条 IPC。成功/失败都落到流尾那一行——
+    *  隔离标记由 listSessions 读侧现算，所以动完必须刷新清单，否则菜单文案还是旧的。 */
+   const sessionWorktreeOp = useCallback(async (kind: "create" | "merge" | "discard", s: WorkspaceSession) => {
+     try {
+       const r = await window.agent.sessionWorktree(
+         kind === "create" ? { kind, sessionId: s.id, ...(s.title !== undefined ? { title: s.title } : {}) } : { kind, sessionId: s.id },
+       );
+       if (!r.ok) {
+         // 冲突单独说：主 checkout 已被 abort 回干净态，用户的活还在隔离树里，不是丢了。
+         setLastError(
+           r.conflict === true
+             ? `合并冲突：${(r.conflictedFiles ?? []).join("、")}——主工作区已恢复干净态，改动仍在隔离工作区里`
+             : `${kind === "create" ? "隔离" : kind === "merge" ? "合并" : "丢弃"}失败：${r.error ?? "未知原因"}`,
+           s.id,
+         );
+         void refreshSessions();
+         return;
+       }
+       setLastNotice(
+         kind === "create"
+           ? `已隔离：下一条消息起写在这条会话自己的隔离工作区里${r.path !== undefined ? `（${r.path}）` : ""}`
+           : kind === "merge"
+             ? `已合并回主工作区${r.branch !== undefined ? `（${r.branch}）` : ""}`
+             : "隔离工作区已丢弃",
+         s.id,
+       );
+       if (r.warnings !== undefined && r.warnings.length > 0) setLastNotice(`隔离已建成，但有降级：${r.warnings.join("；")}`, s.id);
+       void refreshSessions();
+     } catch (err) {
+       setLastError(`隔离工作区操作失败：${err instanceof Error ? err.message : String(err)}`, s.id);
+     }
+   }, [refreshSessions, setLastError, setLastNotice]);
+   const doArchiveSession = useCallback(async (id: string, archived: boolean) => {
+     try {
+       await window.agent.setSessionArchived(id, archived);
+       if (archived && activeIdRef.current === id) newSession(); // 归档的是当前会话 ⇒ 回主页
+       void refreshSessions();
+     } catch (err) {
+       setLastError(`归档失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   }, [refreshSessions, newSession]);
+   /** 归档必问（§3.3 硬闸：「归档任何会话前必问」，与权限档无关）；取消归档不问。
+    *  在跑的会话照样能归档（可逆），但确认卡要前置「本轮继续在后台跑」——不把运行藏起来。 */
+   const requestArchiveSession = useCallback((s: WorkspaceSession, archived: boolean) => {
+     if (!archived) { void doArchiveSession(s.id, false); return; }
+     setArchiveConfirm(runningSet.current.has(runKey(s.workspace, s.id)) ? { ...s, running: true } : s);
+   }, [doArchiveSession, runningSet, setArchiveConfirm]);
+   // §6.3 删除会话：必问（不可撤销）→ 真删；删的是当前会话 ⇒ 回 settings.currentSession 指定的最近一个（core 已回退），无则回主页。
+   // 运行中的会话：确认卡先说「停止并删除」，执行时先取消本轮——核心对在跑会话有硬闸（会话正在运行，
+   // 先停止再删除），取消到锁释放是异步的，锁错误只在预算内重试，不把一次「还在退场」报成删除失败。
+   const requestDeleteSession = useCallback((s: WorkspaceSession) => {
+     setDeleteConfirm(runningSet.current.has(runKey(s.workspace, s.id)) ? { ...s, running: true } : s);
+   }, [setDeleteConfirm, runningSet]);
+   const doDeleteSession = useCallback(async (id: string, target?: WorkspaceSession) => {
+     const workspace = target?.workspace ?? (activeIdRef.current === id ? activeWorkspaceRef.current : null);
+     const key = runKey(workspace, id);
+     let wasRunning = runningSet.current.has(key);
+     if (wasRunning && !(await stopRunForDelete(id, workspace))) {
+       runningSet.current.delete(key); // 主进程没有活动 run：陈旧旗先摘，不把「已停」当事实
+       wasRunning = false;
+     }
+     try {
+       // 只有本窗口确实发起过停止才等锁释放；没停就忙 = 别的进程在跑，立即如实报错。
+       const res = wasRunning ? await deleteSessionWaitingForRun(endSessionDelete, id) : await endSessionDelete(id);
+       runningSet.current.delete(key);
+       if (activeIdRef.current === id) {
+         if (res.currentSession === null) newSession();
+         else openSession(res.currentSession);
+       }
+       void refreshSessions();
+     } catch (err) {
+       setLastError(`删除失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   }, [activeIdRef, activeWorkspaceRef, openSession, newSession, refreshSessions, runningSet, setLastError]);
+
+   return {
+     newSession,
+     newSessionRef,
+     cycleSession,
+     cycleSessionOrToast,
+     closeSessionToHome,
+     renameSessionById,
+     pinSessionById,
+     forkSessionFromMenu,
+     openSessionInCli,
+     sessionWorktreeOp,
+     doArchiveSession,
+     requestArchiveSession,
+     requestDeleteSession,
+     doDeleteSession,
+   };
+ }
+
+ // 侧栏密度（2026-10-31，R3）：参考库 28px 高密行。
+ // 视图偏好，落 localStorage；坏档回舒适，不打断侧栏。
+ export type SidebarDensity = "comfortable" | "compact";
+ export const SIDEBAR_DENSITY_KEY = "cairn.sidebar.density.v1";
+
+ export function parseSidebarDensity(raw: string | null): SidebarDensity {
+   return raw === "compact" ? "compact" : "comfortable";
+ }
+
+ // 思考档位的「本机可选面」（2026-10-31 · 业主：档位有多少种、用户可以自己定义，
+ // 但默认应当来自上游声明）。
+ //
+ // 边界（诚实第一）：本模块**只决定选择器里露哪几档**，不伪造能力。
+ // 「能不能发」仍由 core 的 ProviderCapability.thinking.values 决定（上游 /models 自述、
+ // 内置 registry 声明或 .agent/providers.json 的 reasoningEfforts）；这里永远只做减法：
+ // 用户可以把不想看到的档收起来，不能把上游没声明的档变出来。要加档，去供应商配置里声明。
+ //
+ // 持久化是渲染层偏好（localStorage，与侧栏密度同一档）：不跨窗口同步、不改事件日志。
+ // 存「隐藏了哪些」而不是「启用了哪些」——上游将来多声明一档时，默认仍然露出来。
+ const KEY = "cairn.thinking.hidden.v1";
+
+ /** modelId → 被用户收起的档位 id。 */
+ export type ThinkingHiddenMap = Readonly<Record<string, readonly string[]>>;
+
+ function isStringArray(value: unknown): value is string[] {
+   return Array.isArray(value) && value.every((item) => typeof item === "string" && item.trim() !== "");
+ }
+
+ /** 坏档回空：解析失败不当成「全部隐藏」，否则一次坏 localStorage 会让所有模型只剩「关」。 */
+ export function parseThinkingHidden(raw: string | null): ThinkingHiddenMap {
+   if (raw === null || raw.trim() === "") return {};
+   try {
+     const parsed: unknown = JSON.parse(raw);
+     if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) return {};
+     const out: Record<string, readonly string[]> = {};
+     for (const [modelId, value] of Object.entries(parsed as Record<string, unknown>)) {
+       if (!isStringArray(value)) continue;
+       const unique = [...new Set(value.map((v) => v.trim()))];
+       if (unique.length > 0) out[modelId] = unique;
+     }
+     return out;
+   } catch {
+     return {};
+   }
+ }
+
+ export function serializeThinkingHidden(map: ThinkingHiddenMap): string {
+   return JSON.stringify(map);
+ }
+
+ /** 某一档能不能被用户收起。「off」永远保留——关掉思考是保底动作，不能被配置藏掉。 */
+ export function canHideThinkingLevel(id: string): boolean {
+   return id !== "off";
+ }
+
+ /** 选择器里真正露出的档位：声明顺序不变，去掉用户收起的；off 恒在首位（若上游/内置给了）。 */
+ export function visibleThinkingLevels(declared: readonly string[], hidden: readonly string[] | undefined): string[] {
+   const hiddenSet = new Set(hidden ?? []);
+   const out: string[] = [];
+   for (const id of declared) {
+     if (id === "off") out.push(id);
+     else if (!hiddenSet.has(id)) out.push(id);
+   }
+   // 上游只声明了 off（或空表）时仍给 off：选择器不能出现空段。
+   if (!out.includes("off")) out.unshift("off");
+   return out;
+ }
+
+ /** 收起/恢复一档。非法 id（off 或不在声明表里）原样返回——不猜、不夹紧。 */
+ export function toggleThinkingHidden(hidden: readonly string[], id: string, declared: readonly string[]): string[] {
+   if (!canHideThinkingLevel(id) || !declared.includes(id)) return [...hidden];
+   const set = new Set(hidden);
+   if (set.has(id)) set.delete(id);
+   else set.add(id);
+   return declared.filter((level) => level !== "off" && set.has(level));
+ }
+
+ /** 收起后当前档位若被藏起来，落到哪一档：优先模型缺省，其次第一个可见的非 off，最后 off。 */
+ export function reconcileVisibleLevel(
+   current: string,
+   visible: readonly string[],
+   modelDefault: string | undefined,
+ ): string {
+   if (visible.includes(current)) return current;
+   if (modelDefault !== undefined && visible.includes(modelDefault)) return modelDefault;
+   return visible.find((id) => id !== "off") ?? "off";
+ }
+
+ /** 读当前档案（浏览器外/坏档一律回空）。 */
+ export function readThinkingHidden(): ThinkingHiddenMap {
+   if (typeof localStorage === "undefined") return {};
+   return parseThinkingHidden(localStorage.getItem(KEY));
+ }
+
+ export function writeThinkingHidden(map: ThinkingHiddenMap): void {
+   if (typeof localStorage === "undefined") return;
+   localStorage.setItem(KEY, serializeThinkingHidden(map));
+ }
+
+ export const THINKING_HIDDEN_KEY = KEY;
+
+ // 思考档位的「会话内选择」与「首条消息前选择」的唯一映射处（2026-10-22）。
+ //
+ // 病灶（真机复现）：空屏（activeId === null）上的模型芯片照样显示「· 思考 关」并可拨，
+ // 但 WorkbenchView 的 onThinkingChange 在 activeId === null 时直接 return —— 拨完既没有状态、
+ // 也没有任何提示；用户以为「这一轮用强思考」，第一条消息实际按 off 发出去。控件看着是活的，
+ // 数据没动，这是本仓最忌的「装饰性按钮」。
+ //
+ // 修法：空屏上的选择落进 `pendingThinking`（下一条新会话的起点），建会话时由
+ // `seedNewSessionThinking` 写进按会话的 map；界面读 `composerThinking`（显式选择 > 缺省 off）。
+ // 三条规则都是纯函数，判卷不依赖 React 渲染。
+ import type { ThinkingEffort } from "../../../../../src/providers/capabilities";
+ import { runKey } from "./session-identity";
+
+ const LEVELS: readonly ThinkingEffort[] = ["off", "low", "medium", "high", "max"];
+
+ export function isThinkingEffort(value: unknown): value is ThinkingEffort {
+   return typeof value === "string" && (LEVELS as readonly string[]).includes(value);
+ }
+
+ /** 芯片显示哪一档：空屏读「下一条新会话」的待用值；会话内读该会话的显式选择。 */
+ export function composerThinking(
+   activeId: string | null,
+   pending: ThinkingEffort,
+   bySession: ReadonlyMap<string, string>,
+   workspace?: string | null,
+ ): ThinkingEffort {
+   if (activeId === null) return pending;
+   const stored = bySession.get(runKey(workspace, activeId));
+   return isThinkingEffort(stored) ? stored : "off";
+ }
+
+ export type ThinkingChange =
+   | { kind: "pending"; level: ThinkingEffort }
+   | { kind: "session"; sessionId: string; level: ThinkingEffort };
+
+ /** 拨一下之后该改哪一格：空屏改 pending，会话内改该会话。非法档位 ⇒ null（不猜、不夹紧）。 */
+ export function thinkingChangeTarget(activeId: string | null, level: unknown): ThinkingChange | null {
+   if (!isThinkingEffort(level)) return null;
+   return activeId === null
+     ? { kind: "pending", level }
+     : { kind: "session", sessionId: activeId, level };
+ }
+
+ /** 新会话落成时把待用档位写进按会话的 map。off 不写（缺省本来就不发参数，少一条脏数据）。 */
+ export function seedNewSessionThinking(
+   sessionId: string,
+   pending: ThinkingEffort,
+   bySession: Map<string, string>,
+   workspace?: string | null,
+ ): void {
+   if (pending === "off") return;
+   bySession.set(runKey(workspace, sessionId), pending);
+ }
+
+ // 启动时轻量检查更新（2026-10-30 · 第 810 页）。
+ //
+ // 设置页的「检查更新」一直只在用户主动点时才跑；更新源配好的人也要先想起去点。
+ // 这里在启动时补一次：有 updateManifestUrl 才查，24 小时最多一次，发现新版本用全局 notice 说出来。
+ // 不下载、不安装，也不把「检查失败」当错误弹窗——手动检查才是详细错误面的入口。
+ import { useEffect, useSyncExternalStore } from "react";
+ import type { AgentApi } from "../../../../../src/main/ipc-protocol";
+
+ type UpdateCheckResult = Awaited<ReturnType<AgentApi["checkUpdate"]>>;
+
+ export const UPDATE_CHECK_STORAGE_KEY = "cairn.update-check.v1";
+ export const UPDATE_CHECK_INTERVAL_MS = 24 * 60 * 60 * 1000;
+
+ /** 上次检查为空/非数/超过 24h（或时钟倒退）⇒ 该查；23h 内不重复打扰。 */
+ export function shouldCheckForUpdate(lastCheckedAt: number | null, now: number): boolean {
+   if (lastCheckedAt === null || !Number.isFinite(lastCheckedAt)) return true;
+   if (now < lastCheckedAt) return true;
+   return now - lastCheckedAt >= UPDATE_CHECK_INTERVAL_MS;
+ }
+
+ export interface AvailableUpdate {
+   version: string;
+   url: string;
+   notes?: string;
+ }
+
+ /** 全局可用更新：notice 会随会话走，头像上的点不会——两处读同一个 store。 */
+ let availableUpdate: AvailableUpdate | null = null;
+ const updateListeners = new Set<() => void>();
+
+ export function getAvailableUpdate(): AvailableUpdate | null {
+   return availableUpdate;
+ }
+
+ export function setAvailableUpdate(next: AvailableUpdate | null): void {
+   availableUpdate = next;
+   for (const listener of updateListeners) listener();
+ }
+
+ function subscribeAvailableUpdate(listener: () => void): () => void {
+   updateListeners.add(listener);
+   return () => { updateListeners.delete(listener); };
+ }
+
+ /** 侧栏头像红点读这个；SSR 固定 null（服务端没有更新检查）。 */
+ export function useAvailableUpdate(): AvailableUpdate | null {
+   return useSyncExternalStore(subscribeAvailableUpdate, getAvailableUpdate, () => null);
+ }
+
+ /** 只有「有可用新版本」才值得打扰；未配置/已最新/出错都静默（详细面在设置页）。 */
+ export function updateNoticeText(result: UpdateCheckResult): string | null {
+   if (result.state !== "available") return null;
+   return `发现新版本 ${result.version}——到「设置 → 关于与更新」查看`;
+ }
+
+ function readLastCheck(): number | null {
+   try {
+     const raw = localStorage.getItem(UPDATE_CHECK_STORAGE_KEY);
+     if (raw === null) return null;
+     const n = Number(raw);
+     return Number.isFinite(n) ? n : null;
+   } catch {
+     return null;
+   }
+ }
+
+ function writeLastCheck(now: number): void {
+   try { localStorage.setItem(UPDATE_CHECK_STORAGE_KEY, String(now)); } catch { /* 隐私模式写不了：下次再查，不阻断 */ }
+ }
+
+ /** 启动检查：读设置 → 节流 → checkUpdate → 有更新才 notify。 */
+ export function useUpdateNotice(notify: (message: string) => void): void {
+   useEffect(() => {
+     let alive = true;
+     const now = Date.now();
+     if (!shouldCheckForUpdate(readLastCheck(), now)) return;
+     void (async () => {
+       const settings = await window.agent.getSettings().catch(() => null);
+       if (!alive || settings === null) return;
+       if ((settings.updateManifestUrl ?? "").trim() === "") return;
+       writeLastCheck(now);
+       const result = await window.agent.checkUpdate().catch(() => null);
+       if (!alive || result === null) return;
+       if (result.state === "available") {
+         setAvailableUpdate({
+           version: result.version,
+           url: result.url,
+           ...(result.notes !== undefined ? { notes: result.notes } : {}),
+         });
+         notify(updateNoticeText(result) as string);
+       }
+     })();
+     return () => { alive = false; };
+   }, [notify]);
+ }
