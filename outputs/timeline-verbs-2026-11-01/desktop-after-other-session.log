+ import type { MemorySnapshot } from "../../../../../src/main/ipc-protocol";
+ import type { AutomationDefinition, AutomationSchedule } from "../../../../../src/main/automations";
+ import type { ScheduleSnapshot, HistoryEntry } from "../../../../../src/main/scheduler";
