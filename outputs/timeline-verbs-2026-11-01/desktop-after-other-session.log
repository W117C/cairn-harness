+                 className="menu-item"
+                 role="menuitem"
+                 onClick={() => { setMenu("none"); pasteFromClipboard(); }}
+               >
+                 <span>{STR.composer.attachPaste}</span><span className="sub">{STR.composer.attachPasteSub}</span>
+               </button>
+               {/* 引用最近文件：本会话已引用历史（空 = disabled + tooltip 说明，不摆空壳）。 */}
+               <button
+                 className="menu-item"
+                 role="menuitem"
+                 disabled={recentRefs.length === 0}
+                 title={recentRefs.length === 0 ? STR.composer.attachRecentEmpty : undefined}
+                 onClick={() => setRecentOpen((v) => !v)}
+               >
+                 <span>{STR.composer.attachRecent}</span>
+                 <span className="sub">{String(recentRefs.length)}</span>
+                 <span className="ac-chev" aria-hidden="true"><ChevronRight size={11} /></span>
+               </button>
+               {recentOpen && recentRefs.map((p) => (
+                 <button
+                   key={p}
+                   className="menu-item ac-recent"
+                   role="menuitem"
+                   title={p}
+                   onClick={() => { addAttachment({ path: p, kind: "file", explicit: true, outside: !inWorkspace(p) }); }}
+                 >
+                   <span className="mi-ico" aria-hidden="true">{fileIconKind(p) === "image" ? <ImageIcon size={12} /> : <FileText size={12} />}</span>
+                   <span>{baseNameOf(p)}</span>
+                 </button>
+               ))}
+             </Popover>
+           </div>
+           {/* 权限 chip + 菜单同一相对容器（2026-10-17）：菜单原先是 chip 的兄弟节点，锚到 composer
+               卡左缘、外点/Esc 也无归属；包一层后锚到 chip、dismiss 有落点。 */}
+           <div style={{ position: "relative", display: "inline-flex" }} ref={permWrapRef} onKeyDown={permKeys}>
+             <button
+               className="ctl"
+               aria-haspopup="menu"
+               aria-expanded={menu === "perm"}
+               onClick={() => setPermOpen(menu !== "perm")}
+               disabled={disabled || props.running}
+             >
+               {/* 触发器只留「色点 + 档名 + 箭头」两件事：色点给一眼的严重度，档名给准确词。
+                   原先还叠一枚盾形图标，而它只有两个形（warn 与否），既不比档名更准，
+                   也不比色点更醒目 ⇒ 同一个状态三种标记（第 872 页业主「让布局说话」）。 */}
+               <ModeDot mode={props.mode} />
+               <span>{modeInfo.label}</span>
+               <span className="ctl-caret" aria-hidden="true"><ChevronDown size={10} /></span>
+             </button>
+             <Popover open={menu === "perm"} up role="menu" style={{ minWidth: 280 }}>
+               {/* 权限档菜单（批 5 提取为组件）：色点 + 图标 + 两行副标题 +「自动」二次确认（见 PermissionMenu.tsx）。
+                   条件渲染（关即卸载）——confirming 态不跨开合残留（真机实证过常驻挂载的残留 bug）。 */}
+               {menu === "perm" && (
+                 <PermissionMenu mode={props.mode} onModeChange={props.onModeChange} onClose={closeMenu} />
+               )}
+             </Popover>
+           </div>
+           {/* v23 Plan 模式一等入口：与权限档同排的开关；按轮覆盖 settings 默认，不写回设置。 */}
+           {props.onPlanRequiredChange !== undefined && (
+             <button
+               type="button"
+               className="ctl plan-ctl"
+               data-on={props.planRequired === true}
+               aria-pressed={props.planRequired === true}
+               aria-label={STR.composer.planAria}
+               title={props.planRequired === true ? STR.composer.planOnTip : STR.composer.planOffTip}
+               disabled={disabled}
+               onClick={() => { props.onPlanRequiredChange?.(props.planRequired !== true); }}
+             >
+               <ListChecks size={13} aria-hidden="true" />
+               <span>{STR.composer.planLabel}</span>
+             </button>
+           )}
+           <ModelPicker
+             // 切会话重挂（2026-10-18）：模型菜单是 Composer 之外的局部开合状态，不重挂的话
+             // 会悬在新会话上（真机：@/附件/权限菜单已收，模型搜索框还开着）。
+             key={draftKey}
+             infos={props.providerInfo ? [props.providerInfo] : []}
+             value={props.pickerValue}
+             disabled={disabled}
+             running={props.running}
+             onChange={props.onModelChange}
+             {...(props.onOpenSettings !== undefined ? { onOpenSettings: props.onOpenSettings } : {})}
+             {...(props.modelSessionOverride === true ? { sessionOverride: true } : {})}
+             {...(props.onThinkingChange !== undefined
+               ? {
+                   thinking: props.thinking,
+                   onThinkingChange: props.onThinkingChange,
+                   thinkingSupported,
+                 }
+               : {})}
+             {...(props.configuredProviders !== undefined ? { configuredProviders: props.configuredProviders } : {})}
+             openSeq={pickerOpenSeq}
+             initialFocus={pickerFocus}
+             onUserOpen={() => setPickerFocus("model")}
+             // 开合由 Composer 的浮层槽持有（第 752 页）：模型菜单与用量环/附件/权限同带互斥，
+             // 不许同屏叠放。
+             open={overlayLayer === "model"}
+             onOpenChange={setModelOpen}
+           />
+           <span className="spacer" />
+           {/* 用量环（v3-lite .ring：环心带上下文百分数；环钉在发送/中断钮左侧——原型 .bar 列序
+               模型芯片弹性、ctxRing 与 send 贴右。「模型选择器旁」§3.5 语义随同一控件行保持）。 */}
+           <UsageMeter
+             usage={props.usage}
+             steps={props.steps}
+             {...(props.ctxWindow !== undefined ? { ctxWindow: props.ctxWindow } : {})}
+             open={menu === "meter"}
+             onOpenChange={setMeterOpen}
+             onCompact={props.onCompact}
+           />
+           {/* 加入队列钮（运行中）：**有话说才出现**——空输入下只留打断钮，不摆禁用的灰钟（v7.1 业主裁）。 */}
+           {showQueueButton(props.running, canSend) && (
+             <button
+               className="send-btn queue"
+               aria-label={STR.composer.queueAria}
+               title={STR.composer.queueTitle}
+               onClick={() => { submit({ forceQueue: true }); }}
+             >
+               <Clock size={13} />
+             </button>
+           )}
+           {props.running ? (
+             <button className="send-btn stop" aria-label={STR.composer.stopAria} title={STR.composer.stopTitle} onClick={props.onCancel}>
+               {/* 批 4：转圈内嵌——加载中的转圈放进发送按钮里（变停止钮），不单独出现。 */}
+               <Loader2 size={13} />
+             </button>
+           ) : (
+             <button className="send-btn" aria-label={STR.composer.sendAria} title={STR.composer.sendTitle} disabled={!canSend} onClick={() => { submit(); }}>
+               <ArrowUp size={14} />
+             </button>
+           )}
+         </div>
+       </div>
+     </>
+   );
+ }
+
+ // 思考档位词表随单芯片形态在 ModelPicker（THINKING_LEVELS）；此处 re-export 保持旧 import 可用。
+ export { THINKING_LEVELS };
+
+ // 统一二次确认卡（2026-10-17）：把散落的 window.confirm 收编到产品自绘的确认面。
+ // 为什么不用系统 dialog：原生 confirm 是 macOS 系统弹窗，样式/语气与 Claude 式界面不在一个世界，
+ // 且 Electron 里它会冻结渲染层（模态阻塞），与「浮层优先、Esc 关闭」的键盘语义也不一致。
+ // 形制复用既有归档/删除会话卡（.confirm-card + ModalSurface 焦点陷阱 + Esc）。
+ import { ModalSurface } from "./ModalSurface";
+
+ export interface ConfirmDialogProps {
+   title: string;
+   /** 后果说明（可多句；正文里可用 <br /> 分行）。 */
+   note?: string;
+   confirmLabel: string;
+   cancelLabel?: string;
+   /** 破坏性动作 = 红实底；普通动作用主按钮形态。 */
+   danger?: boolean;
+   onConfirm: () => void;
+   onClose: () => void;
+ }
+
+ export function ConfirmDialog(props: ConfirmDialogProps): React.JSX.Element {
+   return (
+     <ModalSurface className="confirm-scrim" label={props.title} onClose={props.onClose}>
+       <div className="confirm-card">
+         <div className="cc-title">{props.title}</div>
+         {props.note !== undefined && <div className="cc-note">{props.note}</div>}
+         <div className="cc-actions">
+           <button className="mini-btn" onClick={props.onClose}>{props.cancelLabel ?? "取消"}</button>
+           <button
+             className={`mini-btn ${props.danger === true ? "danger" : "primary"}`}
+             onClick={props.onConfirm}
+           >{props.confirmLabel}</button>
+         </div>
+       </div>
+     </ModalSurface>
+   );
+ }
+
+ // 设置页「自定义接口」表单（Claude 蓝本 v1 重建）：填地址 + 钥匙 → 拉取模型 → 勾选 → 存盘。
+ // 2026-10-16（模型/通道页重做）：分步视觉（①地址 ②协议 ③变量名 ④密钥；拉取后面出 ⑤启用模型 + 保存），
+ // 行走 SettingsRow（220px 标签列、卡内距一致）、控件走 Field（36px/8px、统一宽 ≤420）；逻辑零改动。
+ // 三条纪律照抄命令行那一侧（两边共用 src 里的同一套核心，行为不分叉）：
+ //   · 钥匙明文零进 React state（输入框非受控，用 ref 取值）；
+ //   · 「拉取」零副作用（只调 providerDiscover，不改任何文件；要存必须再点「保存」）；
+ //   · 缺的字段摆出来（missing 明说"得你自己补"，绝不替用户填假数）。
+ // 本地端点判定（isLocalEndpointURL）必须被"拉取"与"保存"两处用同一份——这是 2026-10-06
+ // 「能探测、存不进」事故的回归面（源码级哨兵在 render-structure.test 里钉着）。
+ import { useCallback, useEffect, useRef, useState, type RefObject } from "react";
+ import { suggestApiKeyEnv, suggestProviderId, type DiscoveredRow } from "../../../../../src/providers/provider-draft";
+ import { isLocalEndpointURL, selectAllRows } from "./provider-form";
+ import { ModalSurface } from "./ModalSurface";
+ import { Field, SettingsRow } from "./settings-ui";
+
+ type Protocol = "openai" | "anthropic" | "gemini";
+
+ interface DiscoverState {
+   baseURL: string;
+   keyEnv: string;
+   protocol: Protocol;
+   rows: DiscoveredRow[];
+   missing: string[];
+   warnings: string[];
+   catalogOrigin: string;
+   catalogNote?: string;
+   /** 上游被截断的条数（>0 要说出来）。 */
+   truncated: number;
+   matchedProviderId?: string;
+ }
+
+ function rowMeta(row: DiscoveredRow): string {
+   return (
+     `窗口 ${String(row.contextWindow ?? "—")}｜价 ` +
+     (row.price === undefined
+       ? "未提供"
+       : `${String(row.price.inputPerMTok ?? "?")}/${String(row.price.outputPerMTok ?? "?")}`) +
+     `｜${row.origin === "both" ? "探测+目录" : row.origin === "discovery" ? "探测" : "目录"}` +
+     `｜思考 ${row.reasoningEfforts !== undefined && row.reasoningEfforts.length > 0 ? row.reasoningEfforts.join("/") : "不支持"}`
+   );
+ }
+
+ /** 模型选择弹窗（拉取后自动弹出）：整行点选 + 全选/全不选；关闭由「完成」/遮罩收窗。
+  *  选择结果写回表单 selected，保存流程（save 按 selected 过滤）单源不动。 */
+ export function ModelPickModal(props: {
+   rows: readonly DiscoveredRow[];
+   selected: Record<string, boolean>;
+   busy?: boolean;
+   onChange: (next: Record<string, boolean>) => void;
+   onDone: () => void;
+   returnFocusRef?: RefObject<HTMLElement | null>;
+ }): React.JSX.Element {
+   const picked = props.rows.filter((row) => props.selected[row.id] === true).length;
+   return (
+     <div className="cp-overlay" role="presentation" onClick={props.onDone}>
+       <ModalSurface
+         className="cp-modal"
+         label="选择要启用的模型"
+         onClose={props.onDone}
+         returnFocusRef={props.returnFocusRef}
+         onClick={(e) => e.stopPropagation()}
+       >
+         <div className="cp-modal-head">
+           <span className="num">已选 {String(picked)} / {String(props.rows.length)}</span>
+           <button className="mini-btn" disabled={props.busy === true} onClick={() => props.onChange(selectAllRows(props.rows, true))}>全选</button>
+           <button className="mini-btn" disabled={props.busy === true} onClick={() => props.onChange(selectAllRows(props.rows, false))}>全不选</button>
+           <button className="mini-btn primary" onClick={props.onDone}>完成</button>
+         </div>
+         <div className="cp-modal-list">
+           {props.rows.map((row) => {
+             const on = props.selected[row.id] === true;
+             return (
+               <button
+                 key={row.id}
+                 role="checkbox"
+                 aria-checked={on}
+                 className={"cp-row" + (on ? " on" : "")}
+                 disabled={props.busy === true}
+                 onClick={() => props.onChange({ ...props.selected, [row.id]: !on })}
+               >
+                 <span className="cp-check" aria-hidden="true">{on ? "✓" : ""}</span>
+                 <span className="nm mono-k">{row.id}</span>
+                 <span className="sub">{rowMeta(row)}</span>
+               </button>
+             );
+           })}
+         </div>
+       </ModalSurface>
+     </div>
+   );
+ }
+
+ export function CustomProviderForm(props: {
+   /** 保存成功后通知外层：设置页据此重拉 provider 清单，App 据此重拉模型面。 */
+   onSaved?: () => void;
+   /** 编辑模式（2026-10-24 业主：自定义供应商在右详情就地编辑）：预填已存配置，保存按同名覆盖。
+    *  null/缺席 = 新增模式（原行为）。 */
+   editing?: { id: string; label: string; protocol: string; baseURL: string; apiKeyEnv: string; modelIds: readonly string[] } | null;
+ }): React.JSX.Element {
+   const [baseURL, setBaseURL] = useState("");
+   const [protocol, setProtocol] = useState<Protocol>("openai");
+   const [busy, setBusy] = useState(false);
+   const [discovered, setDiscovered] = useState<DiscoverState | null>(null);
+   const [selected, setSelected] = useState<Record<string, boolean>>({});
+   const [pickerOpen, setPickerOpen] = useState(false);
+   const [error, setError] = useState<string | null>(null);
+   const [notice, setNotice] = useState<string | null>(null);
+   const keyInput = useRef<HTMLInputElement>(null);
+   const pickerButton = useRef<HTMLButtonElement | null>(null);
+   // 编辑模式预填：baseURL/protocol 从已存配置回填；key 留空 = 不修改（保存时 keyValue 空串即不改）。
+   useEffect(() => {
+     if (props.editing === null || props.editing === undefined) return;
+     setBaseURL(props.editing.baseURL);
+     setProtocol(props.editing.protocol as Protocol);
+   }, [props.editing?.id]);
+
+   const refresh = useCallback(async () => {
+     setError(null);
+     setNotice(null);
+     setDiscovered(null);
+     if (baseURL.trim() === "") {
+       setError("先填接口地址（如 https://api.deepseek.com/v1）");
+       return;
+     }
+     const keyEnv = suggestApiKeyEnv(suggestProviderId(baseURL).id);
+     setBusy(true);
+     try {
+       const keyValue = keyInput.current?.value ?? "";
+       const r = await window.agent.providerDiscover({
+         baseURL: baseURL.trim(),
+         protocol,
+         keyEnv: keyEnv.trim(),
+         ...(keyValue !== "" ? { keyValue } : {}),
+         ...(isLocalEndpointURL(baseURL.trim()) ? { allowLocal: true } : {}),
+       });
+       if (!r.ok) {
+         setError(r.message);
+         return;
+       }
+       setDiscovered({ ...r, baseURL: baseURL.trim(), keyEnv: keyEnv.trim(), protocol });
+       const savedIds = props.editing?.modelIds;
+       const all: Record<string, boolean> = {};
+       for (const row of r.rows) all[row.id] = savedIds === undefined ? true : savedIds.includes(row.id);
+       setSelected(all);
+       setPickerOpen(true); // 拉到清单直接弹选择窗，别让用户在表单里翻一整面墙
+     } catch (err) {
+       setError(err instanceof Error ? err.message : String(err));
+     } finally {
+       setBusy(false);
+     }
+   }, [baseURL, protocol]);
+
+   const save = useCallback(async () => {
+     if (discovered === null) return;
+     const models = discovered.rows
+       .filter((row) => selected[row.id] === true)
+       .map((row) => ({
+         id: row.id,
+         ...(row.contextWindow !== undefined ? { contextWindow: row.contextWindow } : {}),
+         ...(row.maxOutputTokens !== undefined ? { maxOutputTokens: row.maxOutputTokens } : {}),
+         ...(row.price !== undefined ? { price: row.price } : {}),
+         ...(row.reasoningEfforts !== undefined ? { reasoningEfforts: [...row.reasoningEfforts] } : {}),
+         ...(row.inputModalities !== undefined ? { inputModalities: [...row.inputModalities] } : {}),
+       }));
+     if (models.length === 0) {
+       setError("一条都没勾：至少选一个模型再存");
+       return;
+     }
+     setBusy(true);
+     setError(null);
+     try {
+       const keyValue = keyInput.current?.value ?? "";
+       const r = await window.agent.providerSave({
+         providerId: suggestProviderId(discovered.baseURL).id,
+         label: props.editing?.label ?? suggestProviderId(discovered.baseURL).id,
+         protocol: discovered.protocol,
+         baseURL: discovered.baseURL,
+         apiKeyEnv: discovered.keyEnv,
+         // 拉取那一步用过的同一个判定，必须也在保存时说一遍：漏了它就等于"能探测、存不进"。
+         ...(isLocalEndpointURL(discovered.baseURL) ? { allowLocalEndpoint: true } : {}),
+         models,
+         ...(keyValue !== "" ? { keyValue } : {}),
+       });
+       if (!r.ok) {
+         const detail = (r.problems ?? []).map((p) => `${p.where === "" ? "(顶层)" : p.where}：${p.message}`).join("；");
+         setError(detail === "" ? r.error : `${r.error}——${detail}`);
+         return;
+       }
+       // 保存完直接把它设成当前通道；但这一步必须与"保存"分开报（保存已落盘，只是切没切过去是两件事）。
+       // 编辑模式沿用原 id/label（同名覆盖）；新增模式按 baseURL 推导。
+       const providerId = props.editing?.id ?? suggestProviderId(discovered.baseURL).id;
+       const firstModel = models[0]?.id ?? "";
+       let switchNote = "，并已设为当前通道";
+       try {
+         await window.agent.setSettings({ provider: providerId, ...(firstModel !== "" ? { model: firstModel } : {}) });
+       } catch (err) {
+         switchNote = `。但**没能自动切过去**（${err instanceof Error ? err.message : String(err)}）——可以在模型菜单里手动选它`;
+       }
+       setNotice(
+         `已保存 ${String(models.length)} 个模型${switchNote}。可在对话输入框选择使用，密钥已安全保存在本机。`,
+       );
+       props.onSaved?.();
+       // 保存后清空表单（新增模式），避免把上一家的密钥带到另一家；编辑模式保留预填继续改。
+       if (keyInput.current) keyInput.current.value = "";
+       if (props.editing === null || props.editing === undefined) {
+         setBaseURL("");
+         setProtocol("openai");
+       }
+       setDiscovered(null);
+       setSelected({});
+     } catch (err) {
+       setError(err instanceof Error ? err.message : String(err));
+     } finally {
+       setBusy(false);
+     }
+   }, [discovered, selected, props]);
+
+   const localHint = baseURL.trim() !== "" && isLocalEndpointURL(baseURL.trim());
+   // 2026-10-16（模型/通道页重做）：行改 SettingsRow（220px 标签列，卡内距与其余卡一致）、
+   // 控件走 Field（36px/8px/统一宽 ≤420、select 自绘箭头）；顶部说明压一行、全文收进「帮助」。
+   const step = (n: number, text: string): React.JSX.Element => (
+     <><span className="ss-step">{String(n)}</span>{text}</>
+   );
+   return (
+     <section className="ap-sec">
+       <div className="cp-intro">
+         <p className="cp-intro-line">
+           {(props.editing === null || props.editing === undefined)
+             ? "填写接口地址和 API Key，获取模型后勾选保存。"
+             : `编辑「${props.editing.label}」：改完重新「获取模型」勾选保存（同名覆盖，输入框的模型选择不受影响）。`}
+         </p>
+         <details className="ss-help">
+           <summary>帮助</summary>
+           <div className="ss-help-body">
+             支持兼容 OpenAI、Anthropic 和 Gemini 的模型服务。密钥通过系统安全存储保存，获取到模型后选择要启用的项目即可。
+           </div>
+         </details>
+       </div>
+       <SettingsRow label={step(1, "接口地址")}>
+         <Field width="full">
+           <input
+             type="text"
+             aria-label="自定义接口地址"
+             value={baseURL}
+             placeholder="https://api.deepseek.com/v1"
+             disabled={busy}
+             onChange={(e) => setBaseURL(e.target.value)}
+           />
+         </Field>
+         {localHint && <span className="sp-tag">本地模型服务</span>}
+       </SettingsRow>
+       <SettingsRow label={step(2, "协议")}>
+         <Field width="full" select>
+           <select aria-label="自定义接口协议" value={protocol} disabled={busy} onChange={(e) => setProtocol(e.target.value as Protocol)}>
+             <option value="openai">openai（含 DeepSeek / GLM / 中转）</option>
+             <option value="anthropic">anthropic</option>
+             <option value="gemini">gemini</option>
+           </select>
+         </Field>
+       </SettingsRow>
+       <SettingsRow label={step(3, "API Key")}>
+         <Field width="full">
+           <input ref={keyInput} type="password" aria-label="自定义接口 API key" placeholder="粘贴 API key（可选）" disabled={busy} />
+         </Field>
+         <button className="mini-btn" disabled={busy} onClick={() => void refresh()}>获取模型</button>
+         <span className="ss-hint">密钥只保存在本机安全存储中。本地免密服务可留空。</span>
+       </SettingsRow>
+
+       {discovered !== null && (
+         <>
+           <div className="sp-note">
+             探测到 {String(discovered.rows.length)} 条
+             {discovered.matchedProviderId !== undefined ? `｜目录认出：${discovered.matchedProviderId}` : ""}
+             ｜目录来源：{discovered.catalogOrigin === "live" ? "刚拉到的" : discovered.catalogOrigin === "cache" ? "本地缓存" : "内置快照"}
+             {discovered.truncated > 0 ? `｜另有 ${String(discovered.truncated)} 条未列出` : ""}
+           </div>
+           {discovered.catalogNote !== undefined && <div className="sp-note">目录：{discovered.catalogNote}</div>}
+           <SettingsRow label={step(4, "启用模型")}>
+             <button ref={pickerButton} className="mini-btn" disabled={busy} onClick={() => setPickerOpen(true)}>选择模型…</button>
+             <span className="ss-hint">
+               已选 {String(discovered.rows.filter((row) => selected[row.id] === true).length)} / {String(discovered.rows.length)}
+             </span>
+           </SettingsRow>
+           {discovered.missing.length > 0 && (
+             <div className="sp-note">服务未提供以下模型信息：{discovered.missing.join(" / ")}</div>
+           )}
+           {discovered.warnings.map((w) => (
+             <div key={w} className="sp-note">注意：{w}</div>
+           ))}
+           <SettingsRow label="保存">
+             <button className="mini-btn primary" disabled={busy} onClick={() => void save()}>保存到工作区</button>
+           </SettingsRow>
+           {pickerOpen && (
+             <ModelPickModal
+               rows={discovered.rows}
+               selected={selected}
+               {...(busy ? { busy: true } : {})}
+               onChange={setSelected}
+               onDone={() => setPickerOpen(false)}
+               returnFocusRef={pickerButton}
+             />
+           )}
+         </>
+       )}
+       {error !== null && <div className="sp-note err" role="alert">{error}</div>}
+       {notice !== null && <div className="sp-note" role="status">{notice}</div>}
+     </section>
+   );
+ }
+
+ // DiffView：unified hunks 渲染（变更窗格的逐 hunk 展开区）+ 行级评注（蓝本 §3.6）。
+ // 渲染契约：hunk 头 `@@ -a,b +c,d @@`；每行 = 旧行号 · 新行号 · 符号（+ / − / 空格）· 文本。
+ // 色盲冗余：着色之外，符号与前缀始终在场（不只靠颜色表达增删——同仓 diff 纪律）。
+ // 截断如实标注（超字节/行数帽时不假装完整）。
+ // 评注：仅当传 onComment 时行 hover / 键盘聚焦出「＋」；**已评注的行常驻标记**（title 带评论原文）。
+ //   2026-11-01 第 875 页：本行原写「常显」，实现却把标记塞在 `opacity:0` 的 .dl-actions 里
+ //   ⇒ 只有悬停那一行才看得见，读差异时不会逐行悬停，「哪几行被评过」这个信息等于没有。
+ //   同时标记从 emoji 💬 换成 lucide MessageSquare（全应用图标族一致；emoji 随系统字形漂移）。
+ //   行键 = `<path>|<newNo ?? oldNo>`——评审对象是"现在的这一行"（del 行用旧行号回指）。
+ // 2026-10-31（R4）：新增并排视图（open-claude-ui StreamingDiffViewer 的双模式契约）。
+ //   统一仍为缺省；并排把 del/add 配对成左右两栏，context 两侧同置，空白侧留空。
+ import { MessageSquare } from "lucide-react";
+ import { isCompositionEnter } from "../ime";
+ import { useState, type KeyboardEvent } from "react";
+ import type { DiffHunkView, DiffLineView } from "../../../../../src/main/change-diff";
+
+ export type DiffViewMode = "unified" | "split";
+
+ export interface SplitDiffRow {
+   left?: DiffLineView;
+   right?: DiffLineView;
+ }
+
+ /** 把 unified 行序列配成并排行：context 两侧同置；del 块与紧随的 add 块逐行配对，
+  *  多出的一侧留空。纯函数（判卷面）。 */
+ export function splitDiffRows(lines: readonly DiffLineView[]): SplitDiffRow[] {
+   const rows: SplitDiffRow[] = [];
+   let i = 0;
+   while (i < lines.length) {
+     const line = lines[i]!;
+     if (line.kind === "ctx") {
+       rows.push({ left: line, right: line });
+       i += 1;
+       continue;
+     }
+     if (line.kind === "del") {
+       const dels: DiffLineView[] = [];
+       while (i < lines.length && lines[i]!.kind === "del") {
+         dels.push(lines[i]!);
+         i += 1;
+       }
+       const adds: DiffLineView[] = [];
+       while (i < lines.length && lines[i]!.kind === "add") {
+         adds.push(lines[i]!);
+         i += 1;
+       }
+       const count = Math.max(dels.length, adds.length);
+       for (let j = 0; j < count; j += 1) {
+         rows.push({
+           ...(dels[j] !== undefined ? { left: dels[j] } : {}),
+           ...(adds[j] !== undefined ? { right: adds[j] } : {}),
+         });
+       }
+       continue;
+     }
+     const adds: DiffLineView[] = [];
+     while (i < lines.length && lines[i]!.kind === "add") {
+       adds.push(lines[i]!);
+       i += 1;
+     }
+     for (const add of adds) rows.push({ right: add });
+   }
+   return rows;
+ }
+
+ export interface DiffViewCommentApi {
+   /** 行键 → 评论文本。 */
+   comments: ReadonlyMap<string, string>;
+   /** 行键前缀（`<path>|`）。 */
+   keyPrefix: string;
+   onComment: (lineKey: string, text: string) => void;
+ }
+
+ function lineKeyOf(api: DiffViewCommentApi, line: DiffLineView): string {
+   return `${api.keyPrefix}${String(line.newNo ?? line.oldNo ?? 0)}`;
+ }
+
+ function CommentEditor(props: {
+   lineNo: number;
+   draft: string;
+   onDraft: (text: string) => void;
+   onCommit: () => void;
+   onCancel: () => void;
+   className?: string;
+ }): React.JSX.Element {
+   const onKey = (e: KeyboardEvent<HTMLTextAreaElement>): void => {
+     if (e.key === "Escape") props.onCancel();
+     if (e.key === "Enter" && !isCompositionEnter(e, null) && (e.metaKey || e.ctrlKey)) {
+       e.preventDefault();
+       props.onCommit();
+     }
+   };
+   return (
+     <div className={`dl-editor${props.className !== undefined ? ` ${props.className}` : ""}`}>
+       <textarea
+         autoFocus
+         rows={2}
+         value={props.draft}
+         aria-label={`第 ${String(props.lineNo)} 行评注`}
+         placeholder="写评论（⌘Enter 保存 · Esc 取消）"
+         onChange={(e) => props.onDraft(e.target.value)}
+         onKeyDown={onKey}
+       />
+       <button className="mini-btn primary" onClick={props.onCommit}>保存评论</button>
+     </div>
+   );
+ }
+
+ export function DiffView(props: {
+   hunks: readonly DiffHunkView[];
+   truncated?: boolean;
+   comment?: DiffViewCommentApi;
+   /** 并排/统一的初始档（缺省 unified；只在挂载时读一次）。 */
+   initialView?: DiffViewMode;
+ }): React.JSX.Element {
+   const [mode, setMode] = useState<DiffViewMode>(props.initialView ?? "unified");
+   const [editing, setEditing] = useState<string | null>(null);
+   const [editingNo, setEditingNo] = useState<number | null>(null);
+   const [draft, setDraft] = useState("");
+   if (props.hunks.length === 0) {
+     // 截断态不能说「没有差异」：那会把「没比完」说成「比完了且一样」（真机：大文件超帽）。
+     return props.truncated === true
+       ? <div className="diff-note">已截断比对：显示帽内的内容未发现不同，超出部分未比对。</div>
+       : <div className="diff-empty">没有差异（与快照逐行一致）</div>;
+   }
+   const api = props.comment;
+   const closeEditor = (): void => {
+     setEditing(null);
+     setEditingNo(null);
+     setDraft("");
+   };
+   const openEditor = (key: string, lineNo: number): void => {
+     setEditing(key);
+     setEditingNo(lineNo);
+     setDraft(api?.comments.get(key) ?? "");
+   };
+   const commit = (): void => {
+     if (editing === null) return;
+     const text = draft.trim();
+     if (text !== "") api?.onComment(editing, text);
+     closeEditor();
+   };
+   const switchMode = (next: DiffViewMode): void => {
+     if (next === mode) return;
+     closeEditor();
+     setMode(next);
+   };
+   const commentButton = (line: DiffLineView): React.JSX.Element | null => {
+     if (api === undefined) return null;
+     // 并排视图只允许评右栏（现在还在的那一行）；左栏是删除基线，不重复给入口。
+     const key = lineKeyOf(api, line);
+     const has = api.comments.has(key);
+     const lineNo = line.newNo ?? line.oldNo ?? 0;
+     return (
+       <>
+         {/* 常驻标记在 hover 组之外：见文件头契约 */}
+         {has && (
+           <span className="dl-has-comment" title={api.comments.get(key)} aria-label="该行有评注">
+             <MessageSquare size={11} aria-hidden="true" />
+           </span>
+         )}
+         <span className="dl-actions">
+           <button className="dl-comment" aria-label={`评论第 ${String(lineNo)} 行`} onClick={() => { openEditor(key, lineNo); }}>＋</button>
+         </span>
+       </>
+     );
+   };
+   return (
+     <div className="diff-view" data-view={mode} aria-label="文件差异">
+       <div className="diff-view-head">
+         <div className="diff-view-tabs" role="group" aria-label="差异视图">
+           <button type="button" aria-pressed={mode === "unified"} onClick={() => { switchMode("unified"); }}>统一</button>
+           <button type="button" aria-pressed={mode === "split"} onClick={() => { switchMode("split"); }}>并排</button>
+         </div>
+       </div>
+       {mode === "unified" ? (
+         <>
+           {props.hunks.map((h, i) => (
+             <div className="diff-hunk" key={`${h.header}:${String(i)}`}>
+               <div className="diff-hunk-head num">{h.header}</div>
+               {h.lines.map((l, j) => {
+                 const lineNo = l.newNo ?? l.oldNo ?? 0;
+                 const key = api === undefined ? "" : `${api.keyPrefix}${String(lineNo)}`;
+                 const has = api !== undefined && api.comments.has(key);
+                 return (
+                   <div key={j}>
+                     <div className={`diff-line ${l.kind}`}>
+                       <span className="ln num" aria-hidden="true">{l.oldNo === null ? "" : String(l.oldNo)}</span>
+                       <span className="ln num" aria-hidden="true">{l.newNo === null ? "" : String(l.newNo)}</span>
+                       <span className="sign" aria-hidden="true">{l.kind === "add" ? "+" : l.kind === "del" ? "−" : " "}</span>
+                       <span className="txt">{l.text}</span>
+                       {api !== undefined && has && (
+                         <span className="dl-has-comment" title={api.comments.get(key)} aria-label="该行有评注">
+                           <MessageSquare size={11} aria-hidden="true" />
+                         </span>
+                       )}
+                       {api !== undefined && (
+                         <span className="dl-actions">
+                           <button
+                             className="dl-comment"
+                             aria-label={`评论第 ${String(lineNo)} 行`}
+                             onClick={() => { openEditor(key, lineNo); }}
+                           >＋</button>
+                         </span>
+                       )}
+                     </div>
+                     {editing === key && editingNo !== null && (
+                       <CommentEditor lineNo={editingNo} draft={draft} onDraft={setDraft} onCommit={commit} onCancel={closeEditor} />
+                     )}
+                   </div>
+                 );
+               })}
+             </div>
+           ))}
+         </>
+       ) : (
+         <div className="diff-split" aria-label="并排差异">
+           {props.hunks.map((h, i) => (
+             <div className="diff-hunk" key={`${h.header}:${String(i)}`}>
+               <div className="diff-hunk-head num diff-split-head">{h.header}</div>
+               {splitDiffRows(h.lines).map((row, j) => {
+                 const leftKey = api !== undefined && row.left !== undefined ? lineKeyOf(api, row.left) : null;
+                 const rightKey = api !== undefined && row.right !== undefined ? lineKeyOf(api, row.right) : null;
+                 const editorHere = editing !== null && (editing === leftKey || editing === rightKey);
+                 return (
+                   <div className="diff-split-row" key={j}>
+                     <div className={`diff-cell ${row.left?.kind ?? "empty"}`}>
+                       <span className="ln num" aria-hidden="true">{row.left?.oldNo === null || row.left === undefined ? "" : String(row.left.oldNo)}</span>
+                       <span className="sign" aria-hidden="true">{row.left === undefined ? "" : row.left.kind === "del" ? "−" : " "}</span>
+                       <span className="txt">{row.left?.text ?? ""}</span>
+                     </div>
+                     <div className={`diff-cell ${row.right?.kind ?? "empty"}`}>
+                       <span className="ln num" aria-hidden="true">{row.right?.newNo === null || row.right === undefined ? "" : String(row.right.newNo)}</span>
+                       <span className="sign" aria-hidden="true">{row.right === undefined ? "" : row.right.kind === "add" ? "+" : " "}</span>
+                       <span className="txt">{row.right?.text ?? ""}</span>
+                       {row.right !== undefined && commentButton(row.right)}
+                     </div>
+                     {editorHere && editingNo !== null && (
+                       <CommentEditor className="diff-split-editor" lineNo={editingNo} draft={draft} onDraft={setDraft} onCommit={commit} onCancel={closeEditor} />
+                     )}
+                   </div>
+                 );
+               })}
+             </div>
+           ))}
+         </div>
+       )}
+       {props.truncated === true && (
+         <div className="diff-note">已截断（超字节 / 行数帽）——完整差异请用本地工具查看。</div>
+       )}
+     </div>
+   );
+ }
+
+ // C-17 ErrorStrip（产品化形态）：danger 左条 + alert 图标 + 消息 + 关闭钮（只由用户关闭，不自动消失）。
+ // role="alert"；App 持 lastError state（会话键控 Map），切会话各看各的。
+ import { AlertTriangle, FileText, X } from "lucide-react";
+ import { STR } from "../strings";
+
+ export function ErrorStrip(props: { message: string; onDismiss: () => void; onViewLog?: () => void }) {
+   return (
+     <div className="error-strip" role="alert" style={{ display: "flex" }}>
+       <span className="ico" aria-hidden="true">
+         <AlertTriangle size={14} />
+       </span>
+       <span className="msg">{props.message}</span>
+       {props.onViewLog !== undefined && (
+         <button className="btn-ghost error-log" title={STR.logViewer.openTip} onClick={props.onViewLog}>
+           <FileText size={12} aria-hidden="true" /> {STR.logViewer.open}
+         </button>
+       )}
+       <button className="x" onClick={props.onDismiss} aria-label={STR.logViewer.errorDismiss}>
+         <X size={12} />
+       </button>
+     </div>
+   );
+ }
+
+ import { Fragment, useEffect, useRef, useState } from "react";
+ import { ChevronRight, FileText, Folder } from "lucide-react";
+ import type { DirEntryView } from "../../../../../src/main/workspace-fs";
+
+ /** 快速打开的目标路径 → 需要预展开的祖先目录（不含文件本身）。
+  *  纯函数，判卷可直接钉；命令面板的文件快速打开与 FilePane 的树展开共用这一把尺。 */
+ export function ancestorDirsOf(path: string): string[] {
+   const parts = path.split("/").filter((part) => part !== "");
+   const dirs: string[] = [];
+   for (let i = 1; i < parts.length; i += 1) dirs.push(parts.slice(0, i).join("/"));
+   return dirs;
+ }
+
+ /** 文件窗格（v5 只读浏览）：左树懒加载 + 下方文本预览（帽/二进制由通道侧拒，界面如实呈现）。
+  *  `openTarget`：命令面板快速打开的信号——展开父目录、加载尚未取过的目录、打开预览并聚焦行。 */
+ export function FilePane(props: {
+   onPathMenu?: (rel: string, kind: "file" | "directory", x: number, y: number) => void;
+   openTarget?: { path: string; seq: number };
+ }): React.JSX.Element {
+   type DirNode = { entries: DirEntryView[]; truncated: boolean } | { error: string };
+   const [dirs, setDirs] = useState<Record<string, DirNode>>({});
+   const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set([""]));
+   const [preview, setPreview] = useState<{ path: string; loading: boolean; text?: string; truncated?: boolean; error?: string } | null>(null);
+   const [focusPath, setFocusPath] = useState<string | null>(null);
+   // 请求归属（2026-10-21）：同一目录/预览的旧响应晚到，不能覆盖新请求的结果。
+   const dirSeq = useRef(new Map<string, number>());
+   const previewSeq = useRef(0);
+   const root = dirs[""];
+   const firstPath = root !== undefined && "entries" in root ? root.entries[0]?.name : undefined;
+
+   const loadDir = (rel: string): void => {
+     const seq = (dirSeq.current.get(rel) ?? 0) + 1;
+     dirSeq.current.set(rel, seq);
+     setDirs((prev) => {
+       const next = { ...prev };
+       delete next[rel];
+       return next;
+     });
+     void window.agent.workspaceListDir(rel).then((r) => {
+       if (dirSeq.current.get(rel) !== seq) return;
+       setDirs((prev) => ({
+         ...prev,
+         [rel]: r === undefined
+           ? { error: "通道无应答" }
+           : r.ok
+             ? { entries: r.entries, truncated: r.truncated }
+             : { error: r.error },
+       }));
+     }).catch((err: unknown) => {
+       if (dirSeq.current.get(rel) !== seq) return;
+       setDirs((prev) => ({ ...prev, [rel]: { error: err instanceof Error ? err.message : String(err) } }));
+     });
+   };
+   // 首次挂载拉根目录（懒加载树的唯一根；子层展开时才拉）。
+   useEffect(() => { loadDir(""); }, []);
+
+   // 命令面板快速打开：把父目录一路展开、把还没取过的目录补拉，再打开文件预览。
+   // 只随 target 对象（seq）变化，不随 dirs/函数身份重跑；旧请求有各自序号守卫。
+   useEffect(() => {
+     const target = props.openTarget;
+     if (target === undefined) return;
+     const parents = ancestorDirsOf(target.path);
+     if (parents.length > 0) {
+       setExpanded((prev) => {
+         const next = new Set(prev);
+         for (const parent of parents) next.add(parent);
+         return next;
+       });
+       for (const parent of parents) {
+         if (dirs[parent] === undefined) loadDir(parent);
+       }
+     }
+     openFile(target.path);
+     setFocusPath(target.path);
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+   }, [props.openTarget]);
+
+   const child = (rel: string, name: string): string => (rel === "" ? name : `${rel}/${name}`);
+   const toggleDir = (rel: string): void => {
+     setExpanded((prev) => {
+       const next = new Set(prev);
+       if (next.has(rel)) {
+         next.delete(rel);
+       } else { next.add(rel); if (dirs[rel] === undefined) loadDir(rel); }
+       return next;
+     });
+   };
+   const openFile = (rel: string): void => {
+     const seq = previewSeq.current + 1;
+     previewSeq.current = seq;
+     setPreview({ path: rel, loading: true });
+     void window.agent.workspaceReadText(rel).then((r) => {
+       if (previewSeq.current !== seq) return;
+       setPreview(r === undefined
+         ? { path: rel, loading: false, error: "通道无应答" }
+         : r.ok
+           ? { path: rel, loading: false, text: r.text, truncated: r.truncated }
+           : { path: rel, loading: false, error: r.error });
+     }).catch((err: unknown) => {
+       if (previewSeq.current !== seq) return;
+       setPreview({ path: rel, loading: false, error: err instanceof Error ? err.message : String(err) });
+     });
+   };
+
+   // 树键盘（2026-10-21）：↑/↓ 行间移动，Home/End 首尾，→ 展开/进子行，← 收起/回父行；
+   // Enter/Space 交给原生 button，避免双触发。roving tabindex 只保留一个 Tab 停点。
+   const onTreeKeyDown = (e: React.KeyboardEvent<HTMLDivElement>): void => {
+     if (e.metaKey || e.ctrlKey || e.altKey) return;
+     const rows = [...e.currentTarget.querySelectorAll<HTMLElement>(".fp-row")];
+     const active = document.activeElement;
+     const idx = active instanceof HTMLElement ? rows.indexOf(active) : -1;
+     if (idx < 0) return;
+     const row = rows[idx];
+     if (row === undefined) return;
+     if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Home" || e.key === "End") {
+       e.preventDefault();
+       const target = e.key === "Home" ? rows[0]
+         : e.key === "End" ? rows[rows.length - 1]
+         : e.key === "ArrowDown" ? rows[idx + 1]
+         : rows[idx - 1];
+       target?.focus();
+       return;
+     }
+     if (e.key === "ArrowRight" && row.dataset.kind === "dir") {
+       e.preventDefault();
+       if (row.getAttribute("aria-expanded") !== "true") row.click();
+       // 空、加载中或失败目录没有子行；右键只能进入它自己的直属子行。
+       else if (rows[idx + 1]?.dataset.parent === row.dataset.path) rows[idx + 1]?.focus();
+       return;
+     }
+     if (e.key === "ArrowLeft") {
+       e.preventDefault();
+       if (row.dataset.kind === "dir" && row.getAttribute("aria-expanded") === "true") {
+         row.click();
+         return;
+       }
+       rows.find((r) => r.dataset.path === row.dataset.parent)?.focus();
+     }
+   };
+
+   const renderDir = (rel: string, depth: number): React.ReactNode => {
+     const node = dirs[rel];
+     if (node === undefined) return <div className="fp-note">读取中…</div>;
+     if ("error" in node) {
+       return (
+         <div className="fp-note err" role="alert">
+           <span>{node.error}</span>
+           <button className="mini-btn" onClick={() => { loadDir(rel); }}>重试</button>
+         </div>
+       );
+     }
+     return (
+       <>
+         {node.truncated && (
+           <div className="fp-note warn" role="status">
+             目录过大，已截断：只显示前 {String(node.entries.length)} 项
