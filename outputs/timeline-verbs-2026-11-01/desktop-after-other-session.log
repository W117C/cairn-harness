+                 : (selected.commands ?? []).map((c) => (
+                   <div key={c.invoke} className="ap-li"><span className="kind mono-k">{c.invoke}</span><span className="p">{c.description}</span>{props.onInvoke !== undefined && <button className="mini-btn" onClick={() => { props.onInvoke?.(c.invoke); }}>{STR.pluginSurface.fill}</button>}</div>
+                 ))}
+             </section>
+             <section className="ap-sec">
+               <h3>配置（{String(selected.userConfig?.length ?? 0)}）</h3>
+               {(selected.userConfig ?? []).length === 0
+                 ? <div className="ap-empty">该插件没有声明 userConfig</div>
+                 : (selected.userConfig ?? []).map((f) => {
+                   const key = selected.name + "::" + f.key;
+                   return (
+                     <div className="ap-form-row" key={f.key}>
+                       <label className="ap-k" htmlFor={"uc-" + key}>{f.title ?? f.key}{f.required ? " *" : ""}</label>
+                       <div className="ap-form-ctl">
+                         <input
+                           id={"uc-" + key}
+                           type={f.sensitive ? "password" : "text"}
+                           autoComplete="off"
+                           value={ucDraft[key] ?? ""}
+                           placeholder={f.hasValue ? "已设置（留空保持不变）" : f.missing ? "未设置（必填）" : "未设置"}
+                           onChange={(e) => setUcDraft((prev) => ({ ...prev, [key]: e.target.value }))}
+                         />
+                         {f.sensitive && <span className="sub">值经 safeStorage 加密，界面不回显</span>}
+                         {f.description !== undefined && <span className="sub">{f.description}</span>}
+                       </div>
+                     </div>
+                   );
+                 })}
+               {(selected.userConfig ?? []).length > 0 && (
+                 <button
+                   className="mini-btn primary"
+                   disabled={ucBusy}
+                   onClick={() => {
+                     const values: Record<string, string> = {};
+                     for (const [k, v] of Object.entries(ucDraft)) {
+                       if (!k.startsWith(selected.name + "::")) continue;
+                       if (v === "") continue; // 留空 = 保持不变（含敏感值无法回显）
+                       values[k.slice(selected.name.length + 2)] = v;
+                     }
+                     if (Object.keys(values).length === 0) { props.onError("没有要保存的配置项（留空 = 保持不变）"); return; }
+                     setUcBusy(true);
+                     void window.agent.pluginUserConfigSet(selected.name, values).then((r) => {
+                       if (!r.ok) props.onError(r.error ?? "配置保存失败");
+                       else { setUcDraft({}); props.refresh(); }
+                     }).catch((err: unknown) => props.onError(`配置保存失败：${err instanceof Error ? err.message : String(err)}`))
+                       .finally(() => setUcBusy(false));
+                   }}
+                 >保存配置</button>
+               )}
+             </section>
+             <section className="ap-sec">
+               <h3>信任</h3>
+               <div className="ap-kv">未信任不激活（技能与 MCP 均不挂载）；决议走 pluginDecide。</div>
+               <Switch
+                 label="信任该插件"
+                 checked={selected.trust === "trusted"}
+                 busy={trustBusy === selected.name}
+                 onText="已信任"
+                 offText="未信任"
+                 onChange={(next) => {
+                   setTrustBusy(selected.name);
+                   void window.agent.pluginDecide(selected.name, next).then((r) => {
+                     if (!r.ok) props.onError(r.error ?? "信任决议失败");
+                     else props.refresh();
+                   }).catch((err: unknown) => props.onError(`信任决议失败：${err instanceof Error ? err.message : String(err)}`))
+                     .finally(() => setTrustBusy(null));
+                 }}
+               />
+             </section>
+             {(selected.errors.length > 0 || selected.warnings.length > 0) && (
+               <section className="ap-sec">
+                 <h3>错误与警告</h3>
+                 {selected.errors.map((e, i) => <div key={`e${String(i)}`} className="ap-li"><span className="kind err">错误</span><span className="p">{e}</span></div>)}
+                 {selected.warnings.map((w, i) => <div key={`w${String(i)}`} className="ap-li"><span className="kind">警告</span><span className="p">{w}</span></div>)}
+               </section>
+             )}
+             <section className="ap-sec">
+               <h3>该插件 MCP</h3>
+               {plugins.mcpServers.filter((m) => m.plugin === selected.name).length === 0 && <div className="ap-empty">无 MCP 服务</div>}
+               {plugins.mcpServers.filter((m) => m.plugin === selected.name).map((m) => {
+                 const key = selected.name + "/" + m.server;
+                 const toolPrefix = "mcp__plugin_" + selected.name + "_" + m.server + "__";
+                 const activeNames = activeMcpTools
+                   .filter((s) => s.startsWith(toolPrefix))
+                   .map((s) => s.slice(toolPrefix.length));
+                 // 旧快照可能只有 activeMcpServers / activeMcpTools 没有 summaries：按原始集回退，
+                 // 不把「有 active 记录但缺汇总」显示成未激活。
+                 const summary = mcpSummaries.find((s) => s.key === key)
+                   ?? ((plugins.activeMcpServers ?? []).includes(key)
+                     ? { key, plugin: selected.name, server: m.server, toolCount: m.tools.length, active: true, activeMode: "server" as const, activeToolCount: m.tools.length }
+                     : activeNames.length > 0
+                       ? { key, plugin: selected.name, server: m.server, toolCount: m.tools.length, active: true, activeMode: "tools" as const, activeToolCount: activeNames.length }
+                       : undefined);
+                 return (
+                   <McpServerRow
+                     key={m.server}
+                     server={m.server}
+                     state={m.state}
+                     toolCount={m.tools.length}
+                     {...(summary !== undefined ? { summary } : {})}
+                     activeToolNames={activeNames}
+                     {...(m.error !== undefined ? { error: m.error } : {})}
+                     hasData={hasMcpActiveData}
+                   />
+                 );
+               })}
+             </section>
+           </Drawer>
+         )}
+       </div>
+     </PageFrame>
+   );
+ }
+
+ // ── 自动化任务页 ──────────────────────────────────────────────────
+
+ export function AutomationPane(props: {
+   snap: ScheduleSnapshot;
+   onError: (m: string) => void;
+   refresh: () => void;
+   filter?: string;
+   onFilter?: (filter: string) => void;
+ }): React.JSX.Element {
+   const schedule = props.snap;
+   // 装载期坏档 / 坏行上屏（2026-10-30）：桌面没有控制台，只 warn 的后果是
+   // 「automations.json 坏了 ⇒ 页面写着还没有定时任务，新建又被拒」，用户无从知道原因。
+   // 坏档时任务表恰好是空的 ⇒ 空态分支也必须摆这条横幅。
+   const warningBanner = schedule.warnings.length === 0 ? null : (
+     <Banner
+       tone="warn"
+       icon={<TriangleAlert size={13} />}
+       {...(schedule.warnings.length > 1
+         ? { details: <div>{schedule.warnings.map((w) => <div key={w}>{w}</div>)}</div> }
+         : {})}
+     >
+       {schedule.definitionsCorrupt
+         ? `${schedule.warnings[0] ?? ""}。修好之前，新建、修改、删除任务都会被拒绝。`
+         : schedule.warnings.length === 1
+           ? `装载警告：${schedule.warnings[0] ?? ""}`
+           : `有 ${String(schedule.warnings.length)} 条装载警告；其余任务照常运行。`}
+     </Banner>
+   );
+   const [query, setQuery] = useState("");
+   const [localFilter, setLocalFilter] = useState("all");
+   const [sortByName, setSortByName] = useState(false);
+   const [sel, setSel] = useState<string | null>(null);
+   const [notice, setNotice] = useState<string | null>(null);
+   // 新建表单（表单四 kind：once / interval / daily / weekly）。
+   const [creating, setCreating] = useState(false);
+   const [fName, setFName] = useState("");
+   const [fPrompt, setFPrompt] = useState("");
+   const [fKind, setFKind] = useState<"once" | "interval" | "daily" | "weekly">("daily");
+   const [fTime, setFTime] = useState("09:00");
+   const [fEvery, setFEvery] = useState("60");
+   const [fAt, setFAt] = useState("");
+   const [fWeekdays, setFWeekdays] = useState<number[]>([1]);
+   const [fTier, setFTier] = useState<"read-only" | "workspace-write" | "danger-full-access">("read-only");
+   const [busy, setBusy] = useState(false);
+   // 编辑态（2026-10-18）：整条任务留底（enabled/timeZone/catchUp/model 在保存时原样带回，
+   // 表单只改 name/prompt/排程/档位——局部 upsert 会把未展示字段重置成默认值）。
+   const [editing, setEditing] = useState<AutomationDefinition | null>(null);
+   // 删除任务确认（2026-10-17：原生 confirm → 产品自绘卡）
+   const [deleteAsk, setDeleteAsk] = useState<{ id: string; name: string } | null>(null);
+
+   const filter = props.filter ?? localFilter;
+   const setFilter = props.onFilter ?? setLocalFilter;
+   const q = query.trim().toLowerCase();
+   const rows = schedule.tasks
+     .filter((t) => (filter === "all" ? true : filter === "on" ? t.enabled : !t.enabled))
+     .filter((t) => (t.name + t.prompt).toLowerCase().includes(q));
+   const list = useMemo(() => (sortByName ? [...rows].sort((a, b) => a.name.localeCompare(b.name, "zh")) : rows), [rows, sortByName]);
+   const selected = sel === null ? null : schedule.tasks.find((x) => x.id === sel) ?? null;
+
+   const submitCreate = () => {
+     setNotice(null);
+     setBusy(true);
+     const def: Partial<AutomationDefinition> = {
+       ...(editing ?? {}),
+       name: fName.trim(),
+       prompt: fPrompt,
+       schedule: buildSchedule(fKind, fTime, fEvery, fAt, fWeekdays),
+       permissionTier: fTier,
+     };
+     void window.agent.scheduleUpsert(def, true).then((r) => {
+       if (!r.ok) { props.onError(r.error ?? (editing === null ? "创建失败" : "保存失败")); return; }
+       const wasEditing = editing !== null;
+       setCreating(false);
+       setEditing(null);
+       setFName(""); setFPrompt(""); setFAt("");
+       setNotice(wasEditing ? "任务已更新（按新排程重算下次触发）" : "任务已创建（触发 = 全新会话 · unattended）");
+       props.refresh();
+     }).catch((err: unknown) => props.onError(`${editing === null ? "创建" : "保存"}失败：${err instanceof Error ? err.message : String(err)}`))
+       .finally(() => setBusy(false));
+   };
+
+   // 表单抽成变量：空态里的「新建任务」主按钮直接开它（批 6 总纲阶段 3-3）。
+   const createForm = creating ? (
+     <div className="ap-form">
+       <div className="ap-form-row">
+         <label className="ap-k" htmlFor="at-name">名称</label>
+         <input id="at-name" value={fName} placeholder="如：每日巡检" onChange={(e) => setFName(e.target.value)} />
+       </div>
+       <div className="ap-form-row">
+         <span className="ap-k">排程</span>
+         <div className="ap-form-ctl">
+           <select value={fKind} onChange={(e) => setFKind(e.target.value as typeof fKind)}>
+             <option value="daily">每天</option>
+             <option value="interval">每 N 分钟</option>
+             <option value="weekly">每周</option>
+             <option value="once">一次性</option>
+           </select>
+           {fKind === "daily" && <input aria-label="时间 HH:MM" value={fTime} placeholder="09:00" onChange={(e) => setFTime(e.target.value)} />}
+           {fKind === "weekly" && (
+             <>
+               <span className="ap-weekdays">
+                 {["日", "一", "二", "三", "四", "五", "六"].map((d, i) => (
+                   <button
+                     key={d}
+                     className={"chip" + (fWeekdays.includes(i) ? " on" : "")}
+                     onClick={() => setFWeekdays((prev) => (prev.includes(i) ? prev.filter((x) => x !== i) : [...prev, i]))}
+                   >{d}</button>
+                 ))}
+               </span>
+               <input aria-label="时间 HH:MM" value={fTime} placeholder="09:00" onChange={(e) => setFTime(e.target.value)} />
+             </>
+           )}
+           {fKind === "interval" && <input aria-label="每 N 分钟" value={fEvery} placeholder="60" onChange={(e) => setFEvery(e.target.value)} />}
+           {fKind === "once" && <input aria-label="ISO 时间" value={fAt} placeholder="2026-11-01T09:00:00" onChange={(e) => setFAt(e.target.value)} />}
+         </div>
+       </div>
+       <div className="ap-form-row">
+         <label className="ap-k" htmlFor="at-tier">权限档</label>
+         <select id="at-tier" value={fTier} onChange={(e) => setFTier(e.target.value as typeof fTier)}>
+           <option value="read-only">read-only（只读）</option>
+           <option value="workspace-write">workspace-write（工作区写）</option>
+           <option value="danger-full-access">danger-full-access（全权 · 慎用）</option>
+         </select>
+       </div>
+       <div className="ap-form-row">
+         <label className="ap-k" htmlFor="at-prompt">提示词</label>
+         <textarea id="at-prompt" rows={3} value={fPrompt} placeholder="触发时成为新会话首条消息" onChange={(e) => setFPrompt(e.target.value)} />
+       </div>
+       <div className="ap-form-row">
+         <span className="ap-k" />
+         <div className="ap-form-ctl">
+           <button className="mini-btn primary" disabled={busy || fName.trim() === "" || fPrompt.trim() === ""} onClick={submitCreate}>
+             {busy ? (editing === null ? "创建中…" : "保存中…") : (editing === null ? "创建" : "保存")}
+           </button>
+           {editing !== null && <span className="sp-dim">正在编辑「{editing.name}」；启用状态/时区/模型保持不变。</span>}
+           <span className="sp-dim">触发时自动发起新对话；无人值守场景下，需要审批的操作一律拒绝。</span>
+         </div>
+       </div>
+     </div>
+   ) : null;
+
+   // 任务为 0 但历史非空 ⇒ 不能只显示 EmptyState：运行历史仍在快照里，
+   // 旧分支会让「删光任务」后的运行历史/统计整块不可见（空态隐藏真实数据）。
+   if (schedule.tasks.length === 0 && schedule.history.length === 0) {
+     return (
+       <PageFrame
+         title="自动化任务"
+         search={{ label: "搜索任务", value: query, onChange: setQuery }}
+         onRefresh={props.refresh}
+         filters={PAGE_CONTEXT_ITEMS.automation}
+         activeFilter={filter}
+         onFilter={setFilter}
+       >
+         {warningBanner}
+         <EmptyState
+           icon={<Clock size={22} />}
+           title="还没有定时任务"
+           desc="到点会自动发起新的对话。"
+           action={<button className="mini-btn primary" onClick={() => setCreating(true)}>新建任务</button>}
+         />
+         {createForm}
+         <Notice text={notice} />
+       </PageFrame>
+     );
+   }
+
+   return (
+     <PageFrame
+       title="自动化任务"
+       search={{ label: "搜索任务", value: query, onChange: setQuery }}
+       onRefresh={props.refresh}
+       filters={PAGE_CONTEXT_ITEMS.automation}
+       activeFilter={filter}
+       onFilter={setFilter}
+     >
+       {warningBanner}
+       <Stats items={[
+         { k: "任务", v: schedule.tasks.length },
+         { k: "启用中", v: schedule.tasks.filter((t) => t.enabled).length },
+         { k: "运行中", v: schedule.running },
+         { k: "队列", v: schedule.queued },
+       ]} />
+       <div className="ap-toolbar">
+         <button className="chip" onClick={() => setSortByName((value) => !value)}>
+           {sortByName ? "按名称" : "默认序"}
+         </button>
+       </div>
+       <div className="ap-actions-row">
+         <button className="mini-btn primary" onClick={() => setCreating((v) => { if (v) setEditing(null); return !v; })} aria-expanded={creating}>
+           {creating ? "收起表单" : "＋ 新建任务"}
+         </button>
+         <Notice text={notice} />
+       </div>
+       {createForm}
+       <div className={"ap-split" + (selected !== null ? " has-drawer" : "")}>
+         <div>
+           <div className="ap-list">
+             {list.length === 0 && <div className="ap-empty">没有匹配的任务</div>}
+             {list.map((t) => (
+               <div key={t.id} className={"ap-item" + (sel === t.id ? " on" : "")} onClick={() => setSel(t.id)} role="button" tabIndex={0}
+                 onKeyDown={(e) => { if (activates(e)) { e.preventDefault(); setSel(t.id); } }}>
+                 <span className="nm">{t.name}</span>
+                 <span className={"sp-tag" + (t.enabled ? " ok" : "")}>{t.enabled ? "启用" : "停用"}</span>
+                 <span className="sub mono-k">{scheduleLabel(t.schedule)}</span>
+                 {t.nextRunAt !== undefined && <span className="r sub">下次 {new Date(t.nextRunAt).toLocaleString()}</span>}
+               </div>
+             ))}
+           </div>
+           <div className="ap-gtitle">运行历史（{String(schedule.history.length)} 条）</div>
+           <div className="ap-list">
+             {schedule.history.length === 0 && <div className="ap-empty">暂无运行记录</div>}
+             {schedule.history.slice(0, 20).map((h: HistoryEntry, i: number) => (
+               <div key={i} className="ap-li">
+                 <span className="kind">{h.state}</span>
+                 <span className="p">{h.due_at} · {h.task_name}{h.session_id !== undefined ? ` · ${h.session_id}` : ""}</span>
+               </div>
+             ))}
+           </div>
+         </div>
+         {selected !== null && (
+           <Drawer title={selected.name} sub={`${scheduleLabel(selected.schedule)} · 时区 ${selected.timeZone}`} onClose={() => setSel(null)}>
+             <section className="ap-sec">
+               <h3>提示词</h3>
+               <div className="ap-prompt">{selected.prompt}</div>
+             </section>
+             <section className="ap-sec">
+               <h3>操作</h3>
+               <div className="ap-actions-row">
+                 <button
+                   className="mini-btn"
+                   onClick={() => {
+                     const fields = scheduleToForm(selected.schedule);
+                     if (fields === null) { props.onError("该排程类型（monthly/custom）暂不支持在面板编辑"); return; }
+                     setFName(selected.name);
+                     setFPrompt(selected.prompt);
+                     setFKind(fields.kind); setFTime(fields.time); setFEvery(fields.every); setFAt(fields.at); setFWeekdays(fields.weekdays);
+                     setFTier(selected.permissionTier);
+                     setEditing(selected);
+                     setCreating(true);
+                     setSel(null);
+                   }}
+                 >编辑任务</button>
+                 <Switch
+                   label="启用任务"
+                   checked={selected.enabled}
+                   onText="启用"
+                   offText="停用"
+                   onChange={(next) => {
+                     void window.agent.scheduleUpsert({ ...selected, enabled: next }, false).then((r) => {
+                       if (!r.ok) props.onError(r.error ?? "更新失败"); else props.refresh();
+                     }).catch((err: unknown) => props.onError(`更新失败：${err instanceof Error ? err.message : String(err)}`));
+                   }}
+                 />
+                 <button
+                   className="mini-btn"
+                   onClick={() => {
+                     void window.agent.scheduleRunNow(selected.id).then((r) => {
+                       if (!r.ok) props.onError(r.error ?? "触发失败");
+                       else setNotice("已触发 · 新会话运行中");
+                     }).catch((err: unknown) => props.onError(`触发失败：${err instanceof Error ? err.message : String(err)}`));
+                   }}
+                 >立即运行</button>
+                 <button
+                   className="mini-btn danger-text"
+                   onClick={() => { setDeleteAsk({ id: selected.id, name: selected.name }); }}
+                 >删除</button>
+               </div>
+             </section>
+             <section className="ap-sec">
+               <h3>说明</h3>
+               <div className="ap-kv">权限档 {selected.permissionTier} · 错过时段自动补跑：{selected.catchUp ? "开" : "关"} · 触发时自动发起新对话，需要审批的操作一律拒绝。</div>
+             </section>
+           </Drawer>
+         )}
+       </div>
+       <div className="ap-note">任务在后台按时触发；错过的时段会在应用启动后自动补跑（{schedule.startupDone ? "已补跑" : "待补跑"}）；同时最多运行 {String(schedule.cap)} 个任务。</div>
+       {deleteAsk !== null && (
+         <ConfirmDialog
+           title={`删除任务「${deleteAsk.name}」？`}
+           note="删除后不再触发；已产生的运行历史保留。"
+           confirmLabel="删除"
+           danger
+           onClose={() => setDeleteAsk(null)}
+           onConfirm={() => {
+             const ask = deleteAsk;
+             setDeleteAsk(null);
+             void window.agent.scheduleDelete(ask.id).then((r) => {
+               if (!r.ok) props.onError(r.error ?? "删除失败");
+               else { setSel(null); setNotice("任务已删除"); props.refresh(); }
+             }).catch((err: unknown) => props.onError(`删除失败：${err instanceof Error ? err.message : String(err)}`));
+           }}
+         />
+       )}
+     </PageFrame>
+   );
+ }
+
+ // ── 技能中心页 ────────────────────────────────────────────────────
+
+ const SKILL_FILTER_ITEMS = [
+   { id: "all", label: "全部" },
+   { id: "trusted", label: "已信任" },
+   { id: "untrusted", label: "未信任" },
+ ] as const;
+
+ export function SkillsPane(props: {
+   snap: PluginPanelSnapshot;
+   onError: (m: string) => void;
+   refresh: () => void;
+   filter?: string;
+   onFilter?: (filter: string) => void;
+ }): React.JSX.Element {
+   const plugins = props.snap;
+   const [query, setQuery] = useState("");
+   const [localFilter, setLocalFilter] = useState("all");
+   const [sel, setSel] = useState<string | null>(null);
+   const [showAll, setShowAll] = useState(false);
+   const filter = props.filter === undefined || props.filter === "" ? localFilter : props.filter;
+   const setFilter = props.onFilter ?? setLocalFilter;
+   const q = query.trim().toLowerCase();
+   const rows = plugins.looseSkills
+     .filter((s) => (filter === "all" ? true : filter === "trusted" ? s.trust === "trusted" : s.trust !== "trusted"))
+     .filter((s) => (s.invoke + s.description).toLowerCase().includes(q));
+   const selected = sel === null ? null : plugins.looseSkills.find((x) => x.invoke === sel) ?? null;
+   const selectedName = selected?.name ?? null;
+   const scope = selected === null ? undefined : plugins.toolScopes.find((x) => x.invoke === selected.invoke);
+   // 指令正文（2026-10-18 §8 #15）：快照只带元信息，正文按需走 agent:skill-body。
+   // 信任之前能读到它做什么，是「批准」这个动作的前提。
+   const [body, setBody] = useState<null | { loading: boolean; text?: string; truncated?: boolean; path?: string; error?: string }>(null);
+   useEffect(() => {
+     if (selectedName === null) { setBody(null); return; }
+     let alive = true;
+     setBody({ loading: true });
+     void window.agent.skillBody(selectedName).then((r) => {
+       if (!alive) return;
+       setBody(r.ok
+         ? { loading: false, text: r.body ?? "", truncated: r.truncated === true, path: r.path }
+         : { loading: false, error: r.error ?? "读取失败" });
+     }).catch((err: unknown) => {
+       if (alive) setBody({ loading: false, error: err instanceof Error ? err.message : String(err) });
+     });
+     return () => { alive = false; };
+   }, [selectedName]);
+   // 批 6（总纲阶段 3-3）：数据为 0 时只显示 EmptyState，不摆统计卡与筛选。
+   if (plugins.looseSkills.length === 0) {
+     return (
+       <PageFrame
+         title="技能中心"
+         search={{ label: "搜索技能", value: query, onChange: setQuery }}
+         onRefresh={props.refresh}
+         filters={SKILL_FILTER_ITEMS}
+         activeFilter={filter}
+         onFilter={setFilter}
+         inlineFilter
+       >
+         <EmptyState
+           icon={<BookOpen size={22} />}
+           title="还没有技能"
+           desc="在输入框输入技能名即可调用。"
+         />
+       </PageFrame>
+     );
+   }
+   // 双列卡片默认铺 6 张（3 行 × 2 列），其余收进「查看…另有 N 项」——参照 Codex 自定义页。
+   const shown = showAll ? rows : rows.slice(0, 6);
+   const hidden = rows.length - shown.length;
+   return (
+     <PageFrame
+       title="技能中心"
+       search={{ label: "搜索技能", value: query, onChange: setQuery }}
+       onRefresh={props.refresh}
+       filters={SKILL_FILTER_ITEMS}
+       activeFilter={filter}
+       onFilter={setFilter}
+       inlineFilter
+     >
+       <div className={"ap-split" + (selected !== null ? " has-drawer" : "")}>
+         <div className="ap-gridcol">
+           {rows.length === 0 && <div className="ap-empty">没有匹配的技能</div>}
+           <div className="ap-grid">
+             {shown.map((s) => (
+               <PaneCard
+                 key={s.invoke}
+                 ico={s.invoke.slice(0, 1).toUpperCase()}
+                 name={s.invoke}
+                 sub={s.description}
+                 trusted={s.trust === "trusted"}
+                 trustTitle={s.trust === "trusted" ? "已信任" : "未信任——点卡片查看并决定"}
+                 selected={sel === s.invoke}
+                 onOpen={() => setSel(s.invoke)}
+               />
+             ))}
+           </div>
+           {hidden > 0 && (
+             <button className="ap-more" onClick={() => setShowAll(true)}>
+               查看{shown.slice(-2).map((s) => s.invoke).join("、")}，另有 {String(hidden)} 项
+             </button>
+           )}
+         </div>
+         {selected !== null && (
+           <Drawer title={selected.invoke} sub={selected.description} onClose={() => setSel(null)}>
+             <section className="ap-sec">
+               <h3>来源</h3>
+               <div className="ap-kv">独立技能（loose）· 信任态 {selected.trust}</div>
+               <Switch
+                 label="信任该技能"
+                 checked={selected.trust === "trusted"}
+                 onText="已信任"
+                 offText="未信任"
+                 onChange={(next) => {
+                   void window.agent.pluginDecide(selected.name, next).then((r) => {
+                     if (!r.ok) props.onError(r.error ?? "信任决议失败"); else props.refresh();
+                   }).catch((err: unknown) => props.onError(`信任决议失败：${err instanceof Error ? err.message : String(err)}`));
+                 }}
+               />
+             </section>
+             <section className="ap-sec">
+               <h3>权限联动（toolScopes）</h3>
+               {scope === undefined && <div className="ap-empty">本 turn 无申报记录</div>}
+               {scope !== undefined && (
+                 <div className="ap-li"><span className="kind">scope</span><span className="p">allow: {scope.allow.length > 0 ? scope.allow.join("、") : "—"} · deny: {scope.deny.length > 0 ? scope.deny.join("、") : "—"}</span></div>
+               )}
+             </section>
+             <section className="ap-sec">
+               <h3>指令正文</h3>
+               {body === null || body.loading ? (
+                 <div className="ap-empty">读取中…</div>
+               ) : body.error !== undefined ? (
+                 <div className="ap-empty">读取失败：{body.error}</div>
+               ) : (
+                 <>
+                   <pre className="skill-body">{body.text}</pre>
+                   {body.truncated === true && <div className="sp-dim">正文过长，仅显示前 20000 字符。</div>}
+                   {body.path !== undefined && <div className="sp-dim mono-k">{body.path}</div>}
+                 </>
+               )}
+             </section>
+           </Drawer>
+         )}
+       </div>
+       <div className="ap-note">在输入框输入技能名即可调用。</div>
+     </PageFrame>
+   );
+ }
+
+ // ── 记忆系统页 ────────────────────────────────────────────────────
+
+ export function MemoryPane(props: {
+   snap: MemorySnapshot;
+   onError: (m: string) => void;
+   refresh: () => void;
+   filter?: string;
+   onFilter?: (filter: string) => void;
+ }): React.JSX.Element {
+   const memory = props.snap;
+   const [query, setQuery] = useState("");
+   const [localFilter, setLocalFilter] = useState("all");
+   const [sortByName, setSortByName] = useState(false);
+   const [sel, setSel] = useState<string | null>(null);
+   const [notice, setNotice] = useState<string | null>(null);
+   const [exportBusy, setExportBusy] = useState(false);
+   const now = useNow();
+   // 删除主题确认（2026-10-17：原生 confirm → 产品自绘卡）
+   const [topicAsk, setTopicAsk] = useState<{ layer: "project" | "global"; topic: string } | null>(null);
+   const filter = props.filter ?? localFilter;
+   const setFilter = props.onFilter ?? setLocalFilter;
+   const q = query.trim().toLowerCase();
+   type Row = { layer: "project" | "global"; topic: MemorySnapshot["project"]["topics"][number] };
+   const rows: Row[] = [
+     ...memory.project.topics.map((t) => ({ layer: "project" as const, topic: t })),
+     ...memory.global.topics.map((t) => ({ layer: "global" as const, topic: t })),
+   ].filter((r) => (filter === "all" ? true : filter === r.layer))
+     .filter((r) => (r.topic.topic + r.topic.type).toLowerCase().includes(q));
+   const sorted = sortByName ? [...rows].sort((a, b) => a.topic.topic.localeCompare(b.topic.topic, "zh")) : rows;
+   const [selLayer, selTopic] = sel === null ? [null, null] : (sel.split(":") as [string, string]);
+   const selected = selLayer === null ? null : (selLayer === "project" ? memory.project : memory.global).topics.find((t) => t.topic === selTopic) ?? null;
+   const selectedLayer = selLayer === "project" ? memory.project : memory.global;
+   const exportMemory = async (): Promise<void> => {
+     setExportBusy(true);
+     setNotice(null);
+     try {
+       const r = await window.agent.exportMemory(memoryExportMarkdown(memory), "cairn-memory.md");
+       if (r.ok) setNotice(`已导出：${r.path ?? "记忆文件"}`);
+       else if (r.canceled !== true) props.onError(`导出记忆失败：${r.error ?? "未知原因"}`);
+     } catch (err) {
+       props.onError(`导出记忆失败：${err instanceof Error ? err.message : String(err)}`);
+     } finally {
+       setExportBusy(false);
+     }
+   };
+   // 批 6（总纲阶段 3-3）：数据为 0 时只显示 EmptyState，不摆统计卡与筛选。
+   if (memory.project.topics.length + memory.global.topics.length === 0) {
+     return (
+       <PageFrame
+         title="记忆"
+         search={{ label: "搜索记忆", value: query, onChange: setQuery }}
+         onRefresh={props.refresh}
+         filters={PAGE_CONTEXT_ITEMS.memory}
+         activeFilter={filter}
+         onFilter={setFilter}
+       >
+         <EmptyState
+           icon={<Brain size={22} />}
+           title="还没有记忆"
+           desc="Cairn 会在对话中记下项目约定和你的偏好。"
+         />
+       </PageFrame>
+     );
+   }
+   return (
+     <PageFrame
+       title="记忆"
+       search={{ label: "搜索记忆", value: query, onChange: setQuery }}
+       onRefresh={props.refresh}
+       filters={PAGE_CONTEXT_ITEMS.memory}
+       activeFilter={filter}
+       onFilter={setFilter}
+     >
+       <Stats items={[
+         { k: "项目层", v: memory.project.topics.length },
+         { k: "全局层", v: memory.global.topics.length },
+         {
+           k: "待批外部引用",
+           v: memory.project.pendingExternalRefs.length + memory.global.pendingExternalRefs.length,
+           warn: memory.project.pendingExternalRefs.length + memory.global.pendingExternalRefs.length > 0,
+         },
+       ]} />
+       <div className="ap-toolbar">
+         <button className="chip" onClick={() => setSortByName((value) => !value)}>
+           {sortByName ? "按名称" : "最近更新"}
+         </button>
+         <button className="chip" disabled={exportBusy} onClick={() => { void exportMemory(); }}>
+           {exportBusy ? "导出中…" : "导出记忆…"}
+         </button>
+       </div>
+       <div className="ap-actions-row"><Notice text={notice} /></div>
+       <div className={"ap-split" + (selected !== null ? " has-drawer" : "")}>
+         <div className="ap-list">
+           {sorted.length === 0 && <div className="ap-empty">没有匹配的主题</div>}
+           {sorted.map((r) => (
+             <div
+               key={`${r.layer}:${r.topic.topic}`}
+               className={"ap-item" + (sel === `${r.layer}:${r.topic.topic}` ? " on" : "")}
+               onClick={() => setSel(`${r.layer}:${r.topic.topic}`)}
+               role="button"
+               tabIndex={0}
+               onKeyDown={(e) => { if (activates(e)) { e.preventDefault(); setSel(`${r.layer}:${r.topic.topic}`); } }}
+             >
+               {/* H（2026-10-16）：名称单行省略、类型标签钉右；F：元信息走相对时间（悬停给完整时间）。 */}
+               <span className="nm">{r.topic.topic}</span>
+               <span className="sub" title={fullTime(r.topic.modified)}>{r.topic.type} · {String(r.topic.bytes)}B · {relativeTime(r.topic.modified, now)}</span>
+               <span className="sp-tag">{r.layer === "project" ? "项目层" : "全局层"}</span>
+             </div>
+           ))}
+         </div>
+         {selected !== null && (
+           <Drawer
+             title={selected.topic}
+             sub={`${selLayer === "project" ? "项目层" : "全局层"} · ${selected.type} · ${String(selected.bytes)}B · ${relativeTime(selected.modified, now)}`}
+             subTitle={fullTime(selected.modified)}
+             onClose={() => setSel(null)}
+           >
+             {/* D（2026-10-16 记忆页重做）：顺序 = 标题+元信息 → 主题正文 → 索引 → 待批外部引用 → 删除（底置）。
+                 主题正文 v13 接通：正文随快照来（frontmatter 已剥）；空正文给一句话回落，不摆空壳。 */}
+             <section className="ap-sec">
+               <h3>主题正文</h3>
+               {bodyLines(selected.body).length === 0 && <div className="ap-empty">此主题暂无正文</div>}
+               <div className="ap-drawer-body">
+                 {bodyLines(selected.body).map((line, i) => (
+                   <div key={String(i)} className="ap-body-line">{renderInline(line)}</div>
+                 ))}
+               </div>
+             </section>
+             <section className="ap-sec">
+               <h3>索引（MEMORY.md）</h3>
+               {selectedLayer.index === null
+                 ? <div className="ap-empty">尚无索引</div>
+                 : (
+                   // E：逐行渲染（行首「- 」已剥；**加粗**/`代码` 交 renderInline，原样上屏问题修在这里）。
+                   <div className="ap-index">
+                     {indexLines(selectedLayer.index).map((line, i) => (
+                       <div key={String(i)} className="ap-index-line">{renderInline(line)}</div>
+                     ))}
+                   </div>
+                 )}
+             </section>
+             <section className="ap-sec">
+               <h3>待批外部引用</h3>
+               {selectedLayer.pendingExternalRefs.length === 0 && (
+                 <div className="ap-li"><span className="p">本层无（统计数含两层，见下）</span></div>
+               )}
+               {selectedLayer.pendingExternalRefs.map((p) => <div key={p} className="ap-li"><span className="kind">引用</span><span className="p">{p}</span></div>)}
+               {(selLayer === "project" ? memory.global : memory.project).pendingExternalRefs.map((p) => (
+                 <div key={"other:" + p} className="ap-li"><span className="kind">另层</span><span className="p">{p}</span></div>
+               ))}
+             </section>
+             {/* D：危险操作收进面板底部——描边红小按钮 + 二次确认（window.confirm，既有语义不变）。 */}
+             <div className="ap-drawer-foot">
+               <section className="ap-sec">
+                 <h3>删除</h3>
+                 <div className="ap-kv">仅用户可删（模型无删除权，§8.1.7）；删除后立即生效。</div>
+                 <button
+                   className="mini-btn danger-text"
+                   onClick={() => { setTopicAsk({ layer: selLayer as "project" | "global", topic: selected.topic }); }}
+                 >删除主题</button>
+               </section>
+             </div>
+           </Drawer>
+         )}
+       </div>
+       {topicAsk !== null && (
+         <ConfirmDialog
+           title={`删除记忆主题「${topicAsk.topic}」？`}
+           note="删除后立即生效；该主题下的记忆条目一并移除。"
+           confirmLabel="删除"
+           danger
+           onClose={() => setTopicAsk(null)}
+           onConfirm={() => {
+             const ask = topicAsk;
+             setTopicAsk(null);
+             void window.agent.deleteMemory(ask.layer, ask.topic).then((r) => {
+               if (!r.ok) props.onError(r.error ?? "删除失败");
+               else { setSel(null); setNotice("主题已删除"); props.refresh(); }
+             }).catch((err: unknown) => props.onError(`删除失败：${err instanceof Error ? err.message : String(err)}`));
+           }}
+         />
+       )}
+     </PageFrame>
+   );
+ }
+
+ // ── 页体（并入设置页后的形态）──────────────────────────────────────
+ // v7.1 业主裁：四个入口不再自带整页宿主与页内导航——只导出「页体」，由设置页按分区渲染；
+ // 数据面不变（getState() 真快照），标题与图标事实源仍是 PAGE_META。
+
+ const PAGE_FRAME_TITLE: Record<PageId, string> = {
+   plugins: "插件",
+   automation: "自动化任务",
+   skills: "技能中心",
+   memory: "记忆",
+   worktrees: "工作树",
+ };
+
+ /** 页体：按 page 自取一份 getState() 快照并渲染对应面板（宿主只管分区切换，不管数据）。 */
+ export function AppPageBody(props: {
+   page: PageId;
+   filter?: string;
+   onFilter?: (filter: string) => void;
+   workspace?: string | null;
+   mutationBlocked?: boolean;
+   onPluginUpdateCount?: (count: number) => void;
+ }): React.JSX.Element {
+   const [snapshotState, dispatch] = useReducer(
+     appPageSnapshotReducer,
+     props.page,
+     createAppPageSnapshotState,
+   );
+   const [operationError, setOperationError] = useState<string | null>(null);
+   const requestGeneration = useRef(0);
+   const [fallbackFilters, setFallbackFilters] = useState<Partial<Record<PageId, string>>>({});
+   const activeFilter = props.filter ?? fallbackFilters[props.page] ?? defaultPageFilter(props.page);
+   const setFallbackFilter = useCallback((filter: string): void => {
+     setFallbackFilters((current) => ({ ...current, [props.page]: filter }));
+   }, [props.page]);
+   const setActiveFilter = props.onFilter ?? setFallbackFilter;
+   // 目的地内的操作失败只落在本页的 error strip：不能同时写工作台的 lastError，
+   // 否则切回对话会看到一条属于自动化/记忆页的错误（第 815 页 app-shell 冒烟发现）。
+   const reportError = useCallback((message: string): void => {
+     setOperationError(message);
+   }, []);
+
+   const refresh = useCallback(() => {
+     const page = props.page;
+     const generation = ++requestGeneration.current;
+     dispatch({ type: "start", page, generation });
+     const resolve = (snapshot: Parameters<typeof appPageSnapshotReducer>[0]["snapshot"]): void => {
+       if (snapshot !== null) dispatch({ type: "resolve", page, generation, snapshot });
+     };
+     const reject = (message: string): void => {
+       dispatch({ type: "reject", page, generation, message });
+     };
+     // 自动化页只需要 schedule：走专用的 scheduleSnapshot 通道，不再用整份 getState
+     // （那条整份快照还要算插件/记忆/工作树；也为 invoke 消费面留下一处真实调用点）。
+     if (page === "automation") {
+       void window.agent.scheduleSnapshot().then((schedule) => resolve({ schedule })).catch((err: unknown) => {
+         reject(`调度快照读取失败：${err instanceof Error ? err.message : String(err)}`);
+       });
+       return;
+     }
+     void window.agent.getState().then((snapshot) => resolve(snapshot)).catch((err: unknown) => {
+       reject(`快照读取失败：${err instanceof Error ? err.message : String(err)}`);
+     });
+   }, [props.page]);
+   useEffect(() => {
+     if (props.page === "plugins") return;
+     refresh();
+     return () => { requestGeneration.current += 1; };
+   }, [props.page, refresh]);
+   useEffect(() => { setOperationError(null); }, [props.page]);
+
+   const snapshot = snapshotState.page === props.page ? snapshotState.snapshot : null;
+   const loadError = snapshotState.page === props.page ? snapshotState.loadError : null;
+
+   const stateFrame = (message: string, error = false): React.JSX.Element => (
+     <PageFrame title={PAGE_FRAME_TITLE[props.page]} onRefresh={refresh}>
+       <div className="ap-empty" role={error ? "alert" : "status"}>{message}</div>
+     </PageFrame>
+   );
+
+   return (
+     <div className="ap-body" aria-label={PAGE_META[props.page].label}>
+       {operationError !== null && (
+         <div className="ap-error-host">
+           <ErrorStrip message={operationError} onDismiss={() => { setOperationError(null); }} />
+         </div>
+       )}
+       {props.page === "plugins" ? (
+         <PluginsDestination
+           workspace={props.workspace ?? null}
+           onError={reportError}
+           filter={activeFilter}
+           onFilter={setActiveFilter}
+           mutationBlocked={props.mutationBlocked === true}
+           {...(props.onPluginUpdateCount !== undefined ? { onUpdateCount: props.onPluginUpdateCount } : {})}
+         />
+       ) : (
+         <>
+           {loadError !== null
+             ? stateFrame(loadError, true)
+             : snapshot === null && stateFrame("正在读取快照…")}
+           {loadError === null && snapshot !== null && props.page === "automation" && (
+             snapshot.schedule === undefined
+               ? stateFrame("调度器未初始化")
+               : <AutomationPane snap={snapshot.schedule} onError={reportError} refresh={refresh} filter={activeFilter} onFilter={setActiveFilter} />
+           )}
+           {loadError === null && snapshot !== null && props.page === "skills" && (
+             snapshot.plugins === undefined
+               ? stateFrame("插件运行时未加载")
+               : <SkillsPane snap={snapshot.plugins} onError={reportError} refresh={refresh} filter={activeFilter} onFilter={setActiveFilter} />
+           )}
+           {loadError === null && snapshot !== null && props.page === "memory" && (
+             snapshot.memory === undefined
+               ? stateFrame("记忆层未初始化")
+               : <MemoryPane snap={snapshot.memory} onError={reportError} refresh={refresh} filter={activeFilter} onFilter={setActiveFilter} />
+           )}
+           {loadError === null && snapshot !== null && props.page === "worktrees" && (
+             snapshot.worktree === undefined
+               ? stateFrame("工作区未解析（无可用工作区）")
+               : <WorktreesPane snap={snapshot.worktree} onError={reportError} refresh={refresh} />
+           )}
+         </>
+       )}
+     </div>
+   );
+ }
+
+ import { Brain, Clock3, MessageSquare, Puzzle, Settings2, type LucideIcon } from "lucide-react";
+ import { useEffect, useRef, type ReactNode } from "react";
+ import type { AppDestination } from "../app-controls";
+ import { APP_DESTINATIONS, APP_DESTINATION_LABEL } from "../navigation";
+
+ export interface AppRailProps {
+   destination: AppDestination;
+   onOpen: (destination: AppDestination) => void;
+   onSettings: () => void;
+   badges?: Partial<Record<AppDestination, number>>;
+   /** Chat 上下文动作（收起侧栏时的快捷入口）。
+    *  2026-10-31 去重：此前它是**第二条 48px 图标栏**，与全局轨并排 ⇒ 同屏两列图标、
+    *  底部两枚同款「设置」。现在并进本轨，用一条分隔线与全局目的地分开——全窗口只有一条左轨。 */
+   actions?: ReactNode;
+ }
+
+ const ICON: Record<AppDestination, LucideIcon> = {
+   chat: MessageSquare,
+   plugins: Puzzle,
+   memory: Brain,
+   automation: Clock3,
+ };
+
+ export function AppRail(props: AppRailProps): React.JSX.Element {
+   const activeItem = useRef<HTMLButtonElement | null>(null);
+   const previousDestination = useRef(props.destination);
+   useEffect(() => {
+     if (previousDestination.current === props.destination) return;
+     previousDestination.current = props.destination;
+     activeItem.current?.focus({ preventScroll: true });
+   }, [props.destination]);
+
+   return (
+     <nav className="app-rail" aria-label="全局功能">
+       <div className="app-rail-main">
+         {APP_DESTINATIONS.map((destination) => {
+           const Icon = ICON[destination];
+           const label = APP_DESTINATION_LABEL[destination];
+           const badge = props.badges?.[destination];
+           const hasBadge = badge !== undefined && Number.isInteger(badge) && badge > 0;
+           return (
+             <button
+               key={destination}
+               type="button"
+               className="app-rail-item"
+               ref={props.destination === destination ? activeItem : undefined}
+               data-destination={destination}
+               aria-label={hasBadge ? `${label}，${String(badge)} 项` : label}
+               aria-current={props.destination === destination ? "page" : undefined}
+               title={label}
+               onClick={() => { props.onOpen(destination); }}
+             >
+               <Icon size={17} aria-hidden="true" />
+               {hasBadge && <span className="app-rail-badge" aria-hidden="true">{badge > 99 ? "99+" : String(badge)}</span>}
+             </button>
+           );
+         })}
+         {props.actions !== undefined && (
+           <div className="rail-context">
+             <div className="app-rail-divider" aria-hidden="true" />
+             {props.actions}
+           </div>
+         )}
+       </div>
+       <button
+         type="button"
+         className="app-rail-item app-rail-settings"
+         aria-label="设置"
+         title="设置"
+         onClick={props.onSettings}
+       >
+         <Settings2 size={17} aria-hidden="true" />
+       </button>
+     </nav>
+   );
+ }
+
+ // C-14 ApprovalCard（第十一遍重设计）：头行 = 工具图标 + 人话标题（describeAsk 单点给词）+
+ // 风险 chip（**只在中风险及以上才出**——低风险卡不再顶着黄色警示三角）——再加详情▾；
+ // 主体 = 在动什么（命令/路径/patch 走 mono；不再把 JSON.stringify 直接上屏，见 cards.ts describeAsk）。
+ // 展开详情 = 原因行 / 风险点列表 / 网络注记（AskPayload 字段全在，此前 UI 未收全的现在收齐）。
+ // 「总是允许」二次确认（2.5s 无响应回退）。键盘面（P3-1 Step 3）：⏎ = 允许一次——只在卡**本体**
+ // 聚焦时触发（按钮的原生 ⏎ 不抢、不双发）；**Esc 不做决议**保留（卡面明示口径 + 全局 Esc = 浮层
+ // 优先/停止——拒绝不挂 Esc，防误触与语义打架；计划「按钮集合一致」前提核证不成立，偏差登记 §9）。
+ import { useEffect, useState } from "react";
+ import type { AskPayload } from "../../../../../src/main/ipc-protocol";
+ import { AlertTriangle, BookOpen, ChevronDown, FileText, Globe, SquareTerminal, Timer } from "lucide-react";
+ import { describeAsk } from "./cards";
+
+ /** 风险中文化 + 分级：low/none 不出 chip（低风险的日常动作不摆警示），medium 起才说话。 */
+ const RISK_CHIP: Record<string, { label: string; cls: string } | undefined> = {
+   medium: { label: "中风险", cls: "chip risk" },
+   high: { label: "高风险", cls: "chip danger" },
+   critical: { label: "极高风险", cls: "chip danger" },
+ };
+
+ /** 工具 → 头行图标（认不出的工具不硬凑图标，留给 ⚠/空位）。 */
+ function toolIcon(tool: string) {
+   if (tool === "run_shell") return SquareTerminal;
+   if (tool === "write_file" || tool === "edit_file" || tool === "apply_patch") return FileText;
+   if (tool === "web_fetch") return Globe;
+   if (tool === "remember") return BookOpen;
+   if (tool.startsWith("automation_")) return Timer;
+   return undefined;
+ }
+
+ // 连拦降级（§2.2 双向断路器 · 2026-10-20）：核心早就在数「连续被拒 N 次」（autonomy.ts 的
+ // CRITICAL_DENIAL_LIMIT / downgradeSuggestion），但那一句只进 console.warn —— 界面上一次也没出现过，
+ // 等于断路器只断给日志看。这里把它摆到卡面上：明说是哪一档在连拦、建议降到哪一档，
+ // 且**只给按钮、不自动改档**（改档是用户的动作，静默改档比不提示更糟）。
+ export function ApprovalCard(props: {
+   ask: AskPayload;
+   onDecide: (approved: boolean, scope?: "once" | "session_kind" | "always") => void;
+   /** 一键降档（缺省 = 只提示不给按钮；不摆按不动的按钮）。 */
+   onDowngrade?: () => void;
+ }) {
+   const [expanded, setExpanded] = useState(false);
+   const [alwaysArmed, setAlwaysArmed] = useState(false);
+   // 二次确认 2.5s 回退（持久提权值得一次确认）。
+   useEffect(() => {
+     if (!alwaysArmed) return;
+     const t = setTimeout(() => setAlwaysArmed(false), 2500);
+     return () => clearTimeout(t);
+   }, [alwaysArmed]);
+   const a = props.ask;
+   const digest = describeAsk(a);
+   const chip = a.risk !== undefined ? RISK_CHIP[a.risk] : undefined;
+   const dangerHead = a.risk === "high" || a.risk === "critical";
+   const Icon = dangerHead ? AlertTriangle : toolIcon(a.tool);
+   const isNet = a.riskReasons?.some((r) => r.includes("网络") || r.toLowerCase().includes("net")) ?? false;
+   return (
+     <div
+       className="card"
+       data-status="pending_approval"
+       data-exp={expanded ? "true" : "false"}
+       role="region"
+       aria-label={`工具调用决策卡片: ${a.tool}`}
+       tabIndex={0}
+       onKeyDown={(e) => {
+         // ⏎ = 允许一次（P3-1 Step 3）：仅当焦点在卡本体（按钮自带原生 ⏎，不抢不双发）。
+         if (e.key === "Enter" && e.target === e.currentTarget) props.onDecide(true);
+       }}
+     >
+       <div className="card-head">
+         <span className={`ico${dangerHead ? " danger" : ""}`} aria-hidden="true">
+           {Icon !== undefined ? <Icon size={15} /> : null}
+         </span>
+         <h3>{digest.title}</h3>
+         {chip !== undefined && <span className={chip.cls}>{chip.label}</span>}
+         <span className="spacer" />
+         <button className="iconbtn sm" data-card-exp aria-label={expanded ? "收起详情" : "展开详情"} onClick={() => setExpanded(!expanded)}>
+           <span style={{ display: "inline-flex", transform: expanded ? "rotate(180deg)" : undefined, transition: "transform var(--t-fast)" }}><ChevronDown size={12} /></span>
+         </button>
+       </div>
+       {digest.subject !== undefined && <div className="ask-subject" title={digest.subject}>{digest.subject}</div>}
+       {digest.body !== undefined && <div className="cmdline" title={digest.body}>{digest.body}</div>}
+       {expanded && (
+         <>
+           {a.reason && <div className="why">{a.reason}</div>}
+           {a.riskReasons && a.riskReasons.length > 0 && (
+             <ul className="risk-list">{a.riskReasons.map((r, i) => <li key={i}>{r}</li>)}</ul>
+           )}
+           {isNet && (
+             <div className="note-net">
+               <span aria-hidden="true"><Globe size={13} /></span>
+               <span>批准 = 本次命令放行网络出网（一次性，不记忆）</span>
+             </div>
+           )}
+         </>
+       )}
+       {a.tierWarning !== undefined && (
+         <div className="note-tier" role="status">
+           <span>{a.tierWarning}</span>
+           {props.onDowngrade !== undefined && (
+             <button className="btn ghost" onClick={() => { props.onDowngrade?.(); }}>降档回默认档</button>
+           )}
+         </div>
+       )}
+       <div className="card-actions">
+         {/* 动作次序（2026-10-31，R1）：拒绝 / 总是允许 / 允许一次（主钮最右）。
+             与 open-claude-ui McpToolDecisionCard 的三阶决议同序；危险动作不摆在主位。 */}
+         <button className="btn secondary" onClick={() => props.onDecide(false)}>拒绝</button>
+         {!alwaysArmed ? (
+           <button className="btn ghost" onClick={() => setAlwaysArmed(true)}>总是允许 <ChevronDown size={11} /></button>
+         ) : (
+           <>
+             <button className="btn ghost" onClick={() => props.onDecide(true, "session_kind")}>确认 · 本会话此类</button>
+             <button className="btn danger-text" onClick={() => props.onDecide(true, "always")}>确认 · 总是</button>
+             <button className="btn ghost" onClick={() => setAlwaysArmed(false)}>取消</button>
+           </>
+         )}
+         <span className="spacer" />
+         <span className="consequence">Esc 不做决议</span>
+         <button className="btn primary" onClick={() => props.onDecide(true)}>允许 · 本次</button>
+       </div>
+     </div>
+   );
+ }
+
+ /** Cairn 逐格加载标（2026-10-24）：与启动屏同一图形、同一动效——图形不转，
+  *  颜色沿 7 格（6 段环 + 右上火花）顺时针逐格点亮，一圈 1.68s。
+  *  颜色随上下文（currentColor），尺寸由挂载处的 CSS 定（缺省 14px）；
+  *  动画关键帧与逐格延时在 styles.css 的 .cairn-loader（reduced-motion 停格为全色）。 */
+ export function CairnLoader({ className = "" }: { className?: string }) {
+   return (
+     <svg className={`cairn-loader${className !== "" ? ` ${className}` : ""}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
+       <path d="M 35.31 11.72 A 41 41 0 0 1 64.69 11.72 L 57.17 31.33 A 20 20 0 0 0 42.83 31.33 Z"/>
+       <path d="M 10.79 38.01 A 41 41 0 0 1 28.88 14.86 L 39.70 32.86 A 20 20 0 0 0 30.87 44.15 Z"/>
+       <path d="M 16.41 73.52 A 41 41 0 0 1 9.31 45.00 L 30.15 47.56 A 20 20 0 0 0 33.62 61.47 Z"/>
+       <path d="M 47.85 90.94 A 41 41 0 0 1 21.01 78.99 L 35.86 64.14 A 20 20 0 0 0 48.95 69.97 Z"/>
+       <path d="M 80.94 76.90 A 41 41 0 0 1 55.00 90.69 L 52.44 69.85 A 20 20 0 0 0 65.09 63.12 Z"/>
+       <path d="M 90.25 42.18 A 41 41 0 0 1 85.14 71.12 L 67.14 60.30 A 20 20 0 0 0 69.63 46.18 Z"/>
+       <path d="M 65 36 L 91 9 L 80 34 L 63 43 Z"/>
+     </svg>
+   );
+ }
+
+ /** Decorative brand mark; CSS masks inherit the surrounding theme color. */
+ export function CairnMark({ outline = false, className = "" }: { outline?: boolean; className?: string }) {
+   return <span aria-hidden="true" className={`cairn-mark${outline ? " cairn-mark-outline" : ""} ${className}`} />;
+ }
+
+ // C-32 ChangeSummaryCard（v2 输出优先）：一轮交付摘要——固定四格回答「改了什么、验证了什么、
+ // 哪些未验证、下一步」，文件明细与验证原始证据可继续展开查看。
+ // 数据来自 turnDelivery 纯投影（change 缺席标 unknown，不猜 created/modified；验证只认
+ // 最后一次写盘之后的拍，worker 验证不替主会话销账）。
+ import { useState } from "react";
+ import { Check, ChevronDown, Download, ExternalLink, History } from "lucide-react";
+ import type { TurnDelivery } from "../projections";
+
+ const CHANGE_LABEL: Record<"created" | "modified" | "unknown", string> = {
+   created: "新建",
+   modified: "修改",
+   unknown: "变更",
+ };
+
+ const STATUS_LABEL: Record<TurnDelivery["verification"]["status"], string> = {
+   "not-required": "无需验证",
+   absent: "未验证",
+   stale: "证据已过期",
+   verified: "已验证",
+   failed: "验证未过",
+ };
+
+ const STATUS_CHIP: Record<TurnDelivery["verification"]["status"], string> = {
+   "not-required": "",
+   absent: "wait",
+   stale: "wait",
+   verified: "ok",
+   failed: "danger",
+ };
+
+ function verificationText(delivery: TurnDelivery): string {
+   const v = delivery.verification;
+   if (v.latest === null) {
+     return v.status === "not-required" ? "本轮没有需要验证的文件改动" : "无验证记录";
+   }
+   const mode = v.latest.auto ? "自动验证" : "手动验证";
+   const attempt = `第 ${String(v.latest.attempt)}/${String(v.latest.maxAttempts)} 次`;
+   if (v.status === "failed") return `验证未通过 · ${mode} · ${attempt}`;
+   if (v.status === "stale") return `有验证记录，但最后一次写盘之后没有重新验证 · ${mode} · ${attempt}`;
+   if (v.status === "verified") return `已验证 · ${mode} · ${attempt}`;
+   return "无验证记录";
+ }
+
+ function unverifiedText(delivery: TurnDelivery): string {
+   if (delivery.unverifiedFiles.length === 0) {
+     return delivery.verification.status === "verified" ? "无（当前改动有通过验证）" : "无";
+   }
+   const names = delivery.unverifiedFiles.slice(0, 3).join("、");
+   const suffix = delivery.unverifiedFiles.length > 3 ? ` 等 ${String(delivery.unverifiedFiles.length)} 个` : "";
+   return `${String(delivery.unverifiedFiles.length)} 个文件：${names}${suffix}`;
+ }
+
+ function clipOutput(output: string): string {
+   const max = 4_000;
+   return output.length > max ? output.slice(0, max) + "\n…（已截断，完整输出保留在会话事件里）" : output;
+ }
+
+ export function ChangeSummaryCard(props: {
+   delivery: TurnDelivery;
+   /** v6 交付卡动作行：打开预览 / 恢复上一版 / 导出项目。
+    *  缺省不渲染（判卷面保持纯投影；动作只由 App 在有活动工作区时接上）。 */
+   actions?: {
+     onOpenPreview?: () => void;
+     onRevert?: () => void;
+     onExport?: () => void;
+   };
+   /** 默认收起（2026-10-18 业主截图：连续两轮的交付卡各占半屏，太碍事）。展开后才是四问清单。 */
+   initialOpen?: boolean;
+ }) {
+   const [open, setOpen] = useState(props.initialOpen === true);
+   const [showAll, setShowAll] = useState(false);
+   const d = props.delivery;
+   const actions = props.actions;
+   const visible = showAll ? d.files : d.files.slice(0, 4);
+   const created = d.files.filter((f) => f.change === "created").length;
+   const modified = d.files.filter((f) => f.change === "modified").length;
+   // 「变更」= 投影拒绝判定新建还是修改的那部分（change 缺席，见文件头）。此前它只进总数、
+   // 不进分解 ⇒ 全是 unknown 时副行是空的，而标题却断言「已编辑」——投影明确不猜的东西被界面猜了一遍。
+   const unknown = d.files.length - created - modified;
+   const parts = [
+     { word: "新建", n: created, cls: "cf-add" },
+     { word: "修改", n: modified, cls: "cf-del" },
+     { word: "变更", n: unknown, cls: "cf-chg" },
+   ].filter((p) => p.n > 0);
+   // 只有一档时那个数已经在标题里了，副行再念一遍就是同一句话说两遍（业主口径：让布局说话）。
+   const single = parts.length === 1 ? parts[0] : null;
+   const changedText = d.files.length === 0 ? "无文件改动" : `${String(d.files.length)} 个文件`;
+   return (
+     <div className="changes-card" data-open={open ? "true" : "false"}>
+       <button
+         type="button"
+         className="changes-head"
+         aria-expanded={open}
+         aria-label={open ? "收起改动详情" : "展开改动详情"}
+         title={open ? "收起改动详情" : "展开改动详情"}
+         onClick={() => { setOpen((v) => !v); }}
+       >
+         <span className="cf-ico" aria-hidden="true">
+           <svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.4" strokeLinejoin="round"><path d="M1.8 4.4c0-.83.67-1.5 1.5-1.5h1.9l1.4 1.5h4.1c.83 0 1.5.67 1.5 1.5v3.7c0 .83-.67 1.5-1.5 1.5H3.3c-.83 0-1.5-.67-1.5-1.5Z"/></svg>
+         </span>
+         <span className="cf-heading">
+           <span className="cf-t">{d.files.length === 0
+             ? "本轮交付"
+             : single !== null ? `${single.word} ${String(single.n)} 个文件` : `已编辑 ${String(d.files.length)} 个文件`}</span>
+           <span className="cf-subtitle">
+             {single === null && (
+               <span className="cf-stats num">
+                 {parts.flatMap((p, i) => i === 0
+                   ? [<span key={p.word} className={p.cls}>{`${p.word} ${String(p.n)}`}</span>]
+                   : [
+                     <span key={`sep-${p.word}`} className="cf-sep">·</span>,
+                     <span key={p.word} className={p.cls}>{`${p.word} ${String(p.n)}`}</span>,
+                   ])}
+               </span>
+             )}
+             <span className="cf-round num">第 {String(d.round)} 轮</span>
+           </span>
+         </span>
+         <span className={`chip ${STATUS_CHIP[d.verification.status]}`}>{STATUS_LABEL[d.verification.status]}</span>
+         <span className={"changes-toggle" + (open ? " on" : "")} aria-hidden="true"><ChevronDown size={13} /></span>
+       </button>
+       {open && (
+         <>
+           <div className="delivery-list">
+             <span className="dg-k">改了什么</span>
+             <span className="dg-v">{changedText}</span>
+             <span className="dg-k">验证了什么</span>
+             <span className="dg-v">{verificationText(d)}</span>
+             <span className="dg-k">哪些未验证</span>
+             <span className="dg-v">{unverifiedText(d)}</span>
+             <span className="dg-k">下一步</span>
+             <span className="dg-v">{d.nextAction}</span>
+           </div>
+           {d.files.length > 0 && (
+             <section className="changes-files" aria-label="改动文件">
+               <div className="changes-files-head">
+                 <span>改动文件</span>
+                 <span className="changes-files-count num">{d.files.length}</span>
+               </div>
+               <div className="changes-list">
+                 {visible.map((f) => (
+                   <div key={f.path} className="change-item" title={f.snapshotId !== undefined ? "覆盖前快照已保留（.agent/snapshots）" : undefined}>
+                     <span className="ci-change" data-change={f.change}>{CHANGE_LABEL[f.change]}</span>
+                     <span className="ci-path" title={f.path}>{f.path}</span>
+                     {f.snapshotId !== undefined && (
+                       <span className="ci-stat" title={`快照：${f.snapshotId}`}>
+                         <Check size={11} aria-hidden="true" />已存快照
+                       </span>
+                     )}
+                   </div>
+                 ))}
+                 {d.files.length > 4 && !showAll && (
+                   <button type="button" className="changes-more" onClick={() => setShowAll(true)}>
+                     全部 {String(d.files.length)} 个文件 <ChevronDown size={11} aria-hidden="true" />
+                   </button>
+                 )}
+               </div>
+             </section>
+           )}
+           {d.verification.latest !== null && (
+             <details className="delivery-evidence">
+               <summary>查看验证证据</summary>
+               <div className="evidence-body">
+                 {d.verification.latest.results.length === 0 ? (
+                   <div className="evidence-empty">这一拍没有命令明细。</div>
+                 ) : (
+                   d.verification.latest.results.map((r, i) => (
+                     <div key={`${r.command}-${String(i)}`} className="evidence-command">
+                       <div className="evi-head">
+                         <span className={`chip ${r.ok ? "ok" : "danger"}`}>{r.ok ? "通过" : "失败"}</span>
+                         <code className="cmd">{r.command}</code>
+                         {r.exitCode !== undefined && <span className="evi-meta">退出码 {r.exitCode === null ? "无" : String(r.exitCode)}</span>}
+                         {r.cause !== undefined && <span className="evi-meta">{r.cause}</span>}
+                       </div>
+                       {r.output !== "" && <pre className="evidence-output">{clipOutput(r.output)}</pre>}
+                     </div>
+                   ))
+                 )}
+               </div>
+             </details>
+           )}
+           {actions !== undefined && (actions.onOpenPreview !== undefined || actions.onRevert !== undefined || actions.onExport !== undefined) && (
+             <div className="delivery-actions">
+               {actions.onOpenPreview !== undefined && (
+                 <button type="button" className="mini-btn primary delivery-action" onClick={actions.onOpenPreview}>
+                   <ExternalLink size={12} aria-hidden="true" />打开预览
+                 </button>
+               )}
+               {actions.onRevert !== undefined && (
+                 <button
+                   type="button"
+                   className="mini-btn delivery-action delivery-action-danger"
+                   title={`把第 ${String(d.round)} 轮改动过的文件还原成该轮之前的状态（新建文件会删除；之后又被改过的文件不动）`}
+                   onClick={actions.onRevert}
+                 >
+                   <History size={12} aria-hidden="true" />恢复上一版
+                 </button>
+               )}
+               {actions.onExport !== undefined && (
+                 <button type="button" className="mini-btn delivery-action" onClick={actions.onExport}>
+                   <Download size={12} aria-hidden="true" />导出项目
+                 </button>
+               )}
+             </div>
+           )}
+         </>
+       )}
+     </div>
+   );
+ }
+
+ // C-15 ClarifyCard（2026-10-07 产品化重写）：进 .card 体系（与审批/方案卡同门面：card-head +
+ // chip + q-block + opts），淘汰旧 card-approval 裸样式路径。表单语义与必答校验不动（cards.ts 纯函数）。
+ import { useState } from "react";
+ import type { ClarifyAnswerMap, ClarifyQuestion } from "../../../../../src/events";
+ import { clarifyFormValues } from "./cards";
+ import { MessageSquare } from "lucide-react";
+
+ /**
+  * 澄清卡（M2-5）：questions 渲染表单——options 有 ⇒ radio（单选）/ checkbox（multiSelect），
+  * 无 ⇒ 文本框；提交组 ClarifyAnswerMap（key = 问题原文）交 submitClarify。
+  * 表单态 key 直接用问题原文（与提交 key 同源，纯函数负责必答校验）。
+  */
+ export function ClarifyCard(props: {
+   callId: string;
+   questions: ClarifyQuestion[];
+   onSubmit: (callId: string, answers: ClarifyAnswerMap) => void;
+ }) {
+   const [values, setValues] = useState<Record<string, string | string[]>>({});
+   const [error, setError] = useState<string | null>(null);
+
+   const setText = (question: string, text: string) => setValues((prev) => ({ ...prev, [question]: text }));
+   const toggleMulti = (question: string, label: string) =>
+     setValues((prev) => {
+       const cur = Array.isArray(prev[question]) ? (prev[question] as string[]) : [];
+       const next = cur.includes(label) ? cur.filter((l) => l !== label) : [...cur, label];
+       return { ...prev, [question]: next };
+     });
+
+   const submit = () => {
+     try {
+       setError(null);
+       props.onSubmit(props.callId, clarifyFormValues(props.questions, values));
+     } catch (e) {
+       setError(e instanceof Error ? e.message : String(e));
+     }
+   };
+
+   return (
+     <div className="card">
+       <div className="card-head">
+         <span className="ico-wait" aria-hidden="true"><MessageSquare size={15} /></span>
+         <h3>需要澄清（{props.questions.length} 问）</h3>
+         <span className="chip wait">回答后继续</span>
+       </div>
+       {props.questions.map((q, i) => {
+         const hasOptions = Array.isArray(q.options) && q.options.length > 0;
+         return (
+           <div className="q-block" key={i}>
+             {q.header && <div className="q-head">{q.header}</div>}
+             <div className="q-text">{q.question}</div>
+             {hasOptions ? (
+               <div className="opts">
+                 {q.options!.map((o) => (
+                   <label
+                     key={o.label}
+                     className={"opt" + (q.multiSelect === true
+                       ? Array.isArray(values[q.question]) && (values[q.question] as string[]).includes(o.label)
+                       : values[q.question] === o.label ? " on" : "")}
+                     title={o.description ?? undefined}
+                   >
+                     <input
+                       type={q.multiSelect === true ? "checkbox" : "radio"}
+                       name={`${props.callId}:${i}`}
+                       checked={q.multiSelect === true
+                         ? Array.isArray(values[q.question]) && (values[q.question] as string[]).includes(o.label)
+                         : values[q.question] === o.label}
+                       onChange={() => (q.multiSelect === true ? toggleMulti(q.question, o.label) : setText(q.question, o.label))}
+                     />
+                     <span className="o-label">{o.label}</span>
+                     {o.description && <span className="o-desc">{o.description}</span>}
+                   </label>
+                 ))}
+               </div>
+             ) : (
+               <div className="q-free">
+                 <input
+                   type="text"
+                   value={typeof values[q.question] === "string" ? (values[q.question] as string) : ""}
+                   aria-label={q.question}
+                   onChange={(e) => setText(q.question, e.target.value)}
+                 />
+               </div>
+             )}
+           </div>
+         );
+       })}
+       {error !== null && <div className="form-error">{error}</div>}
+       <div className="card-actions">
+         <button className="btn primary" onClick={submit}>提交回答</button>
+         <span className="spacer" />
+         <span className="consequence">带选项的问题必答；自由项可留空</span>
+       </div>
+     </div>
+   );
+ }
+
+ // 命令面板（P3-3 · brief 八）：⌘K 或侧栏搜索钮打开；可搜 会话 / 项目 / 设置页 / 常用操作；
+ // 键盘优先（cmdk 默认 ↑↓/⏎；Esc 由 Radix Dialog 收）。操作条目全部复用 App 既有能力（不另起炉灶）。
+ // 键位提示从 SHORTCUTS 表取（keysOf——单一事实源，防漂移）。
+ // 技能分组（2026-10-21 批 136）：与斜杠菜单共用 App 的 skills 数据面；空则整组缺席，不摆空组。
+ import { Command } from "cmdk";
+ import { useNow } from "../useNow";
+ import { Archive, Brain, Clock3, Copy, Download, FileText, Folder, FolderOpen, FolderPlus, MessageSquare, PanelLeft, PanelRight, Pencil, Plus, Puzzle, Search, Shield, Sun, Trash2, Wand2 } from "lucide-react";
+ import { useEffect, useState } from "react";
+ import { RenderErrorBoundary } from "./RenderErrorBoundary";
+ import { SessionSearchResults, type SessionSearchState } from "./SessionSearchResults";
+ import { relativeTime } from "../projections";
+ import { sessionTime, type WorkspaceSession } from "../sessions-view";
+ import { keysOf } from "../shortcuts";
+ import { SECTIONS, SECTION_KEYWORDS, type SectionId } from "./settings-nav";
+ import { APP_DESTINATIONS, APP_DESTINATION_LABEL } from "../navigation";
+
+ import type { AppDestination, PaletteAction } from "../app-controls";
+ export type { PaletteAction } from "../app-controls";
+
+ const DESTINATION_ICON: Record<AppDestination, React.JSX.Element> = {
+   chat: <MessageSquare size={14} />,
+   plugins: <Puzzle size={14} />,
+   memory: <Brain size={14} />,
+   automation: <Clock3 size={14} />,
+ };
+
+ /** 操作组条目表（shortcutId 从 SHORTCUTS 取键位——表里改键，这里自动跟）。
+  *  2026-10-21 命令面板 2.0：每条带图标与搜索同义词；`sessionOnly` 的条目只在有活动会话时出现
+  *  ——在主页摆「压缩历史」等于给一个必然报错的入口。 */
+ const OPS: readonly {
+   id: PaletteAction;
+   label: string;
+   icon: React.JSX.Element;
+   shortcutId?: string;
+   keywords?: string;
+   sessionOnly?: boolean;
+ }[] = [
+   { id: "new-session", label: "新任务", icon: <Plus size={14} />, shortcutId: "new-session", keywords: "新建 会话 任务" },
+   { id: "open-folder", label: "打开文件夹", icon: <FolderOpen size={14} />, shortcutId: "open-folder", keywords: "目录 项目 打开" },
+   { id: "new-project", label: "添加项目", icon: <FolderPlus size={14} />, keywords: "创建 新建 文件夹" },
+   { id: "toggle-theme", label: "切换主题", icon: <Sun size={14} />, keywords: "外观 深色 暗色 亮色" },
+   { id: "cycle-perm", label: "切换权限档", icon: <Shield size={14} />, keywords: "权限 只读 自动 审批" },
+   { id: "toggle-sidebar", label: "开合侧栏", icon: <PanelLeft size={14} />, shortcutId: "sidebar", keywords: "收起 展开 左侧" },
+   { id: "toggle-inspector", label: "开合检查器", icon: <PanelRight size={14} />, shortcutId: "inspector", keywords: "右侧 面板 收起 展开" },
+   { id: "find-in-session", label: "在当前会话中查找", icon: <Search size={14} />, shortcutId: "find", keywords: "搜索 查找", sessionOnly: true },
+   { id: "copy-transcript", label: "复制整段对话", icon: <Copy size={14} />, keywords: "复制 对话 全文", sessionOnly: true },
+   { id: "compact", label: "压缩当前会话历史", icon: <Archive size={14} />, keywords: "压缩 上下文 历史", sessionOnly: true },
+   { id: "view-log", label: "查看当前会话日志", icon: <FileText size={14} />, keywords: "日志 错误 排障", sessionOnly: true },
+   { id: "export-transcript", label: "导出整段对话（Markdown 文件）", icon: <Download size={14} />, keywords: "导出 保存 文件 markdown", sessionOnly: true },
+ ];
+
+ /** 最近使用（只存 action id，打开面板时按当前上下文过滤）：上限 4，去重后置顶。
+  *  纯函数导出给判卷；localStorage 读写留在组件内。 */
+ export const PALETTE_RECENT_LIMIT = 4;
+ const PALETTE_RECENT_KEY = "cairn.palette.recent.v1";
+ const ACTION_IDS: ReadonlySet<string> = new Set(OPS.map((op) => op.id));
+ const SESSION_ONLY: ReadonlySet<PaletteAction> = new Set(OPS.filter((op) => op.sessionOnly === true).map((op) => op.id));
+
+ function isPaletteAction(v: unknown): v is PaletteAction {
+   return typeof v === "string" && ACTION_IDS.has(v);
+ }
+
+ export function pushRecentAction(prev: readonly PaletteAction[], id: PaletteAction): PaletteAction[] {
+   return [id, ...prev.filter((x) => x !== id)].slice(0, PALETTE_RECENT_LIMIT);
+ }
+
+ /** 最近列表按当前上下文过滤：主页不显示会话专属动作（与操作组同一条规则）。 */
+ export function visibleRecentActions(prev: readonly PaletteAction[], sessionOpen: boolean): PaletteAction[] {
+   return prev.filter((id) => isPaletteAction(id) && (sessionOpen || !SESSION_ONLY.has(id))).slice(0, PALETTE_RECENT_LIMIT);
+ }
+
+ /** 技能/命令去重（2026-10-21 评审）：插件技能与命令都可能解析成同一个 `/plugin:name`，
+  *  同一 invoke 摆两行既是 React key 撞车，也让"选中哪个"没有确定答案。先到先得，保留首条。 */
+ export function uniqueSkills<T extends { invoke: string }>(skills: readonly T[]): T[] {
+   const seen = new Set<string>();
+   return skills.filter((s) => {
+     if (seen.has(s.invoke)) return false;
+     seen.add(s.invoke);
+     return true;
+   });
+ }
+
+ function loadRecentActions(): PaletteAction[] {
+   if (typeof window === "undefined") return [];
+   try {
+     const raw: unknown = JSON.parse(window.localStorage.getItem(PALETTE_RECENT_KEY) ?? "[]");
+     return Array.isArray(raw) ? raw.filter(isPaletteAction).slice(0, PALETTE_RECENT_LIMIT) : [];
+   } catch { return []; }
+ }
+
+ function rememberRecentAction(prev: readonly PaletteAction[], id: PaletteAction): PaletteAction[] {
+   const next = pushRecentAction(prev, id);
+   try { window.localStorage.setItem(PALETTE_RECENT_KEY, JSON.stringify(next)); } catch { /* 存不下则只在本次打开期间生效 */ }
+   return next;
+ }
+
+ type FileSearchState =
+   | { status: "loading" }
+   | { status: "ready"; hits: readonly { path: string; kind: "file" | "directory" }[]; truncated: boolean }
+   | { status: "error"; error: string };
+
+ const baseNameOf = (path: string): string => path.slice(path.lastIndexOf("/") + 1);
+ const parentOf = (path: string): string => {
+   const at = path.lastIndexOf("/");
+   return at < 0 ? "" : path.slice(0, at);
+ };
+
+ export interface PaletteContentProps {
+   /** 正文搜索只读当前已选择的项目；标题检索仍覆盖会话清单。 */
+   activeWorkspace?: string | null;
+   /** 工作区技能/插件命令（与斜杠菜单同一份数据面；缺省 = 不摆空组）。 */
+   skills?: readonly { invoke: string; description: string; trust: string }[];
+   /** 选中技能：App 关闭面板并把 `/invoke ` 填进输入框（不直接发送）。 */
+   onUseSkill?: (invoke: string) => void;
+   sessions: readonly WorkspaceSession[];
+   projects: readonly { id: string; name: string; path: string }[];
+   onOpenSession: (id: string, workspace?: string) => void;
+   onSwitchWorkspace: (path: string) => void;
+   onOpenSettings: (section: SectionId) => void;
+   onOpenDestination: (destination: AppDestination) => void;
+   /** 文件快速打开：只对当前工作区搜文件名；选中后由 App 打开文件窗格并预览该文件。 */
+   onOpenFile?: (path: string) => void;
+   onAction: (action: PaletteAction) => void;
+   /** 单会话动作（2026-10-18 补）：改名 / 归档 / 删除此前只在侧栏行内 ⋯ 菜单里，
+    *  命令面板列得出会话却不给动作——用户搜到某个会话后想改名，得关掉面板去侧栏找那一行。
+    *  App 侧把行菜单的同一批 handler 传下来（requestArchiveSession 自带确认卡，delete 同）。 */
+   onSessionAction?: (action: "rename" | "archive" | "delete", id: string) => void;
+   /** 当前打开的会话（单会话动作的作用对象）；null = 在主页，不给这三条。 */
+   activeSessionId?: string | null;
+ }
+
+ /** 内容面（判卷/嵌用）：Command root 由外层给——CommandPalette 用 CommandDialog 包，判卷用裸 Command。 */
+ export function PaletteContent(props: PaletteContentProps): React.JSX.Element {
+   const visible = props.sessions.filter((s) => s.archived !== true); // 归档不列（侧栏同口径）；搜索即过滤
+   const now = useNow();
+   const sessionOpen = props.activeSessionId !== undefined && props.activeSessionId !== null;
+   const skillItems = uniqueSkills(props.skills ?? []);
+   const [query, setQuery] = useState("");
+   const [recent, setRecent] = useState<PaletteAction[]>(loadRecentActions);
+   const searchQuery = query.trim();
+   const searchWorkspace = props.activeWorkspace ?? null;
+   const [retrySearch, setRetrySearch] = useState(0);
+   const [bodySearch, setBodySearch] = useState<{ query: string; workspace: string; state: SessionSearchState } | null>(null);
+   useEffect(() => {
+     if (searchQuery === "" || searchWorkspace === null) { setBodySearch(null); return; }
+     let alive = true;
+     const update = (state: SessionSearchState): void => {
+       if (alive) setBodySearch({ query: searchQuery, workspace: searchWorkspace, state });
+     };
+     update({ status: "loading" });
+     const timer = window.setTimeout(() => {
+       void Promise.resolve().then(() => window.agent.sessionSearch(searchWorkspace, searchQuery)).then(
+         (result) => update(result === undefined
+           ? { status: "error", error: "正文搜索没有返回结果，请重试" }
+           : { status: "ready", result }),
+         (error: unknown) => update({ status: "error", error: `正文搜索失败：${error instanceof Error ? error.message : String(error)}` }),
+       );
+     }, 200);
+     return () => { alive = false; window.clearTimeout(timer); };
+   }, [searchQuery, searchWorkspace, retrySearch]);
+   // 文件快速打开：与正文搜索同一条输入、同一工作区；只取文件名/路径命中（不搜正文）。
+   // 160ms 防抖；错误与截断都如实呈现，不用空组冒充「没有匹配」。
+   const [fileSearch, setFileSearch] = useState<FileSearchState | null>(null);
+   useEffect(() => {
+     if (searchQuery === "" || searchWorkspace === null) { setFileSearch(null); return; }
+     let alive = true;
+     setFileSearch({ status: "loading" });
+     const timer = window.setTimeout(() => {
+       void Promise.resolve().then(() => window.agent.workspaceSearch(searchWorkspace, searchQuery)).then(
+         (result) => {
+           if (!alive) return;
+           if (result === undefined) setFileSearch({ status: "error", error: "文件搜索没有返回结果，请重试" });
+           else if (result.ok) setFileSearch({ status: "ready", hits: result.hits, truncated: result.truncated });
+           else setFileSearch({ status: "error", error: result.error });
+         },
+         (error: unknown) => {
+           if (alive) setFileSearch({ status: "error", error: `文件搜索失败：${error instanceof Error ? error.message : String(error)}` });
+         },
+       );
+     }, 160);
+     return () => { alive = false; window.clearTimeout(timer); };
+   }, [searchQuery, searchWorkspace]);
+   const searchActive = searchQuery !== "" && searchWorkspace !== null;
+   const fileHits = props.onOpenFile === undefined || fileSearch?.status !== "ready"
+     ? []
+     : fileSearch.hits.filter((hit) => hit.kind === "file").slice(0, 8);
+   const searchState: SessionSearchState = bodySearch?.query === searchQuery && bodySearch.workspace === searchWorkspace
+     ? bodySearch.state : { status: "loading" };
+
+   const actions = OPS.filter((op) => op.sessionOnly !== true || sessionOpen);
+   const recents = query.trim() === "" ? visibleRecentActions(recent, sessionOpen) : [];
+   // 单会话动作的键位也走表（文件头第 3 行写的就是「单一事实源，防漂移」）。
+   const renameKeys = keysOf("rename");
+   const runAction = (id: PaletteAction): void => {
+     setRecent(rememberRecentAction(recent, id));
+     props.onAction(id);
+   };
+   return (
+     <>
+       {/* 搜索行（2026-10-17）：图标 + 吃满面板宽度的输入框。此前 .cp-input 不设宽，实测 186px，
+           占位符被截半句；行容器补图标后与 Claude 命令面板同形。 */}
+       <div className="cp-search">
+         <Search size={14} className="cp-search-ico" aria-hidden="true" />
+         <Command.Input
+           className="cp-input"
+           placeholder="搜索会话、项目、设置与常用操作…"
+           value={query}
+           onValueChange={setQuery}
+           autoFocus
+         />
+       </div>
+       <Command.List className="cp-list">
+         {!searchActive && <Command.Empty className="cp-empty">没有匹配的结果</Command.Empty>}
+         {/* 最近使用（2026-10-21）：空查询时把最近 4 条放到最上面；输入后自然让位给搜索结果。
+             只存 action id，不存文案——文案/键位仍只从 OPS 与 SHORTCUTS 取。 */}
+         {recents.length > 0 && (
+           <Command.Group heading="最近" className="cp-group cp-recent">
+             {recents.map((id) => {
+               const op = OPS.find((o) => o.id === id);
+               if (op === undefined) return null;
+               const k = op.shortcutId !== undefined ? keysOf(op.shortcutId) : null;
+               return (
+                 <Command.Item
+                   key={`recent-${id}`}
+                   value={`最近 ${op.label} ${op.keywords ?? ""}`}
+                   className="cp-item"
+                   onSelect={() => { runAction(op.id); }}
+                 >
+                   <span className="cp-ico" aria-hidden="true">{op.icon}</span>
+                   <span className="cp-label">{op.label}</span>
+                   {k !== null && <span className="cp-keys">{k}</span>}
+                 </Command.Item>
+               );
+             })}
+           </Command.Group>
+         )}
+         <Command.Group heading="操作" className="cp-group">
+           {actions.map((op) => {
+             const k = op.shortcutId !== undefined ? keysOf(op.shortcutId) : null;
+             return (
+               <Command.Item
+                 key={op.id}
+                 value={`${op.label} ${op.keywords ?? ""}`}
+                 className="cp-item"
+                 onSelect={() => { runAction(op.id); }}
+               >
+                 <span className="cp-ico" aria-hidden="true">{op.icon}</span>
+                 <span className="cp-label">{op.label}</span>
+                 {k !== null && <span className="cp-keys">{k}</span>}
+               </Command.Item>
+             );
+           })}
+         </Command.Group>
+         {skillItems.length > 0 && props.onUseSkill !== undefined && (
+           <Command.Group heading="技能" className="cp-group">
+             {skillItems.map((sk) => {
+               const pending = sk.trust !== "trusted";
+               return (
+                 <Command.Item
+                   key={`skill-${sk.invoke}`}
+                   value={`技能 ${sk.invoke} ${sk.description}`}
+                   className="cp-item cp-skill"
+                   onSelect={() => { props.onUseSkill?.(sk.invoke); }}
+                 >
+                   <span className="cp-ico" aria-hidden="true"><Wand2 size={14} /></span>
+                   <span className="cp-stack">
+                     <span className="cp-label">{sk.invoke}</span>
+                     <span className="cp-sub" title={sk.description}>{sk.description}</span>
+                   </span>
+                   {pending && <span className="cp-trust">{sk.trust === "declined" ? "已拒绝" : "待批准"}</span>}
+                 </Command.Item>
+               );
+             })}
+           </Command.Group>
+         )}
+         {searchActive && props.onOpenFile !== undefined && fileSearch?.status === "error" && (
+           <Command.Group heading="文件" className="cp-group">
+             <div className="cp-empty" role="status">文件搜索失败：{fileSearch.error}</div>
+           </Command.Group>
+         )}
+         {searchActive && fileHits.length > 0 && (
+           <Command.Group heading="文件" className="cp-group">
+             {fileHits.map((hit) => {
+               const dir = parentOf(hit.path);
+               return (
+                 <Command.Item
+                   key={`file-${hit.path}`}
+                   value={`文件 ${hit.path}`}
+                   className="cp-item"
+                   data-file={hit.path}
+                   onSelect={() => props.onOpenFile?.(hit.path)}
+                 >
+                   <span className="cp-ico" aria-hidden="true"><FileText size={14} /></span>
+                   <span className="cp-label" title={hit.path}>{baseNameOf(hit.path)}</span>
+                   <span className="cp-at">{dir === "" ? "工作区根" : dir}</span>
+                 </Command.Item>
+               );
+             })}
+             {fileSearch?.status === "ready" && fileSearch.truncated && (
+               <div className="cp-empty">文件结果已截断（只显示前若干项）</div>
+             )}
+           </Command.Group>
+         )}
+         {searchActive && (
+           <SessionSearchResults
+             state={searchState}
+             workspace={searchWorkspace}
+             onOpenSession={props.onOpenSession}
+             onRetry={() => { setRetrySearch((n) => n + 1); }}
+           />
+         )}
+         {visible.length > 0 && (
+           <Command.Group heading="会话" className="cp-group">
+             {visible.slice(0, 30).map((s) => (
+               <Command.Item key={`${s.workspace ?? ""}|${s.id}`} value={`${s.title ?? s.id} ${s.id}`} className="cp-item" onSelect={() => props.onOpenSession(s.id, s.workspace)}>
+                 <span className="cp-ico" aria-hidden="true"><MessageSquare size={14} /></span>
+                 <span className="cp-label">{s.title ?? s.id}</span>
+                 <span className="cp-at num">{relativeTime(now, sessionTime(s))}</span>
+               </Command.Item>
+             ))}
+             {/* 单会话动作（2026-10-18 补）：对**当前打开的那个会话**生效，不再让用户
+                 关掉面板去侧栏行内找 ⋯ 菜单。归档/删除都走 App 侧带确认卡的同一入口。 */}
+             {props.onSessionAction !== undefined && props.activeSessionId !== undefined && props.activeSessionId !== null && (
+               <>
+                 <Command.Item
+                   className="cp-item"
+                   value="重命名当前会话"
+                   onSelect={() => { props.onSessionAction?.("rename", props.activeSessionId ?? ""); }}
+                 >
+                   <span className="cp-ico" aria-hidden="true"><Pencil size={14} /></span>
+                   <span className="cp-label">重命名当前会话</span>
+                   {renameKeys !== null && <span className="cp-keys">{renameKeys}</span>}
+                 </Command.Item>
+                 <Command.Item
+                   className="cp-item"
+                   value="归档当前会话"
+                   onSelect={() => { props.onSessionAction?.("archive", props.activeSessionId ?? ""); }}
+                 >
+                   <span className="cp-ico" aria-hidden="true"><Archive size={14} /></span>
+                   <span className="cp-label">归档当前会话</span>
+                 </Command.Item>
+                 <Command.Item
+                   className="cp-item"
+                   value="删除当前会话"
+                   onSelect={() => { props.onSessionAction?.("delete", props.activeSessionId ?? ""); }}
+                 >
+                   <span className="cp-ico" aria-hidden="true"><Trash2 size={14} /></span>
+                   <span className="cp-label">删除当前会话</span>
