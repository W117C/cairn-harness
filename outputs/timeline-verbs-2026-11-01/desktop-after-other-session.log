+         if (entry === undefined) return null;
+         return (
+           <ConfirmDialog
+             title="恢复这条全局经验？"
+             note={"恢复前会复核 ≥3 个 workspace 的存储证据；失效会拒绝并保持 dormant。\n" + entry.body}
+             confirmLabel="恢复"
+             onClose={() => { setRestoreTarget(null); }}
+             onConfirm={() => {
+               const id = entry.id;
+               setRestoreTarget(null);
+               props.onRestoreGlobal?.(id);
