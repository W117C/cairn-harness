+ const CAPABILITY_LABEL = {
+   skills: "技能",
+   commands: "命令",
+   agents: "智能体",
+   hooks: "hooks",
+   mcp: "MCP",
+   lsp: "LSP",
+ } as const;
+
+ export interface PluginDetailProps {
