+       if (rect === undefined) return;
+       const layout = modelMenuLayout(rect.top, rect.bottom, window.innerHeight);
+       setMenuMax(layout.maxHeight);
+       setMenuUp(layout.up);
+       setMenuPosition(layout.viewportTop === undefined ? undefined : {
+         top: layout.viewportTop - rect.top,
+         left: Math.max(12, Math.min(rect.left, window.innerWidth - 356)) - rect.left,
+       });
+     };
+     update();
+     window.addEventListener("resize", update);
+     return () => { window.removeEventListener("resize", update); };
+   }, [open]);
+   // 信号开菜单：seq 前进且未被**硬锁**（disabled：门槛/排队读回）才开。
+   // v7.2 业主裁后 running 不再折进 disabled ⇒ ⌘⇧E 运行中也能开（思考档要能调）。
+   //
+   // 首帧只**对齐**、不开（2026-10-19 独立评审追出）：ModelPicker 按 `key={draftKey}` 在切会话时
+   // 重挂（见 Composer.tsx 的注释），重挂会把 `lastOpenSeq` 这个 ref 复位成 0；而 Composer 那边的
+   // `pickerOpenSeq` 不会重挂、还留着上一次 ⌘⇧I 的值（3 之类）⇒ 重挂后的 picker 看到
+   // "openSeq(3) > lastOpenSeq(0)" ⇒ **切会话时菜单自己弹开**，悬在新会话的输入框上抢焦点——
+   // 正是那个 key 原本要防的症状（"模型搜索框还开着"）。
+   // 修法：首帧把基线对齐到当前 openSeq（此后只在它**真的前进**时开），语义不变：
+   // "seq 前进一次 = 开一次"，重挂不算前进。
+   const lastOpenSeq = useRef<number | null>(null);
+   useEffect(() => {
+     if (props.openSeq === undefined) return;
+     const step = nextOpenSeqState(lastOpenSeq.current, props.openSeq);
+     lastOpenSeq.current = step.baseline;
+     if (step.open && props.disabled !== true) setOpen(true);
+   }, [props.openSeq, props.disabled]);
+   const allOptions = flattenModels(props.infos);
+   const options = props.configuredProviders === undefined
+     ? allOptions
+     : allOptions.filter((o) => o.provider === null || props.configuredProviders!.has(o.provider));
+   const info = props.infos[0] ?? null;
+   const notice = pickerKeyNotice(info);
+   // 当前选中模型**自己声明**的思考档（缺席 = 该模型不支持思考）。
+   const selected = options.find((o) => o.registryId === props.value);
+   // 芯片显示的是**当前档**（用户设的那一档 = 真正发出去的那一档；既有契约）。
+   const level = props.thinking ?? "off";
+   // 归位档：当前档不被该模型支持时的落点（对标 Codex 的 defaultReasoningEffort）。
+   // 归位**不在显示层偷换**（芯片不许显示一档、请求发另一档），
+   // 而是由下面的 effect 把它写回状态 ⇒ 显示与请求永远同一个。
+   const reconciled = reconcileThinkingLevel(level, selected?.thinkingLevels, selected?.thinkingDefault);
+   const levelLabel = THINKING_LEVELS.find((l) => l.id === level)?.short ?? STR.modelPicker.thinkOff;
+   // 首次挂载不弹（那是「进场」）；换过模型之后才弹（那是「值变了」）。
+   const everPicked = useRef(false);
+   // 换模型 ⇒ 思考档归位（对标 Codex）：两条路径都走这里——用户在菜单里点模型，
+   // 以及父级直接换 value（切会话 / 恢复会话 / provider 列表变了）。
+   // 只在「归位档 ≠ 当前档」时写回，避免来回写回造成死循环。
+   useEffect(() => {
+     if (props.onThinkingChange === undefined) return;
+     if (reconciled !== level) props.onThinkingChange(reconciled);
+     // 依赖只认 value：档本身变化不该再触发一次归位（那是 effect 自己写的）。
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+   }, [props.value]);
+
+   const close = useCallback(() => setOpen(false), [setOpen]);
+   // 外点 / Esc 关闭：单源在 Popover（阶段 1 共享化；行为与旧内联监听逐条同构）。
+   usePopoverDismiss(open, close, box, triggerRef);
+
+   const pick = (registryId: string | null): void => {
+     // 换模型 ⇒ 思考档**归位**（对标 Codex）：新模型不支持当前档时，当场落到它的缺省档
+     // 并通知上层。否则给不支持思考的模型发思考参数（provider 侧会拒）。
+     const next = options.find((o) => o.registryId === registryId);
+     const nextLevel = reconcileThinkingLevel(level, next?.thinkingLevels, next?.thinkingDefault);
+     if (nextLevel !== level) props.onThinkingChange?.(nextLevel);
+     everPicked.current = true;
+     props.onChange(registryId);
+     close();
+   };
+
+   return (
+     <div className="mp" ref={box}>
+       <button
+         type="button"
+         className="mp-trigger"
+         ref={triggerRef}
+         aria-label={STR.modelPicker.triggerAria}
+         aria-haspopup="dialog"
+         aria-expanded={open}
+         title={describeSelection(props.value, options)}
+         disabled={props.disabled}
+         onClick={() => { props.onUserOpen?.(); setOpen(!open); }}
+       >
+         {/* 芯片的值变了 ⇒ 名字这一格**重挂** ⇒ 播放「弹一下」的动效（对标 Claude 的
+             cds-pill-pop：上冲 40% 时长到 1.32，再落回，overshoot 收尾）。
+             key 变了 ⇒ React 重挂 ⇒ CSS 动画重播（不必手动重置动画状态）。 */}
+         <span className="mp-name" key={`mp-name-${String(props.value)}`} data-pop={everPicked.current ? "true" : "false"}>
+           {shortModelName(props.value, options)}
+           {/* 「· 思考 X」段只在模型真声明支持时出现——没能力的模型不带这个按键面（业主 22.01 裁）。 */}
+           {props.onThinkingChange !== undefined && props.thinkingSupported === true
+             ? STR.modelPicker.thinkingChip.replace("{level}", levelLabel)
+             : ""}
+         </span>
+         {props.sessionOverride === true && <span className="mp-dot" aria-label={STR.modelPicker.sessionDotAria} />}
+         <span className="mp-caret" aria-hidden="true"><ChevronDown size={10} /></span>
+       </button>
+       {open && (
+         <ModelMenu
+           up={menuUp}
+           options={options}
+           value={props.value}
+           maxHeight={menuMax}
+           viewportPosition={menuPosition}
+           {...(props.disabled === true || props.running === true ? { running: true } : {})}
+           initialFocus={props.initialFocus ?? "model"}
+           keyNotice={notice}
+           {...(props.onOpenSettings !== undefined ? { onOpenSettings: props.onOpenSettings } : {})}
+           {...(props.onThinkingChange !== undefined
+             ? {
+                 thinking: reconciled,
+                 thinkingSupported: props.thinkingSupported === true,
+                 ...(selected?.thinkingLevels !== undefined ? { thinkingLevels: selected.thinkingLevels } : {}),
+                 onThinkingChange: props.onThinkingChange,
+               }
+             : {})}
+           onPick={pick}
+         />
+       )}
+     </div>
+   );
+ }
+
+ /** 菜单本体（P2-2 合并单面）：搜索 + 模型列表 + 下半区思考强度 Segmented。
+  *  纯展示、可服务端渲染。
+  *
+  *  判卷约束（render-structure.test.tsx 钉住的序列不许变形）：分组头 `>openai<`、
+  *  子行 `标准 · 窗口 128k`、勾 `class="check">✓<`、`⚠ OpenAI 未配置 key · 去设置配置`
+  *  （⚠ 字面量**豁免**于全局 emoji 清理）、空目录两串、aria-selected 计数、running disabled 计数；
+  *  思考段钉分段 aria-pressed / title 逐档说明 / 未声明整段禁用数。 */
+ export function ModelMenu(props: {
+   options: readonly ModelOption[];
+   value: string | null;
+   /** 运行中：模型列表整列禁用（规范「运行中 disabled」）；**思考强度不在此列**——
+    *  v7.2 业主裁：思考档是「下一轮派活」的旋钮，跑着也能拧（只随 capability 锁）。 */
+   running?: boolean;
+   /** key 未配置时的置顶提示行；undefined / null = 不显示。 */
+   keyNotice?: string | null;
+   onPick: (registryId: string | null) => void;
+   onOpenSettings?: () => void;
+   /** 向上开时允许的最大高度（px）；undefined = 不限制（测试/旧调用）。 */
+   maxHeight?: number;
+   viewportPosition?: { top: number; left: number };
+   up?: boolean;
+   /** 当前思考档位（缺省 off）。 */
+   thinking?: string;
+   /** 当前模型**自己声明**的思考档位；给了就只出这些档（对标 Codex 的 supportedReasoningEfforts）。
+    *  不给 = 沿用全局四档（旧行为；未声明支持的模型整段禁用，见下）。 */
+   thinkingLevels?: readonly string[];
+   /** 当前模型是否**声明**支持思考档位；未声明 ⇒ 整区禁用 + 注记 + 配置折叠（fail-visible）。 */
+   thinkingSupported?: boolean;
+   onThinkingChange?: (level: string) => void;
+   /** 打开落点（2026-10-18）：effort = 首帧把焦点送进思考档分段（⌘⇧E）；
+    *  model = 保持搜索框 autofocus（⌘⇧I / 点击）。 */
+   initialFocus?: "model" | "effort";
+ }): React.JSX.Element {
+   const wantEffort = props.onThinkingChange !== undefined;
+   const [query, setQuery] = useState("");
+   const [hl, setHl] = useState(() => {
+     const ordered = [...groupModels(props.options).flatMap((g) => g.models), { registryId: null }];
+     return Math.max(0, ordered.findIndex((m) => m.registryId === props.value));
+   });
+   const listId = useId();
+   const listRef = useRef<HTMLDivElement>(null);
+   const filtered = filterModelOptions(props.options, query);
+   const groups = groupModels(filtered);
+   const demoVisible = query.trim() === "";
+   const flat: ModelOption[] = [
+     ...groups.flatMap((g) => g.models),
+     ...(demoVisible ? [{ registryId: null, label: STR.modelPicker.demo, provider: null } as ModelOption] : []),
+   ];
+   const warn = props.keyNotice !== undefined && props.keyNotice !== null;
+   const modelsDisabled = props.running === true;
+   const supported = props.thinkingSupported === true;
+   const level = props.thinking ?? "off";
+   // 档位列表 = **当前模型声明的档**（对标 Codex：每个模型带自己的 supportedReasoningEfforts）。
+   // 此前无论哪个模型都摆全局四档 ⇒ 能选到该模型不支持的档（请求会被 provider 拒）。
+   // 模型没声明 ⇒ 沿用四档但整段禁用（fail-visible，见下方 unsupportedNote）。
+   const declared = props.thinkingLevels;
+   // 2026-10-31 · 业主「有多少档、用户可以自己定义，但默认从上游得知」：
+   // 声明表仍由上游决定（capability），用户只能收起不想看到的档（存 localStorage，见 state/thinking-prefs）。
+   const [hidden, setHidden] = useState<readonly string[]>(() => {
+     if (props.value === null) return [];
+     return readThinkingHidden()[props.value] ?? [];
+   });
+   const [editingEfforts, setEditingEfforts] = useState(false);
+   useEffect(() => {
+     setHidden(props.value === null ? [] : readThinkingHidden()[props.value] ?? []);
+     setEditingEfforts(false);
+   }, [props.value]);
+   const declaredIds = declared ?? THINKING_LEVELS.map((l) => l.id);
+   const visibleIds = visibleThinkingLevels(declaredIds, hidden);
+   const levels: readonly { id: string; short: string; hint: string }[] = (declared === undefined || declared.length === 0
+     ? THINKING_LEVELS.map((l) => l.id)
+     : declaredIds
+   ).filter((id) => visibleIds.includes(id)).map((id) => THINKING_LEVELS.find((l) => l.id === id) ?? { id, short: id, hint: "" });
+   const levelLabelOf = (id: string): string => THINKING_LEVELS.find((l) => l.id === id)?.short ?? id;
+   const modelDefaultLevel = props.options.find((o) => o.registryId === props.value)?.thinkingDefault;
+   // 用户收起当前档 ⇒ 当场归位（显示与请求永远同一个；与换模型归位同一条契约）。
+   useEffect(() => {
+     if (!supported) return;
+     const next = reconcileVisibleLevel(level, levels.map((l) => l.id), modelDefaultLevel);
+     if (next !== level) props.onThinkingChange?.(next);
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+   }, [hidden, props.value]);
+   const commitHidden = (next: readonly string[]): void => {
+     if (props.value === null) return;
+     const map = { ...readThinkingHidden(), [props.value]: next };
+     writeThinkingHidden(map);
+     setHidden(next);
+   };
+   const optionId = (index: number): string => `${listId}-option-${index}`;
+   useEffect(() => {
+     listRef.current?.querySelector<HTMLElement>('[data-highlighted="true"]')?.scrollIntoView({ block: "nearest" });
+   }, [hl, query]);
+   // ⌘⇧E 的落点（2026-10-18）：首帧滚到思考分段并聚焦当前档按钮；模型不声明思考时
+   // 分段整区禁用——聚焦分组本身（读屏仍报「思考强度，不可用」+ 下方说明），不静默。
+   const effortRef = useRef<HTMLDivElement | null>(null);
+   const searchRef = useRef<HTMLInputElement | null>(null);
+   useEffect(() => {
+     if (props.initialFocus !== "effort") { searchRef.current?.focus(); return; }
+     const box = effortRef.current;
+     if (box === null) return;
+     const target = box.querySelector<HTMLButtonElement>('button[aria-pressed="true"]:not(:disabled)') ?? box.querySelector<HTMLButtonElement>("button:not(:disabled)") ?? box;
+     target.focus({ preventScroll: true });
+     target.scrollIntoView({ block: "nearest" });
+   }, [props.initialFocus]);
+
+   const onKeyNav = (e: React.KeyboardEvent): void => {
+     if (isCompositionEnter(e, null) || modelsDisabled) return;
+     const targetElement = e.target as HTMLElement;
+     const inSearch = targetElement === searchRef.current;
+     if (!inSearch && targetElement.closest('[role="option"]') === null) return;
+     // 蓝本 §3.6：在打开的列表里 1–9 选第 N 项。搜索框里的数字是**输入**不是选择——先让路。
+     if (/^[1-9]$/.test(e.key) && !(e.target instanceof HTMLInputElement)) {
+       const target = flat[Number(e.key) - 1];
+       if (target !== undefined) { e.preventDefault(); props.onPick(target.registryId); }
+       return;
+     }
+     const next = inSearch && (e.key === "Home" || e.key === "End") ? null : menuNavIndex(e.key, hl, flat.length);
+     if (next !== null) { e.preventDefault(); setHl(next); }
+     else if (e.key === "Enter") {
+       const target = flat[hl];
+       if (target !== undefined) { e.preventDefault(); props.onPick(target.registryId); }
+     }
+   };
+
+   return (
+     <Popover
+       open
+       up={props.up !== false}
+       className="mp-pop"
+       role="dialog"
+       aria-label={STR.modelPicker.menuAria}
+       onKeyDown={onKeyNav}
+       style={{ maxHeight: props.maxHeight, ...(props.viewportPosition === undefined ? {} : { bottom: "auto", ...props.viewportPosition }) }}
+     >
+       <div className="mp-search">
+         <Search size={14} aria-hidden="true" />
+         <input
+           ref={searchRef}
+           type="text"
+           role="combobox"
+           aria-expanded="true"
+           aria-autocomplete="list"
+           aria-controls={listId}
+           aria-activedescendant={flat[hl] === undefined || modelsDisabled ? undefined : optionId(hl)}
+           aria-label={STR.modelPicker.searchAria}
+           placeholder={STR.modelPicker.searchPlaceholder}
+           value={query}
+           autoFocus
+           onChange={(e) => { setQuery(e.target.value); setHl(0); }}
+         />
+       </div>
+       {warn && (
+         <button type="button" className="menu-item mp-warn" onClick={() => props.onOpenSettings?.()}>
+           <span>⚠ {props.keyNotice}</span>
+         </button>
+       )}
+       <div id={listId} className="mp-models" role="listbox" aria-label={STR.modelPicker.menuAria} ref={listRef}>
+       {groups.map((g, gi) => (
+         <div key={g.provider} className={"mp-group" + (gi > 0 ? " separated" : "")}>
+           <div className="mp-group-label">
+             {/* 分组圆点：中性灰（v7.1 业主裁——按 provider 名取色相是装饰性用色，会被误读成状态点）。 */}
+             <span className="g-dot" aria-hidden="true" />
+             <span>{g.provider}</span>
+           </div>
+           {g.models.map((m) => (
+             <button
+               key={m.registryId ?? "demo"}
+               type="button"
+               role="option"
+               id={optionId(flat.indexOf(m))}
+               aria-selected={m.registryId === props.value}
+               className="menu-item"
+               disabled={modelsDisabled}
+               tabIndex={-1}
+               data-highlighted={flat.indexOf(m) === hl}
+               title={STR.modelPicker.tierMeta.replace("{tier}", tierBadge(m.tier)).replace("{ctx}", formatCtxWindow(m.ctxWindow))}
+               onPointerMove={() => setHl(flat.indexOf(m))}
+               onFocus={() => setHl(flat.indexOf(m))}
+               onClick={() => props.onPick(m.registryId)}
+             >
+               <span className="mi-name">{m.label}</span>
+               <span className="sub">
+                 {m.ctxWindow !== undefined ? formatCtxWindow(m.ctxWindow) : ""}
+               </span>
+               {m.vision === true && <span className="v-badge" title={STR.modelPicker.visionTip}><Eye size={11} /></span>}
+               {m.registryId === props.value && <span className="check">✓</span>}
+             </button>
+           ))}
+         </div>
+       ))}
+       {groups.length === 0 && !demoVisible && (
+         <div className="pop-label">{STR.modelPicker.noMatch.replace("{q}", query.trim())}</div>
+       )}
+       {groups.length === 0 && demoVisible && (
+         <div className="pop-label">{STR.modelPicker.noModels}</div>
+       )}
+       {demoVisible && (
+         <button
+           type="button"
+           role="option"
+           id={optionId(flat.length - 1)}
+           aria-selected={props.value === null}
+           className="menu-item"
+           tabIndex={-1}
+           data-highlighted={hl === flat.length - 1}
+           onPointerMove={() => setHl(flat.length - 1)}
+           disabled={props.running === true}
+           // 行副文案放短词（长句在 300px 菜单里折成两行、行高翻倍）；完整免责句进 title 与触发条。
+           title={STR.modelPicker.demoTitle}
+           onClick={() => props.onPick(null)}
+         >
+           <span className="mi-name">{STR.modelPicker.demo}</span>
+           <span className="sub">{STR.modelPicker.demoSub}</span>
+           {props.value === null && <span className="check">✓</span>}
+         </button>
+       )}
+       </div>
+       <div className="mp-controls">
+       {wantEffort && (
+         <>
+           <div className="menu-sep" />
+           {/* 运行中注记只在真有可调的东西时出现（未声明支持的模型不谎称「思考程度可调」）。 */}
+           {modelsDisabled && supported && <div className="menu-note">{STR.modelPicker.runningNote}</div>}
+           <div className="th-head">
+             <span className="pop-label">{STR.modelPicker.effortLabel}</span>
+             {supported && declared !== undefined && declared.length > 1 && (
+               <button
+                 type="button"
+                 className="th-custom"
+                 aria-expanded={editingEfforts}
+                 onClick={() => { setEditingEfforts(!editingEfforts); }}
+               >
+                 <SlidersHorizontal size={11} aria-hidden="true" />
+                 {editingEfforts ? STR.modelPicker.effortDone : STR.modelPicker.effortCustom}
+               </button>
+             )}
+           </div>
+           {!editingEfforts ? (
+             <div className="th-row" role="group" aria-label={STR.modelPicker.effortGroupAria} ref={effortRef} tabIndex={-1} data-effort-anchor="true">
+               {levels.map((lv) => (
+                 <button
+                   key={lv.id}
+                   type="button"
+                   data-e={lv.id}
+                   title={lv.hint}
+                   aria-pressed={level === lv.id}
+                   disabled={!supported}
+                   onClick={() => { props.onThinkingChange?.(lv.id); }}
+                 >{lv.short}</button>
+               ))}
+             </div>
+           ) : (
+             <div className="th-edit" role="group" aria-label={STR.modelPicker.effortEditAria}>
+               <p className="th-edit-note">{STR.modelPicker.effortEditNote.replace("{levels}", declaredIds.filter((id) => id !== "off").join(" / ") || STR.modelPicker.effortUndeclared)}</p>
+               <div className="th-edit-list">
+                 {declaredIds.filter((id) => id !== "off").map((id) => {
+                   const on = !hidden.includes(id);
+                   return (
+                     <button
+                       key={id}
+                       type="button"
+                       role="checkbox"
+                       aria-checked={on}
+                       className="th-edit-chip"
+                       onClick={() => { commitHidden(toggleThinkingHidden(hidden, id, declaredIds)); }}
+                     >
+                       <span className="th-edit-box" aria-hidden="true">{on ? "✓" : ""}</span>
+                       <span>{levelLabelOf(id)}</span>
+                     </button>
+                   );
+                 })}
+               </div>
+               <button type="button" className="th-reset" onClick={() => { commitHidden([]); }}>
+                 {STR.modelPicker.effortReset}
+               </button>
+             </div>
+           )}
+           {!supported && (
+             <>
+               <div className="th-off" role="status">{STR.modelPicker.unsupportedNote}</div>
+               <details className="th-why">
+                 <summary className="th-info">
+                   <Info size={12} className="th-info-ico" aria-hidden="true" />
+                   <span>{STR.modelPicker.whySummary}</span>
+                   <span className="th-info-link">{STR.modelPicker.whyLink}</span>
+                 </summary>
+                 <div className="th-why-body">{STR.modelPicker.whyBody}</div>
+               </details>
+             </>
+           )}
+         </>
+       )}
+       {props.onOpenSettings !== undefined && (
+         <div className="mp-foot">
+           <button type="button" className="menu-item" onClick={() => props.onOpenSettings?.()}>
+             <Settings size={12} />
+             <span>{STR.modelPicker.manage}</span>
+           </button>
+         </div>
+       )}
+       </div>
+     </Popover>
+   );
+ }
+
+ // 新建项目 Dialog（brief 第四节）：居中弹窗，取代侧栏内联表单。
+ // 同屏三步：选模板（卡片网格，清单以现有 projectTemplates 为准）→ 填名字（实时校验）→ 选位置
+ // （默认 ~/Cairn Projects，「更改…」走系统选择器；显示「将创建在：」预览）。
+ // 全程零路径手输（原则 1）；文案走 STR。
+ import { useRef, useState } from "react";
+ import { isCompositionEnter } from "../ime";
+ import { Atom, BarChart3, ClipboardList, FolderPlus, LayoutTemplate, X } from "lucide-react";
+ import { STR } from "../strings";
+ import { ModalSurface } from "./ModalSurface";
+
+ export interface TemplateCard {
+   id: string;
+   name: string;
+   description: string;
+ }
+
+ /** 模板 → 图标（未知模板兜底 FolderPlus——不因模板目录扩项而空图标）。 */
+ function templateIcon(id: string): React.JSX.Element {
+   if (id === "static-site") return <LayoutTemplate size={16} />;
+   if (id === "form-widget") return <ClipboardList size={16} />;
+   if (id === "data-panel") return <BarChart3 size={16} />;
+   if (id === "react-vite") return <Atom size={16} />;
+   return <FolderPlus size={16} />;
+ }
+
+ /** 单选组键盘目标：方向键循环，Home/End 到首尾；其他键留给控件本身。 */
+ export function templateNavigationTarget(key: string, current: number, count: number): number | null {
+   if (count <= 0) return null;
+   const at = current >= 0 && current < count ? current : 0;
+   if (key === "ArrowRight" || key === "ArrowDown") return (at + 1) % count;
+   if (key === "ArrowLeft" || key === "ArrowUp") return (at - 1 + count) % count;
+   if (key === "Home") return 0;
+   if (key === "End") return count - 1;
+   return null;
+ }
+
+ /** 名字实时校验（纯判据内联；返回错误文案或 null）。 */
+ export function validateProjectName(name: string, existingNames: readonly string[]): string | null {
+   const trimmed = name.trim();
+   if (trimmed === "") return STR.newProject.nameEmpty;
+   if (/[\\/\u0000-\u001f]/.test(trimmed)) return STR.newProject.nameInvalid;
+   if (existingNames.includes(trimmed)) return STR.newProject.nameTaken;
+   return null;
+ }
+
+ export function NewProjectDialog(props: {
+   templates: readonly TemplateCard[];
+   /** 已在场项目名（重名校验）。 */
+   existingNames: readonly string[];
+   onClose: () => void;
+   onPickDirectory: () => Promise<string | null>;
+   /** 成功后由 App 关窗/刷新/聚焦输入框；reject ⇒ 错误行内 fail-visible。 */
+   onCreate: (input: { name: string; templateId: string; parentDir?: string }) => Promise<void>;
+ }): React.JSX.Element {
+   const [templateId, setTemplateId] = useState(props.templates[0]?.id ?? "");
+   const [name, setName] = useState("");
+   const [parentDir, setParentDir] = useState<string | null>(null);
+   const [busy, setBusy] = useState(false);
+   const [error, setError] = useState<string | null>(null);
+   const nameInput = useRef<HTMLInputElement | null>(null);
+   const nameError = validateProjectName(name, props.existingNames);
+   const showNameError = name.trim() !== "" && nameError !== null;
+   const previewParent = parentDir ?? STR.newProject.defaultParent;
+   /** 回车 = 提交（按钮同一条路；busy / 校验失败时不动，错误照样上屏）。 */
+   const submit = () => {
+     if (busy) return;
+     const trimmed = name.trim();
+     const invalid = validateProjectName(trimmed, props.existingNames);
+     if (invalid !== null) { setError(invalid); return; }
+     setBusy(true);
+     setError(null);
+     void props.onCreate({
+       name: trimmed,
+       templateId,
+       ...(parentDir !== null ? { parentDir } : {}),
+     }).then(
+       () => { props.onClose(); },
+       (err: unknown) => { setError(STR.newProject.failed.replace("{reason}", err instanceof Error ? err.message : String(err))); setBusy(false); },
+     );
+   };
+   return (
+     <div className="modal-backdrop" role="presentation" onClick={props.onClose}>
+       <ModalSurface
+         className="modal-card modal-wide"
+         label={STR.newProject.title}
+         onClose={props.onClose}
+         initialFocusRef={nameInput}
+         onClick={(e) => { e.stopPropagation(); }}
+       >
+         <div className="modal-head">
+           <span>{STR.newProject.title}</span>
+           <button className="iconbtn sm" aria-label={STR.common.cancel} title={STR.common.cancel} onClick={props.onClose}>
+             <X size={13} />
+           </button>
+         </div>
+
+         <div className="modal-field">
+           <span>{STR.newProject.templateLabel}</span>
+           <div className="tpl-grid" role="radiogroup" aria-label={STR.newProject.templateLabel}>
+             {props.templates.map((t) => (
+               <button
+                 key={t.id}
+                 type="button"
+                 className="tpl-card"
+                 role="radio"
+                 aria-checked={templateId === t.id}
+                 tabIndex={templateId === t.id ? 0 : -1}
+                 data-on={templateId === t.id}
+                 title={t.description}
+                 onClick={() => { setTemplateId(t.id); }}
+                 onKeyDown={(e) => {
+                   const current = props.templates.findIndex((template) => template.id === templateId);
+                   const next = templateNavigationTarget(e.key, current, props.templates.length);
+                   if (next === null) return;
+                   const target = props.templates[next];
+                   if (target === undefined) return;
+                   e.preventDefault();
+                   setTemplateId(target.id);
+                   e.currentTarget.parentElement
+                     ?.querySelectorAll<HTMLButtonElement>('[role="radio"]')
+                     [next]?.focus();
+                 }}
+               >
+                 <span className="tpl-ico" aria-hidden="true">{templateIcon(t.id)}</span>
+                 <span className="tpl-name">{t.name}</span>
+                 <span className="tpl-desc">{t.description}</span>
+               </button>
+             ))}
+           </div>
+         </div>
+
+         <label className="modal-field">
+           <span>{STR.newProject.nameLabel}</span>
+           <input
+             ref={nameInput}
+             aria-label={STR.newProject.nameLabel}
+             placeholder={STR.newProject.namePlaceholder}
+             value={name}
+             onChange={(e) => { setName(e.target.value); setError(null); }}
+             onKeyDown={(e) => { if (e.key === "Enter" && !isCompositionEnter(e, null)) { e.preventDefault(); submit(); } }}
+           />
+           {showNameError && <span className="form-error" role="alert">{nameError}</span>}
+         </label>
+
+         <div className="modal-field">
+           <span>{STR.newProject.locationLabel}</span>
+           <div className="modal-row">
+             <code className="modal-path" title={previewParent}>{previewParent}</code>
+             <button
+               type="button"
+               className="mini-btn"
+               title={STR.newProject.locationHint}
+               onClick={() => {
+                 void props.onPickDirectory().then((picked) => { if (picked !== null) setParentDir(picked); });
+               }}
+             >
+               {STR.newProject.locationChange}
+             </button>
+           </div>
+           <span className="sp-dim">{STR.newProject.locationHint}</span>
+           <span className="sp-dim">{STR.newProject.preview.replace("{path}", `${previewParent}/${name.trim() !== "" ? name.trim() : "…"}`)}</span>
+         </div>
+
+         {error !== null && <div className="form-error" role="alert">{error}</div>}
+         <div className="modal-foot">
+           <button className="mini-btn" title={STR.common.cancel} onClick={props.onClose}>{STR.common.cancel}</button>
+           <button
+             className="mini-btn primary"
+             title={STR.newProject.title}
+             disabled={busy || nameError !== null || templateId === ""}
+             onClick={submit}
+           >
+             {busy ? STR.common.creating : STR.common.create}
+           </button>
+         </div>
+       </ModalSurface>
+     </div>
+   );
+ }
+
+ // 首启空屏的「设置检查」：七组覆盖面**来自主进程**（唯一事实源 `src/main/onboarding-groups.ts`），
+ // 渲染层不抄那份清单——只把它按步号摆开，并给出到设置页的入口。
+ //
+ // 为什么是「检查」而不是「向导」：向导要记进度、要能跳过、要有下一步按钮；本仓的首启面是一屏空态，
+ // 用户要的是「我该看哪几格」——四行步号，七格都有落点。做得比需要的多，就是噪音。
+ //
+ // 纪律：组 id → 设置分区是**唯一一份**映射（七组全有落点 ⇒ 没有一格是「点不动的死行」）。
+ // 清单本身由服务端给，渲染层只负责排版与导航——抄一份清单就多一份会各自漂的决策点。
+ import type { OnboardingGroup } from "../../../../../src/main/onboarding-groups";
+ import type { SectionId } from "../app-controls";
+ import { STR } from "../strings";
+
+ /** 组 id → 设置分区。**七组全有落点**：没有落点的那一格会被读成「点不动」，
+  * 而「点不动」比「不列它」更糟——用户以为坏了。 */
+ export const ONBOARDING_TARGET: Readonly<Record<OnboardingGroup["id"], SectionId>> = {
+   provider: "provider",
+   permission: "permissions",
+   ui: "general",
+   schedule: "automation",
+   memory: "memory",
+   telemetry: "advanced",
+   about: "about",
+ };
+
+ /** 按步号摆开（步号域是 1..4，服务端给的事实；这里只排版）。 */
+ export function groupByStep(
+   groups: readonly OnboardingGroup[],
+ ): { step: number; groups: OnboardingGroup[] }[] {
+   const byStep = new Map<number, OnboardingGroup[]>();
+   for (const g of groups) {
+     byStep.set(g.step, [...(byStep.get(g.step) ?? []), g]);
+   }
+   return [...byStep.entries()]
+     .sort((a, b) => a[0] - b[0])
+     .map(([step, items]) => ({ step, groups: items }));
+ }
+
+ /** 这一组的落点分区；**没有落点就返回 undefined**。
+  *  为什么要留这个洞：服务端若加了新组而渲染层还不知道它落在哪个分区，
+  *  那一格就**不能**摆成可点的按钮（点了会跳到一个不存在的分区＝点不动）。
+  *  宁可这一格不出现，也不要给一个点不动的入口。 */
+ export function onboardingTarget(id: string): SectionId | undefined {
+   return Object.prototype.hasOwnProperty.call(ONBOARDING_TARGET, id)
+     ? ONBOARDING_TARGET[id as OnboardingGroup["id"]]
+     : undefined;
+ }
+
+ export function OnboardingChecklist(props: {
+   /** 七组覆盖面（主进程给的副本；空数组 = 还没取到 ⇒ 整块不渲染，不摆空壳）。 */
+   groups: readonly OnboardingGroup[];
+   /** 点一格：跳到对应设置分区（由调用方开设置页并定位）。 */
+   onOpen: (section: SectionId) => void;
+   /** 完成：落 settings.onboarded=true 并由调用方立即隐藏（失败回滚）。 */
+   onDone: () => void;
+ }): React.JSX.Element | null {
+   // 只摆**有落点**的组（见 onboardingTarget 的理由）。
+   const groups = props.groups.filter((g) => onboardingTarget(g.id) !== undefined);
+   if (groups.length === 0) return null;
+   const steps = groupByStep(groups);
+   return (
+     // 不摆标题、不摆步号：这一块**自己**就是那七格，步号是「说给读者听的中间标签」——
+     // 同一屏上方的建议行已经有一套 01/02/03，再来一套就是两列互相打架的编号。
+     // 分组交给**行距**（四行，行间留白）说；无障碍名留在 aria-label（读屏要，屏幕上不要）。
+     <div className="onboard" role="group" aria-label={STR.onboarding.title}>
+       {steps.map((s) => (
+         <div className="onboard-step" key={s.step}>
+           <div className="onboard-items">
+             {/* 每格不再挂 title：entry 本来就整行可见（white-space: normal），
+                 再挂一枚同文 tooltip 是同一句话的第二份，且键盘用户读不到。 */}
+             {s.groups.map((g) => (
+               <button
+                 key={g.id}
+                 className="onboard-item"
+                 onClick={() => {
+                   const target = onboardingTarget(g.id);
+                   if (target !== undefined) props.onOpen(target);
+                 }}
+               >
+                 <span className="onboard-label">{g.label}</span>
+                 <span className="onboard-entry">{g.entry}</span>
+               </button>
+             ))}
+           </div>
+         </div>
+       ))}
+       <div className="onboard-foot">
+         <button type="button" className="onboard-done" onClick={props.onDone}>
+           {STR.onboarding.done}
+         </button>
+       </div>
+     </div>
+   );
+ }
+
+ import { useEffect, useRef, useState } from "react";
+ import type { OrchestrationAddress, OrchestrationResponse, OrchestrationSnapshot } from "../../../../../src/main/orchestration-service";
+ import type { ControlAction, ControlCommand, OrchPlan, PlanView } from "../../../../../src/orchestration/types";
+ import {
+   acceptanceLabel, artifactKindLabel, canEnableExecution, effectLabel, evidenceLabel, laneLabel, planControls,
+   planPhaseLabel, reasonLabel, scheduleKindLabel, taskControls, taskPhaseLabel, verdictLabel,
+   type OrchestrationControl,
+ } from "../derived/orchestration";
+ import "./orchestration-pane.css";
+
+ /** The simple editor deliberately grants read-only capability; imported plans retain their own contract. */
+ export function buildReadPlan(input: { id: string; goal: string; tasks: string; budget: number; sequential: boolean }): OrchPlan {
+   const goals = input.tasks.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
+   if (!input.goal.trim() || goals.length === 0 || goals.length > 64 || !Number.isFinite(input.budget) || input.budget <= 0) throw new Error("请填写目标、1–64 个任务和大于 0 的美元预算。");
+   return {
+     plan_id: input.id, version: 1, goal: input.goal.trim(), non_goals: [], domain: "generic", created_by: "user",
+     policy_ref: "desktop-read-only-v1", budget: { usd: input.budget }, max_concurrency: 1,
+     agents: [{ agent_spec_id: "reader", role: "只读分析", max_turns: 8, capability: {
+       tools: ["read_file", "grep", "glob"], fs_read: ["."], fs_write: [], network: [], shell: "none", git: "none", external_effects: "none",
+     } }],
+     tasks: goals.map((goal, i) => ({
+       task_id: `task-${String(i + 1)}`, goal, non_goals: [], agent_spec: "reader", lane: "read",
+       depends_on: input.sequential && i > 0 ? [`task-${String(i)}`] : [], write_scopes: [], inputs: [],
+       contract: { effect: "none", acceptance: [{ kind: "evidence", id: "repository", fields: ["file_count", "revision"] }] },
+       budget: { usd: input.budget / goals.length }, max_attempts: 2, priority: 0,
+     })),
+   };
+ }
+
+ const money = (value: number): string => Number.isFinite(value) ? `$${value.toFixed(4)}` : "未知";
+
+ /** 只摆当前阶段合法的动作；会终止进行中工作或改写文件的那几个要二次确认。 */
+ function ControlButtons(props: {
+   controls: readonly OrchestrationControl[];
+   pending: boolean;
+   scope: string;
+   onRun: (action: ControlAction) => void;
+ }): React.JSX.Element | null {
+   const [confirming, setConfirming] = useState<ControlAction | null>(null);
+   if (props.controls.length === 0) return null;
+   const run = (control: OrchestrationControl): void => {
+     // 第一次点只摆出确认；第二次点才真的发命令（避免误触把运行中的计划停掉）。
+     if (control.confirm === true && confirming !== control.action) { setConfirming(control.action); return; }
+     setConfirming(null);
+     props.onRun(control.action);
+   };
+   return (
+     <div className="orch-actions">
+       {props.controls.map(control => (
+         <button
+           type="button"
+           className={"mini-btn" + (confirming === control.action ? " orch-danger" : "")}
+           key={control.action}
+           disabled={props.pending}
+           aria-label={confirming === control.action ? `确认${control.label}` : `${control.label} ${props.scope}`}
+           data-control-action={control.action}
+           data-control-scope={props.scope}
+           data-confirm={control.confirm === true ? "true" : undefined}
+           onClick={() => { run(control); }}
+         >{confirming === control.action ? `确认${control.label}` : control.label}</button>
+       ))}
+       {confirming !== null && <button type="button" className="mini-btn ghost" onClick={() => { setConfirming(null); }}>返回</button>}
+     </div>
+   );
+ }
+
+ export function OrchestrationSnapshotView(props: {
+   snapshot: OrchestrationSnapshot;
+   pending: boolean;
+   onControl: (plan: PlanView, action: ControlAction, taskId?: string, execute?: boolean) => void;
+ }): React.JSX.Element {
+   const { snapshot } = props;
+   const rollback = snapshot.backend_capabilities?.rollback === true;
+   const executionContext = { mode: snapshot.mode, backend: snapshot.backend, executionUnavailable: snapshot.execution_unavailable !== undefined };
+   return <>
+     <div className="orch-mode"><strong>{snapshot.mode === "execute" ? "执行模式" : "预览模式（shadow）"}</strong><span>后端：{snapshot.backend ?? "未连接"}</span></div>
+     {snapshot.execution_unavailable && <p className="orch-notice">{snapshot.execution_unavailable}</p>}
+     {snapshot.error && <p className="orch-error" role="alert">运行异常：{snapshot.error}</p>}
+     {snapshot.view.anomalies.length > 0 && <div className="orch-error" role="alert"><strong>事件异常</strong><ul>{snapshot.view.anomalies.map((item, i) => <li key={i}>{item}</li>)}</ul></div>}
+     {Object.values(snapshot.view.plans).length === 0 && <p className="orch-notice">本会话没有编排计划。填写目标与任务，或导入已有计划。</p>}
+     {Object.values(snapshot.view.plans).map(plan => <section className="orch-plan" key={`${plan.plan.plan_id}:${String(plan.plan.version)}`} aria-label={`计划 ${plan.plan.goal}`}>
+       <div className="orch-plan-title"><strong>{plan.plan.goal}</strong><span className="orch-phase" data-phase={plan.phase} title={plan.phase}>{planPhaseLabel(plan.phase)}</span></div>
+       <p className="orch-meta">{plan.plan.plan_id} · v{String(plan.plan.version)} · 预算 {money(plan.plan.budget.usd)} · 已用 {money(plan.spent_usd)} · 预留 {money(plan.reserved_usd)}</p>
+       <ControlButtons
+         controls={planControls(plan)}
+         pending={props.pending}
+         scope={plan.plan.plan_id}
+         onRun={action => { props.onControl(plan, action); }}
+       />
+       {canEnableExecution(plan, executionContext) && (
+         <div className="orch-actions">
+           <button type="button" className="mini-btn" disabled={props.pending} onClick={() => { props.onControl(plan, "resume_plan", undefined, true); }}>启用执行</button>
+         </div>
+       )}
+       <ul className="orch-tasks">{Object.values(plan.tasks).map(item => <li key={item.task.task_id}>
+         <div className="orch-plan-title"><span>{item.task.goal}</span><code data-phase={item.phase} title={item.phase}>{taskPhaseLabel(item.phase)}</code></div>
+         <p className="orch-meta">{item.task.task_id} · 尝试 {String(item.attempt)}/{String(item.task.max_attempts)} · 证据 {evidenceLabel(item.evidence)} · 裁决 {verdictLabel(item.verdict)}</p>
+         <p className="orch-meta">依赖：{item.task.depends_on.join("、") || "无"} · 预算 {money(item.task.budget.usd)} · 已用 {money(item.spent_usd)} · 预留 {money(item.reserved_usd)}</p>
+         {item.reason && <p className="orch-error" title={item.reason}>{reasonLabel(item.reason)}</p>}
+         {item.summary && <details><summary>产出摘要</summary><p className="orch-summary">{item.summary}</p></details>}
+         {item.artifacts && item.artifacts.length > 0 && <details><summary>产物引用 · {String(item.artifacts.length)}</summary><ul>{item.artifacts.map((artifact, i) => <li key={i}><code>{artifact.id}</code> · {artifactKindLabel(artifact.kind)}{artifact.hash ? ` · ${artifact.hash}` : ""}</li>)}</ul></details>}
+         <details><summary>能力与验收</summary><div className="orch-detail">
+           <p>权限：{laneLabel(item.task.lane)} · 写入范围：{item.task.write_scopes.join("、") || "无"} · 外部效果：{effectLabel(item.task.contract.effect)}</p>
+           <ul>{item.task.contract.acceptance.map(check => <li key={check.id}>{check.id} · {acceptanceLabel(check.kind)}{check.kind === "human" ? ` · ${check.instruction}` : check.kind === "command" ? ` · ${check.run}` : check.kind === "evidence" ? ` · ${check.fields.join("、")}` : ` · ${check.artifact_id}`}</li>)}</ul>
+           <p>修订：{item.revision ?? "未知"} · 验证者：{item.verifier_id ?? "未知"}</p>
+         </div></details>
+         <ControlButtons
+           controls={taskControls(item, { rollback })}
+           pending={props.pending}
+           scope={item.task.task_id}
+           onRun={action => { props.onControl(plan, action, item.task.task_id); }}
+         />
+       </li>)}</ul>
+     </section>)}
+     {snapshot.next_actions.length > 0 && <details className="orch-next"><summary>调度建议 · {String(snapshot.next_actions.length)}</summary><ul>{snapshot.next_actions.map((action, i) => <li key={i}>{action.task_id} · {scheduleKindLabel(action.kind)}{action.reason ? ` · ${reasonLabel(action.reason)}` : ""}</li>)}</ul></details>}
+   </>;
+ }
+
+ export function OrchestrationPane(props: { workspace: string | null; sessionId: string | null; active?: boolean }): React.JSX.Element {
+   const key = props.workspace && props.sessionId ? JSON.stringify([props.workspace, props.sessionId]) : null;
+   const keyRef = useRef(key); keyRef.current = key;
+   const [result, setResult] = useState<{ key: string; snapshot: OrchestrationSnapshot } | null>(null);
+   const [error, setError] = useState<{ key: string; message: string } | null>(null);
+   const [pending, setPending] = useState<{ key: string; id: string } | null>(null);
+   const pendingRef = useRef<string | null>(null);
+   const [goal, setGoal] = useState("");
+   const [tasks, setTasks] = useState("");
+   const [budget, setBudget] = useState("1");
+   const [sequential, setSequential] = useState(true);
+   const [refresh, setRefresh] = useState(0);
+   const requestSeq = useRef(0);
