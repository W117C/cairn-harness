+                     {bodyFor === sk.invoke && (
+                       bodies[sk.invoke]?.loading === true ? <div className="ap-empty">读取中…</div>
+                       : bodies[sk.invoke]?.error !== undefined ? <div className="ap-empty">读取失败：{bodies[sk.invoke]?.error}</div>
+                       : <pre className="skill-body">{bodies[sk.invoke]?.text}</pre>
