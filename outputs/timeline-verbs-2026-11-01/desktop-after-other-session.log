+ // 面板层·五张确认闸（Phase 2 · 批 2.4）。
+ //
+ // 分层契约（见 src/renderer/LAYERING.md）：
+ //   · 本层**只吃 props、只吐事件**——不读全局状态、不自己取数据；
+ //   · 本层**不 import App.tsx**（I1）：否则 App → panes → App 成环，模块一热就循环解析。
+ //
+ // 五张闸同形（标题 + 后果说明 + 取消/确认），故合成一个组件：确认态由 props 给出，
+ // 事件由 props 给出（onConfirm/onClose），组件自己不含任何状态。
+ import type { ProjectRecord } from "../../../../../src/main/ipc-protocol";
+ import type { DeleteConfirmTarget, SessionConfirmTarget, WorkspaceSession } from "../sessions-view";
+ import { ConfirmDialog } from "../components/ConfirmDialog";
+ import { permissionConfirmCopy } from "../components/PermissionMenu";
+ import type { PermissionConfirmApi } from "../state/use-permission-confirm";
+ import { ModalSurface } from "../components/ModalSurface";
+ import { STR } from "../strings";
+
+ export interface ConfirmScrimsProps {
+   /** 回滚轮次确认（round 号码；null = 不在场）。 */
+   revertConfirm: number | null;
+   setRevertConfirm: (v: number | null) => void;
+   doRevertTurn: (round: number) => void;
+   /** 移除项目确认。 */
+   projectRemoveConfirm: ProjectRecord | null;
+   setProjectRemoveConfirm: (v: ProjectRecord | null) => void;
+   doRemoveProject: (p: ProjectRecord) => void;
+   /** 归档必问闸。 */
+   archiveConfirm: SessionConfirmTarget | null;
+   setArchiveConfirm: (v: SessionConfirmTarget | null) => void;
+   doArchiveSession: (id: string, archived: boolean) => void;
+   /** 删除会话闸（running = 请求确认时这条会话在跑，文案与按钮据此变化）。 */
+   deleteConfirm: DeleteConfirmTarget | null;
+   setDeleteConfirm: (v: DeleteConfirmTarget | null) => void;
+   doDeleteSession: (id: string, target?: WorkspaceSession) => void;
+   /** 丢弃隔离工作区闸。 */
+   wtDiscard: WorkspaceSession | null;
+   setWtDiscard: (v: WorkspaceSession | null) => void;
+   sessionWorktreeOp: (kind: "create" | "merge" | "discard", s: WorkspaceSession) => void;
+   /** 命令面板循环到危险权限档时的确认（服务层只给待确认态，不直接落盘）。 */
+   permissionGuard: PermissionConfirmApi;
+ }
+
+ export function ConfirmScrims(props: ConfirmScrimsProps) {
+   const {
+     revertConfirm, setRevertConfirm, doRevertTurn,
+     projectRemoveConfirm, setProjectRemoveConfirm, doRemoveProject,
+     archiveConfirm, setArchiveConfirm, doArchiveSession,
+     deleteConfirm, setDeleteConfirm, doDeleteSession,
+     wtDiscard, setWtDiscard, sessionWorktreeOp,
+     permissionGuard,
+   } = props;
+   const permissionCopy = permissionGuard.permissionConfirm === null ? null : permissionConfirmCopy(permissionGuard.permissionConfirm);
+   return (
+     <>
+       {permissionGuard.permissionConfirm !== null && permissionCopy !== null && (
+         <ConfirmDialog
+           title={permissionCopy.title}
+           note={permissionCopy.desc}
+           confirmLabel={STR.permissionMenu.confirmOk}
+           danger
+           onClose={() => permissionGuard.setPermissionConfirm(null)}
+           onConfirm={() => { const m = permissionGuard.permissionConfirm; permissionGuard.setPermissionConfirm(null); if (m !== null) permissionGuard.apply(m); }}
+         />
+       )}
+       {/* 回滚轮次 / 移除项目的确认卡（2026-10-17：原生 confirm → 产品自绘）。 */}
+       {revertConfirm !== null && (
+         <ConfirmDialog
+           title={`还原第 ${String(revertConfirm)} 轮的改动？`}
+           note={"本轮新建的文件会删除；本轮之后又被改过的文件不会动，会列进「需手动处理」。"}
+           confirmLabel="还原"
+           danger
+           onClose={() => setRevertConfirm(null)}
+           onConfirm={() => { const round = revertConfirm; setRevertConfirm(null); doRevertTurn(round); }}
+         />
+       )}
+       {projectRemoveConfirm !== null && (
+         <ConfirmDialog
+           title={STR.removeProject.title.replace("{name}", projectRemoveConfirm.name)}
+           note={STR.removeProject.body}
+           confirmLabel="移除"
+           danger
+           onClose={() => setProjectRemoveConfirm(null)}
+           onConfirm={() => { const p = projectRemoveConfirm; setProjectRemoveConfirm(null); void doRemoveProject(p); }}
+         />
+       )}
+       {/* 归档必问闸（§3.3 硬闸：所有权限模式下都问；取消归档不问）。 */}
+       {archiveConfirm !== null && (
+         <ModalSurface className="confirm-scrim" label="归档确认" onClose={() => setArchiveConfirm(null)}>
+           <div className="confirm-card">
+             <div className="cc-title">归档「{archiveConfirm.title ?? archiveConfirm.id}」？</div>
+             <div className="cc-note">
+               归档后会话移出常规列表，收进侧栏底部的「已归档」分组；随时能取消归档。归档不删任何内容。
+               {archiveConfirm.running === true && <><br />该会话正在运行：归档后本轮（含已排队消息）会在后台继续跑，完成后照常通知。</>}
+             </div>
+             <div className="cc-actions">
+               <button className="mini-btn" onClick={() => setArchiveConfirm(null)}>取消</button>
+               <button
+                 className="mini-btn primary"
+                 onClick={() => {
+                   const target = archiveConfirm;
+                   setArchiveConfirm(null);
+                   void doArchiveSession(target.id, true);
+                 }}
+               >归档</button>
+             </div>
+           </div>
+         </ModalSurface>
+       )}
+       {/* 删除会话闸（§6.3 文案规范）：后果前置（删什么）+ 明示不可撤销 + 什么没被动（工作区文件）。 */}
+       {deleteConfirm !== null && (
+         <ModalSurface className="confirm-scrim" label="删除会话确认" onClose={() => setDeleteConfirm(null)}>
+           <div className="confirm-card">
+             <div className="cc-title">删除「{deleteConfirm.title ?? deleteConfirm.id}」？</div>
+             <div className="cc-note">
+               此操作无法撤销：该会话的全部记录将从磁盘删除（含旁路提升历史与队列残留）。<br />
+               工作区里的文件不受影响——agent 改过的文件不会随会话回滚。
+               {deleteConfirm.running === true && <><br />该会话正在运行：确认后会先停止本轮，再删除。</>}
+             </div>
+             <div className="cc-actions">
+               <button className="mini-btn" onClick={() => setDeleteConfirm(null)}>取消</button>
+               <button
+                 className="mini-btn danger"
+                 onClick={() => {
+                   const target = deleteConfirm;
+                   setDeleteConfirm(null);
+                   void doDeleteSession(target.id, target);
+                 }}
+               >{deleteConfirm.running === true ? "停止并删除" : "删除"}</button>
+             </div>
+           </div>
+         </ModalSurface>
+       )}
+       {/* §3.7 · G4 丢弃隔离工作区闸：后果前置（哪棵树、会丢什么）+ 明示不可撤销。 */}
+       {wtDiscard !== null && (
+         <ModalSurface className="confirm-scrim" label="丢弃隔离工作区确认" onClose={() => setWtDiscard(null)}>
+           <div className="confirm-card">
+             <div className="cc-title">丢弃「{wtDiscard.title ?? wtDiscard.id}」的隔离工作区？</div>
+             <div className="cc-note">
+               此操作无法撤销：这块隔离工作区会被删除，里面未提交的改动一并消失。<br />
+               主工作区不受影响——合并前它本来就没被动过。
+             </div>
+             <div className="cc-actions">
+               <button className="mini-btn" onClick={() => setWtDiscard(null)}>取消</button>
+               <button
+                 className="mini-btn danger"
+                 onClick={() => {
+                   const target = wtDiscard;
+                   setWtDiscard(null);
+                   void sessionWorktreeOp("discard", target);
+                 }}
+               >丢弃</button>
+             </div>
+           </div>
+         </ModalSurface>
+       )}
+     </>
+   );
+ }
+
+ import { useEffect, useState } from "react";
+ import type { AppDestination, AppPageDestination } from "../app-controls";
+ import { APP_DESTINATION_LABEL } from "../navigation";
+ import { addVisitedDestination } from "../state/destination-pages";
+
+ interface DestinationWorkspaceProps {
+   destination: AppDestination;
+   renderPage: (destination: AppPageDestination) => React.ReactNode;
+   children: React.ReactNode;
+ }
+
+ export function DestinationWorkspace(props: DestinationWorkspaceProps): React.JSX.Element {
+   const hidden = props.destination !== "chat";
+   const [visited, setVisited] = useState<readonly AppPageDestination[]>(
+     () => addVisitedDestination([], props.destination),
+   );
+   const visiblePages = addVisitedDestination(visited, props.destination);
+   useEffect(() => {
+     setVisited((current) => addVisitedDestination(current, props.destination));
+   }, [props.destination]);
+
+   const chatInert = hidden
+     ? ({ inert: "" } as unknown as React.HTMLAttributes<HTMLDivElement>)
+     : {};
+
+   return (
+     <div className="workspace-host">
+       <div
+         className="chat-workspace"
+         data-hidden={hidden ? "true" : "false"}
+         aria-hidden={hidden ? "true" : undefined}
+         {...chatInert}
+       >
+         {props.children}
+       </div>
+       {visiblePages.map((destination) => {
+         const pageHidden = props.destination !== destination;
+         const inertProps = pageHidden
+           ? ({ inert: "" } as unknown as React.HTMLAttributes<HTMLElement>)
+           : {};
+         return (
+           <section
+             key={destination}
+             className="destination-page"
+             data-destination-page={destination}
+             data-hidden={pageHidden ? "true" : "false"}
+             aria-label={APP_DESTINATION_LABEL[destination]}
+             aria-hidden={pageHidden ? "true" : undefined}
+             {...inertProps}
+           >
+             {props.renderPage(destination)}
+           </section>
+         );
+       })}
+     </div>
+   );
+ }
+
+ // 发送队列条的在场面：读的是「当前会话」的队列表（限定键），写回也走同一个键。
+ //
+ // ⚠️ 2026-10-28（第 750 页）：读队列表必须与写**同键**——写方 `setQueueFor` 用
+ // `runKey(workspace, sid)`（限定键），曾经这里按**裸 sid** 读 ⇒ 读到 undefined ⇒ `?? []`
+ // ⇒ `promoteQueued([], i)` 得 `[]` ⇒ 写回空表 ⇒ **整条队列被静默清空**。
+ // 从现在起：本文件所有 `queue.current.get` 都只吃 `runKey(...)`；改动请同步跑 queue-key 判卷。
+ import type { MutableRefObject } from "react";
+ import { dropQueued, editQueued, moveQueued, promoteQueued, type QueuedSend } from "../send-queue";
+ import { runKey } from "../state/session-identity";
+ import { SendQueueStrip } from "../components/SendQueueStrip";
+
+ export function QueueDock(props: {
+   activeId: string;
+   activeWorkspace: string | null;
+   queue: MutableRefObject<Map<string, QueuedSend[]>>;
+   running: boolean;
+   queueLoading: boolean;
+   queueSaving?: boolean;
+   queueSaveFailed?: boolean;
+   pendingSend: boolean;
+   pendingClarify: unknown;
+   pendingPlan: unknown;
+   setQueueFor: (sid: string, list: QueuedSend[], workspace?: string | null) => void;
+   cancelRunHeal: (sid: string, workspace?: string | null) => void;
+   resumeQueueFor: (sid: string, workspace?: string | null) => void;
+ }) {
+   // 打断并发送 / 移出 / 编辑：都按目标会话的限定键读当前表，再交给纯函数改一条。
+   const items = props.queue.current.get(runKey(props.activeWorkspace, props.activeId)) ?? [];
+   const blocked = props.queueLoading || props.queueSaving === true;
+   const editAt = (index: number, change: (list: QueuedSend[], at: number) => QueuedSend[]): boolean => {
+     const sid = props.activeId;
+     if (blocked) return false;
+     const key = runKey(props.activeWorkspace, sid);
+     const id = items[index]?.id;
+     const current = props.queue.current.get(key) ?? [];
+     const at = current.findIndex((item) => item.id === id);
+     if (id === undefined || at < 0) return false;
+     props.setQueueFor(sid, change(current, at), props.activeWorkspace);
+     return true;
+   };
+   return (
+     <SendQueueStrip
+       items={items}
+       running={props.running}
+       disabled={blocked}
+       saving={props.queueSaving}
+       saveFailed={props.queueSaveFailed}
+       onRetrySave={() => {
+         if (!blocked) props.setQueueFor(props.activeId, props.queue.current.get(runKey(props.activeWorkspace, props.activeId)) ?? [], props.activeWorkspace);
+       }}
+       onInterruptSend={(index) => {
+         if (blocked) return;
+         /** 「打断并发送」：先把它提到队首，再打断本轮——收束在轮界，runOn 随即先派它。
+          *  打断走 cancelRunHeal：陈旧旗（main 无在跑）时摘旗并把这条当场派出去，不再是死点。 */
+         if (editAt(index, (list, at) => promoteQueued(list, at))) props.cancelRunHeal(props.activeId, props.activeWorkspace);
+       }}
+       onRemove={(index) => { editAt(index, (list, at) => dropQueued(list, at)); }}
+       onEdit={(index, text) => { editAt(index, (list, at) => editQueued(list, at, text)); }}
+       onMove={(index, delta) => { editAt(index, (list, at) => moveQueued(list, at, delta)); }}
+       {...(!props.running && !blocked && !props.pendingSend && props.pendingClarify === null && props.pendingPlan === null
+         ? { onResume: () => { props.resumeQueueFor(props.activeId, props.activeWorkspace); } }
+         : {})}
+     />
+   );
+ }
