+   }, [textSize]);
+   // 2026-10-20 尺寸档应用：与字号同一形制——单一事实源写一个 data 属性，tokens.css 消费。
+   // "2" 档不写属性（让 --size-scale 保持 :root 的 1），不往 DOM 上堆无意义的状态。
+   useEffect(() => {
