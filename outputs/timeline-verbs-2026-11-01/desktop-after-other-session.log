+               <span className="start-icon" aria-hidden="true"><Icon size={15} strokeWidth={1.7} /></span>
+               <span className="start-q">{q}</span>
+               <ArrowUpRight size={14} strokeWidth={1.8} className="start-go" aria-hidden="true" />
+             </button>
+           );
+         })}
+       </div>
+       {props.firstRunSub !== null && <div className="empty-sub">{props.firstRunSub}</div>}
+     </div>
+   );
+ }
+
+ // 渲染错误边界：把「一块界面炸了」收在它自己的格子里，而不是让 React 根卸载成白屏/启动占位。
+ // 三个落点（2026-10-25）：
+ //   · 应用根（main.tsx）：兜底任何未预料的渲染错误，给重试 / 重新载入；
+ //   · 设置分区（SettingsPanel）：分区 key 变化即重置；一个分区炸了，左导航与其他分区照常；
+ //   · 窗格内容（PaneDock）：每个已开窗格各自一条边界；一个窗格炸了，标签条与其他窗格照常。
+ // 无错误时直接返回 children（不包 wrapper）：设置页的 `.sp-body > .ss-page`、
+ // 窗格的 `.pane-chunk-body` 都依赖直接子元素，包一层会把既有版式改掉。
+ // 只捕渲染期错误；异步 Promise 的错误仍由各组件自己的 catch / role=alert 面负责。
+ import { Component, Fragment, type ErrorInfo, type ReactNode } from "react";
+ import { AlertTriangle, RefreshCw } from "lucide-react";
+ import { STR } from "../strings";
+ import "./render-error.css";
+
+ type Variant = "page" | "inline";
+
+ interface Props {
+   children: ReactNode;
+   variant?: Variant;
+   title?: string;
+   body?: string;
+ }
+
+ interface State {
+   error: Error | null;
+   componentStack: string;
+   generation: number;
+ }
+
+ /** 可单测的兜底面：不依赖 class 的 state 迁移，SSR 也能出真 HTML。 */
+ export function RenderErrorFallback(props: {
+   variant: Variant;
+   title: string;
+   body: string;
+   error: Error;
+   componentStack: string;
+   onRetry: () => void;
+   onReload: () => void;
+ }): ReactNode {
+   const { variant, title, body, error, componentStack, onRetry, onReload } = props;
+   return (
+     <div className={`render-error ${variant}`} role="alert">
+       <div className="re-icon" aria-hidden="true"><AlertTriangle size={variant === "page" ? 26 : 18} /></div>
+       <div className="re-copy">
+         <h2 className="re-title">{title}</h2>
+         <p className="re-body">{body}</p>
+         <div className="re-actions">
+           <button type="button" className="mini-btn primary" onClick={onRetry}>
+             <RefreshCw size={13} aria-hidden="true" />{STR.crash.retry}
+           </button>
+           {variant === "page" && (
+             <button type="button" className="mini-btn" onClick={onReload}>{STR.crash.reload}</button>
+           )}
+         </div>
+         <details className="re-details">
+           <summary>{STR.crash.details}</summary>
+           <pre className="re-pre">{error.message}{componentStack !== "" ? `\n${componentStack}` : ""}</pre>
+         </details>
+       </div>
+     </div>
+   );
+ }
+
+ export class RenderErrorBoundary extends Component<Props, State> {
+   state: State = { error: null, componentStack: "", generation: 0 };
+
+   static getDerivedStateFromError(error: Error): Partial<State> {
+     return { error };
+   }
+
+   componentDidCatch(error: Error, info: ErrorInfo): void {
+     // 仅为诊断留痕：不吞错误、不发网络、不写用户数据。
+     console.error("[render-boundary]", error, info.componentStack ?? "");
+     this.setState({ componentStack: info.componentStack ?? "" });
+   }
+
+   private reset = (): void => {
+     // generation 变更会重挂子树：组件内部半坏的状态也一起丢掉，避免「重试后仍坏」。
+     this.setState((prev) => ({ error: null, componentStack: "", generation: prev.generation + 1 }));
+   };
+
+   private reload = (): void => {
+     if (typeof window !== "undefined") window.location.reload();
+   };
+
+   render(): ReactNode {
+     const { error, componentStack, generation } = this.state;
+     if (error === null) {
+       // Fragment 不产生 DOM 节点：直接子元素关系保持不变（不破坏 .sp-body > .ss-page 等选择器）。
+       return <Fragment key={generation}>{this.props.children}</Fragment>;
+     }
+     const variant = this.props.variant ?? "inline";
+     const title = this.props.title ?? (variant === "page" ? STR.crash.pageTitle : STR.crash.inlineTitle);
+     const body = this.props.body ?? (variant === "page" ? STR.crash.pageBody : STR.crash.inlineBody);
+     return (
+       <RenderErrorFallback
+         variant={variant}
+         title={title}
+         body={body}
+         error={error}
+         componentStack={componentStack}
+         onRetry={this.reset}
+         onReload={this.reload}
+       />
+     );
+   }
+ }
+
+ // v2.17 运行中可沟通：排队条（挂在 ComposerCard 上沿）。
+ // 只做展示与转发——队列状态在 App（按会话），语义在 send-queue.ts；本组件只有「正在编辑哪条」的局部态。
+ import { useRef, useState } from "react";
+ import type { QueuedSend } from "../send-queue";
+ import { ChevronDown, ChevronUp, Clock, Pencil, X } from "lucide-react";
+
+ export function SendQueueStrip(props: {
+   items: readonly QueuedSend[];
+   /** 运行中才有「打断并发送」（不运行时队列自行出队，没有可打断的对象）。 */
+   running: boolean;
+   /** 缓存可查看，但读取未完成前不能改写或派发。 */
+   disabled?: boolean;
+   saving?: boolean;
+   saveFailed?: boolean;
+   onRetrySave?: () => void;
+   onInterruptSend: (index: number) => void;
+   onRemove: (index: number) => void;
+   /** 改一条排队消息的正文；缺席 = 不提供编辑入口（旧用法字节不变）。 */
+   onEdit?: (index: number, text: string) => void;
+   /** 上/下移一条；缺席 = 不提供排序入口。 */
+   onMove?: (index: number, delta: -1 | 1) => void;
+   /** 重启恢复入口：不运行时显式继续发送队列头；缺省 = 不显示入口。 */
+   onResume?: () => void;
+ }) {
+   // 按 id 记正在编辑的那条（队列可能在编辑期间被移出/重排；index 会漂）。
+   const [editingId, setEditingId] = useState<number | null>(null);
+   const [draft, setDraft] = useState("");
+   // 键盘收尾后主动 blur 会在真实窗口里再补一个 blur 事件；跳过它，避免同一次编辑提交两遍。
+   const skipBlurRef = useRef(false);
+   if (props.items.length === 0 && !props.saving && !props.saveFailed) return null;
+   const commit = (id: number): void => {
+     if (props.disabled) return;
+     const index = props.items.findIndex((item) => item.id === id);
+     const text = draft.trim();
+     if (index >= 0 && text !== "") props.onEdit?.(index, text);
+   };
+   // Enter/Esc 直接收尾，不把「能不能关掉」押在 blur 上：窗口未获焦时 blur 不派发
+   // focusout（离屏实例实测），只靠 onBlur 会让编辑框关不掉。
+   const finish = (id: number, apply: boolean): void => {
+     skipBlurRef.current = true;
+     setEditingId(null);
+     if (apply) commit(id);
+   };
+   return (
+     <div className="queue-strip" data-cds="ChatComposerQueuedMessages" role="list" aria-label="待发送队列">
+       <span className="queue-head">
+         <Clock size={11} />
+         {props.saving && <span role="status">正在保存队列…</span>}
+         {!props.saving && props.saveFailed && <span role="status">更改尚未保存</span>}
+         {!props.saving && !props.saveFailed && props.disabled && "会话未读取完成，队列暂不可修改"}
+         {!props.saving && !props.saveFailed && !props.disabled && (props.running ? "排队中 · 本轮结束后自动发送" : "排队中 · 等待恢复发送")}
+         {props.saveFailed && props.onRetrySave !== undefined && (
+           <button className="btn-ghost queue-retry" disabled={props.disabled} onClick={props.onRetrySave}>重试保存</button>
+         )}
+         {!props.running && props.onResume !== undefined && (
+           <button className="btn-ghost queue-resume" aria-label="继续发送队列" disabled={props.disabled} onClick={props.onResume}>
+             继续发送
+           </button>
+         )}
+       </span>
+       {props.items.map((item, index) => (
+         <div className="queue-item" role="listitem" key={item.id}>
+           {editingId === item.id ? (
+             <input
+               className="q-edit"
+               data-esc-owns="true"
+               aria-label={`编辑排队消息：${item.text}`}
+               value={draft}
+               disabled={props.disabled}
+               autoFocus
+               onFocus={(e) => { e.currentTarget.select(); }}
+               onChange={(e) => { setDraft(e.target.value); }}
+               onKeyDown={(e) => {
+                 // 全局 Esc 是「智慧停止本轮」：编辑排队项时它只该取消这次编辑，不许停跑。
+                 if (e.key === "Enter") { e.preventDefault(); e.stopPropagation(); finish(item.id, true); e.currentTarget.blur(); }
+                 else if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); finish(item.id, false); e.currentTarget.blur(); }
+               }}
+               onBlur={() => {
+                 if (skipBlurRef.current) { skipBlurRef.current = false; return; }
+                 if (editingId !== null) { setEditingId(null); commit(editingId); }
+               }}
+             />
+           ) : (
+             <span className="q-text" title={item.text}>{item.text}</span>
+           )}
+           {item.attachments.length > 0 && (
+             <span
+               className="q-sub"
+               title={item.attachments.map((a) => a.path.split("/").filter(Boolean).pop() ?? a.path).join("\n")}
+             >{String(item.attachments.length)} 引用</span>
+           )}
+           {props.onMove !== undefined && (
+             <>
+               <button
+                 className="btn-ghost"
+                 aria-label={`上移排队项：${item.text}`}
+                 title="上移"
+                 disabled={props.disabled || index === 0}
+                 onClick={() => { props.onMove?.(index, -1); }}
+               ><ChevronUp size={10} /></button>
+               <button
+                 className="btn-ghost"
+                 aria-label={`下移排队项：${item.text}`}
+                 title="下移"
+                 disabled={props.disabled || index === props.items.length - 1}
+                 onClick={() => { props.onMove?.(index, 1); }}
+               ><ChevronDown size={10} /></button>
+             </>
+           )}
+           {props.onEdit !== undefined && editingId !== item.id && (
+             <button
+               className="btn-ghost"
+               aria-label={`编辑排队项：${item.text}`}
+               title="编辑这条排队消息"
+               disabled={props.disabled}
+               onClick={() => { skipBlurRef.current = false; setDraft(item.text); setEditingId(item.id); }}
+             ><Pencil size={10} /></button>
+           )}
+           {props.running && (
+             <button className="btn-ghost" disabled={props.disabled} onClick={() => { props.onInterruptSend(index); }}>打断并发送</button>
+           )}
+           <button
+             className="btn-ghost"
+             aria-label={`移出队列：${item.text}`}
+             disabled={props.disabled}
+             onClick={() => { props.onRemove(index); }}
+           ><X size={10} /></button>
+         </div>
+       ))}
+     </div>
+   );
+ }
+
+ import { STR } from "../strings";
+
+ /** 正文与队列未读完整时的恢复出口；不会清除用户草稿。 */
+ export function SessionLoadNotice(props: { loading: boolean; error: string | null; onRetry: () => void }) {
+   if (!props.loading && props.error === null) return null;
+   return (
+     <div className="session-load-notice" role={props.error === null ? "status" : "alert"} aria-busy={props.loading}>
+       <div className="session-load-heading">
+         <span>{props.loading ? STR.sessionLoad.loading : STR.sessionLoad.failed}</span>
+         {props.error !== null && (
+           <button type="button" className="btn-ghost" data-session-retry disabled={props.loading} onClick={props.onRetry}>
+             {STR.sessionLoad.retry}
+           </button>
+         )}
+       </div>
+       {props.error !== null && (
+         <details>
+           <summary>{STR.sidebar.errorDetails}</summary>
+           <pre tabIndex={0}>{props.error}</pre>
+         </details>
+       )}
+     </div>
+   );
+ }
+
+ // 会话日志查看器（2026-10-21 批 132）：错误条 / 命令面板的「查看日志」落点。
+ // 只读尾部：主进程按会话归属解析路径后读最近 400 行（≤256 KiB），渲染层不传路径。
+ import { useCallback, useEffect, useRef, useState } from "react";
+ import { AlertTriangle, Copy, Loader2, RefreshCw, X } from "lucide-react";
+ import type { SessionLogPayload } from "../../../../../src/main/ipc-protocol";
+ import { STR } from "../strings";
+ import { toast } from "../toast";
+ import { ModalSurface } from "./ModalSurface";
+
+ export type SessionLogState =
+   | { status: "loading" }
+   | { status: "error"; error: string }
+   | { status: "ready"; data: Extract<SessionLogPayload, { ok: true }> };
+
+ function formatBytes(n: number): string {
+   if (n < 1024) return `${n} B`;
+   if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
+   return `${(n / 1024 / 1024).toFixed(1)} MB`;
+ }
+
+ function copyText(text: string, okMessage: string): void {
+   if (typeof navigator === "undefined" || navigator.clipboard === undefined) {
+     toast.error(STR.logViewer.copyFailed);
+     return;
+   }
+   void navigator.clipboard.writeText(text).then(
+     () => { toast.success(okMessage); },
+     () => { toast.error(STR.logViewer.copyFailed); },
+   );
+ }
+
+ /** 内容面（判卷可单独渲染三态，不必真开 IPC）。 */
+ export function SessionLogBody(props: {
+   state: SessionLogState;
+   onRetry: () => void;
+   onCopyPath: (path: string) => void;
+ }): React.JSX.Element {
+   if (props.state.status === "loading") {
+     return (
+       <p className="session-log-empty" role="status">
+         <Loader2 size={13} className="s-spin" aria-hidden="true" /> {STR.logViewer.loading}
+       </p>
+     );
+   }
+   if (props.state.status === "error") {
+     return (
+       <div className="session-log-fail" role="alert">
+         <p className="session-log-empty"><AlertTriangle size={13} aria-hidden="true" /> {STR.logViewer.failed}：{props.state.error}</p>
+         <button className="mini-btn" title={STR.common.retry} onClick={props.onRetry}>{STR.common.retry}</button>
+       </div>
+     );
+   }
+   const data = props.state.data;
+   return (
+     <>
+       <div className="session-log-meta">
+         <code className="session-log-path" title={data.path} aria-label={STR.logViewer.pathAria}>{data.path}</code>
+         <button className="mini-btn" title={STR.logViewer.copyPath} onClick={() => { props.onCopyPath(data.path); }}>{STR.logViewer.copyPath}</button>
+       </div>
+       {data.lines === 0
+         ? <p className="session-log-empty">{STR.logViewer.empty}</p>
+         : <pre className="session-log-pre" tabIndex={0} aria-label={STR.logViewer.logAria}>{data.text}</pre>}
+       <div className="session-log-note">
+         {data.truncated ? (data.lines === 1 && data.text.length > 100_000 ? STR.logViewer.singleLine : STR.logViewer.truncated) : null}
+         <span className="num">{data.lines} {STR.logViewer.lines} · {STR.logViewer.size} {formatBytes(data.bytes)}</span>
+       </div>
+     </>
+   );
+ }
+
+ export function SessionLogDialog(props: { id: string; title: string; onClose: () => void }): React.JSX.Element {
+   const [state, setState] = useState<SessionLogState>({ status: "loading" });
+   const seqRef = useRef(0);
+
+   const load = useCallback(() => {
+     const seq = ++seqRef.current;
+     setState((prev) => (prev.status === "ready" ? prev : { status: "loading" }));
+     void Promise.resolve()
+       .then(() => window.agent.sessionLog(props.id, 400))
+       .then(
+         (r) => {
+           if (seq !== seqRef.current) return;
+           setState(r.ok ? { status: "ready", data: r } : { status: "error", error: r.error });
+         },
+         (e: unknown) => {
+           if (seq !== seqRef.current) return;
+           setState({ status: "error", error: e instanceof Error ? e.message : String(e) });
+         },
+       );
+   }, [props.id]);
+
+   useEffect(() => { load(); }, [load]);
+
+   return (
+     <div className="modal-backdrop" role="presentation" onClick={props.onClose}>
+       <ModalSurface
+         className="modal-card modal-wide session-log-modal"
+         label={`${STR.logViewer.title} · ${props.title}`}
+         onClose={props.onClose}
+         onClick={(e) => { e.stopPropagation(); }}
+       >
+         <div className="modal-head">
+           <span>{STR.logViewer.title} <span className="session-log-target">{props.title}</span></span>
+           <button className="iconbtn sm" aria-label={STR.logViewer.close} title={STR.logViewer.close} onClick={props.onClose}>
+             <X size={13} />
+           </button>
+         </div>
+         <SessionLogBody
+           state={state}
+           onRetry={load}
+           onCopyPath={(path) => { copyText(path, STR.logViewer.copiedPath); }}
+         />
+         <div className="modal-foot">
+           <button className="mini-btn" title={STR.logViewer.refresh} onClick={load} disabled={state.status === "loading"}>
+             <RefreshCw size={12} aria-hidden="true" /> {STR.logViewer.refresh}
+           </button>
+           <button className="mini-btn" title={STR.logViewer.copyLog} onClick={() => {
+             if (state.status === "ready") copyText(state.data.text, STR.logViewer.copiedLog);
+           }} disabled={state.status !== "ready"}>
+             <Copy size={12} aria-hidden="true" /> {STR.logViewer.copyLog}
+           </button>
+           <button className="mini-btn primary" title={STR.logViewer.close} onClick={props.onClose}>{STR.logViewer.close}</button>
+         </div>
+       </ModalSurface>
+     </div>
+   );
+ }
+
+ // 会话预览窗格（2026-10-25，2026-10-27 可继续）：⌘+点击侧栏会话，在右栏看另一场会话，
+ // 不打断当前会话。输入框走主会话同一条 sendTo 管线（插话/队列/runOn），不是预览私有副本；
+ // 附件、@引用、技能菜单仍归主输入框，预览只发纯文本。
+ import { useEffect, useMemo, useRef, useState } from "react";
+ import { Send, Square } from "lucide-react";
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { isMainSessionTerminalEvent, mergeSessionSnapshot } from "../derived/session";
+ import { isCompositionEnter } from "../ime";
+ import { projectStream } from "../projections";
+ import { Stream } from "./Stream";
+ import "./session-preview.css";
+
+ export interface PreviewSendOutcome {
+   outcome: "steered" | "queued" | "started" | "failed";
+   error?: string;
+ }
+
+ export function SessionPreviewPane(props: {
+   target: { id: string; workspace?: string; title: string } | null;
+   onSwitch?: (id: string, workspace?: string) => void;
+   /** 在预览中继续发送；running = 目标会话此刻是否在跑（由本窗格的事件态传入）。 */
+   onSend?: (text: string, running: boolean) => Promise<PreviewSendOutcome>;
+   onStop?: () => void;
+   /** 队列停表（本轮失败/停止后）时继续发送队首。 */
+   onResume?: () => void;
+ }): React.JSX.Element {
+   const [events, setEvents] = useState<AgentEvent[]>([]);
+   const [loading, setLoading] = useState(false);
+   const [error, setError] = useState<string | null>(null);
+   const [running, setRunning] = useState(false);
+   const [retry, setRetry] = useState(0);
+   const [draft, setDraft] = useState("");
+   const [sending, setSending] = useState(false);
+   const [notice, setNotice] = useState<string | null>(null);
+   const [queued, setQueued] = useState(false);
+   const previewScrollRef = useRef<HTMLDivElement | null>(null);
+   const stickRef = useRef(true);
+   const targetRef = useRef(props.target);
+   targetRef.current = props.target;
+   const loadingRef = useRef(false);
+   const pendingRef = useRef<AgentEvent[]>([]);
+   const genRef = useRef(0);
+
+   useEffect(() => {
+     return window.agent.onEvent((e) => {
+       const target = targetRef.current;
+       if (target === null) return;
+       if ((e as { session_id?: string }).session_id !== target.id) return;
+       if ((e as { type?: string }).type === "session_titled") return;
+       const eventWorkspace = (e as { workspace?: string }).workspace;
+       if (eventWorkspace !== undefined && target.workspace !== undefined && eventWorkspace !== target.workspace) return;
+       if (loadingRef.current) { pendingRef.current.push(e); return; }
+       setEvents((prev) => [...prev, e]);
+       setRunning(!isMainSessionTerminalEvent(e));
+     });
+   }, []);
+
+   useEffect(() => {
+     const target = props.target;
+     const gen = ++genRef.current;
+     setDraft("");
+     setSending(false);
+     setNotice(null);
+     setQueued(false);
+     loadingRef.current = true;
+     pendingRef.current = [];
+     setEvents([]);
+     setError(null);
+     setRunning(false);
+     if (target === null) {
+       loadingRef.current = false;
+       setLoading(false);
+       return;
+     }
+     setLoading(true);
+     void window.agent.openSession(target.id, target.workspace).then((result) => {
+       if (gen !== genRef.current) return;
+       loadingRef.current = false;
+       setEvents(mergeSessionSnapshot(result.events, pendingRef.current));
+       pendingRef.current = [];
+       const status = result as { running?: unknown };
+       setRunning(status.running === true);
+       setLoading(false);
+     }).catch((err: unknown) => {
+       if (gen !== genRef.current) return;
+       loadingRef.current = false;
+       pendingRef.current = [];
+       setError(err instanceof Error ? err.message : String(err));
+       setLoading(false);
+     });
+     return () => {
+       // 卸载/换目标后迟到的 openSession 不落状态。
+       if (gen === genRef.current) genRef.current += 1;
+       loadingRef.current = false;
+     };
+   }, [props.target, retry]);
+
+   const rows = useMemo(() => projectStream(events, running), [events, running]);
+   useEffect(() => {
+     const el = previewScrollRef.current;
+     if (el !== null && stickRef.current) el.scrollTop = el.scrollHeight;
+   }, [events.length]);
+   useEffect(() => {
+     if (running) setQueued(false);
+   }, [running]);
+   const onStreamScroll = (): void => {
+     const el = previewScrollRef.current;
+     if (el !== null) stickRef.current = el.scrollHeight - el.scrollTop - el.clientHeight < 80;
+   };
+   const submit = async (): Promise<void> => {
+     const text = draft.trim();
+     const target = props.target;
+     if (text === "" || sending || target === null || props.onSend === undefined || loading || error !== null) return;
+     const submittedFor = target.id;
+     setSending(true);
+     setNotice(null);
+     setDraft("");
+     stickRef.current = true;
+     try {
+       const result = await props.onSend(text, running);
+       if (targetRef.current?.id !== submittedFor) return;
+       if (result.outcome === "steered") setNotice("已插话到本轮");
+       else if (result.outcome === "queued") { setQueued(true); setNotice("已加入队列，本轮结束后发送"); }
+       else if (result.outcome === "started") setNotice("已发送");
+       else {
+         setDraft((prev) => (prev === "" ? text : text + "\n" + prev));
+         setNotice("发送失败：" + (result.error ?? "未知原因"));
+       }
+     } catch (err) {
+       if (targetRef.current?.id === submittedFor) {
+         setDraft((prev) => (prev === "" ? text : text + "\n" + prev));
+         setNotice("发送失败：" + (err instanceof Error ? err.message : String(err)));
+       }
+     } finally {
+       if (targetRef.current?.id === submittedFor) setSending(false);
+     }
+   };
+   const target = props.target;
+   if (target === null) {
+     return (
+       <div className="session-preview" aria-label="会话预览">
+         <div className="svp-empty">
+           <p>在侧栏按住 ⌘ 点击一个会话，或从行菜单选「在侧栏预览」。</p>
+           <p className="svp-dim">不会切走当前会话，也不会打断正在运行的任务。</p>
+         </div>
+       </div>
+     );
+   }
+   return (
+     <div className="session-preview" aria-label="会话预览">
+       <div className="svp-head">
+         <div className="svp-title" title={target.title}>{target.title}</div>
+         <span className="svp-badge" title="发送只作用于这个预览会话；点「切到会话」才换主体">不切主会话</span>
+         {running && <span className="svp-live">运行中</span>}
+         {props.onSwitch !== undefined && (
+           <button type="button" className="mini-btn svp-switch" onClick={() => { props.onSwitch?.(target.id, target.workspace); }}>
+             切到会话
+           </button>
+         )}
+       </div>
+       {loading && <div className="svp-note" role="status">正在读取会话…</div>}
+       {error !== null && (
+         <div className="svp-note err" role="alert">
+           <span>预览失败：{error}</span>
+           <button type="button" className="mini-btn" onClick={() => { setRetry((n) => n + 1); }}>重试</button>
+         </div>
+       )}
+       {!loading && error === null && (
+         <div className="stream svp-stream" ref={previewScrollRef} onScroll={onStreamScroll}>
+           <Stream rows={rows} streaming={running} />
+         </div>
+       )}
+       {props.onSend !== undefined && (
+         <div className="svp-composer">
+           {notice !== null && <div className="svp-composer-note" role="status">{notice}</div>}
+           <div className="svp-composer-row">
+             <textarea
+               className="svp-input"
+               rows={2}
+               value={draft}
+               placeholder="在预览中继续对话（Enter 发送，Shift+Enter 换行）"
+               aria-label="在预览中继续对话"
+               disabled={loading || error !== null}
+               onChange={(e) => { setDraft(e.target.value); }}
+               onKeyDown={(e) => {
+                 // IME 组字守卫（2026-10-28）：组字途中的一次回车归 IME，不发消息。
+                 // 口径与主输入框**同一处**（`ime.ts`）——此前这里自己抄了 `nativeEvent.isComposing`，
+                 // 与 Composer 的判定不同源：合成事件缺旗时两处行为会分叉。
+                 if (e.key === "Enter" && !e.shiftKey && !isCompositionEnter(e, null)) {
+                   e.preventDefault();
+                   void submit();
+                 }
+               }}
+             />
+             <div className="svp-composer-actions">
+               {running && props.onStop !== undefined && (
+                 <button
+                   type="button"
+                   className="mini-btn svp-stop"
+                   aria-label="停止预览会话本轮"
+                   title="停止这一轮"
+                   onClick={() => { props.onStop?.(); setNotice("已请求停止"); }}
+                 >
+                   <Square size={11} aria-hidden="true" />
+                 </button>
+               )}
+               <button
+                 type="button"
+                 className="mini-btn svp-send"
+                 aria-label={running ? "发送到预览会话（本轮运行中则插入本轮）" : "发送到预览会话"}
+                 title={running ? "本轮运行中：发送即插话；主进程拒绝时自动入队" : "发送到预览会话"}
+                 disabled={draft.trim() === "" || sending || loading || error !== null}
+                 onClick={() => void submit()}
+               >
+                 <Send size={13} aria-hidden="true" />
+               </button>
+             </div>
+           </div>
+           {queued && !running && props.onResume !== undefined && (
+             <button type="button" className="mini-btn svp-resume" onClick={() => { props.onResume?.(); setQueued(false); }}>
+               继续发送队列
+             </button>
+           )}
+         </div>
+       )}
+     </div>
+   );
+ }
+
+ import { Command } from "cmdk";
+ import { MessageSquare } from "lucide-react";
+ import type { SessionSearchResult } from "../../../../../src/main/ipc-protocol";
+
+ export type SessionSearchState =
+   | { status: "idle" | "loading" }
+   | { status: "ready"; result: SessionSearchResult }
+   | { status: "error"; error: string };
+
+ export function SessionSearchResults(props: {
+   state: SessionSearchState;
+   workspace: string;
+   onOpenSession: (id: string, workspace?: string) => void;
+   onRetry: () => void;
+ }): React.JSX.Element | null {
+   const { state, workspace } = props;
+   if (state.status === "idle") return null;
+   if (state.status === "loading") return <div className="cp-empty" role="status">正在搜索当前项目的对话正文…</div>;
+   let error: string | null = null;
+   if (state.status === "error") error = state.error;
+   else if (state.status === "ready" && state.result.kind === "unavailable") {
+     error = ["当前项目的对话正文暂时无法搜索", state.result.detail].filter(Boolean).join("：");
+   }
+   if (error !== null) return (
+     <div className="cp-empty" role="status">
+       <span>{error}</span>{" "}
+       <button type="button" className="mini-btn" onClick={props.onRetry}>重试搜索</button>
+     </div>
+   );
+   if (state.status !== "ready" || state.result.kind === "unavailable") return null;
+   const result = state.result;
+   return (
+     <Command.Group forceMount heading="当前项目正文" className="cp-group cp-body-search">
+       {result.kind === "partial" && <div className="cp-empty" role="status">搜索尚未完成，可能还有结果</div>}
+       {result.kind === "ok" && result.matches.length === 0 && <div className="cp-empty" role="status">正文中没有匹配</div>}
+       {result.matches.map((match) => (
+         <Command.Item
+           key={match.sessionId}
+           forceMount
+           className="cp-item"
+           data-session-search-result={match.sessionId}
+           value={`正文 ${workspace} ${match.sessionId}`}
+           onSelect={() => props.onOpenSession(match.sessionId, workspace)}
+         >
+           <span className="cp-ico" aria-hidden="true"><MessageSquare size={14} /></span>
+           <span className="cp-stack">
+             <span className="cp-label">{match.title ?? match.sessionId}</span>
+             <span className="cp-sub" title={match.snippets[0]?.excerpt}>{match.snippets[0]?.excerpt}</span>
+           </span>
+           <span className="cp-at num">{match.matchCount}{match.complete && match.badLines === 0 ? "" : "+"} 条</span>
+         </Command.Item>
+       ))}
+     </Command.Group>
+   );
+ }
+
+ // 设置页（批 6 换壳 · 总纲阶段 2-3 + 改动清单阶段 6）：
+ //   壳只留三件事：左导航（settings-nav 是唯一事实源，渲染锚不动）+ 状态管理（settings/status/cap/回执）+
+ //   工作台四分区接线（AppPageBody；导航元数据已抽到轻量 settings-nav，避免命令面板拉入整页）。
+ //   正文四段全在 settings-sections.tsx（通用 / 模型与 Provider / 权限与安全 / 关于与更新），
+ //   公共件走 settings-ui（SettingsPage/SettingsSection/SettingsRow）。
+ //   「修改即保存」静态行 → 右下「已保存 ✓」短暂指示（清单阶段 6）；
+ //   字段级保存（无全局保存键，SettingsStore patch 语义）；校验失败行内红字，不静默。
+ // 纯函数资产（panelPatch / providerStatusLabel / …）随迁 settings-sections，
+ // 本文件重导出保旧 import 面（settings-panel.test 判卷锚不动）。
+ import { Fragment, useEffect, useMemo, useRef, useState } from "react";
+ import { ChevronLeft, Search, X } from "lucide-react";
+ import type { AgentApi, AppSettings, CapabilityReadout, ProviderInfo } from "../../../../../src/main/ipc-protocol";
+ import type { SettingsLoadIssue, TextSizeSetting, UiSizeSetting } from "../../../../../src/main/settings";
+ import { SettingsPage, SettingsRow, SettingsSection } from "./settings-ui";
+ import {
+   AboutSection,
+   AdvancedSection,
+   GeneralSection,
+   PermissionsSection,
+   ProviderSection,
+   SettingsIssueBanner,
+   ShortcutsSection,
+   defaultKeyProvider,
+   panelPatch,
+ } from "./settings-sections";
+ import { AppPageBody, type PageId } from "./AppPage";
+ import { ModalSurface } from "./ModalSurface";
+ import { isCompositionEnter } from "../ime";
+ import { RenderErrorBoundary } from "./RenderErrorBoundary";
+ import { UsageSection } from "./settings/UsageSection";
+ import { EvolveSection } from "./settings/EvolveSection";
+ import { NetworkSection } from "./settings/NetworkSection";
+ import { SETTINGS_PAGE_ORDER, SECTIONS, filterSections, type SectionId } from "./settings-nav";
+ import { destinationForSection } from "../navigation";
+ import "./settings-refinement.css";
+
+ export { SECTIONS, type SectionId };
+
+ // 纯函数资产重导出（原在壳内定义；判卷 import 面不动）。
+ export {
+   PANEL_PATCH_KEYS,
+   panelPatch,
+   PANEL_PROVIDER_KINDS,
+   providerNeedsKey,
+   defaultKeyProvider,
+   providerStatusLabel,
+   searchCapabilityLabel,
+   SEARCH_CONFIG_HINT,
+ } from "./settings-sections";
+
+ const PAGE_SECTION_IDS = new Set<string>(SETTINGS_PAGE_ORDER);
+
+ /* ── 更新区（P1 修复 · 2026-10-22）：「发现新版本」不能是一句死胡同 ────────────────
+    实测缺陷：旧实现只把检查结果的 version 拼成「发现新版本 X」⇒ manifest 里的下载页
+    URL 与更新说明被静默丢掉；渲染层对 openExternal 零调用点 ⇒ 用户看到"有新版"却无处可去。
+    现在：available 态带出版本 + 更新说明 + 一个可点动作，动作**只**走主进程通道
+    agent.openExternal（http(s) 白名单在主进程，manifest 注入协议进不来）。 */
+
+ /** 主进程检查结果（从 AgentApi 派生——渲染层不直接引 updater 模块）。 */
+ type UpdateCheckResult = Awaited<ReturnType<AgentApi["checkUpdate"]>>;
+
+ /** 更新区读数。available 变体必须带 url/notes：丢掉它们＝把"有新版"变成死胡同。 */
+ export type UpdateState =
+   | { kind: "idle" }
+   | { kind: "checking" }
+   | { kind: "unconfigured" }
+   | { kind: "error"; message: string }
+   | { kind: "up-to-date" }
+   | { kind: "available"; version: string; url: string; notes?: string; openError: string | null };
+
+ /** 检查结果 → 读数（url/notes 原样带出，不在这一步丢）。 */
+ export function updateStateOf(r: UpdateCheckResult): UpdateState {
+   if (r.state === "available") return { kind: "available", version: r.version, url: r.url, notes: r.notes, openError: null };
+   if (r.state === "error") return { kind: "error", message: r.message };
+   if (r.state === "unconfigured") return { kind: "unconfigured" };
+   return { kind: "up-to-date" };
+ }
+
+ /** 「检查更新」→ 读数（网络失败也是显式态，绝不静默）。 */
+ export async function checkUpdateState(): Promise<UpdateState> {
+   try {
+     return updateStateOf(await window.agent.checkUpdate());
+   } catch (err) {
+     return { kind: "error", message: err instanceof Error ? err.message : String(err) };
+   }
+ }
+
+ /** 主进程拒绝打开时把原因并进读数（错误面要看得见，不能吞）。 */
+ export function withOpenError(state: UpdateState, message: string): UpdateState {
+   return state.kind === "available" ? { ...state, openError: message } : state;
+ }
+
+ /** 打开下载页：只走主进程通道 agent.openExternal（http(s) 白名单在主进程）。
+  *  外链不经渲染层——渲染层不自己开浏览器、也不改地址栏。 */
+ export async function openUpdateUrl(url: string, onError: (message: string) => void): Promise<void> {
+   let message: string | null = null;
+   try {
+     const r = await window.agent.openExternal(url);
+     if (!r.ok) message = r.error ?? "打开下载页失败";
+   } catch (err) {
+     message = `打开下载页失败：${err instanceof Error ? err.message : String(err)}`;
+   }
+   if (message !== null) onError(message);
+ }
+
+ /** 「发现新版本」卡：版本 + 更新说明 + 一个可点动作（打开下载页）。 */
+ export function UpdateOffer(props: {
+   version: string;
+   url: string;
+   notes?: string;
+   /** 主进程拒绝时的错误文案；null = 无。 */
+   error: string | null;
+   /** 打开失败回调（面板接自己的读数）。 */
+   onError: (message: string) => void;
+ }): React.JSX.Element {
+   return (
+     <SettingsSection title="新版本">
+       <SettingsRow label={`发现新版本 ${props.version}`} desc={props.notes}>
+         <button type="button" className="mini-btn" title={props.url} onClick={() => openUpdateUrl(props.url, props.onError)}>
+           打开下载页
+         </button>
+       </SettingsRow>
+       {props.error !== null && <div className="sp-note err" role="alert">{props.error}</div>}
+     </SettingsSection>
+   );
+ }
+
+ export function SettingsPanel(props: {
+   onClose: () => void;
+   initialSection?: SectionId;
+   onSettingsSaved?: () => void;
+   /** 重新显示首启检查（只落 onboarded=false，不重置其它设置）。 */
+   onShowOnboarding?: () => void;
+ }): React.JSX.Element {
+   const [section, setSection] = useState<SectionId>(() =>
+     props.initialSection !== undefined && destinationForSection(props.initialSection) === null
+       ? props.initialSection
+       : "general",
+   );
+   const [settings, setS] = useState<AppSettings | null>(null);
+   const [status, setStatus] = useState<{ available: boolean; stored: string[]; envActive: boolean }>({ available: true, stored: [], envActive: false });
+   const [about, setAbout] = useState<{ version: string; build?: import("../../../../../src/main/build-info").BuildInfo } | null>(null);
+   const [license, setLicense] = useState<import("../../../../../src/main/license").LicenseState | null>(null);
+   // v26：设置文件首读失败（坏 JSON / 读不了）。null = 没有文件或读得动，不摆横幅。
+   const [settingsIssue, setSettingsIssue] = useState<SettingsLoadIssue | null>(null);
+   /** 「重新读取」进行中：按钮禁用（重读是串行进写队列的，连点没有第二份收益）。 */
+   const [reloadingSettings, setReloadingSettings] = useState(false);
+   // 能力在场性读数（搜索端点配没配）。null = 还没问到 / 问失败——那一格显示「读不到」，
+   // 不显示「已配」：把读不到当成配好，正是这个面板要修的那类假象。
+   const [cap, setCap] = useState<CapabilityReadout | null>(null);
+   // 供应商清单（内置 + 已装自定义）与全量模型——供应商管理列表的数据面（参照 Codex 供应商页）。
+   const [pvInfo, setPvInfo] = useState<ProviderInfo | null>(null);
+   const [update, setUpdate] = useState<UpdateState>({ kind: "idle" });
+   const [keyProvider, setKeyProvider] = useState(defaultKeyProvider);
+   // 「检查连接」的三态回执：保存成功 ≠ 服务可用，两件事分开显示（主进程只 GET 模型清单，不耗额度）。
+   const [checkMsg, setCheckMsg] = useState<{ tone: "wait" | "ok" | "err"; text: string; hint?: string } | null>(null);
+   // 右下保存状态指示（替换原「修改即保存」静态行）：短暂显示后淡出，不占版式。
+   const [flash, setFlash] = useState<string | null>(null);
+   const flashTimer = useRef<number | null>(null);
+   const [error, setError] = useState<string | null>(null);
+   const [busy, setBusy] = useState(false);
+   // key 明文零进 React state：输入框非受控，用 ref 取值（与旧实现同一条纪律）。
+   const keyInput = useRef<HTMLInputElement | null>(null);
+   // 字号档（2026-10-18）：与 App 的 live state 同源，但设置页自己持一份初值，
+   // 保存后立刻回灌（不等 App 的 getSettings 回流）——点下去就要看见变化。
+   const [textSize, setTextSize] = useState<TextSizeSetting>("md");
+   const [uiSize, setUiSize] = useState<UiSizeSetting>("2");
+   // 分区搜索（2026-10-18）：收窄左栏九个分区；Esc 两级（有字先清空，空着才失焦）。
+   const [navQuery, setNavQuery] = useState("");
+   const navSearchRef = useRef<HTMLInputElement | null>(null);
+   const visibleSections = useMemo(() => filterSections(navQuery), [navQuery]);
+
+   const pulse = (msg: string) => {
+     setFlash(msg);
+     if (flashTimer.current !== null) window.clearTimeout(flashTimer.current);
+     flashTimer.current = window.setTimeout(() => setFlash(null), 2200);
+   };
+
+   useEffect(() => () => {
+     if (flashTimer.current !== null) window.clearTimeout(flashTimer.current);
+   }, []);
+
+   const refresh = () => {
+     void window.agent.getSettings().then((s) => { setS(s); setTextSize(s.textSize); setUiSize(s.uiSize); }).catch((err: unknown) => {
+       setError(err instanceof Error ? err.message : String(err));
+     });
+     void window.agent.providerKeyStatus().then((s) => setStatus({ available: s.available, stored: s.stored, envActive: s.envActive })).catch(() => undefined);
+     void window.agent.getProviderInfo().then(setPvInfo).catch(() => setPvInfo(null));
+   };
+
+   /** getState 面（关于/许可证/设置首读问题）——横幅上的「重新检查」也走这一条。 */
+   const loadState = () => {
+     void window.agent.getState().then((s) => {
+       setAbout(s.about ?? null);
+       setLicense(s.license ?? null);
+       setSettingsIssue(s.settingsIssue ?? null);
+     }).catch(() => { setAbout(null); setSettingsIssue(null); });
+   };
+
+   useEffect(() => {
+     refresh();
+     loadState();
+     void window.agent.capabilities().then(setCap).catch(() => setCap(null));
+     // eslint-disable-next-line react-hooks/exhaustive-deps
+   }, []);
+
+   /** 关闭设置前先提交正在编辑的输入（v33 真机实测：数字框未失焦时按 Esc，值会随卸载丢掉）。
+    *  blur() 同步触发 React onBlur（失焦即存），再调 props.onClose 卸载面板。
+    *  返回按钮/遮罩/键盘三条关闭路径都走这里。 */
+   const closeSettings = () => {
+     const active = document.activeElement;
+     if (active instanceof HTMLElement && active.closest(".sp-page") !== null) active.blur();
+     props.onClose();
+   };
+
+   /** 「重新读取」：真重读盘（主进程 SettingsStore.reload）——修好文件后不重启即可恢复。
+    *  重读成功后把盘上值回灌面板与 App 的 live state（主题/档位/字号…），并清掉横幅。 */
+   const reloadFromDisk = async () => {
+     setError(null);
+     setReloadingSettings(true);
+     try {
+       const r = await window.agent.reloadSettings();
+       if (!r.ok) { setError(`重新读取失败：${r.error ?? "未知错误"}`); return; }
+       refresh();
+       loadState();
+       props.onSettingsSaved?.();
+       pulse("已重新读取 ✓");
+     } catch (err) {
+       setError(`重新读取失败：${err instanceof Error ? err.message : String(err)}`);
+     } finally {
+       setReloadingSettings(false);
+     }
+   };
+
+   const save = async (patch: Record<string, unknown>) => {
+     setError(null);
+     try {
+       const next = await window.agent.setSettings(panelPatch(patch));
+       setS(next);
+       pulse("已保存 ✓");
+       props.onSettingsSaved?.();
+     } catch (err) {
+       setError(`保存失败：${err instanceof Error ? err.message : String(err)}`);
+     }
+   };
+
+   /** Ctrl+Tab 会话循环（§3.6/§7.3.3）：不走 panelPatch（那份白名单与其判卷口径保持原样），单键直调同一条通道。 */
+   const saveCtrlTab = (next: boolean) => {
+     setError(null);
