+     <span className="sw-wrap">
+       <button
+         type="button"
+         role="switch"
+         aria-checked={props.checked}
+         aria-label={props.label}
+         className={"sw" + (props.checked ? " on" : "")}
+         disabled={off}
+         title={props.busy === true ? "保存中…" : `${props.label}：${stateText}`}
+         onClick={() => { props.onChange(!props.checked); }}
+       >
+         <span className="sw-knob" aria-hidden="true" />
+       </button>
+       <span className={"sw-state" + (props.checked ? " on" : "")}>{props.busy === true ? "保存中…" : stateText}</span>
+       {props.trailing}
+     </span>
+   );
+ }
+
+ // 时间线窗格（P3-2 检查器「时间线」Tab = Cairn 核心卖点的可见面）：事件日志 → 步骤序列，
+ // 点击一步跳到对话中的对应位置（App 经 data-event-id 锚 scrollIntoView；折叠轮先展开）。
+ // 数据面 = projections.timelineItems（纯函数：只取在场字段——不编时间、不摆占位步）。
+ // 布局 = 竖轴 + 节点圆点；kind 词在窄列（320–420）里最省位：你 / 回复 / 工具 / 用量。
+ import { relativeTime, type TimelineItem } from "../projections";
+ import { useNow } from "../useNow";
+
+ /** kind 词（窄列可读性）。 */
+ const KIND_WORD: Record<TimelineItem["kind"], string> = {
+   user: "你",
+   assistant: "回复",
+   tool: "工具",
+   usage: "用量",
+ };
+
+ export function TimelinePane(props: { items: readonly TimelineItem[]; onJump?: (eventId: number) => void }): React.JSX.Element {
+   const now = useNow();
+   if (props.items.length === 0) {
+     return <div className="isp-empty">本会话还没有可列的事件。<br />对话开始后，每一步会按事件日志在这里排队。</div>;
+   }
+   return (
+     <ol className="tl-list">
+       {props.items.map((it) => (
+         <li className="tl-row" key={it.eventId}>
+           <button className="tl-item" title="跳到对话中的对应位置" onClick={() => props.onJump?.(it.eventId)}>
+             <span className={`tl-kind ${it.kind}`}>{KIND_WORD[it.kind]}</span>
+             <span className="tl-label">{it.label}</span>
+             {it.at !== undefined && <span className="tl-at">{relativeTime(now, it.at)}</span>}
+           </button>
+         </li>
+       ))}
+     </ol>
+   );
+ }
+
+ // 统一工具栏（2026-10-20 批 129 · Apple 统一工具栏 + Claude/Codex「顶栏＝上下文锚点」）：
+ // 原先是**两条**顶栏——38px 窗口 chrome（居中「Cairn」）+ 26px 会话条（会话名 + 窗格按钮）。
+ // 规范 §9 批 120/121 在这上面翻过车：批 120 把会话名放进顶栏，批 121 又因「标题出现两次」撤回——
+ // 真因是两条栏都在；合并成一条，标题任何时刻只出现一次，争点自然消解。
+ //
+ // 本组件只管**几何与壳**；内容（重命名态、GoalChip、窗格按钮）由 App 传进来。
+ //
+ // 几何（会话名对中栏居中，且永不与右组按钮重叠）：
+ //   c  = 中栏中心（相对 .app）              ← 标题恒对中栏，标题所在的「带」绕 c 对称
+ //   带宽 = 2 · min(c − 左界, 右界 − c)      ← 左右各自能借到的空间取小者 ⇒ 长名收窄而不是滑到按钮下
+ //   左界 = max(左组右沿, 中栏左沿)；右界 = min(中栏右沿, 右组左沿 − 气沟)
+ // 侧栏收起时中栏左沿自动为 0，公式照样成立。观测 .main / .tb-left / .tb-right 三者：
+ //   .main 抓窗口缩放、侧栏开合（140ms 过渡 ⇒ 逐帧重算，标题跟着侧栏滑）、检查器开合、专注模式；
+ //   .tb-right 抓窗格簇的出现/消失、目录按钮的出现、变更徽标数字变宽。
+ //
+ // 红绿灯由系统绘制（main/index.ts 的 hiddenInset），这里只留 76px 避让位，不画假灯。
+ import { useLayoutEffect, useRef, type ReactNode } from "react";
+ import { PanelLeft } from "lucide-react";
+
+ /** 中栏带与右组之间的气沟（px）：标题带右沿不让到按钮贴脸。 */
+ const GUTTER = 8;
+
+ export function TitleBar(props: {
+   /** 中栏主体：会话名（可重命名）或主页品牌名。 */
+   center: ReactNode;
+   /** 紧随标题右侧的附属件（目标芯片）。 */
+   aside?: ReactNode;
+   /** 左翼上下文（工作区名 + 本地标记）；窄窗由 CSS 收起。 */
+   context?: ReactNode;
+   sidebarCollapsed: boolean;
+   onToggleSidebar: () => void;
+   /** 全屏面板（设置）里不摆侧栏开关——它只会切换被盖住的侧栏；返回留在面板 surface 内。 */
+   showToggle?: boolean;
+   /** 右端操作槽（窗格入口、专注模式等；no-drag）。 */
+   right?: ReactNode;
+ }) {
+   const bandRef = useRef<HTMLDivElement | null>(null);
+   const leftRef = useRef<HTMLDivElement | null>(null);
+   const rightRef = useRef<HTMLDivElement | null>(null);
+   useLayoutEffect(() => {
+     const band = bandRef.current;
+     const host = band?.closest(".app");
+     if (!band || !host) return;
+     const sync = (): void => {
+       const main = host.querySelector(".main");
+       if (!main) return;
+       const hostRect = host.getBoundingClientRect();
+       const mainRect = main.getBoundingClientRect();
+       const leftRect = leftRef.current?.getBoundingClientRect();
+       const rightRect = rightRef.current?.getBoundingClientRect();
+       const L = mainRect.left - hostRect.left;
+       const M = mainRect.width;
+       const c = L + M / 2;
+       const leftLimit = Math.max(
+         leftRect ? leftRect.right - hostRect.left : L,
+         L,
+       );
+       const rightLimit = Math.min(
+         L + M,
+         rightRect && rightRect.width > 0 ? rightRect.left - hostRect.left - GUTTER : L + M,
+       );
+       const half = Math.max(0, Math.min(c - leftLimit, rightLimit - c));
+       const width = Math.min(M, half * 2);
+       band.style.left = `${String(c - width / 2)}px`;
+       band.style.width = `${String(width)}px`;
+     };
+     sync();
+     const ro = new ResizeObserver(sync);
+     ro.observe(host.querySelector(".main") ?? host);
+     if (leftRef.current) ro.observe(leftRef.current);
+     if (rightRef.current) ro.observe(rightRef.current);
+     window.addEventListener("resize", sync);
+     return () => {
+       ro.disconnect();
+       window.removeEventListener("resize", sync);
+     };
+   }, []);
+   return (
+     <header className="titlebar" data-cds="Toolbar">
+       {/* hiddenInset：红绿灯由系统绘制，这里只留 76px 避让位 */}
+       <div className="tb-left" ref={leftRef}>
+         <div className="traffic" aria-hidden="true"></div>
+         {props.showToggle !== false && (
+           <button
+             className="iconbtn sm"
+             title={props.sidebarCollapsed ? "展开侧栏" : "折叠侧栏"}
+             aria-label={props.sidebarCollapsed ? "展开侧栏" : "折叠侧栏"}
+             onClick={props.onToggleSidebar}
+           >
+             <PanelLeft size={14} />
+           </button>
+         )}
+         {props.context}
+       </div>
+       {/* 中栏带：只作定位与居中。本体不接管指针 ⇒ 工具栏的拖拽区照旧覆盖中栏；
+           可交互子元素（重命名按钮/输入框、目标芯片）各自 pointer-events:auto + no-drag。 */}
+       <div className="tb-center" ref={bandRef}>
+         {/* 左右两翼等宽（1fr auto 1fr）⇒ 标题槽恒在带的正中，
+             目标芯片在右翼（贴标题右侧）不会把标题挤偏。 */}
+         <div className="tb-lead" aria-hidden="true"></div>
+         <div className="tb-title-slot">{props.center}</div>
+         <div className="tb-trail">{props.aside}</div>
+       </div>
+       <div className="tb-right" ref={rightRef}>{props.right}</div>
+     </header>
+   );
+ }
+
+ import { useEffect, useState } from "react";
+ import { subscribeToastHost } from "../toast";
+
+ type ToasterComponent = (typeof import("sonner"))["Toaster"];
+
+ /** 首次提示请求后才挂载 sonner；空提示路径不下载、不解析 Toast 样式与状态机。 */
+ export function ToastHost(): React.JSX.Element | null {
+   const [toaster, setToaster] = useState<{ Component: ToasterComponent } | null>(null);
+   useEffect(() => subscribeToastHost((module) => setToaster({ Component: module.Toaster })), []);
+   if (toaster === null) return null;
+   const Toaster = toaster.Component;
+   return <Toaster position="bottom-right" gap={8} />;
+ }
+
+ // 用量环 + 明细浮层（2026-10-25）：从 Composer 抽出（Composer 已超 1200 行帽；App 规则要求
+ // 先拆再加）。行为、DOM 类名与文案出处保持不变：环心=上下文水位、未知分两种说清、明细与
+ // 「压缩历史…」入口原样；外点/Esc 关闭仍走 usePopoverDismiss。
+ import { useRef } from "react";
+ import { STR } from "../strings";
+ import { formatTokens } from "./format-tokens";
+ import { Popover, usePopoverDismiss } from "./Popover";
+
+ const USAGE_RING_R = 11.5;
+ const USAGE_RING_C = 2 * Math.PI * USAGE_RING_R;
+
+ /** 上下文预算（纯函数，判卷面）：窗口 / 已用 / **余量** / 水位。
+  *
+  *  「已用」取**上一轮实际带进去的 token**（`lastInputTokens`）——那正是下一轮要带的上下文，
+  *  也是 Codex 说的 context window 口径（不是本轮输入输出的累计总和）。
+  *  窗口未知（模型没登记窗口）⇒ null（界面说「未知」，**不许拿 0 冒充**）。
+  *  低水位阈值：余量 ≤ 窗口的 10%（Codex 的自动压缩点落在 90% 用量 ⇒ 余量 10%）。
+  */
+ export interface ContextBudget {
+   /** 模型窗口（token）。 */
+   window: number;
+   /** 当前上下文（token）。 */
+   used: number;
+   /** 余量（token）。 */
+   remaining: number;
+   /** 已用百分比（0–100）。 */
+   pct: number;
+   /** 余量是否已经偏低（≤ 窗口的 10%）。 */
+   low: boolean;
+ }
+
+ export function contextBudget(ctxWindow: number | undefined, lastInputTokens: number): ContextBudget | null {
+   if (ctxWindow === undefined || ctxWindow <= 0 || lastInputTokens <= 0) return null;
+   const used = Math.min(lastInputTokens, ctxWindow);
+   const remaining = Math.max(0, ctxWindow - used);
+   const pct = Math.min(100, Math.round((used / ctxWindow) * 100));
+   return { window: ctxWindow, used, remaining, pct, low: remaining <= ctxWindow * 0.1 };
+ }
+
+ /** 余量占窗口的百分比（给人话看：还剩多少）。 */
+ export function remainingPctOf(budget: ContextBudget): number {
+   return Math.max(0, 100 - Math.round((budget.used / budget.window) * 100));
+ }
+
+ export function UsageMeter(props: {
+   usage: { inputTokens: number; outputTokens: number; usageCount: number; cacheReadTokens: number; lastInputTokens: number };
+   steps: number;
+   ctxWindow?: number;
+   open: boolean;
+   onOpenChange: (open: boolean) => void;
+   onCompact: () => void;
+ }): React.JSX.Element {
+   const wrapRef = useRef<HTMLDivElement | null>(null);
+   const close = (): void => { props.onOpenChange(false); };
+   usePopoverDismiss(props.open, close, wrapRef);
+   const usage = props.usage;
+   const totalTok = usage.inputTokens + usage.outputTokens;
+   const cachePct = usage.cacheReadTokens > 0 && usage.inputTokens > 0
+     ? Math.min(99, Math.round((usage.cacheReadTokens / (usage.cacheReadTokens + usage.inputTokens)) * 100))
+     : null;
+   // 上下文预算：窗口、已用、余量、水位（纯函数在上）。
+   const budget = contextBudget(props.ctxWindow, usage.lastInputTokens);
+   const ctxPct = budget === null ? null : budget.pct;
+   const ctxWindowDeclared = props.ctxWindow !== undefined && props.ctxWindow > 0;
+   const ringFacts: string[] = [];
+   if (totalTok > 0) ringFacts.push(STR.composer.ringTokens.replace("{n}", formatTokens(totalTok)));
+   if (usage.usageCount > 0) ringFacts.push(STR.composer.ringRounds.replace("{n}", String(usage.usageCount)));
+   if (props.steps > 0) ringFacts.push(STR.composer.ringSteps.replace("{n}", String(props.steps)));
+   if (cachePct !== null) ringFacts.push(STR.composer.ringCache.replace("{n}", String(cachePct)));
+   const ringTail = ringFacts.length > 0 ? ` · ${ringFacts.join(" · ")}` : "";
+   const ringTitle = ctxPct !== null
+     ? STR.composer.ringTitlePct.replace("{pct}", String(ctxPct)).replace("{tail}", ringTail)
+     : ctxWindowDeclared
+       ? STR.composer.ringTitleNoData.replace("{tail}", ringTail)
+       : STR.composer.ringTitleUnknown.replace("{tail}", ringTail);
+   const ringAria = ctxPct !== null
+     ? STR.composer.ringAriaPct.replace("{pct}", String(ctxPct))
+     : ctxWindowDeclared ? STR.composer.ringAriaNoData : STR.composer.ringAriaUnknown;
+
+   return (
+     <div className="usage-slot" ref={wrapRef}>
+       <button
+         className="usage-ring"
+         data-level={budget !== null && budget.low ? "low" : "normal"}
+         aria-label={ringAria}
+         title={ringTitle}
+         aria-expanded={props.open}
+         onClick={() => { props.onOpenChange(!props.open); }}
+       >
+         <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
+           <circle className="ur-track" cx="14" cy="14" r={USAGE_RING_R} />
+           <circle
+             className="ur-bar"
+             cx="14" cy="14" r={USAGE_RING_R}
+             style={{
+               strokeDasharray: USAGE_RING_C,
+               strokeDashoffset: USAGE_RING_C * (1 - (ctxPct ?? 0) / 100),
+             }}
+           />
+         </svg>
+         <b className="ur-num">{ctxPct !== null ? String(ctxPct) : STR.composer.dash}</b>
+       </button>
+       <Popover open={props.open} up role="menu" style={{ left: "auto", right: 0 }}>
+         <div className="meter-detail">
+           <div className="pop-label">{STR.composer.meterTitle}</div>
+           <div className="mt-row"><span>{STR.composer.meterInput}</span><b>{formatTokens(usage.inputTokens)}</b></div>
+           <div className="mt-row"><span>{STR.composer.meterOutput}</span><b>{formatTokens(usage.outputTokens)}</b></div>
+           <div className="mt-row"><span>{STR.composer.meterCacheRead}</span><b>{usage.cacheReadTokens > 0 ? formatTokens(usage.cacheReadTokens) : STR.composer.dash}</b></div>
+           <div className="mt-row"><span>{STR.composer.meterRounds}</span><b>{String(usage.usageCount)}</b></div>
+           <div className="mt-row"><span>{STR.composer.meterSteps}</span><b>{String(props.steps)}</b></div>
+           <div className="mt-row">
+             <span>{STR.composer.meterCtx}</span>
+             <b>
+               {ctxPct !== null && props.ctxWindow !== undefined
+                 ? STR.composer.meterCtxDetail
+                     .replace("{pct}", String(ctxPct))
+                     .replace("{used}", formatTokens(usage.lastInputTokens))
+                     .replace("{max}", formatTokens(props.ctxWindow))
+                 : ctxWindowDeclared ? STR.composer.meterCtxNoData : STR.composer.meterCtxUnknown}
+             </b>
+           </div>
+           {budget !== null && (
+             <>
+               <div className="mt-row">
+                 <span>{STR.composer.meterCtxRemaining}</span>
+                 <b>
+                   {STR.composer.meterCtxRemainingValue
+                     .replace("{n}", formatTokens(budget.remaining))
+                     .replace("{max}", formatTokens(budget.window))
+                     .replace("{pct}", String(remainingPctOf(budget)))}
+                 </b>
+               </div>
+               {budget.low && (
+                 <div className="meter-warn" role="status">
+                   {STR.composer.meterCtxLow.replace("{n}", formatTokens(budget.remaining))}
+                 </div>
+               )}
+             </>
+           )}
+           <div className="menu-note">{STR.composer.meterNote}</div>
+           <div className="menu-sep" />
+           <button className="menu-item" onClick={() => { close(); props.onCompact(); }}>{STR.composer.meterCompact}</button>
+         </div>
+       </Popover>
+     </div>
+   );
+ }
+
+ import * as DropdownMenu from "@radix-ui/react-dropdown-menu";
+ import { ChevronDown, FileDiff } from "lucide-react";
+ import { PANE_META, PANE_OPENABLE, type PaneKind } from "../pane-registry";
+ import { paneShortcutKeys } from "../pane-shortcuts";
+
+ export interface WorkbenchToolsProps {
+   hasSession: boolean;
+   paneTabs: readonly PaneKind[];
+   fileCount: number;
+   inspectorOpen: boolean;
+   pluginSidebarOpen: boolean;
+   focusMode: boolean;
+   onOpenPane: (kind: PaneKind) => void;
+   onToggleInspector: () => void;
+   onTogglePluginSidebar: () => void;
+   onToggleFocusMode: () => void;
+ }
+
+ /** 工具只在需要时出现；改动是直接导航，已挂载的窗格也应切到前台。 */
+ export function WorkbenchTools(props: WorkbenchToolsProps) {
+   return <>
+     {props.hasSession && <button
+       className="tb-btn tb-action"
+       data-workbench-changes="true"
+       aria-label={`查看本会话改动（${String(props.fileCount)} 个文件）`}
+       title={`查看本会话改动（${paneShortcutKeys("changes")}）`}
+       onClick={() => props.onOpenPane("changes")}
+     >
+       <FileDiff size={14} aria-hidden="true" />
+       <span>改动</span>
+       {props.fileCount > 0 && <span className="tb-action-count num" aria-hidden="true">{String(props.fileCount)}</span>}
+     </button>}
+     <DropdownMenu.Root>
+       <DropdownMenu.Trigger asChild>
+         <button className="tb-btn tb-action" aria-label="工作台工具" title="工作台工具">
+           <span>工具</span><ChevronDown size={12} aria-hidden="true" />
+         </button>
+       </DropdownMenu.Trigger>
+       <DropdownMenu.Content className="pop-rd" data-workbench-menu="true" side="bottom" align="end" sideOffset={4}>
+         {props.hasSession && <>
+           {PANE_OPENABLE.filter(k => k !== "changes").map(kind => (
+             <DropdownMenu.Item key={kind} className="menu-item" onSelect={() => props.onOpenPane(kind)}>
+               <span>{props.paneTabs.includes(kind) ? "查看" : "打开"}{PANE_META[kind].label}窗格</span>
+               <span className="sub">{paneShortcutKeys(kind)}</span>
+             </DropdownMenu.Item>
+           ))}
+           <DropdownMenu.Separator className="menu-sep" />
+           <DropdownMenu.CheckboxItem className="menu-item" checked={props.inspectorOpen} onCheckedChange={props.onToggleInspector}>
+             <span>{props.inspectorOpen ? "收起右侧面板" : "显示右侧面板"}</span><span className="sub">⌘⌥I</span>
+           </DropdownMenu.CheckboxItem>
+         </>}
+         <DropdownMenu.CheckboxItem className="menu-item" aria-label="插件侧栏" aria-controls="mod-sidebar" checked={props.pluginSidebarOpen} onCheckedChange={props.onTogglePluginSidebar}>
+           <span>{props.pluginSidebarOpen ? "收起插件侧栏" : "打开插件侧栏"}</span><span className="sub">⌘⌥B</span>
+         </DropdownMenu.CheckboxItem>
+         <DropdownMenu.CheckboxItem className="menu-item" aria-label={props.focusMode ? "退出专注模式" : "进入专注模式"} checked={props.focusMode} onCheckedChange={props.onToggleFocusMode}>
+           <span>{props.focusMode ? "退出专注模式" : "进入专注模式"}</span><span className="sub">⌘⌥F</span>
+         </DropdownMenu.CheckboxItem>
+       </DropdownMenu.Content>
+     </DropdownMenu.Root>
+   </>;
+ }
+
+ // 工作树页（2026-10-23）：把 `getState().worktree.orphans` 从「协议里有、界面看不见」接到可见面。
+ //
+ // 孤儿 = `.agents/wt-*` 目录里没有终态/收尾记录、也不在 orchestrator 归属表里的 worker 树。
+ // 只列不自动删：清理是显式动作，走 `window.agent.worktreeClean(name)`；主进程仍会再判一次归属
+ // （第 688 页）——展示层过滤不是删除决策的闸。
+ import { useState } from "react";
+ import { GitBranch } from "lucide-react";
+ import { ConfirmDialog } from "./ConfirmDialog";
+ import { PageFrame } from "./PageFrame";
+
+ export function WorktreesPane(props: {
+   snap: { workspace: string; orphans: string[]; details?: { name: string; dirty: boolean }[] };
+   onError: (message: string) => void;
+   refresh: () => void;
+ }): React.JSX.Element {
+   const [ask, setAsk] = useState<string | null>(null);
+   const [busy, setBusy] = useState<string | null>(null);
+
+   const clean = (name: string) => {
+     setAsk(null);
+     setBusy(name);
+     void window.agent.worktreeClean(name, props.snap.workspace)
+       .then((r) => {
+         if (!r.ok) props.onError(r.error ?? "清理失败");
+         else props.refresh();
+       })
+       .catch((err: unknown) => props.onError(`清理失败：${err instanceof Error ? err.message : String(err)}`))
+       .finally(() => setBusy(null));
+   };
+
+   return (
+     <PageFrame title="工作树" onRefresh={props.refresh}>
+       <div className="ap-worktrees" data-workspace={props.snap.workspace}>
+         <div className="ap-toolbar">
+           <div className="ap-note">孤儿 worktree 只在没有归属时列出；运行中或待合并的树不会出现在这里。</div>
+         </div>
+         {props.snap.orphans.length === 0 ? (
+           <div className="ap-empty">没有遗留的工作树。</div>
+         ) : (
+           <div className="ap-list" aria-label="孤儿工作树">
+             {props.snap.orphans.map((name) => {
+               const dirty = props.snap.details?.find((d) => d.name === name)?.dirty === true;
+               return (
+               <div className="ap-item" key={name} data-orphan={name} data-dirty={dirty ? "true" : "false"}>
+                 <GitBranch size={14} aria-hidden="true" />
+                 <span className="nm">wt-{name}</span>
+                 <span className="sub">孤儿 worktree</span>
+                 {dirty && <span className="sp-tag" style={{ color: "hsl(var(--color-risk-ink))" }}>有未提交改动</span>}
+                 <button
+                   className="mini-btn danger"
+                   disabled={busy === name}
+                   onClick={() => setAsk(name)}
+                 >{busy === name ? "清理中…" : "清理"}</button>
+               </div>
+               );
+             })}
+           </div>
+         )}
+       </div>
+       {ask !== null && (
+         <ConfirmDialog
+           title={`清理 wt-${ask}？`}
+           note={props.snap.details?.find((d) => d.name === ask)?.dirty === true
+             ? "该 worktree 有未提交改动；清理会删除目录与对应 agent 分支，未提交内容无法恢复。"
+             : "会删除该 worktree 目录与对应 agent 分支；未提交的改动无法恢复。"}
+           confirmLabel="清理"
+           danger
+           onClose={() => setAsk(null)}
+           onConfirm={() => clean(ask)}
+         />
+       )}
+     </PageFrame>
+   );
+ }
+
+ // 键盘可达性（a11y）公件：把 `role="button"` 的自绘元素补上「Enter / Space 激活」语义。
+ //
+ // 为什么需要它：原生 <button> 白送这两键，而自绘的 div[role=button] 只有 onClick——
+ // tabIndex={0} 让键盘用户「能聚焦」，聚焦后按 Enter 却没反应。这是「看得见摸不着」的缺口：
+ // 鼠标用户一切正常，纯键盘用户被静默挡在门外。真机实证过（2026-10-18）：插件/定时/记忆三页的
+ // 列表项全部如此，而 Sidebar 会话行、Stream 思考行各自手写了同样的判断——四份重复实现。
+ //
+ // 口径与原生一致（WAI-ARIA button 模式）：
+ //   · Enter / Space 都激活；Space 另需 preventDefault，否则页面会滚动；
+ //   · 只在「目标就是宿主自身」时处理——行内若有真 button（如「…」），
+ //     它的 Enter/Space 冒泡上来不能顺带触发外层（否则一次按键做两件事）。
+ //   · 不碰 modifier 组合（⌘Enter / ⇧Enter 属于应用快捷键，不当作激活）。
+ //
+ // 用法：onKeyDown={(e) => { if (activates(e)) { e.preventDefault(); run(); } }}
+ export function activates(e: { key: string; target: unknown; currentTarget: unknown }): boolean {
+   if (e.target !== e.currentTarget) return false;
+   return e.key === "Enter" || e.key === " ";
+ }
+
+ // 三卡共享纯函数（M2-5）：只做数据组形/校验，不碰 React 与 IPC——组件与测试共用同一份语义。
+ import type { ClarifyAnswerMap, ClarifyQuestion, PlanFileChange } from "../../../../../src/events";
+
+ /**
+  * 澄清表单值 ⇒ 可提交的 ClarifyAnswerMap（key = 问题原文）。
+  * 校验语义：带 options 的问题必答——单选缺选（非 string/空串）、多选空数组都抛「必答」
+  * （错误文案带问题原文，组件原样展示给用户）；自由项（无 options）可空，空则不进提交值
+  * （空串对模型是噪音）。值原样透传不做二次整形：选中项本就是 label 原文。
+  */
+ export function clarifyFormValues(
+   questions: readonly ClarifyQuestion[],
+   values: Readonly<Record<string, string | string[]>>,
+ ): ClarifyAnswerMap {
+   const out: ClarifyAnswerMap = {};
+   for (const q of questions) {
+     const raw = values[q.question];
+     const hasOptions = Array.isArray(q.options) && q.options.length > 0;
+     if (hasOptions) {
+       if (q.multiSelect === true) {
+         const picked = Array.isArray(raw) ? raw : [];
+         if (picked.length === 0) throw new Error(`「${q.question}」必答`);
+         out[q.question] = [...picked];
+       } else {
+         if (typeof raw !== "string" || raw === "") throw new Error(`「${q.question}」必答`);
+         out[q.question] = raw;
+       }
+     } else if (typeof raw === "string" && raw.trim() !== "") {
+       out[q.question] = raw;
+     }
+   }
+   return out;
+ }
+
+ /** 方案卡的文件变更行：`action  path — summary`（action 与 path 间两空格，测试钉死的列面）。 */
+ export function planFileLines(files: readonly PlanFileChange[]): string[] {
+   return files.map((f) => `${f.action}  ${f.path} — ${f.summary}`);
+ }
+
+ /** 批准卡该说的人话（第十一遍重设计；纯函数，SSR 判卷锚）。
+  *  旧版把 `JSON.stringify(args)` 直接上屏——remember 卡显示 `{"trigger":"session_end_distill"}`、
+  *  write_file 卡一整行转义 JSON：业主截屏批「太丑」的一半就是它。锚定口径：
+  *  · title = 这是什么事（工具级人话）；body = 在动什么（命令/路径/patch，mono 面）；
+  *  · subject = 一行补充（记忆层与类型 / 出网地址）；
+  *  · 只有**兜底名单外的工具**才把 args 落 body（可诊断性保留，别把未知形状藏起来）。 */
+ export interface AskDigest {
+   title: string;
+   body?: string;
+   subject?: string;
+ }
+
+ export function describeAsk(ask: { tool?: string; args?: Record<string, unknown> }): AskDigest {
+   const tool = ask.tool ?? "";
+   const args = ask.args ?? {};
+   const s = (v: unknown): string | undefined => (typeof v === "string" && v !== "" ? v : undefined);
+   if (tool === "run_shell") return { title: "运行命令", body: s(args.command) ?? JSON.stringify(args) };
+   if (tool === "write_file") return { title: "写入文件", body: s(args.path) ?? JSON.stringify(args) };
+   if (tool === "edit_file") return { title: "编辑文件", body: s(args.path) ?? JSON.stringify(args) };
+   if (tool === "apply_patch") return { title: "应用补丁", body: s(args.patch) ?? JSON.stringify(args) };
+   if (tool === "web_fetch") return { title: "访问网络", subject: s(args.url) };
+   if (tool === "web_search") {
+     // 端点必须在卡上（2026-10-19 独立评审追出）：端点不在模型给的 args 里
+     // （它来自工作区的 `.agent/config.json`）⇒ 卡上只有 `{"query":"…"}`，人不知道这次要把
+     // 查询发到哪去 ⇒ 批准是**不知情**的。而一个克隆来的仓带一份 `.agent/config.json`
+     // （`search.endpoint` + `allowLocalEndpoint:true`）就能把端点指向回环/内网/云元数据地址。
+     const endpoint = s(args.endpoint);
+     const local = s(args.allowLocalEndpoint);
+     return {
+       title: "搜索网络",
+       ...(endpoint !== undefined ? { subject: endpoint } : {}),
+       ...(local !== undefined ? { body: local } : {}),
+     };
+   }
+   if (tool === "remember") {
+     if (args.trigger === "session_end_distill") {
+       return { title: "写入全局记忆", subject: "会话沉淀：把本场要点写进跨项目记忆（影响你的所有项目）" };
+     }
+     const layer = args.scope === "global" ? "全局记忆" : "项目记忆";
+     const KIND: Record<string, string> = { architecture: "架构", decision: "决策", preference: "偏好", memory: "记忆" };
+     const kind = KIND[String(args.kind)] ?? "记忆";
+     const topic = s(args.topic) ?? s(args.type);
+     return { title: `写入${layer}`, subject: topic !== undefined ? `${kind}「${topic}」` : kind };
+   }
+   if (tool.startsWith("automation_")) return { title: "变更定时任务", subject: s(args.name) };
+   return { title: "需要你批准", body: JSON.stringify(args) };
+ }
+
+ // 用量数字格式化（原 TokenPanel.tsx 的同名函数）。TokenPanel 组件自 M2 起就没被渲染过，
+ // 批 98 把它删掉：Composer 底部用量环（↑in ↓out / 缓存 / 轮数）才是唯一消费面。
+ // 保留独立模块而不是塞回 Composer——纯函数有判卷（model-picker.test）且以后状态条可复用。
+
+ /** 元位数字：过 1000 显 k 一位小数（12400 → "12.4k"），未过原样。 */
+ export function formatTokens(n: number): string {
+   if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
+   return String(n);
+ }
+
+ /** Radix 关闭浮层时用零延时任务恢复触发器；后续控件要再等一轮，避免刚聚焦就被抢回。 */
+ export function scheduleAfterOverlayDismissal(run: () => void): () => void {
+   let timer = globalThis.setTimeout(() => {
+     timer = globalThis.setTimeout(run, 0);
+   }, 0);
+   return () => { globalThis.clearTimeout(timer); };
+ }
+
+ // 窗格投影（纯函数，判卷面）：方案窗格 / 任务窗格的数据面。
+ // 全部从主会话事件流的原始事件投影（worker 子流事件直接按 agent_id 归组——projectStream 会滤掉，
+ // 本层不经过它）。diff 窗格复用既有 turnDelivery 投影，不在此重复。
+ import type { AgentEvent } from "../../../../../src/events";
+ import { turnChanges } from "../projections";
+
+ // ── 窗格集合与路由（唯一事实源；PaneDock 与独立窗口路由共用）────────
+
+ import { PANE_META, PANE_OPENABLE, type PaneKind } from "../pane-registry";
+ // 窗格登记表（类型/标签表/重排/⌘\ 选窗格）已搬到顶层 pane-registry.ts（Phase 2 · 批 2.3）：
+ // state/ 不许 import components/，而那份是数据与纯函数、不是组件。导出面照旧从本文件转出。
+ export { PANE_META, PANE_OPENABLE, lastOpenedPane, movePane, paneTabTargetForKey, type PaneKind } from "../pane-registry";
+
+ /** 独立窗口路由：`#pane=<kind>[&session=<id>]` → 目标窗格；非该形状（含未知 kind）返回 null
+  *  （主窗口模式——不猜、不部分匹配）。 */
+ export function parsePaneHash(hash: string): { kind: PaneKind; sessionId: string | null } | null {
+   const raw = hash.startsWith("#") ? hash.slice(1) : hash;
+   if (raw === "") return null;
+   const params = new URLSearchParams(raw);
+   const kind = params.get("pane");
+   if (kind === null || !Object.hasOwn(PANE_META, kind)) return null;
+   const session = params.get("session");
+   return { kind: kind as PaneKind, sessionId: session === null || session === "" ? null : session };
+ }
+
+ // ── 方案窗格 ──────────────────────────────────────────────────────
+
+ export interface PlanPaneItem {
+   callId: string;
+   goal: string;
+   /** 计划中的文件动作（action/path/summary 逐字来自 plan_proposed）。 */
+   files: { action: string; path: string; summary: string }[];
+   approach?: string;
+   verify?: { lint?: string; test?: string };
+   /** 决议状态：待决 / 已批准 / 已拒绝（plan_approved 配对；缺席 = 待决）。 */
+   state: "pending" | "approved" | "rejected";
+   ts?: number;
+ }
+
+ /** 全部方案（提交顺序）+ 决议配对。plan_approved 按 callId 收口；无对应提案的决议忽略（不编条目）。 */
+ export function projectPlans(events: readonly AgentEvent[]): PlanPaneItem[] {
+   const out: PlanPaneItem[] = [];
+   const byCall = new Map<string, PlanPaneItem>();
+   for (const e of events) {
+     if (e.type === "plan_proposed") {
+       const plan = (e as { plan: { goal: string; files: { action: string; path: string; summary: string }[]; approach?: string; verify?: { lint?: string; test?: string } } }).plan;
+       const item: PlanPaneItem = {
+         callId: (e as { callId: string }).callId,
+         goal: plan.goal,
+         files: plan.files.map((f) => ({ action: f.action, path: f.path, summary: f.summary })),
+         state: "pending",
+         ...(plan.approach !== undefined ? { approach: plan.approach } : {}),
+         ...(plan.verify !== undefined ? { verify: plan.verify } : {}),
+         ...((e as { ts?: number }).ts !== undefined ? { ts: (e as { ts?: number }).ts } : {}),
+       };
+       out.push(item);
+       byCall.set(item.callId, item);
+     } else if (e.type === "plan_approved") {
+       const callId = (e as { callId: string }).callId;
+       const item = byCall.get(callId);
+       if (item !== undefined) item.state = (e as { approved: boolean }).approved ? "approved" : "rejected";
+     }
+   }
+   return out;
+ }
+
+ // ── 任务窗格（多 agent 状态）─────────────────────────────────────
+
+ export type WorkerVerified = "verified" | "failed" | "stale" | "absent";
+
+ export interface WorkerPaneItem {
+   agentId: string;
+   mode: string;
+   task: string;
+   role?: string;
+   status: "running" | "waiting_approval" | "waiting_input" | "done" | "failed" | "cancelled";
+   reason?: string;
+   /** 进度行（agent_message.kind=progress，按到达顺序）。 */
+   progress: string[];
+   startedTs?: number;
+   endedTs?: number;
+   durationSec?: number;
+   filesChanged?: string[];
+   /** worker「代码能跑」的凭据（四态）；缺席 = 本轮没改过文件没有这张券。 */
+   verified?: WorkerVerified;
+   /** 表价花费（USD）；**缺席 = 价格不可知**，消费者不许当 0。 */
+   spentUsd?: number;
+   summary?: string;
+   usage?: { inputTokens: number; outputTokens: number };
+   /** agent_result 在会话事件流里的 1-based 行号（card_action 的 sourceEventId；worker 合并/拒绝用）。 */
+   resultEventId?: number;
+   /** worker 的 diff_ref（`<worktree>@<baseCommit>`）；有了它才能「看过再合」。 */
+   diffRef?: string;
+ }
+
+ /** worker 四事件（spawned/status/message/result）按 agent_id 归组。spawned 缺席的孤儿事件忽略
+  *  （没有派活记录就没有可信的任务面——不编一个空任务）。终态时长 = ended − started（缺一不算）。 */
+ /** worker 合并/拒绝的 card_action 请求（sourceEventId 必须是 agent_result 的行号；
+  *  主进程的 merge/reject 路由按 targetAgentId 找 mergeOwners，cardId 只作审计标识）。 */
+ export function workerCardAction(agentId: string, sourceEventId: number, action: "merge" | "reject"): {
+   cardId: string; sourceEventId: number; cardType: "diff"; action: "merge" | "reject"; targetAgentId: string;
+ } {
+   return { cardId: "worker-diff-" + agentId, sourceEventId, cardType: "diff", action, targetAgentId: agentId };
+ }
+
+ export function projectWorkers(events: readonly AgentEvent[]): WorkerPaneItem[] {
+   const out: WorkerPaneItem[] = [];
+   const byId = new Map<string, WorkerPaneItem>();
+   for (const [eventIndex, e] of events.entries()) {
+     const agentId = (e as { agent_id?: string }).agent_id;
+     if (typeof agentId !== "string") continue;
+     if (e.type === "agent_spawned") {
+       const sp = e as {
+         agent_id: string; mode: string; task: string; role?: string; ts?: number;
+       };
+       const item: WorkerPaneItem = {
+         agentId,
+         mode: sp.mode,
+         task: sp.task,
+         status: "running",
+         progress: [],
+         ...(sp.role !== undefined ? { role: sp.role } : {}),
+         ...(sp.ts !== undefined ? { startedTs: sp.ts } : {}),
+       };
+       out.push(item);
+       byId.set(agentId, item);
+     } else if (e.type === "agent_status") {
+       const item = byId.get(agentId);
+       if (item === undefined) continue;
+       const st = e as { status: WorkerPaneItem["status"]; reason?: string; ts?: number };
+       item.status = st.status;
+       if (st.reason !== undefined) item.reason = st.reason;
+       if (st.ts !== undefined) item.endedTs = st.ts;
+     } else if (e.type === "agent_message") {
+       const item = byId.get(agentId);
+       if (item === undefined) continue;
+       const msg = e as { kind: string; text: string };
+       if (msg.kind === "progress") item.progress.push(msg.text);
+       else item.summary = msg.text;
+     } else if (e.type === "agent_result") {
+       const item = byId.get(agentId);
+       if (item === undefined) continue;
+       const r = e as {
+         status: "done" | "failed"; summary: string;
+         artifacts: { files_changed?: string[]; diff_ref?: string; verified?: WorkerVerified; spent_usd?: number };
+         usage?: { inputTokens: number; outputTokens: number };
+       };
+       item.status = r.status;
+       item.summary = r.summary;
+       if (r.artifacts.files_changed !== undefined) item.filesChanged = r.artifacts.files_changed;
+       if (r.artifacts.verified !== undefined) item.verified = r.artifacts.verified;
+       if (r.artifacts.spent_usd !== undefined) item.spentUsd = r.artifacts.spent_usd;
+       if (r.usage !== undefined) item.usage = { inputTokens: r.usage.inputTokens, outputTokens: r.usage.outputTokens };
+       item.resultEventId = eventIndex + 1;
+       if (r.artifacts.diff_ref !== undefined) item.diffRef = r.artifacts.diff_ref;
+     }
+   }
+   // 终态时长（缺 started 或 ended 不算——不编）。
+   for (const w of out) {
+     if (w.startedTs !== undefined && w.endedTs !== undefined && w.endedTs >= w.startedTs) {
+       w.durationSec = Math.round((w.endedTs - w.startedTs) / 1000);
+     }
+   }
+   return out;
+ }
+
+ export { changedFileCount } from "../changed-files";
+
+ /** 检查器「改动」Tab 的数据面（P3-2）：全轮写工具改动的跨轮去重——同一文件取**最新**轮次与快照
+  *  （撤销要撤到最近一次覆盖前的原件）；顺序 = 首现序（与 changedFileCount 的 Set 序同口径）。 */
+ export function changedFilesOf(events: readonly AgentEvent[]): Array<{
+   path: string;
+   change: "created" | "modified" | "unknown";
+   snapshotId?: string;
+   round: number;
+ }> {
+   const byPath = new Map<string, { path: string; change: "created" | "modified" | "unknown"; snapshotId?: string; round: number }>();
+   const order: string[] = [];
+   for (const t of turnChanges(events)) {
+     for (const f of t.files) {
+       if (!byPath.has(f.path)) order.push(f.path);
+       byPath.set(f.path, { path: f.path, change: f.change, round: t.round, ...(f.snapshotId !== undefined ? { snapshotId: f.snapshotId } : {}) });
+     }
+   }
+   return order.map((p) => byPath.get(p)!);
+ }
+
+ /** 行级评注集合（行键 `<path>|<line>`）→ 一次性提交的消息（蓝本 §3.6：多处评论 ⌘Enter 一次性提交）。
+  *  格式稳定（判卷钉）：按文件分组、行号升序；键形状不合解析的**原样保留**为兜底条目——不吞任何评论。 */
+ export function composeReviewMessage(comments: ReadonlyMap<string, string>): string {
+   const byPath = new Map<string, { line: number; text: string; raw?: string }[]>();
+   for (const [key, text] of comments) {
+     const at = key.lastIndexOf("|");
+     const line = at < 0 ? NaN : Number(key.slice(at + 1));
+     const path = at < 0 ? key : key.slice(0, at);
+     const arr = byPath.get(path) ?? [];
+     if (Number.isFinite(line) && path !== "") arr.push({ line, text });
+     else arr.push({ line: 0, text, raw: key });
+     byPath.set(path, arr);
+   }
+   const parts: string[] = ["针对以下文件改动的**行级评论**（inline review），请按评论修正并重跑验证："];
+   for (const [path, items] of byPath) {
+     items.sort((a, b) => a.line - b.line);
+     parts.push("");
+     parts.push(`**${path}**`);
+     for (const it of items) {
+       parts.push(it.raw !== undefined ? `- ${it.text}（原键：${it.raw}）` : `- 第 ${String(it.line)} 行：${it.text}`);
+     }
+   }
+   return parts.join("\n");
+ }
+
+
+ /** 键盘换位（2026-10-18）：窗格头焦点上按 ⌥↑ / ⌥↓ 的目标下标；到头返回 null（不环绕）。
+  *  与拖拽共用 movePane——换位语义只许一处。 */
+ export function reorderTarget(index: number, key: "ArrowUp" | "ArrowDown", count: number): number | null {
+   const to = index + (key === "ArrowUp" ? -1 : 1);
+   return to < 0 || to >= count ? null : to;
+ }
+
+
+ /** 浏览器窗格的站点授权判定（蓝本 §3.5）：本地（localhost/回环/*.local）免问；
+  *  已记住的域放行；其余要问（Allow once / 记住该域 / 拒绝）。解析失败按"要问"（宁可多问）。
+  *  注意：这只决定"问不问"，不决定"能不能"——外站的写操作在 browse 后端侧另有安全面。 */
+ export function sitePermissionFor(url: string, allowed: ReadonlySet<string>): "local" | "granted" | "ask" {
+   let host: string;
+   try {
+     host = new URL(url).hostname.toLowerCase();
+   } catch {
+     return "ask";
+   }
+   if (host === "localhost" || host === "127.0.0.1" || host === "::1" || host === "[::1]" || host === "0.0.0.0") return "local";
+   if (host.endsWith(".local")) return "local";
+   return allowed.has(host) ? "granted" : "ask";
+ }
+
