+ import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+ import { AlertCircle, ArrowDown, BarChart3, ChevronDown, ClipboardCopy, RefreshCw } from "lucide-react";
+ import type { UsageLedgerPayload } from "../../../../../../src/main/ipc-protocol";
+ import { sumUsageMetrics, usageCsv, usagePeriod, usageTokenLabel, type UsageDay, type UsageMetrics } from "./usage-dashboard-data";
+ import "./usage-dashboard.css";
+
+ export { usagePeriod, usageTokenLabel } from "./usage-dashboard-data";
+ type LedgerData = Extract<UsageLedgerPayload, { ok: true }>;
+ const count = (value: number) => value.toLocaleString("zh-CN");
+ const dateLabel = (day: string) => `${Number(day.slice(5, 7))}月${Number(day.slice(8))}日`;
+ const tokenTotal = (row: UsageMetrics) => row.inputTokens + row.outputTokens;
+ const measured = (row: UsageMetrics) => row.inputMeasured + row.outputMeasured;
+
+ function TokenValue({ value, measurements }: { value: number; measurements: number }) {
+   return <span title={measurements === 0 ? "没有有效用量字段" : `${count(value)} Token`}>{usageTokenLabel(value, measurements)}</span>;
+ }
+
+ function DailyTrend({ days }: { days: UsageDay[] }) {
+   const maximum = Math.max(1, ...days.map(tokenTotal));
+   const chartWidth = 660;
+   const step = 600 / days.length;
+   const ticks = [0, Math.round((days.length - 1) / 2), days.length - 1];
+   return <>
+     <svg className="ud-trend" viewBox={`0 0 ${chartWidth} 194`} role="img" aria-label={`最近 ${days.length} 天的每日用量`}>
+       <title>每日输入与输出 Token。缓存读取单独展示，不重复计入总量；缺测字段不补成已测量的零。</title>
+       {[0, 0.5, 1].map((fraction) => <g key={fraction}>
+         <line x1="48" x2="648" y1={152 - fraction * 128} y2={152 - fraction * 128} className="ud-gridline" />
+         <text x="39" y={156 - fraction * 128} textAnchor="end" className="ud-axis">{usageTokenLabel(Math.round(maximum * fraction), 1)}</text>
+       </g>)}
+       {days.map((day, index) => {
+         const inputHeight = day.inputTokens / maximum * 128;
+         const outputHeight = day.outputTokens / maximum * 128;
+         return <g key={day.day}><title>{day.day}：输入 {usageTokenLabel(day.inputTokens, day.inputMeasured)}，输出 {usageTokenLabel(day.outputTokens, day.outputMeasured)}，{day.usageCount} 条用量记录</title>
+           <rect className="ud-input-fill" x={49 + index * step} y={152 - inputHeight} width={Math.max(1, step - 3)} height={inputHeight} rx="1" />
+           <rect className="ud-output-fill" x={49 + index * step} y={152 - inputHeight - outputHeight} width={Math.max(1, step - 3)} height={outputHeight} rx="1" />
+         </g>;
+       })}
+       {ticks.map((index) => <text key={index} x={49 + index * step + step / 2} y="180" textAnchor={index === 0 ? "start" : index === days.length - 1 ? "end" : "middle"} className="ud-axis">{dateLabel(days[index]!.day)}</text>)}
+     </svg>
+     <details className="ud-data-details"><summary>查看每日数据</summary>
+       <div className="ud-table-scroll"><table className="ud-table"><caption className="ud-sr-only">每日用量明细，缺字段显示为未记录</caption>
+         <thead><tr><th scope="col">日期</th><th scope="col">输入</th><th scope="col">输出</th><th scope="col">用量记录</th></tr></thead>
+         <tbody>{[...days].reverse().map((day) => <tr key={day.day}><th scope="row">{day.day}</th><td>{usageTokenLabel(day.inputTokens, day.inputMeasured)}</td><td>{usageTokenLabel(day.outputTokens, day.outputMeasured)}</td><td>{day.usageCount}</td></tr>)}</tbody>
+       </table></div>
+     </details>
+   </>;
+ }
+
+ function ActivityHeatmap({ days }: { days: UsageDay[] }) {
+   const [selected, setSelected] = useState<string | null>(null);
+   const selectedDay = days.find((day) => day.day === selected) ?? days[days.length - 1]!;
+   const maximum = Math.max(1, ...days.map((day) => day.usageCount + day.rounds));
+   // 周一在首行；起始空格使日期在日历中的星期位置真实。
+   const offset = (new Date(`${days[0]!.day}T12:00:00`).getDay() + 6) % 7;
+   return <>
+     <div className="ud-heatmap-layout">
+       <div className="ud-weekdays" aria-hidden="true"><span>一</span><span>三</span><span>五</span><span>日</span></div>
+       <div className="ud-heatmap" role="group" aria-label="每日活动，使用方向键浏览日期">
+         {Array.from({ length: offset }, (_, index) => <span key={`blank-${index}`} className="ud-heat-blank" aria-hidden="true" />)}
+         {days.map((day, index) => {
+           const active = day.sessions > 0;
+           const intensity = active ? Math.max(1, Math.ceil((day.usageCount + day.rounds) / maximum * 4)) : 0;
+           const label = `${day.day}，${count(day.sessions)} 个活跃会话，${count(day.usageCount)} 条用量记录，${usageTokenLabel(tokenTotal(day), measured(day))} Token`;
+           return <button key={day.day} type="button" className="ud-heat-day" data-level={intensity}
+             aria-label={label} title={label} aria-pressed={selectedDay.day === day.day} tabIndex={selectedDay.day === day.day ? 0 : -1}
+             onFocus={() => setSelected(day.day)} onClick={() => setSelected(day.day)}
+             onKeyDown={(event) => {
+               const delta = event.key === "ArrowRight" ? 7 : event.key === "ArrowLeft" ? -7 : event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0;
+               if (!delta) return;
+               event.preventDefault();
+               const target = Math.max(0, Math.min(days.length - 1, index + delta));
+               const buttons = event.currentTarget.parentElement?.querySelectorAll<HTMLButtonElement>("button");
+               buttons?.[target]?.focus();
+             }} />;
+         })}
+       </div>
+     </div>
+     <div className="ud-heat-caption"><p aria-live="polite"><strong>{dateLabel(selectedDay.day)}</strong><span>{selectedDay.sessions} 个会话 · {selectedDay.usageCount} 条用量记录 · {usageTokenLabel(tokenTotal(selectedDay), measured(selectedDay))} Token</span></p>
+       <div className="ud-heat-legend" aria-label="活动强度由少到多"><span>少</span>{[0, 1, 2, 3, 4].map((level) => <i key={level} data-level={level} />)}<span>多</span></div>
+     </div>
+   </>;
+ }
+
+ export function UsageDashboard({ data, refreshing, error, onRefresh }: { data: LedgerData; refreshing: boolean; error: string | null; onRefresh: () => void }) {
+   const [range, setRange] = useState<7 | 30 | 90>(30);
+   const [copyMsg, setCopyMsg] = useState<string | null>(null);
+   const [sort, setSort] = useState<"tokens" | "records">("tokens");
+   const analytics = data.analytics;
+   const period = useMemo(() => analytics ? usagePeriod(analytics, range) : null, [analytics, range]);
+   const lifetime = analytics ? sumUsageMetrics(analytics.buckets) : null;
+   const undated = analytics ? sumUsageMetrics(analytics.buckets.filter((row) => row.day === null)) : null;
+   const unknownModel = analytics?.buckets.filter((row) => row.model === null).reduce((total, row) => total + row.usageCount, 0) ?? 0;
+   const missingTokens = lifetime ? lifetime.usageCount * 2 - lifetime.inputMeasured - lifetime.outputMeasured : 0;
+   const models = period ? [...period.models].sort((left, right) => sort === "tokens" ? tokenTotal(right) - tokenTotal(left) : right.usageCount - left.usageCount) : [];
+   const periodTokens = period ? tokenTotal(period.totals) : 0;
+   const inputPercent = periodTokens > 0 && period ? period.totals.inputTokens / periodTokens * 100 : 0;
+   const hasWarnings = data.skipped > 0 || data.badLines > 0 || (analytics?.sessionsWithoutUsage ?? 0) > 0 || (undated?.usageCount ?? 0) > 0 || unknownModel > 0 || missingTokens > 0;
+   return <div className="ss-page usage-dashboard">
+     <header className="ud-header"><div><h1 className="ss-title">用量统计</h1><p className="ss-desc">查看累计消耗，以及每天与各模型的使用情况。</p></div>
+       <div className="ud-header-actions">
+         <button type="button" className="ud-refresh" disabled={period === null} onClick={() => { if (period === null) return; void navigator.clipboard.writeText(usageCsv(period)).then(() => { setCopyMsg("CSV 已复制"); setTimeout(() => { setCopyMsg(null); }, 1800); }).catch(() => { setCopyMsg("复制失败：剪贴板不可用"); }); }} aria-label="复制用量 CSV"><ClipboardCopy size={14} aria-hidden="true" />{copyMsg ?? "复制 CSV"}</button>
+         <button type="button" className="ud-refresh" disabled={refreshing} onClick={onRefresh} aria-label={error ? "重试用量统计" : "刷新用量统计"}><RefreshCw size={14} aria-hidden="true" />{refreshing ? "统计中…" : error ? "重试" : "刷新"}</button>
+       </div>
+     </header>
+     {error && <p className="ud-notice ud-error" role="alert"><AlertCircle size={15} aria-hidden="true" />刷新失败：{error}。当前仍显示上次结果。</p>}
+     <dl className="ud-overview">
+       <div><dt>累计 Token</dt><dd><TokenValue value={data.totals.inputTokens + data.totals.outputTokens} measurements={lifetime ? measured(lifetime) : data.totals.usageCount} /></dd><small>输入 + 输出{missingTokens > 0 ? " · 部分缺测" : ""}</small></div>
+       <div><dt>用量记录</dt><dd>{count(data.totals.usageCount)}</dd><small>{lifetime ? `含 ${count(lifetime.workerUsageCount)} 条子代理记录` : "模型上报的消耗记录"}</small></div>
+       <div><dt>累计会话</dt><dd>{count(data.sessions)}</dd><small>{count(data.workspaces)} 个工作区</small></div>
+       <div><dt>活跃天数</dt><dd>{analytics ? count(analytics.activity.filter((row) => row.day !== null).length) : "—"}</dd><small>有日期的会话活动</small></div>
+     </dl>
+     {hasWarnings && <details className="ud-coverage"><summary><AlertCircle size={14} aria-hidden="true" />统计存在缺失，查看覆盖情况<ChevronDown className="ud-coverage-chevron" size={13} aria-hidden="true" /></summary><ul>
+       {data.skipped > 0 && <li>{data.skipped} 个会话无法读取。</li>}
+       {data.badLines > 0 && <li>{data.badLines} 行损坏记录未计入。</li>}
+       {(analytics?.sessionsWithoutUsage ?? 0) > 0 && <li>{analytics!.sessionsWithoutUsage} 个会话没有上报用量；没有记录不代表消耗为零。</li>}
+       {(undated?.usageCount ?? 0) > 0 && <li>{undated!.usageCount} 条用量记录未记录日期（{usageTokenLabel(tokenTotal(undated!), measured(undated!))} Token），仅计入累计指标。</li>}
+       {unknownModel > 0 && <li>{unknownModel} 条用量记录未记录模型，保留为独立分组。</li>}
+       {missingTokens > 0 && <li>{missingTokens} 个输入或输出字段缺测；数字仅为已上报部分，未记录显示为「—」。</li>}
+     </ul></details>}
+     {data.totals.usageCount === 0 && <div className="ud-empty"><BarChart3 size={26} aria-hidden="true" /><h2>尚无用量记录</h2><p>{data.sessions === 0 ? "开始一段对话后，模型上报的 Token 用量会显示在这里。" : "已找到会话，但模型尚未上报有效用量。对话活动仍可在下方查看。"}</p></div>}
+     {!analytics || !period ? <p className="ud-notice">详细统计暂不可用。刷新后可重试读取日期与模型信息。</p> : <>
+       <div className="ud-period-bar"><h2>使用概览</h2><div className="ud-range" role="group" aria-label="统计时间范围">{([7, 30, 90] as const).map((days) => <button key={days} type="button" aria-pressed={range === days} onClick={() => setRange(days)}>最近 {days} 天</button>)}</div></div>
+       <section className="ud-section" aria-labelledby="ud-trend-title"><div className="ud-section-heading"><div><h3 id="ud-trend-title">每日消耗</h3><p>{dateLabel(period.days[0]!.day)} — {dateLabel(period.days[period.days.length - 1]!.day)} · {analytics.timeZone}</p></div><div className="ud-chart-legend"><span><i className="ud-input-fill" />输入</span><span><i className="ud-output-fill" />输出</span></div></div>
+         {period.totals.usageCount === 0 && <p className="ud-period-empty">这 {range} 天没有带日期的用量记录。</p>}
+         <DailyTrend days={period.days} />
+       </section>
+       <div className="ud-detail-grid"><section className="ud-section ud-composition" aria-labelledby="ud-composition-title"><h3 id="ud-composition-title">输入与输出</h3>
+         <div className="ud-composition-bar" role="img" aria-label={`输入 ${usageTokenLabel(period.totals.inputTokens, period.totals.inputMeasured)}，输出 ${usageTokenLabel(period.totals.outputTokens, period.totals.outputMeasured)}，总计仅含输入与输出`}><span style={{ width: `${inputPercent}%` }} /><span style={{ width: `${periodTokens > 0 ? 100 - inputPercent : 0}%` }} /></div>
+         <dl className="ud-composition-values"><div><dt><i className="ud-input-fill" />输入</dt><dd><TokenValue value={period.totals.inputTokens} measurements={period.totals.inputMeasured} /></dd></div><div><dt><i className="ud-output-fill" />输出</dt><dd><TokenValue value={period.totals.outputTokens} measurements={period.totals.outputMeasured} /></dd></div></dl>
+         <p className="ud-cache-note">缓存读取 <strong>{usageTokenLabel(period.totals.cacheReadTokens, period.totals.cacheReadMeasured)}</strong><br />缓存读取单独展示，不重复计入输入 + 输出总量。{period.totals.cacheReadMeasured < period.totals.usageCount && " 部分记录未上报缓存。"}</p>
+       </section><section className="ud-section ud-activity" aria-labelledby="ud-activity-title"><div className="ud-section-heading"><h3 id="ud-activity-title">活动日历</h3><span>{period.days.filter((day) => day.sessions > 0).length} 天有活动</span></div><ActivityHeatmap key={range} days={period.days} /></section></div>
+       <section className="ud-section" aria-labelledby="ud-models-title"><div className="ud-section-heading"><h3 id="ud-models-title">模型用量</h3><label className="ud-sort">排序<select value={sort} onChange={(event) => setSort(event.target.value as "tokens" | "records")}><option value="tokens">Token 总量</option><option value="records">用量记录</option></select><ArrowDown size={12} aria-hidden="true" /></label></div>
+         {models.length === 0 ? <p className="ud-period-empty">这段时间没有可分组的模型用量。</p> : <div className="ud-table-scroll"><table className="ud-table ud-model-table"><caption className="ud-sr-only">最近 {range} 天各模型上报的用量，包含子代理；未记录模型保留为单独一组</caption><thead><tr><th scope="col">模型</th><th scope="col">输入</th><th scope="col">输出</th><th scope="col">总 Token</th><th scope="col">记录</th></tr></thead><tbody>{models.map((model) => <tr key={JSON.stringify(model.model)}><th scope="row"><span className="ud-model-name">{model.model ?? "未记录模型"}</span><span className="ud-model-track" aria-hidden="true"><i style={{ width: `${periodTokens > 0 ? tokenTotal(model) / periodTokens * 100 : 0}%` }} /></span></th><td>{usageTokenLabel(model.inputTokens, model.inputMeasured)}</td><td>{usageTokenLabel(model.outputTokens, model.outputMeasured)}</td><td className="ud-total-cell">{usageTokenLabel(tokenTotal(model), measured(model))}</td><td>{model.usageCount}</td></tr>)}</tbody></table></div>}
+       </section>
+     </>}
+     <footer className="ud-footer">按已登记工作区的原始日志统计，包含子代理消耗。Token 为模型上报值；用量记录数不等于网络请求数。{analytics && <span>更新于 {new Date(analytics.generatedAt).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })}</span>}</footer>
+   </div>;
+ }
+
+ /** 设置页独立加载；刷新保留上次读数，卸载后的迟到响应不会回写。 */
+ export function UsageSection(): React.JSX.Element {
+   const [data, setData] = useState<LedgerData | null>(null);
+   const [refreshing, setRefreshing] = useState(true);
+   const [error, setError] = useState<string | null>(null);
+   const generation = useRef(0);
+   const load = useCallback(async () => {
+     const current = ++generation.current;
+     setRefreshing(true);
+     setError(null);
+     try {
+       const result = await window.agent.usageLedger();
+       if (current !== generation.current) return;
+       if (result.ok) setData(result);
+       else setError(result.error.trim() || "未知原因");
+     } catch (failure) {
+       const message = failure instanceof Error ? failure.message : String(failure);
+       if (current === generation.current) setError(message.trim() || "未知原因");
+     } finally {
+       if (current === generation.current) setRefreshing(false);
+     }
+   }, []);
+   useEffect(() => { void load(); return () => { generation.current += 1; }; }, [load]);
+   if (data) return <UsageDashboard data={data} refreshing={refreshing} error={error} onRefresh={() => { void load(); }} />;
+   return <div className="ss-page usage-dashboard"><h1 className="ss-title">用量统计</h1>{error ? <div className="ud-initial-error" role="alert"><AlertCircle size={24} aria-hidden="true" /><h2>无法读取用量统计</h2><p>{error}</p><button type="button" className="ud-refresh" onClick={() => { void load(); }}>重试</button></div> : <div className="ud-loading" role="status" aria-label="正在统计用量"><p>正在读取会话用量…</p><div /><div /><div /></div>}</div>;
+ }
+
+ // 桌面「运行诊断」的视图投影（2026-10-30 · v34）。
+ // 纯函数：把 DoctorReport 折成给人看的一行一项；**凭据一项按桌面口径重写**——
+ // CLI 的 keys 检查只查环境变量，桌面用户在设置页存的密钥不算在内，直接把原句搬上来会误报「全未设」。
+ // 界面用两侧事实合成：环境变量在位（envProviders）+ 设置页已存（stored）。
+ import type { DoctorCheck, DoctorReport } from "../../../../../../src/main/doctor";
+ import type { SectionId } from "../../app-controls";
+
+ export interface DoctorKeyStatus {
+   available: boolean;
+   stored: readonly string[];
+   envActive: boolean;
+   envProviders?: readonly string[];
+ }
+
+ export interface DoctorRow {
+   id: string;
+   label: string;
+   ok: boolean;
+   fatal: boolean;
+   detail: string;
+   hint?: string;
+ }
+
+ const LABELS: Record<DoctorCheck["id"], string> = {
+   node: "Node",
+   keys: "凭据",
+   tiers: "模型档位",
+   sandbox: "沙箱",
+   workspace: "工作区",
+   settings: "设置文件",
+   sessions: "会话数据",
+   search: "联网搜索",
+   trust: "插件信任面",
+ };
+
+ function cut(check: DoctorCheck): DoctorRow {
+   return {
+     id: check.id,
+     label: LABELS[check.id],
+     ok: check.ok,
+     fatal: check.fatal,
+     detail: check.detail,
+     ...(check.hint !== undefined ? { hint: check.hint } : {}),
+   };
+ }
+
+ /** 报告 → 行；`keys` 为 null = 设置页密钥状态没读到，此时退回 doctor 原句并注明只查了环境变量。 */
+ export function doctorRows(report: DoctorReport, keys: DoctorKeyStatus | null): DoctorRow[] {
+   return report.checks.map((check) => {
+     if (check.id !== "keys") return cut(check);
+     if (keys === null) {
+       return { ...cut(check), label: "凭据（仅环境变量）", detail: `${check.detail}（设置页密钥状态读取失败，本次只查了环境变量）` };
+     }
+     const stored = [...keys.stored];
+     const env = [...(keys.envProviders ?? [])];
+     const ok = keys.envActive || stored.length > 0;
+     const parts: string[] = [];
+     if (env.length > 0) parts.push(`环境变量在位：${env.join("、")}`);
+     if (stored.length > 0) parts.push(`设置页已存 ${String(stored.length)} 家：${stored.join("、")}`);
+     return {
+       id: "keys",
+       label: "凭据",
+       ok,
+       fatal: false,
+       detail: ok ? parts.join("；") : "环境变量与设置页都没有可用凭据",
+       ...(ok ? {} : { hint: "到「模型与 Provider」保存一把密钥；或用 demo 通道零凭据看流程" }),
+     };
+   });
+ }
+
+ /** 总档一行：失败项数比 verdict 本身更能告诉用户「有几件事要处理」。
+  *  计数以**上屏的行**为准——凭据行已换成桌面口径，若仍数报告里的 CLI 原行，
+  *  会出现「列表只有一行红、总档说两项」的自相矛盾。 */
+ export function doctorVerdictText(report: DoctorReport, rows: readonly DoctorRow[]): string {
+   const failing = rows.filter((r) => !r.ok).length;
+   return failing === 0
+     ? `总档：${report.verdict}（${String(rows.length)} 项全过）`
+     : `总档：${report.verdict}（${String(failing)} 项要处理）`;
+ }
+
+ /**
+  * 「去修」落点：诊断行 → 设置分区（2026-10-30 · v37）。
+  *
+  * 为什么必须有这一格：诊断只说「哪里坏了」，用户还要自己在十几个设置分区里找能修它的那一页——
+  * 找不到时，一份正确的诊断等于一句指责。这里只映射**真的能在应用里改**的项：
+  *   · keys         → 模型与 Provider（存 key、选模型）
+  *   · sandbox      → 权限与安全（档位 / 沙箱）
+  *   · search       → 联网搜索（端点与密钥）
+  * Node / 工作区 / 设置文件 / 会话数据不在应用里改（要动环境或文件系统）；插件信任面落在
+  * 「插件」目的地页而不是设置分区（SettingsPanel 的 setSection 到不了），一并返回 undefined——
+  * 宁可不给按钮，也不给一个点了没用的入口。
+  */
+ const DOCTOR_TARGETS: Partial<Record<DoctorCheck["id"], SectionId>> = {
+   keys: "provider",
+   sandbox: "permissions",
+   search: "network",
+ };
+
+ export function doctorTarget(id: string): SectionId | undefined {
+   return Object.prototype.hasOwnProperty.call(DOCTOR_TARGETS, id)
+     ? DOCTOR_TARGETS[id as DoctorCheck["id"]]
+     : undefined;
+ }
+
+ /**
+  * 诊断报告的可带走文本（2026-10-30 · 第 803 页）。
+  * 为什么是纯函数：报告要能复制/贴进 issue，格式就不能靠 JSX 现拼；`generatedAt` 由调用方注入，
+  * 判卷不赌时钟。行序与屏上一致（doctorRows 的顺序），总档取**上屏行**计数后的那一句。
+  */
+ export function doctorReportText(input: {
+   version: string | null;
+   generatedAt: string;
+   verdict: string;
+   rows: readonly DoctorRow[];
+ }): string {
+   const lines = [
+     "Cairn 诊断报告",
+     `版本：${input.version ?? "未知"}`,
+     `生成时间：${input.generatedAt}`,
+     input.verdict,
+     "",
+   ];
+   for (const row of input.rows) {
+     lines.push(`${row.ok ? "[✓]" : "[✗]"} ${row.label}：${row.detail}`);
+     if (row.hint !== undefined) lines.push(`    提示：${row.hint}`);
+   }
+   return lines.join("\n") + "\n";
+ }
+
+ import type { UsageLedgerAnalyticsPayload, UsageLedgerBucketPayload } from "../../../../../../src/main/ipc-protocol";
+
+ export type UsageMetrics = Omit<UsageLedgerBucketPayload, "day" | "model">;
+ export type UsageDay = UsageMetrics & { day: string; sessions: number; rounds: number; toolSteps: number };
+ export type UsageModel = UsageMetrics & { model: string | null };
+
+ export function emptyUsageMetrics(): UsageMetrics {
+   return { inputTokens: 0, outputTokens: 0, cacheReadTokens: 0, usageCount: 0, workerUsageCount: 0, inputMeasured: 0, outputMeasured: 0, cacheReadMeasured: 0 };
+ }
+
+ export function sumUsageMetrics(rows: readonly UsageMetrics[]): UsageMetrics {
+   const total = emptyUsageMetrics();
+   for (const row of rows) {
+     total.inputTokens += row.inputTokens;
+     total.outputTokens += row.outputTokens;
+     total.cacheReadTokens += row.cacheReadTokens;
+     total.usageCount += row.usageCount;
+     total.workerUsageCount += row.workerUsageCount;
+     total.inputMeasured += row.inputMeasured;
+     total.outputMeasured += row.outputMeasured;
+     total.cacheReadMeasured += row.cacheReadMeasured;
+   }
+   return total;
+ }
+
+ export function usageTokenLabel(value: number, measured: number): string {
+   return measured === 0 ? "—" : new Intl.NumberFormat("zh-CN", { notation: "compact", maximumFractionDigits: 1 }).format(value);
+ }
+
+ /** 按扫描器声明的时区确定今天，再做纯日历运算；跨时区/夏令时不移动归日边界。 */
+ export function usagePeriod(analytics: UsageLedgerAnalyticsPayload, range: number) {
+   const parts = new Intl.DateTimeFormat("en-CA", { timeZone: analytics.timeZone, year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(analytics.generatedAt);
+   const part = (name: string) => Number(parts.find((value) => value.type === name)?.value);
+   const end = new Date(Date.UTC(part("year"), part("month") - 1, part("day")));
+   const days: UsageDay[] = Array.from({ length: range }, (_, index) => {
+     const date = new Date(end);
+     date.setUTCDate(date.getUTCDate() - range + index + 1);
+     const day = date.toISOString().slice(0, 10);
+     return { ...emptyUsageMetrics(), day, sessions: 0, rounds: 0, toolSteps: 0 };
+   });
+   const dayMap = new Map(days.map((row) => [row.day, row]));
+   const modelMap = new Map<string | null, UsageModel>();
+   const selected = analytics.buckets.filter((row) => row.day !== null && dayMap.has(row.day));
+   for (const row of selected) {
+     const day = dayMap.get(row.day!)!;
+     Object.assign(day, sumUsageMetrics([day, row]));
+     const previous = modelMap.get(row.model);
+     modelMap.set(row.model, { ...sumUsageMetrics(previous ? [previous, row] : [row]), model: row.model });
+   }
+   for (const row of analytics.activity) {
+     const day = row.day === null ? undefined : dayMap.get(row.day);
+     if (day) { day.sessions = row.sessions; day.rounds = row.rounds; day.toolSteps = row.toolSteps; }
+   }
+   return { days, totals: sumUsageMetrics(selected), models: [...modelMap.values()] };
+ }
+
+ /** 用量 CSV（第 825 页）：逐日明细 + 合计行；数值用原始整数，缺测仍写已上报值（与界面口径一致：
+  *  「—」只在展示层，CSV 不把缺测伪装成 0）。纯函数，方便粘贴进表格。 */
+ export function usageCsv(period: ReturnType<typeof usagePeriod>): string {
+   const esc = (value: string | number): string => {
+     const text = String(value);
+     return /[",\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
+   };
+   const rows: (string | number)[][] = [
+     ["日期", "输入Token", "输出Token", "缓存读取Token", "用量记录", "输入缺测", "输出缺测"],
+   ];
+   for (const day of period.days) {
+     rows.push([day.day, day.inputTokens, day.outputTokens, day.cacheReadTokens, day.usageCount, day.usageCount - day.inputMeasured, day.usageCount - day.outputMeasured]);
+   }
+   const t = period.totals;
+   rows.push(["合计", t.inputTokens, t.outputTokens, t.cacheReadTokens, t.usageCount, t.usageCount - t.inputMeasured, t.usageCount - t.outputMeasured]);
+   return rows.map((row) => row.map(esc).join(",")).join("\n") + "\n";
+ }
+
+ export { truncateSummary, turnSummaries, foldAllButLast, canFoldRound } from "../stream-model";
+
+ // 输入卡浮层槽（2026-10-28 · 第 752 页）：Composer 的四个浮层族（模型菜单 / 用量环 /
+ // ＋附件 / 权限菜单）**共用一个开合真相**。
+ //
+ // 为什么单独成文件：① `Composer.tsx` 已近 1200 行帽（`renderer-layer-check` 的 I4），
+ // 浮层槽的逻辑该有自己的家；② 这段逻辑有**自己的**行为契约（互斥、派生旧语义、
+ // 受控接线），独立成模块才能被纯函数判卷钉住，而不靠"读 Composer 源码有没有这句"。
+ //
+ // 缺陷本体（真机复现）：模型菜单此前自己一份 open 态，与 Composer 的 `menu` 槽互不知情
+ // ⇒ 模型菜单开着时点用量环，两个浮层同屏叠放（几何真的重叠，命中测试落在用量浮层上）。
+ // 现在开合真相在此一处，模型菜单是受控件。
+ import { useCallback, useState } from "react";
+ import { nextOverlay, type OverlayLayer } from "./overlay-mutex";
+
+ /** 旧 `menu` 语义的成员（attach/perm/meter）——既有代码读它，不必全改。 */
+ export type ComposerMenu = "none" | "perm" | "meter" | "attach";
+
+ export interface ComposerOverlaySlot {
+   /** 当前层（唯一真相）。 */
+   layer: OverlayLayer;
+   /** 旧语义的派生值：模型菜单在场时为 `none`（旧代码不认识它）。 */
+   menu: ComposerMenu;
+   /** 旧语义的写入口（既有用法不改）。 */
+   setMenu: (next: ComposerMenu) => void;
+   /** 模型菜单的受控出口：开 ⇒ 别的层让路；关 ⇒ 只关它自己。 */
+   setModelOpen: (next: boolean) => void;
+   /** 附件菜单的开合出口。 */
+   setAttachOpen: (next: boolean) => void;
+   /** 权限菜单的开合出口。 */
+   setPermOpen: (next: boolean) => void;
+   /** 用量环的开合出口。 */
+   setMeterOpen: (next: boolean) => void;
+ }
+
+ /** Composer 的浮层槽：一次只开一个层。 */
+ export function useComposerOverlaySlot(): ComposerOverlaySlot {
+   const [layer, setLayer] = useState<OverlayLayer>("none");
+   const menu: ComposerMenu =
+     layer === "attach" || layer === "perm" || layer === "meter" ? layer : "none";
+   const setMenu = useCallback((next: ComposerMenu): void => {
+     setLayer(next === "none" ? "none" : next);
+   }, []);
+   // 开某层 ⇒ 目标接管（别的层让路）；关某层 ⇒ 只关它自己（不误伤当前层之外的态）。
+   const openExclusive = useCallback((target: Exclude<OverlayLayer, "none">, next: boolean): void => {
+     setLayer((cur) => {
+       if (next) return nextOverlay(cur, target);
+       return cur === target ? "none" : cur;
+     });
+   }, []);
+   const setModelOpen = useCallback((next: boolean) => { openExclusive("model", next); }, [openExclusive]);
+   const setAttachOpen = useCallback((next: boolean) => { openExclusive("attach", next); }, [openExclusive]);
+   const setPermOpen = useCallback((next: boolean) => { openExclusive("perm", next); }, [openExclusive]);
+   const setMeterOpen = useCallback((next: boolean) => { openExclusive("meter", next); }, [openExclusive]);
+   return { layer, menu, setMenu, setModelOpen, setAttachOpen, setPermOpen, setMeterOpen };
+ }
+
+ // 来源视图 → 渲染行（计划 Task 5 · 派生层：纯函数，不读 IO/时钟）。
+ //
+ // 分叉会话的转录 = 视图里的祖先前缀 + 本地有效历史 + **快照之后新到的本地事件**。
+ // 快照的水位是 `localEvents.length`：实时事件的物理行号从它往后推，不用合成历史的长度
+ // （否则父前缀一变，所有本地行的反馈锚点都漂）。
+ import type { AgentEvent, EventRef, SessionView } from "../../../../../src/events";
+
+ export interface ReferencedEvent {
+   event: AgentEvent;
+   /** 该事件在**所属文件**里的物理行号（父第 2 行与子第 2 行是两格）。 */
+   ref: EventRef;
+   /** true = 来自祖先文件（不是本地会话自己的行）。 */
+   inherited: boolean;
+ }
+
+ /** 视图快照 + 实时本地事件（含快照时刻的本地部分）→ 带来源的事件序列。
+  *  `liveLocal` 的前 `view.localEvents.length` 条与快照重复，只取尾部增量。 */
+ export function mergeViewEvents(view: SessionView, liveLocal: readonly AgentEvent[]): ReferencedEvent[] {
+   const out: ReferencedEvent[] = view.entries.map((entry) => ({
+     event: entry.event,
+     ref: entry.ref,
+     inherited: entry.inherited,
+   }));
+   const watermark = view.localEvents.length;
+   for (let index = watermark; index < liveLocal.length; index++) {
+     out.push({
+       event: liveLocal[index]!,
+       ref: { workspace: view.session.workspace, sessionId: view.session.sessionId, eventId: index + 1 },
+       inherited: false,
+     });
+   }
+   return out;
+ }
+
+ /** 显示序（mergeViewEvents 的下标）→ 来源引用；渲染行按 seq 取它。 */
+ export function refsByDisplayIndex(merged: readonly ReferencedEvent[]): ReadonlyMap<number, EventRef> {
+   const out = new Map<number, EventRef>();
+   merged.forEach((entry, index) => out.set(index, entry.ref));
+   return out;
+ }
+
+ /** 祖先行的显示序集合（渲染层据此挂「来自 …」来源标记）。 */
+ export function inheritedDisplayIndexes(merged: readonly ReferencedEvent[]): ReadonlySet<number> {
+   const out = new Set<number>();
+   merged.forEach((entry, index) => { if (entry.inherited) out.add(index); });
+   return out;
+ }
+
+ /** 某显示序的物理引用（缺省 null）。 */
+ export function refAt(merged: readonly ReferencedEvent[], index: number): EventRef | null {
+   return merged[index]?.ref ?? null;
+ }
+
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { isMainSessionTerminalEvent, isWorkerSubflowEvent } from "./session";
+
+ /** 等待占位属于本次 run，而非上一轮历史；起点由发送入口/主进程给出，投影不读时钟。 */
+ export function waitingForModel(input: {
+   events: readonly AgentEvent[];
+   running: boolean;
+   startedAt?: number;
+   blocked?: boolean;
+ }): boolean {
+   if (!input.running || input.blocked) return false;
+   let from = 0;
+   if (input.startedAt !== undefined) {
+     const startedAt = input.startedAt;
+     from = input.events.findIndex((e) => !isWorkerSubflowEvent(e) && e.ts !== undefined && e.ts >= startedAt);
+     // run 已起跑、IPC 尚未送回首个事件：不能用上一轮回答/终态关闭这次等待。
+     if (from === -1) return true;
+   } else {
+     for (let i = input.events.length - 1; i >= 0; i--) {
+       const e = input.events[i]!;
+       if (!isWorkerSubflowEvent(e) && e.type === "user_message" && e.origin?.kind !== "steering") { from = i; break; }
+     }
+   }
+   let waiting = true;
+   const pendingTools = new Set<string>();
+   for (let i = from; i < input.events.length; i++) {
+     const e = input.events[i]!;
+     if (isWorkerSubflowEvent(e)) continue;
+     if (isMainSessionTerminalEvent(e) || e.type === "error") return false;
+     switch (e.type) {
+       case "assistant_delta":
+       case "thinking_delta":
+       case "assistant_message": waiting = false; break;
+       case "tool_call": pendingTools.add(e.id); waiting = false; break;
+       case "tool_result":
+         if (pendingTools.delete(e.callId) && pendingTools.size === 0) waiting = true;
+         break;
+       case "clarify_requested":
+       case "plan_proposed": waiting = false; break;
+       // usage 结束当前调用；工具收口后再到的 usage 不应吃掉下一次模型等待。
+       default: break;
+     }
+   }
+   return waiting && pendingTools.size === 0;
+ }
+
+ // 编排控制面的可用动作：镜像引擎 engine.control() 的合法转移表，别让面板出现「必然被拒」的按钮。
+ // 事实源是 `src/orchestration/engine.ts` 的 phases 表与终态守卫；这里只做投影，不新增规则。
+ // 手动合并/拒绝交付在引擎里恒被拒（交付由验证队列控制）⇒ 面板永不出这两个动作。
+ import type {
+   AcceptanceCheck, ArtifactRef, Contract, ControlAction, EvidenceState, FlowTask, PlanPhase, PlanView,
+   ScheduleAction, TaskPhase, TaskView, Verdict,
+ } from "../../../../../src/orchestration/types";
+
+ export interface OrchestrationControl {
+   action: ControlAction;
+   label: string;
+   /** 会改写用户文件或终止进行中的工作：面板必须二次确认。 */
+   confirm?: boolean;
+ }
+
+ export interface PlanExecutionContext {
+   mode: "shadow" | "execute";
+   backend: string | null;
+   executionUnavailable?: boolean | undefined;
+ }
+
+ export interface TaskCapabilities {
+   rollback: boolean;
+ }
+
+ const TERMINAL: ReadonlySet<TaskPhase> = new Set(["done", "failed", "cancelled"]);
+
+ export function planControls(plan: PlanView): OrchestrationControl[] {
+   switch (plan.phase) {
+     case "proposed":
+       return [
+         { action: "approve_plan", label: "批准" },
+         { action: "reject_plan", label: "拒绝" },
+         { action: "cancel_plan", label: "取消计划", confirm: true },
+       ];
+     case "approved":
+       return [
+         { action: "pause_plan", label: "暂停计划" },
+         { action: "cancel_plan", label: "取消计划", confirm: true },
+       ];
+     case "paused":
+       return [
+         { action: "resume_plan", label: "恢复计划" },
+         { action: "cancel_plan", label: "取消计划", confirm: true },
+       ];
+     default:
+       return [];
+   }
+ }
+
+ export function taskControls(task: TaskView, capabilities: TaskCapabilities): OrchestrationControl[] {
+   if (TERMINAL.has(task.phase)) {
+     // 终态只留「再试一次」与「回滚」；暂停/取消/接管在引擎里都被终态守卫拒绝。
+     const controls: OrchestrationControl[] = [];
+     if ((task.phase === "failed" || task.phase === "cancelled")
+       && task.attempt < task.task.max_attempts) controls.push({ action: "retry_task", label: "重试任务" });
+     // 回滚要同时满足：已有交付修订的 run（引擎按 run_id 找回滚记录）+ 后端声明支持。
+     if (task.phase === "done" && task.run_id !== undefined && capabilities.rollback) {
+       controls.push({ action: "rollback_task", label: "回滚改动", confirm: true });
+     }
+     return controls;
+   }
+   const controls: OrchestrationControl[] = [];
+   if (task.phase === "needs_you" && task.attempt < task.task.max_attempts) {
+     controls.push({ action: "retry_task", label: "重试任务" });
+   }
+   if (task.phase === "paused" || task.reason === "paused by user") {
+     controls.push({ action: "resume_task", label: "恢复任务" });
+   }
+   // 接管把任务交还给人：只对「没有活执行器」的任务有意义（引擎同口径）。
+   const live = task.run_id !== undefined && task.phase !== "paused";
+   if (task.phase === "needs_you" || !live) controls.push({ action: "takeover_task", label: "接管任务" });
+   if (task.phase !== "paused" && task.reason !== "paused by user") {
+     controls.push({ action: "pause_task", label: "暂停任务" });
+   }
+   controls.push({ action: "cancel_task", label: "取消任务", confirm: true });
+   return controls;
+ }
+
+ export function canEnableExecution(plan: PlanView, context: PlanExecutionContext): boolean {
+   return context.mode === "shadow" && context.backend !== null
+     && plan.phase === "approved" && context.executionUnavailable !== true;
+ }
+
+ const PLAN_PHASE_LABEL: Record<PlanPhase, string> = {
+   proposed: "待批准", approved: "已批准", paused: "已暂停", cancelled: "已取消", rejected: "已拒绝",
+ };
+ const TASK_PHASE_LABEL: Record<TaskPhase, string> = {
+   planned: "待调度", queued: "排队中", running: "执行中", verifying: "验证中", merging: "交付中",
+   done: "已完成", failed: "失败", cancelled: "已取消", paused: "已暂停", needs_you: "需你处理",
+ };
+ const EVIDENCE_LABEL: Record<EvidenceState, string> = {
+   verified: "已验证", failed: "验证失败", stale: "验证过期", absent: "未验证",
+ };
+ const VERDICT_LABEL: Record<Verdict, string> = { pass: "通过", fail: "未通过", unverifiable: "无法验证" };
+
+ export const planPhaseLabel = (phase: PlanPhase): string => PLAN_PHASE_LABEL[phase];
+ export const taskPhaseLabel = (phase: TaskPhase): string => TASK_PHASE_LABEL[phase];
+ export const evidenceLabel = (evidence: EvidenceState): string => EVIDENCE_LABEL[evidence];
+ export const verdictLabel = (verdict: Verdict | undefined): string => verdict === undefined ? "未知" : VERDICT_LABEL[verdict];
+
+ const LANE_LABEL: Record<FlowTask["lane"], string> = { read: "只读", write: "写入", external: "外部" };
+ const EFFECT_LABEL: Record<Contract["effect"], string> = { none: "无", workspace: "工作区", external: "外部" };
+ const ACCEPTANCE_LABEL: Record<AcceptanceCheck["kind"], string> = { evidence: "证据", human: "人工", command: "命令", artifact: "产物" };
+ const ARTIFACT_LABEL: Record<ArtifactRef["kind"], string> = { file: "文件", blob: "二进制", json: "JSON", url: "链接" };
+ const SCHEDULE_LABEL: Record<ScheduleAction["kind"], string> = { dispatch: "派发", verify: "验证", merge: "合并", cancel: "取消", escalate: "升级" };
+
+ /** 引擎与调度器写进事件的原因原句。未知原句原样透出——宁可显示英文，也不编一句没发生的话。 */
+ const REASON_LABEL: Record<string, string> = {
+   "budget exceeded": "超出预算",
+   "paused by user": "已由你暂停",
+   "taken over by user": "已由你接管",
+   "merge rejected": "交付被拒绝",
+   "rolled back": "已回滚",
+   "plan cancelled; confirm the previous executor stopped": "计划已取消；请确认上一个执行器已停止",
+   "lease expired; confirm the previous executor stopped": "租约过期；请确认上一个执行器已停止",
+   "verification failed or is unverifiable": "验证未通过或无法验证",
+   "verification lacks fresh contract evidence": "验证缺少最新的契约证据",
+   "plan budget exceeded": "计划预算已超",
+   "task failed; explicit retry or takeover required": "任务失败；需要显式重试或接管",
+   "dependency failed, was cancelled or requires user action": "依赖失败、被取消或需要你处理",
+   "task deadline exceeded": "任务已超时",
+   "attempt limit reached": "已达到尝试次数上限",
+   "insufficient task or plan budget": "任务或计划预算不足",
+ };
+
+ export const laneLabel = (lane: FlowTask["lane"]): string => LANE_LABEL[lane];
+ export const effectLabel = (effect: Contract["effect"]): string => EFFECT_LABEL[effect];
+ export const acceptanceLabel = (kind: AcceptanceCheck["kind"]): string => ACCEPTANCE_LABEL[kind];
+ export const artifactKindLabel = (kind: ArtifactRef["kind"]): string => ARTIFACT_LABEL[kind];
+ export const scheduleKindLabel = (kind: ScheduleAction["kind"]): string => SCHEDULE_LABEL[kind];
+ export function reasonLabel(reason: string | undefined): string {
+   if (reason === undefined || reason === "") return "";
+   return REASON_LABEL[reason] ?? reason;
+ }
+
+ import type { PluginPanelSnapshot } from "../../../../../src/agent/plugins";
+ import type {
+   MarketplaceCapabilities,
+   MarketplaceEntry,
+ } from "../../../../../src/agent/plugins/marketplace";
+ import type {
+   InstalledPluginRecord,
+   MarketplaceCatalogReadout,
+   PluginSource,
+   PluginUpdateCheck,
+ } from "../../../../../src/main/ipc-protocol";
+
+ export type PluginView = "discover" | "installed" | "updates";
+ export type PluginCapabilityCategory = "skills" | "commands" | "agents" | "hooks" | "mcp" | "lsp";
+ export type PluginSourceKind = PluginSource["kind"] | "runtime";
+ export type PluginRowState =
+   | "available"
+   | "installed"
+   | "enabled"
+   | "disabled"
+   | "unmanaged"
+   | "name-conflict";
+
+ export interface PluginFavoriteStorage {
+   getItem(key: string): string | null;
+   setItem(key: string, value: string): void;
+ }
+
+ export type PluginRuntimeView = PluginPanelSnapshot["plugins"][number];
+
+ export interface PluginRowView {
+   readonly id: string;
+   readonly name: string;
+   readonly summary: string;
+   readonly sourceKind: PluginSourceKind;
+   readonly version: string | null;
+   readonly installed: InstalledPluginRecord | null;
+   readonly runtime: PluginRuntimeView | null;
+   readonly catalogEntry: MarketplaceEntry | null;
+   readonly capabilities: MarketplaceCapabilities | null;
+   readonly state: PluginRowState;
+   readonly favorite: boolean;
+   readonly warnings: readonly string[];
+   readonly errors: readonly string[];
+ }
+
+ export interface PluginUpdateRow {
+   readonly id: string;
+   readonly row: PluginRowView;
+   readonly check: PluginUpdateCheck;
+   readonly sourceKind: PluginSource["kind"];
+   readonly currentVersion: string | null;
+   readonly nextVersion: string | null;
+ }
+
+ export const PLUGIN_FAVORITES_KEY = "cairn.plugins.favorites.v1";
+
+ function countsOf(runtime: PluginRuntimeView | null): MarketplaceCapabilities | null {
+   if (runtime === null) return null;
+   return {
+     skills: runtime.counts.skills,
+     commands: runtime.counts.commands,
+     agents: runtime.counts.agents,
+     hooks: runtime.counts.hooks,
+     mcp: runtime.counts.mcp,
+     lsp: runtime.counts.lsp,
+   };
+ }
+
+ function runtimeGroups(runtime: PluginPanelSnapshot | null): ReadonlyMap<string, readonly PluginRuntimeView[]> {
+   const groups = new Map<string, PluginRuntimeView[]>();
+   if (runtime === null) return groups;
+   for (const plugin of runtime.plugins) {
+     const rows = groups.get(plugin.name) ?? [];
+     rows.push(plugin);
+     groups.set(plugin.name, rows);
+   }
+   return groups;
+ }
+
+ function installedGroups(records: readonly InstalledPluginRecord[]): ReadonlyMap<string, readonly InstalledPluginRecord[]> {
+   const groups = new Map<string, InstalledPluginRecord[]>();
+   for (const record of records) {
+     const rows = groups.get(record.manifestName) ?? [];
+     rows.push(record);
+     groups.set(record.manifestName, rows);
+   }
+   return groups;
+ }
+
+ function rowState(input: {
+   conflict: boolean;
+   installed: InstalledPluginRecord | null;
+   runtime: PluginRuntimeView | null;
+ }): PluginRowState {
+   if (input.conflict) return "name-conflict";
+   if (input.installed !== null) return input.installed.enabled ? "enabled" : "disabled";
+   if (input.runtime !== null) return "unmanaged";
+   return "available";
+ }
+
+ function runtimeWarnings(rows: readonly PluginRuntimeView[]): readonly string[] {
+   return [...new Set(rows.flatMap((row) => row.warnings))];
+ }
+
+ function runtimeErrors(rows: readonly PluginRuntimeView[]): readonly string[] {
+   return [...new Set(rows.flatMap((row) => row.errors))];
+ }
+
+ /**
+  * Registry-owned rows win over runtime discovery. Catalog rows retain catalog ordering;
+  * installed-only and runtime-only rows follow deterministically by name.
+  */
+ export function mergePluginRows(
+   catalog: MarketplaceCatalogReadout | null,
+   installed: readonly InstalledPluginRecord[],
+   runtime: PluginPanelSnapshot | null,
+   favorites: ReadonlySet<string>,
+ ): readonly PluginRowView[] {
+   const catalogEntries = catalog?.status === "ready" && catalog.catalog !== null
+     ? catalog.catalog.entries
+     : [];
+   const runtimeByName = runtimeGroups(runtime);
+   const installedByName = installedGroups(installed);
+   const rows: PluginRowView[] = [];
+   const consumedRuntime = new Set<string>();
+   const consumedInstalled = new Set<string>();
+   const catalogIds = new Set<string>();
+
+   for (const entry of catalogEntries) {
+     const duplicateCatalog = catalogIds.has(entry.id);
+     catalogIds.add(entry.id);
+     const installedMatches = installedByName.get(entry.id) ?? [];
+     const runtimeMatches = runtimeByName.get(entry.id) ?? [];
+     const installedMatch = installedMatches[0] ?? null;
+     const runtimeMatch = runtimeMatches[0] ?? null;
+     const sourceConflict = installedMatch !== null && installedMatch.source.kind !== "catalog";
+     const manualConflict = installedMatches.length === 0 && runtimeMatches.length > 0;
+     const conflict = duplicateCatalog
+       || installedMatches.length > 1
+       || runtimeMatches.length > 1
+       || sourceConflict
+       || manualConflict;
+     if (runtimeMatches.length > 0) consumedRuntime.add(entry.id);
+     if (installedMatches.length > 0) consumedInstalled.add(entry.id);
+     rows.push({
+       id: entry.id,
+       name: entry.name,
+       summary: entry.summary,
+       sourceKind: installedMatch?.source.kind ?? "catalog",
+       version: installedMatch?.version ?? entry.version,
+       installed: installedMatch,
+       runtime: runtimeMatch,
+       catalogEntry: entry,
+       capabilities: countsOf(runtimeMatch) ?? (installedMatch === null ? entry.capabilities : null),
+       state: rowState({ conflict, installed: installedMatch, runtime: runtimeMatch }),
+       favorite: favorites.has(entry.id),
+       warnings: runtimeWarnings(runtimeMatches),
+       errors: runtimeErrors(runtimeMatches),
+     });
+   }
+
+   const remainingInstalled = [...installedByName.entries()]
+     .filter(([name]) => !consumedInstalled.has(name))
+     .sort(([left], [right]) => left.localeCompare(right));
+   for (const [name, matches] of remainingInstalled) {
+     const record = matches[0];
+     if (record === undefined) continue;
+     const runtimeMatches = runtimeByName.get(name) ?? [];
+     const runtimeMatch = runtimeMatches[0] ?? null;
+     consumedRuntime.add(name);
+     rows.push({
+       id: record.entryId,
+       name,
+       summary: "",
+       sourceKind: record.source.kind,
+       version: record.version,
+       installed: record,
+       runtime: runtimeMatch,
+       catalogEntry: null,
+       capabilities: countsOf(runtimeMatch),
+       state: rowState({
+         conflict: matches.length > 1 || runtimeMatches.length > 1,
+         installed: record,
+         runtime: runtimeMatch,
+       }),
+       favorite: favorites.has(record.entryId),
+       warnings: runtimeWarnings(runtimeMatches),
+       errors: runtimeErrors(runtimeMatches),
+     });
+   }
+
+   const remainingRuntime = [...runtimeByName.entries()]
+     .filter(([name]) => !consumedRuntime.has(name))
+     .sort(([left], [right]) => left.localeCompare(right));
+   for (const [name, matches] of remainingRuntime) {
+     const runtimeMatch = matches[0];
+     if (runtimeMatch === undefined) continue;
+     rows.push({
+       id: name,
+       name,
+       summary: "",
+       sourceKind: "runtime",
+       version: null,
+       installed: null,
+       runtime: runtimeMatch,
+       catalogEntry: null,
+       capabilities: countsOf(runtimeMatch),
+       state: rowState({ conflict: matches.length > 1, installed: null, runtime: runtimeMatch }),
+       favorite: favorites.has(name),
+       warnings: runtimeWarnings(matches),
+       errors: runtimeErrors(matches),
+     });
+   }
+
+   return rows;
+ }
+
+ export function pluginUpdateCheckKey(source: PluginSource): string {
+   if (source.kind === "catalog") {
+     return JSON.stringify(["catalog", source.catalogId, source.entryId]);
+   }
+   if (source.kind === "git") {
+     return JSON.stringify(["git", source.repositoryUrl, source.ref]);
+   }
+   return JSON.stringify(["local", source.sourcePath]);
+ }
+
+ export function pluginUpdateRows(
+   rows: readonly PluginRowView[],
+   checks: Readonly<Record<string, PluginUpdateCheck>>,
+ ): readonly PluginUpdateRow[] {
+   const updates: PluginUpdateRow[] = [];
+   for (const row of rows) {
+     const installed = row.installed;
+     if (installed === null) continue;
+     const check = checks[pluginUpdateCheckKey(installed.source)];
+     if (check === undefined || check.status !== "available" || check.sourceKind !== installed.source.kind) {
+       continue;
+     }
+     if (installed.source.kind === "catalog") {
+       if (
+         check.currentVersion !== installed.version
+         || check.nextVersion === null
+         || check.nextVersion === check.currentVersion
+       ) {
+         continue;
+       }
+     }
+     updates.push({
+       id: row.id,
+       row,
+       check,
+       sourceKind: installed.source.kind,
+       currentVersion: check.currentVersion,
+       nextVersion: check.nextVersion,
+     });
+   }
+   return updates;
+ }
+
+ export function pluginCategoryOf(
+   capabilities: MarketplaceCapabilities | null | undefined,
+ ): PluginCapabilityCategory | null {
+   if (capabilities === null || capabilities === undefined) return null;
+   if (capabilities.lsp > 0) return "lsp";
+   if (capabilities.mcp > 0) return "mcp";
+   if (capabilities.hooks > 0) return "hooks";
+   if (capabilities.agents > 0) return "agents";
+   if (capabilities.commands > 0) return "commands";
+   if (capabilities.skills > 0) return "skills";
+   return null;
+ }
+
+ export function filterPluginRows(
+   rows: readonly PluginRowView[],
+   query: string,
+   category: PluginCapabilityCategory | "all" | null,
+ ): readonly PluginRowView[] {
+   const q = query.trim().toLowerCase();
+   return rows.filter((row) => {
+     if (category !== null && category !== "all" && pluginCategoryOf(row.capabilities) !== category) {
+       return false;
+     }
+     if (q === "") return true;
+     return `${row.name}\n${row.summary}`.toLowerCase().includes(q);
+   });
+ }
+
+ export function loadPluginFavorites(storage: PluginFavoriteStorage): ReadonlySet<string> {
+   try {
+     const parsed: unknown = JSON.parse(storage.getItem(PLUGIN_FAVORITES_KEY) ?? "[]");
+     if (!Array.isArray(parsed)) return new Set();
+     return new Set(parsed
+       .filter((value): value is string => typeof value === "string" && value.trim() !== "")
+       .map((value) => value.trim())
+       .sort());
+   } catch {
+     return new Set();
+   }
+ }
+
+ export function savePluginFavorites(
+   storage: PluginFavoriteStorage,
+   ids: Iterable<string>,
+ ): void {
+   const values = [...new Set(ids)]
+     .map((id) => id.trim())
+     .filter((id) => id !== "")
+     .sort();
+   try {
+     storage.setItem(PLUGIN_FAVORITES_KEY, JSON.stringify(values));
+   } catch {
+     /* Favorites are a preference; storage failure must not block marketplace actions. */
+   }
+ }
+
+ // 派生层·运行面（纯投影）：事件流 → 相位/门/步数等运行读数。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import type { ClarifyQuestion, PlanProposal } from "../../../../../src/events";
+ import { isWorkerSubflowEvent } from "./session";
+
+ export type RunPhase = "idle" | "thinking" | "tool" | "ask" | "clarify" | "plan";
+
+ /** 尾扫判据（v2 语义钉死）：pending 三参任一 true ⇒ 对应门相位，ask 优先级最高；
+  * 否则从尾向头扫——未决 tool_call（其后无同 id 的 tool_result）⇒ "tool"；
+  * 晚于最后 tool_result 的 assistant_delta ⇒ "thinking"（扫描途中已见 result 的 delta 一律跳过，
+  * 那些是「早于最后 tool_result」的 delta，判据不成立）；error 在尾部 ⇒ "idle"（error 行自呈现，不再判忙）。
+  * pendingClarify/pendingPlan 带缺省 false：M1 的两参调用式（App.tsx 与 M1 存量用例）保持可编译，
+  * 任务书 Interfaces 的四参调用式逐字可用。
+  */
+ export function deriveRunPhase(
+   events: readonly AgentEvent[],
+   pendingAsk: boolean,
+   pendingClarify: boolean = false,
+   pendingPlan: boolean = false,
+ ): RunPhase {
+   if (pendingAsk) return "ask";
+   if (pendingClarify) return "clarify";
+   if (pendingPlan) return "plan";
+   const seenResults = new Set<string>(); // 尾扫途中已见的 result callId（都晚于当前扫描位）
+   for (let i = events.length - 1; i >= 0; i--) {
+     const e = events[i]!;
+     // M3-4 裁定：worker 子流不进相位判据——未决 worker tool_call 不亮「tool」，worker
+     // tool_result 也不占用 seenResults（否则它会把「delta 晚于最后 result = thinking」的判据吃掉）。
+     if (isWorkerSubflowEvent(e)) continue;
+     if (e.type === "tool_result") { seenResults.add(e.callId); continue; }
+     if (e.type === "tool_call" && !seenResults.has(e.id)) return "tool";
+     if (e.type === "assistant_delta" && seenResults.size === 0) return "thinking";
+     if (e.type === "error") return "idle";
+   }
+   return "idle";
+ }
+
+ /** 本轮（最后一条主会话 user_message 之后）是否已有模型正文。
+  *  用途：状态条不能把「正文已经开始/已经输出完、run 还在收尾」继续叫「思考中」。
+  *  worker 子流正文不算（父会话唯一接收物是 agent_result）。 */
+ export function hasAssistantTextThisRun(events: readonly AgentEvent[]): boolean {
+   let start = 0;
+   for (let i = events.length - 1; i >= 0; i--) {
+     const e = events[i]!;
+     if (isWorkerSubflowEvent(e)) continue;
+     if (e.type === "user_message") { start = i; break; }
+   }
+   for (let i = start; i < events.length; i++) {
+     const e = events[i]!;
+     if (isWorkerSubflowEvent(e)) continue;
+     if (e.type === "assistant_message" && e.content.trim() !== "") return true;
+     if (e.type === "assistant_delta" && e.text.trim() !== "") return true;
+   }
+   return false;
+ }
+
+ /** 状态条那一格的文案（纯函数，好判卷；2026-10-20 从 App.tsx 搬出来）。
+  *
+  *  口径（逐条，顺序即优先级）：
+  *  ① 已停止 ⇒ "已停止"；
+  *  ② 三道门在场 ⇒ "等待审批" / "等待澄清" / "等待方案"；
+  *  ③ **工具在跑 ⇒ "执行工具"**（这一条排在"收尾中"**之前**——2026-10-20 独立评审追出的 MEDIUM-HIGH：
+  *     旧实现先判 `finishing`，而 `finishing` 的第二个条件 `answerQuiet`（正文停了 >1.5s）
+  *     **恰好就是"工具在跑"的形状**（模型吐完字就调工具，然后等着它跑完）
+  *     ⇒ 任何超过 1.5s 的构建/测试都被报成"收尾中"，而 agent 还在干活。
+  *     那条注释自己写着「读错比不读更坏」——报错的相位比不报更坏）；
+  *  ④ 正文停了而 run 还在 ⇒ "收尾中"（Stop hook / 安全报告 / 记忆沉淀那几样）；
+  *  ⑤ 有正文 ⇒ "生成中"；还没有 ⇒ "思考中"；
+  *  ⑥ run 还在但没有正文 ⇒ "思考中"；都不在 ⇒ "就绪"。
+  */
+ export function runPhaseLabel(input: {
+   phase: RunPhase;
+   stopped: boolean;
+   running: boolean;
+   /** 本轮已经有模型正文（`hasAssistantTextThisRun`）。 */
+   hasAnswerText: boolean;
+   /** 正文已停 >1.5s（App 的 `answerQuiet`）。 */
+   answerQuiet: boolean;
+ }): string {
+   if (input.stopped) return "已停止";
+   if (input.phase === "ask") return "等待审批";
+   if (input.phase === "clarify") return "等待澄清";
+   if (input.phase === "plan") return "等待方案";
+   // 工具在跑 ⇒ 不是收尾（见上：answerQuiet 与"工具在跑"同形）
+   if (input.phase === "tool") return "执行工具";
+   const finishing = input.running && input.hasAnswerText && (input.phase === "idle" || input.answerQuiet);
+   if (finishing) return "收尾中";
+   if (input.phase === "thinking") return input.hasAnswerText ? "生成中" : "思考中";
+   if (input.running) return input.hasAnswerText ? "收尾中" : "思考中";
+   return "就绪";
+ }
+
+ /** 最后一个 clarify_requested，且其后无同 callId 的 tool_result（澄清门的答复按原工具 id 挂回）。
+  *  只看最后一个请求：其后已收口 ⇒ null（更早的未决请求不追溯，与门的串行语义一致）。 */
+ export function pendingClarifyOf(events: readonly AgentEvent[]): { callId: string; questions: ClarifyQuestion[] } | null {
+   for (let i = events.length - 1; i >= 0; i--) {
+     const e = events[i]!;
+     if (e.type !== "clarify_requested") continue;
+     const closed = events.slice(i + 1).some((r) => r.type === "tool_result" && r.callId === e.callId);
+     return closed ? null : { callId: e.callId, questions: e.questions };
+   }
+   return null;
+ }
+
+ /** 最后一个 plan_proposed，且其后无同 callId 的 plan_approved（批准与拒绝都算决议收口）。 */
+ export function pendingPlanOf(events: readonly AgentEvent[]): { callId: string; plan: PlanProposal } | null {
+   for (let i = events.length - 1; i >= 0; i--) {
+     const e = events[i]!;
+     if (e.type !== "plan_proposed") continue;
+     const closed = events.slice(i + 1).some((r) => r.type === "plan_approved" && r.callId === e.callId);
+     return closed ? null : { callId: e.callId, plan: e.plan };
+   }
+   return null;
+ }
+
+ /** 步数（状态条「N 轮 · M 步」的 M）：主会话 tool_call 计数（worker 子流不计，同 projectStream 口径）。 */
+ export function countToolSteps(events: readonly AgentEvent[]): number {  let steps = 0;
+   for (const e of events) {
+     if (e.type === "tool_call" && !isWorkerSubflowEvent(e)) steps += 1;
+   }
+   return steps;
+ }
+
+ /** 本轮步数（2026-10-18）：最后一个 user_message 之后的 tool_call 数——状态条要的是“这一轮做了几步”。
+  *  不能直接拿 countToolSteps（那是整条会话的累计）。工头子流程不计（与累计口径同一谓词）。 */
+ export function countRunSteps(events: readonly AgentEvent[]): number {
+   // 找不到 user_message 时返回 0，而不是把整条会话的历史步数冒充成本轮——状态条宁可空着。
+   let start = events.length;
+   for (let i = events.length - 1; i >= 0; i -= 1) {
+     if (events[i]!.type === "user_message") { start = i + 1; break; }
+   }
+   let steps = 0;
+   for (let i = start; i < events.length; i += 1) {
+     const e = events[i]!;
+     if (e.type === "tool_call" && !isWorkerSubflowEvent(e)) steps += 1;
+   }
+   return steps;
+ }
+
+ /** 文件级回滚（v2.16）的结果提示文案（纯函数，可判卷）：还原/删除两段计数恒在；
+  *  manual（轮后又被改过、取不到原件——core 拒绝静默抹掉）与 failed（越界/快照缺失）有货才显，
+  *  点名路径——「看不见的降级等于没降级」。 */
+ export function formatRevertNotice(
+   round: number,
+   r: { restored: string[]; deleted: string[]; manual: { path: string; why: string }[]; failed: { path: string; error: string }[] },
+ ): string {
+   const parts = [`第 ${String(round)} 轮文件回滚：还原 ${String(r.restored.length)} 个、删除 ${String(r.deleted.length)} 个`];
+   if (r.manual.length > 0) parts.push(`需手动处理 ${String(r.manual.length)} 个（${r.manual.map((m) => m.path).join("、")}）`);
+   if (r.failed.length > 0) parts.push(`失败 ${String(r.failed.length)} 个（${r.failed.map((f) => f.path).join("、")}）`);
+   return parts.join("；");
+ }
+
+ // 派生层·会话面（纯投影）：事件流 → 会话/轮/可见文本。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+
+ // M3-4 过滤裁定（任务书）：带 agent_id 的事件 = worker 子流（tool_call/tool_result/usage/… 的归因
+ // 字段，src/events/index.ts M3a §4.4.9），不进主流行、不进相位判据——主线只讲父会话的事
+ // （M3 不做 worker 子视图，账本留 M4+）。勘定：agent_spawned 类型上带**必填** agent_id（worker 的
+ // id，血缘另靠 parent_event_id），但它是父流事实（「派出了哪个 worker」）⇒ 按类型特判保留，
+ // 不按字段缺席判定——按字段判会把 spawn 行也滤掉。agent_status/agent_message/agent_result 属
+ // 必带 agent_id 的子流事件族，恒滤。
+ // 导出：对话转录也要走这同一条过滤（worker 子流的 delta 不是主会话的对话正文）。
+ // 判据自己抄一遍就会漂——所以这里导出，让 transcript.ts 用同一份。
+ export function isWorkerSubflowEvent(e: AgentEvent): boolean {
+   if (e.type === "agent_spawned") return false;
+   const id = (e as { agent_id?: unknown }).agent_id;
+   return typeof id === "string";
+ }
+
+ /** 独立窗格窗口（PopoutApp）收不收这条事件——**归属**判据，纯函数。
+  *
+  *  旧实现在组件里内联写着 `props.sessionId === null || sid === undefined || sid === props.sessionId`：
+  *  第一个析取项为真时，后面两项全是废话 ⇒ 一个**没有会话归属**的弹出窗会把**所有会话**的事件
+  *  都吸进来。而这种窗格是真实存在的路径：⌘N 回首页时 paneTabs 不清，⧉ 传的是 undefined。
+  *  用户于是在一个只有「变更」两个字的窗格里，读到**另一个会话**的轮次、文件与验证状态，
+  *  而空态还写着"本会话还没有文件改动"——两句话互相打架。
+  *
+  *  三条判据各自的理由：
+  *  · `sessionId === null` ⇒ **没有归属就不显示**（不是"全都显示"）。显示别人的会话比不显示更坏。
+  *  · `sid === undefined` ⇒ 事件没盖章归属。推送是广播来的（所有窗口都收得到），没盖章的
+  *    那条**不属于任何会话**，让它进来就等于让弹出窗回到"什么都收"的老毛病。
+  *  · `session_titled` 是 push-only 的命名推送（第十八遍的既定口径），与窗格内容无关。
+  */
+ export function popoutEventBelongsTo(e: AgentEvent, sessionId: string | null): boolean {
+   if (sessionId === null) return false;
+   if ((e as { type?: string }).type === "session_titled") return false;
+   const sid = (e as { session_id?: string }).session_id;
+   if (sid === undefined) return false;
+   return sid === sessionId;
+ }
+
+ /** 运行秒表读数：起点按**会话**存，读的时候只读**当前会话**那一格。
+  *
+  *  旧实现是**一个** ref（谁起跑就盖谁）+ 读的时候无条件取它 ⇒ A 起跑、切 B、B 起跑、
+  *  切回 A（A 还在跑）时，秒表算的是 `now − B 的起点`：A 真实跑了 3600s 会显示成 0s。
+  *  秒表是"这一轮跑了多久"的用户可见读数，读错比不读更坏（用户以为任务刚开始）。
+  *
+  *  纯函数形态（起点表 + 会话 id + 当前时刻 → 秒数），让判卷能真跑这一格，
+  *  不必退化成源码断言。缺起点（这一格还没盖）按"现在起算"⇒ 0s，不编一个假起点。 */
+ export function elapsedSecondsFor(
+   startBySession: ReadonlyMap<string, number>,
+   sessionId: string | null,
+   now: number,
+ ): number {
+   if (sessionId === null) return 0;
+   const t0 = startBySession.get(sessionId);
+   if (t0 === undefined) return 0;
+   return Math.max(0, Math.floor((now - t0) / 1000));
+ }
+
+ /** 主会话终态判据（运行旗/侧栏黄点唯一处）：worker 的 agent_status 也是 agent_status 且
+  *  同样被盖上父会话 session_id（agent-runner 的 outbox 盖章），不能据此摘主会话的运行旗。 */
+ export function isMainSessionTerminalEvent(e: AgentEvent): boolean {
+   if (isWorkerSubflowEvent(e)) return false;
+   if (e.type !== "agent_status") return false;
+   const status = (e as { status?: unknown }).status;
+   return status === "done" || status === "failed" || status === "cancelled";
+ }
+
+ /** 打开会话时的快照合并：openSession 读盘期间 onEvent 仍会追加 live 事件；
+  *  直接 setEvents(快照) 会丢掉这段增量（长会话可达数百毫秒）。pending 从快照尾巴之后开始，
+  *  用「后缀/前缀重叠」去重——重叠部分已在快照里，其余按序接上。
+  *  事件没有全局 seq，只能按内容比；同一事件在两侧的序列化逐字节一致（同一 JSONL 行）。 */
+ export function mergeSessionSnapshot(
+   snapshot: readonly AgentEvent[],
+   pending: readonly AgentEvent[],
+ ): AgentEvent[] {
+   if (pending.length === 0) return [...snapshot];
+   const pendingText = pending.map((e) => JSON.stringify(e));
+   const max = Math.min(snapshot.length, pending.length);
+   for (let k = max; k > 0; k -= 1) {
+     let same = true;
+     for (let i = 0; i < k; i += 1) {
+       if (JSON.stringify(snapshot[snapshot.length - k + i]) !== pendingText[i]) {
+         same = false;
+         break;
+       }
+     }
+     if (same) return [...snapshot, ...pending.slice(k)];
+   }
+   return [...snapshot, ...pending];
+ }
+
+ /** 事件 id（1-based 行号，assistant 行 eventId 同口径）→ 所属轮号（1-based）。P3-1 分叉的
+  *  轮号自事件日志投影（hover 操作对「事件日志的 fork/replay」的接口）。轮界口径与 projectStream
+  *  的 rounds 计数同一份：主会话 user_message 计数（worker 子流先滤）；事件在首个用户消息之前
+  *  或 id 越界（<1 / > events.length）→ null（不猜）。 */
+ export function roundOfEvent(events: readonly AgentEvent[], eventId: number): number | null {
+   if (!Number.isInteger(eventId) || eventId < 1 || eventId > events.length) return null;
+   let rounds = 0;
+   for (let i = 0; i < eventId; i++) {
+     const e = events[i]!;
+     if (isWorkerSubflowEvent(e)) continue;
+     if (e.type === "user_message") rounds += 1;
+   }
+   return rounds === 0 ? null : rounds;
+ }
+
+ /** 第 N 轮的用户输入原文（编辑并重发要用）。拿不到 → null，不编。 */
+ /** 用户面原文（2026-10-18）：技能调用轮的事件 content 是**展开后的技能提示词**（模型面），
+  *  直接显示会把整份 SKILL.md 当成用户说的话。skill 元信息在 ⇒ 还原成用户敲的 `<invoke> <args>`；
+  *  缺席（普通消息）⇒ 原样。事件本身不改：重放/续跑要的是展开后的上下文。 */
+ export function userVisibleText(e: { content: string; skill?: { invoke: string; args: string } }): string {
+   if (e.skill === undefined) return e.content;
+   const args = e.skill.args.trim();
+   return args === "" ? e.skill.invoke : `${e.skill.invoke} ${args}`;
+ }
+
+ export function userTextOfRound(events: readonly AgentEvent[], round: number): string | null {
+   if (!Number.isInteger(round) || round < 1) return null;
+   let rounds = 0;
+   for (const e of events) {
+     if (isWorkerSubflowEvent(e)) continue;
+     if (e.type === "user_message") {
+       rounds += 1;
+       if (rounds === round) return userVisibleText(e);
+     }
+   }
+   return null;
+ }
+
+ // 派生层·流面（纯投影）：事件流 → 对话行（user/assistant/tool/error）。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { isMainSessionTerminalEvent, isWorkerSubflowEvent, userVisibleText } from "./session";
+
+ // v2 行面：ts 为事件真值时间戳（毫秒）的透传——新事件恒有值（core 落盘统一盖戳、live=盘），
+ // openSession 读旧日志时 undefined ⇒ 行上留空，不造假。
+ // v2.16 行面补钉：user 行带 round（主会话 1-based 轮号，core planTurnRevert 同口径——worker
+ // 事件不成轮）；assistant 行带 eventId（事件在会话 JSONL 里的 1-based 行号，赞/踩的锚）。
+ // v7 行面补钉：assistant 行也带 round（它所属的用户轮——「从这条回复分支」= fork 保留到该轮）。
+ export type StreamRow =
+   | { kind: "user"; text: string; ts?: number; seq: number; round: number; attachments?: readonly { path: string; kind: "file" | "directory" }[]
+       /** 第 9 点·轮中插话：这条是同一轮里补的话，不是新任务（见文件头轮界分流那段）。
+        *  缺席 = 普通用户轮次（既有形状，字节不变）。 */
+       steering?: true }
+   | { kind: "assistant"; text: string; live?: boolean; thinking?: string; ts?: number; seq: number; eventId: number; round: number } // live=true = delta 流式中尚未被终稿取代的未结桶行；thinking = 同一 callId 下累计的思考正文
+   | { kind: "tool"; tool: string; summary: string; path?: string; args?: string; output?: string; outputTruncated?: boolean; pending?: boolean; interrupted?: boolean; ok?: boolean; ts?: number; seq: number
+       /** 命令行原文（args.command 是字符串时才有）：展开区据此单独排一行 `$ 命令`，
+        *  不必让人去 JSON 里捞。摘要会被别的字段占位（path/file…），所以显式取，不靠摘要猜。 */
+       command?: string
+       /** D7 覆盖前快照（ToolResultEvent.snapshotId）：行内 diff 必须带它才能显示真实「修改」，
+        *  否则 changeDiff 把修改文件当成全新增。 */
+       snapshotId?: string
+       /** tool_result 收口的到达时间（P3-1 折叠行耗时 = then − ts；拿不到不显）。 */
+       then?: number
+       /** 产物引用（本次调用交付给用户的东西）。从前聊天里只有文字回执 ⇒ 用户看不到 agent
+        *  刚渲染的图，也拿不到"刚写的那份 HTML"的直接入口，只能自己去仓库里翻。 */
+       artifact?: { kind: "image" | "html" | "svg" | "text"; path: string; note?: string } }
+   | { kind: "error"; text: string; ts?: number; seq: number };
+
+ type ToolRow = Extract<StreamRow, { kind: "tool" }>;
+
+ const str = (v: unknown): string | undefined => (typeof v === "string" && v.trim() !== "" ? v : undefined);
+ const idsOf = (v: unknown): string[] =>
+   Array.isArray(v) ? v.filter((x): x is string => typeof x === "string" && x !== "") : [];
+
+ /** 按工具挑**主语**（第 917 页）：编排族与 clarify 的参数里没有一个字段在通用取值链上
+  *  （`spawn_agent` 是 task、`send_agent` 是 message、`wait/cancel_agents` 是 agent_ids、`list_agents` 空参数），
+  *  于是整行落到 JSON 兜底：用户看到的是 `{"task":"…","mode":"write"}` 或 `{}`，而不是「派了什么活」。
+  *  这里只做「挑一格/数个数」，不编内容；挑不到返回 undefined，回通用链。 */
+ function ownSubject(tool: string, args: Record<string, unknown>): string | undefined {
+   if (tool === "spawn_agent") return str(args.task)?.slice(0, 80);
+   if (tool === "send_agent") return str(args.message);
+   if (tool === "resume_agent" || tool === "close_agent") return str(args.thread_id);
+   if (tool === "wait_for_agents" || tool === "cancel_agents") {
+     const n = idsOf(args.agent_ids).length;
+     return n > 0 ? `${String(n)} 个子任务` : "本会话全部子任务";
+   }
+   if (tool === "list_agents") return "本会话全部子任务";
+   if (tool === "clarify") {
+     const qs = Array.isArray(args.questions) ? args.questions : [];
+     const q = str((qs[0] as { question?: unknown } | undefined)?.question);
+     if (q === undefined) return undefined;
+     return qs.length > 1 ? `${q}（共 ${String(qs.length)} 问）` : q;
+   }
+   return undefined;
+ }
+
+ export const summarize = (tool: string, args: Record<string, unknown>): string => {
+   // url / query 进取值链（阶段 2 · brief §二.4 例：「抓取 api-docs.deepseek.com/news」——
+   // web_fetch/web_search 的一句话摘要就是目标本身）。
+   // **pattern 排在 path 前**（第 916 页）：grep 的 args = {pattern, path}，pattern 才是「搜什么」，
+   // path 只是范围；按 path 优先会把整行读成一个目录（现读：`{pattern:"TODO",path:"src/agent"}` ⇒
+   // 「src/agent」），而 glob 只有 pattern ⇒ 掉到 JSON 兜底、整行变成 `{"pattern":"src/**/*.ts"}`。
+   // 工具行折叠态只有这一句话，主语丢了就没地方补。
+   const own = ownSubject(tool, args);
+   const first = own ?? args.command ?? args.pattern ?? args.path ?? args.file ?? args.url ?? args.query ?? "";
+   return typeof first === "string" && first ? first : JSON.stringify(args).slice(0, 80);
+ };
+
+ /** 工具行展开区数据源（阶段 2 · brief §二.4）：原始参数的美化 JSON（2 格缩进）。
+  *  超 1500 字截断加省略标记——折叠区不摆巨物；原始事件面不动，这里只是展示层的字符串。 */
+ const rawArgs = (args: Record<string, unknown>): string => {
+   const s = JSON.stringify(args, null, 2);
+   return s.length > 1500 ? `${s.slice(0, 1500)}…` : s;
+ };
+
+ export function projectStream(events: readonly AgentEvent[], running: boolean = true): StreamRow[] {
+   const rows: StreamRow[] = [];
+   // delta 分桶（语义钉死）：callId → 累计文本 ＋ 首 delta 的 seq/ts（live 行落在流式开始的位置，
+   // 时间取首 delta——行的时间戳口径与其在流里的位置一致）。桶被 assistant_message 终稿取代后即清除。
+   const buckets = new Map<string, { text: string; seq: number; ts?: number }>();
+   // 思考正文桶：与正文**分开累计**（思考是模型自言自语，不并进 text，转录因此保持干净）。
+   const thinkingBuckets = new Map<string, string>();
+   // tool_call id → 行对象：tool_result 按 callId 收口（就地改写 pending/ok，行保持 call 侧 ts）；
+   // 无匹配调用的 tool_result 忽略，不造假行。
+   const toolRows = new Map<string, ToolRow>();
+   const interruptTools = (): void => {
+     for (const row of toolRows.values()) {
+       if (row.pending !== true) continue;
+       row.pending = false;
+       row.interrupted = true;
+     }
+   };
+   // 轮号（v2.16）：主会话 user_message 的 1-based 计数——与 core planTurnRevert 的轮口径同一份
+   // （worker 子流事件不成轮，见 isWorkerSubflowEvent 过滤；worker 本也不产生 user_message）。
+   let rounds = 0;
+   // 落定未结桶（v7.1 修）：真实 provider 的**一轮只发 assistant_delta**（aggregate 的 assistant_message
+   // 是 mock/demo 通道才有的东西，见 src/cli.ts 的刻意注释）——所以「桶什么时候算说完」不能只靠
+   // assistant_message。轮界（下一条 user_message）与停转（running=false）都是落定点：以终稿形态
+   // （live=false）吐行，操作条与光标据此归位。settled=true 的空文本桶：有思考正文落 thinking-only 行，真空的仍不产行。
+   const flushBuckets = (settled: boolean): void => {
+     for (const [callId, bucket] of buckets) {
+       const thinking = thinkingBuckets.get(callId);
+       if (settled && bucket.text === "") {
+         // 只想过没说：思考正文不能跟着空桶一起丢（业主 2026-10-24：工具调用前的思考消失——
+         // 旧口径把空文本桶整桶弃行，桶上挂着的思考正文随之蒸发）。有思考就落一条 thinking-only
+         // 行（渲染层只画思考折叠行，不画空气泡）；真连思考都没有的空桶仍然不产行。
+         if (thinking !== undefined && thinking !== "") {
+           rows.push({
+             kind: "assistant", text: "", live: false, ts: bucket.ts, seq: bucket.seq, eventId: bucket.seq + 1, round: rounds, thinking,
+           });
+         }
+         continue;
+       }
+       rows.push({
+         kind: "assistant", text: bucket.text, live: settled ? false : true, ts: bucket.ts, seq: bucket.seq, eventId: bucket.seq + 1, round: rounds,
+         ...(thinking !== undefined ? { thinking } : {}),
+       });
+     }
+     buckets.clear();
+     thinkingBuckets.clear();
+   };
+   for (let seq = 0; seq < events.length; seq++) {
+     const e = events[seq]!;
+     // M3-4 裁定：worker 子流事件不进主流行（过滤判据见 isWorkerSubflowEvent）；seq 仍按事件
+     // 全序编号，行序与流序一致，不因过滤错位。
+     if (isWorkerSubflowEvent(e)) continue;
+     switch (e.type) {
+       case "user_message": {
+         // 第 9 点·轮中插话（`origin.kind === "steering"`）**不是轮界**：它是同一轮里
+         // 用户补的一句话，模型在**这一轮的下一拍**就看到了（见 `SteeringOrigin` 的注释）。
+         // 若把它当新轮：轮号会 +1（同一轮被劈成两轮 ⇒ 轮次跳转、上一轮气泡提前落定全错位），
+         // 而转录里那条插话还会被画成"用户又开了一个任务"。
+         // 它**仍要显示**（用户说过的话不许在转录里消失）——只是挂在**当前轮**上。
+         const steering = e.origin?.kind === "steering";
+         if (!steering) {
+           // 轮界：上一轮还没被终稿收走的桶在此落定（新消息开头 = 旧轮已说完）。
+           flushBuckets(true);
+           rounds += 1;
+         }
+         rows.push({
+           kind: "user", text: userVisibleText(e), ts: e.ts, seq, round: rounds,
+           ...(steering ? { steering: true } : {}),
+           ...(e.attachments !== undefined && e.attachments.length > 0 ? { attachments: e.attachments } : {}),
+         });
+         break;
+       }
+       case "assistant_message":
+         // 终稿到达：AssistantMessageEvent 无 callId，无法按桶匹配 ⇒ 全部未结桶被终稿行取代
+         //（live=false），此后不再输出这些桶的 live 行。
+         // 终稿到达：思考桶里的正文**挂到终稿行上再清**——这样输出结束后用户仍能看到那一轮想了什么
+         //（清空后消失的话，"思考过程"只在流式那几秒可见，等于没展示）。
+         const carriedThinking = [...thinkingBuckets.values()].join("") || undefined;
+         buckets.clear();
+         thinkingBuckets.clear();
+         rows.push({
+           kind: "assistant", text: e.content, live: false, ts: e.ts, seq, eventId: seq + 1, round: rounds,
+           ...(carriedThinking !== undefined ? { thinking: carriedThinking } : {}),
+         });
+         break;
+       case "assistant_delta": {
+         const bucket = buckets.get(e.callId);
+         if (bucket === undefined) buckets.set(e.callId, { text: e.text, seq, ts: e.ts });
+         else bucket.text += e.text;
+         break;
+       }
+       // 第十九遍（业主 21.51.47「输出完之后橙色竖线还闪一下才停」）：usage = 本次模型调用说完了的
+       // 精确落定点（openai.ts 在流末 yield usage；案卷 21:51:38 实证：末 delta 与 usage 同秒，
+       // 之后 10s 尾部记忆沉淀才收束——旧判据 running=false 让光标陪跑了整个尾巴）。
+       // 工具轮里 usage 亦在 tool_result 之后、下一 call 之前到达 ⇒ 桶不跨调用，flush 语义干净；
+       // 空文本桶（只想过没说）在此落定即按既有口径弃行。
+       case "usage": {
+         flushBuckets(true);
+         break;
+       }
+       case "thinking_delta": {
+         // 不进正文桶：走独立累计，渲染时挂在回答行前面单独一段。
+         thinkingBuckets.set(e.callId, (thinkingBuckets.get(e.callId) ?? "") + e.text);
+         // 思考阶段也要有 live 行承载 ThinkingLive（否则「先思考」无处落脚，二者只剩同时出现）。
+         // 建 text="" 的桶，后续 assistant_delta 来到同一 callId 即累积正文——该行自动成为输出行。
+         if (!buckets.has(e.callId)) buckets.set(e.callId, { text: "", seq, ts: e.ts });
+         break;
+       }
+       // 勘误落地：ToolCallEvent 的工具名字段是 name（不是计划作者预期的 tool）；行面仍叫 tool。
+       case "tool_call": {
+         const row: ToolRow = {
+           kind: "tool", tool: e.name, summary: summarize(e.name, e.args), args: rawArgs(e.args),
+           ...(typeof e.args.command === "string" && e.args.command !== "" ? { command: e.args.command } : {}),
+           pending: true, ts: e.ts, seq,
+         };
+         // 行为数据不从展示用截断 JSON 反解；长编辑参数仍保留差异入口。
+         if (typeof e.args.path === "string" && e.args.path !== "") row.path = e.args.path;
+         toolRows.set(e.id, row);
+         rows.push(row);
+         break;
+       }
+       case "tool_result": {
+         const row = toolRows.get(e.callId);
+         if (row) {
+           row.pending = false;
+           delete row.interrupted;
+           row.ok = e.ok;
+           if (typeof e.output === "string") {
+             row.output = e.output.slice(0, 10000);
+             if (e.output.length > 10000) row.outputTruncated = true;
+           }
+           if (e.ts !== undefined) row.then = e.ts; // P3-1：耗时的落地端（ts→then 一段）
+           if (typeof e.snapshotId === "string" && e.snapshotId !== "") row.snapshotId = e.snapshotId;
+           // 只认**成功**的产物：失败的那一笔没有可看的东西（写盘被拒 / 渲染超时）。
+           if (e.ok && e.artifact !== undefined) row.artifact = e.artifact;
+         }
+         break;
+       }
+       // M3-4 裁定：agent_spawned 是父流事实，保留为 tool 类行——summary=task 截断（与 summarize
+       // 的 80 字符口径一致），tool 名取 core 的 spawn 工具名。行不带 pending：spawn 本身无收口对
+       // （worker 的终态走 agent_status/agent_result 子流，本就不进主流）。
+       case "agent_spawned":
+         rows.push({ kind: "tool", tool: "spawn_agent", summary: e.task.slice(0, 80), ts: e.ts, seq });
+         break;
+       // RunErrorEvent 勘定（src/events/index.ts）：失败原因原文在 message（渲染侧负责转义）。
+       case "error":
+         flushBuckets(true);
+         rows.push({ kind: "error", text: e.message, ts: e.ts, seq });
+         break;
+       case "agent_status":
+         if (isMainSessionTerminalEvent(e)) { flushBuckets(true); interruptTools(); }
+         break;
+       default: break; // 其余事件类型不成行：clarify/plan 走卡片选择器（pendingClarifyOf/pendingPlanOf）
+     }
+   }
+   // 尾部未结桶（按首 delta 的 seq 归位后与既有行并序——末尾 sort 统一收口）：
+   // 运行中 ⇒ live=true 行（追字光标只该亮在正在流的那一段）；会话已停 ⇒ 同样是终稿（live=false），
+   // 操作条与「思考完成」据此显形——真实 provider 不补发 assistant_message，停转就是落定信号。
+   flushBuckets(!running);
+   if (!running) interruptTools();
+   return rows.sort((a, b) => a.seq - b.seq);
+ }
+
+ // 派生层·时间线面（纯投影）：事件流 → 步骤序列 / 轮次时间线。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { summarize } from "./stream";
+ import { toolVerb } from "./tool-verbs";
+ import { isWorkerSubflowEvent } from "./session";
+ import type { StreamRow } from "./stream";
+
+ /** 步骤时间线（P3-2 检查器「时间线」Tab 的数据面）——事件日志 → 步骤序列。
+  *  「只取在场字段，不编时间」：at 直接取事件 ts（缺席即不给），label 是在场文本的截断。
+  *  落步口径：user_message → user 步；tool_call → tool 步（中文动词 + 摘要，未知工具回落原名）；
+  *  assistant 内容在真实 provider 是 delta-only（aggregate 终稿是 mock/demo 通道的产品）⇒
+  *  **每个 callId 的首个 delta** 落一个 assistant 步（后续 delta 并入——与「回放到此步」的
+  *  段落开头语义一致）；assistant_message 终稿是独立一笔事件，照落（demo 通道会同时有两者，
+  *  这里如实两步——都是真实事件，不合并）。usage → 用量步（「模型调用说完了」的精确落定点）。
+  *  worker 子流不进（与主流行同一过滤）；error 在对话行自呈现，时间线不为它立步。 */
+ export interface TimelineItem {
+   /** 事件全序的 1-based 行号（assistant 行 eventId / DOM data-event-id 同口径）。 */
+   eventId: number;
+   kind: "user" | "tool" | "assistant" | "usage";
+   label: string;
+   /** 事件真值时间戳（毫秒）；缺席 = 旧日志没戳，不编。 */
+   at?: number;
+ }
+
+ const TIMELINE_LABEL_MAX = 60;
+ const timelineLabel = (text: string): string => {
+   const flat = text.replace(/\s+/g, " ").trim();
+   return flat.length <= TIMELINE_LABEL_MAX ? flat : flat.slice(0, TIMELINE_LABEL_MAX) + "…";
+ };
+ const fmtTokens = (n: number): string => {
+   if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}m`;
+   if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
+   return String(n);
+ };
+
+ export function timelineItems(events: readonly AgentEvent[]): TimelineItem[] {
+   const out: TimelineItem[] = [];
+   const seenDeltaCalls = new Set<string>(); // 已落步的 callId（其后续 delta 并入首步）
+   for (let seq = 0; seq < events.length; seq++) {
+     const e = events[seq]!;
+     if (isWorkerSubflowEvent(e)) continue;
+     const eventId = seq + 1;
+     switch (e.type) {
+       case "user_message":
+         out.push({ eventId, kind: "user", label: timelineLabel(e.content), ...(e.ts !== undefined ? { at: e.ts } : {}) });
+         break;
+       case "assistant_delta":
+         if (seenDeltaCalls.has(e.callId)) break;
+         seenDeltaCalls.add(e.callId);
+         out.push({ eventId, kind: "assistant", label: timelineLabel(e.text), ...(e.ts !== undefined ? { at: e.ts } : {}) });
+         break;
+       case "assistant_message":
+         out.push({ eventId, kind: "assistant", label: timelineLabel(e.content), ...(e.ts !== undefined ? { at: e.ts } : {}) });
+         break;
+       case "tool_call":
+         out.push({ eventId, kind: "tool", label: timelineLabel(`${toolVerb(e.name) ?? e.name} ${summarize(e.name, e.args)}`), ...(e.ts !== undefined ? { at: e.ts } : {}) });
+         break;
+       case "usage":
+         out.push({ eventId, kind: "usage", label: `输入 ${fmtTokens(e.inputTokens)} · 输出 ${fmtTokens(e.outputTokens)}`, ...(e.ts !== undefined ? { at: e.ts } : {}) });
+         break;
+       default:
+         break; // clarify/plan/error 等：对话面有专卡/专行，时间线不为它们立步
+     }
+   }
+   return out;
+ }
+
+ /** v2.12 轮次时间线（rail）的投影：每条 = 一轮（user 发问 + 模型回复），供 rail 线段与悬停
+  *  信息面板取料。回复摘要 = 该轮第一条 assistant 行截断；无模型行回退 null（面板标注「结果：」缺）。 */
+ export function roundTimeline(
+   rows: readonly StreamRow[],
+ ): Array<{ round: number; userText: string; replySummary: string | null; ts?: number }> {
+   const out: Array<{ round: number; userText: string; replySummary: string | null; ts?: number }> = [];
+   let current: (typeof out)[number] | null = null;
+   for (const r of rows) {
+     if (r.kind === "user") {
+       if (current !== null) out.push(current);
+       current = { round: r.round, userText: r.text, replySummary: null, ...(r.ts !== undefined ? { ts: r.ts } : {}) };
+     } else if (r.kind === "assistant" && current !== null && current.replySummary === null) {
+       current.replySummary = r.text.slice(0, 120);
+     }
+   }
+   if (current !== null) out.push(current);
+   return out;
+ }
+
+ // 工具名的中文动词层（第 918 页从 `components/Stream.tsx` 搬到派生层）：
+ // 它有两个消费面——对话流的工具行（`Stream`）与时间线的步骤标签（`derived/timeline`）。
+ // 词表留在组件里时，时间线只能退回复制一份或直接写实现名（改前就是后者：`read_file a.ts`）；
+ // 派生层不依赖组件层，两边都能读它，这才是「一个词表」的落点。
+ /** 工具行一句话摘要的动词层（阶段 2 · brief §二.4 例：「抓取 api-docs.deepseek.com/news」）。
+  *  已知工具给中文动词；未知工具 null——宁缺不编（渲染层回落「· 摘要」形态）。 */
+ export const TOOL_VERBS: Readonly<Record<string, string>> = {
+   read_file: "读取",
+   write_file: "写入",
+   edit_file: "编辑",
+   apply_patch: "打补丁",
+   run_shell: "运行",
+   // 静态工具面（`TOOL_NAMES`）里剩下的七把（第 916 页）：它们此前没有动词，渲染层按「未知工具」
+   // 处理 ⇒ 折叠行把 `grep` / `glob` / `lsp` / `clarify` / `propose_plan` / `render_image` 这些
+   // 实现名原样摆上屏，与「不暴露实现名」相反。`list_dir` 是从前的工具，现已不存在（glob 取代），
+   // 留着这条 = 词表比工具面多一格，判据看不出来。
+   grep: "查找",
+   glob: "找文件",
+   lsp: "查符号",
+   clarify: "提问",
+   propose_plan: "提方案",
+   render_image: "出图",
+   verify: "验证",
+   web_fetch: "抓取",
+   web_search: "搜索",
+   spawn_agent: "派发子任务",
+   // 子任务生命周期（第 917 页）：这几个工具的参数里没有 command/path 一类字段，摘要走 ownSubject
+   // （task/message/agent_ids/thread_id）。没有动词的话，行首仍会把 `wait_for_agents` 这类实现名摆上屏。
+   send_agent: "发消息",
+   wait_for_agents: "等待",
+   cancel_agents: "撤销",
+   list_agents: "列出",
+   resume_agent: "恢复",
+   close_agent: "关闭",
+   read_image: "读图",
+ };
+ export function toolVerb(tool: string): string | null {
+   return TOOL_VERBS[tool] ?? null;
+ }
+
+
+ // 派生层·交付面（纯投影）：事件流 → 逐轮交付（改动 + 验证证据）。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+
+ export type TurnVerificationStatus = "not-required" | "absent" | "stale" | "verified" | "failed";
+
+ export interface TurnVerificationEvidence {
+   command: string;
+   ok: boolean;
+   output: string;
+   cause?: string;
+   exitCode?: number | null;
+ }
+
+ export interface TurnDelivery {
+   round: number;
+   files: Array<{ path: string; change: "created" | "modified" | "unknown"; snapshotId?: string }>;
+   verification: {
+     status: TurnVerificationStatus;
+     attempts: number;
+     latest: {
+       ok: boolean;
+       auto: boolean;
+       attempt: number;
+       maxAttempts: number;
+       results: TurnVerificationEvidence[];
+     } | null;
+   };
+   unverifiedFiles: string[];
+   nextAction: string;
+ }
+
+ interface InternalVerification {
+   index: number;
+   ok: boolean;
+   auto: boolean;
+   attempt: number;
+   maxAttempts: number;
+   results: TurnVerificationEvidence[];
+ }
+
+ interface InternalTurn {
+   round: number;
+   files: TurnDelivery["files"];
+   lastWriteIndex: number;
+   verifications: InternalVerification[];
+ }
+
+ /** 被显式还原过、且此后**没有再被写**的文件集合（退出改动面的那些）。
+  *
+  *  为什么要有这一格：还原（检查器「撤销此文件改动」）此前只改盘上的文件、**不留任何事件**，
+  *  而改动面全部从事件流投影 ⇒ 还原之后那一行仍写着"修改"、仍提供"撤销"、徽标仍数着它、
+  *  交付卡仍说"改动已验证"——那个改动在盘上已经不存在了。
+  *
+  *  判定按**最后一次动作**：还原之后再被写 ⇒ 重新进改动面（还原只撤掉改动，没撤掉这个文件
+  *  以后再被改的资格）；只还原过、没再写 ⇒ 不在改动面。 */
+ export function restoredPathsOf(events: readonly AgentEvent[]): ReadonlySet<string> {
+   const lastAction = new Map<string, "write" | "restore">();
+   const WRITE_TOOLS = new Set(["write_file", "edit_file", "apply_patch"]);
+   const writes = new Map<string, string>(); // tool_call id → path
+   for (const e of events) {
+     if (e.type === "tool_call" && WRITE_TOOLS.has(e.name)) {
+       const p = (e as { args?: { path?: unknown } }).args?.path;
+       if (typeof p === "string" && p !== "") writes.set(e.id, p);
+       continue;
+     }
+     if (e.type === "tool_result") {
+       const p = writes.get(e.callId);
+       if (p !== undefined) {
+         writes.delete(e.callId);
+         // 被拒绝/失败的一笔没有改动盘上文件（门拒绝、审批超时、工具报错都在执行前/写盘前收口）：
+         // 记成 write 会让「还原」之后的文件被一笔没发生的写入重新拉回改动面。
+         if (e.ok) lastAction.set(p, "write");
+       }
+       continue;
+     }
+     if (e.type === "file_restored") {
+       const p = (e as { path?: unknown }).path;
+       if (typeof p === "string" && p !== "") lastAction.set(p, "restore");
+     }
+   }
+   const out = new Set<string>();
+   for (const [p, kind] of lastAction) if (kind === "restore") out.add(p);
+   return out;
+ }
+
+ /** C-32 ChangeSummaryCard 的投影（v2 输出优先）：按轮聚合写工具改动——user 行开新轮，
+  *  写类 tool_call（write_file/edit_file/apply_patch）与其 tool_result 配对后计入该轮；
+  *  change 字段缺席标 unknown（不猜 created/modified）；worker 子流事件已在 projectStream
+  *  的过滤之外（此处直接吃原始事件，沿用同一过滤判据）。
+  *  新投影在这份文件事实之上补验证券：验证拍晚于最后一次写盘才算当前证据，
+  *  验证后又写盘标 stale，worker 验证不替主会话销账。 */
+ function collectTurnDelivery(events: readonly AgentEvent[]): InternalTurn[] {
+   const WRITE_TOOLS = new Set(["write_file", "edit_file", "apply_patch"]);
+   const isWorker = (e: AgentEvent): boolean =>
+     e.type !== "agent_spawned" && typeof (e as { agent_id?: unknown }).agent_id === "string";
+   const out: InternalTurn[] = [];
+   let round = 0;
+   let current: InternalTurn | null = null;
+   // tool_call id → { path }（写工具才登记）；tool_result 按 callId 收口并计入当前轮。
+   const pendingWrites = new Map<string, { path: string }>();
+   const finish = (): void => {
+     if (current !== null && (current.files.length > 0 || current.verifications.length > 0)) out.push(current);
+     current = null;
+   };
+   for (let index = 0; index < events.length; index++) {
+     const e = events[index]!;
+     if (isWorker(e)) continue;
+     if (e.type === "user_message") {
+       finish();
+       round += 1;
+       current = { round, files: [], lastWriteIndex: -1, verifications: [] };
+       continue;
+     }
+     if (current === null) continue;
+     if (e.type === "tool_call" && WRITE_TOOLS.has(e.name)) {
+       const p = e.args.path;
+       if (typeof p === "string" && p !== "") pendingWrites.set(e.id, { path: p });
+       continue;
+     }
+     if (e.type === "tool_result") {
+       const call = pendingWrites.get(e.callId);
+       if (call === undefined) continue;
+       pendingWrites.delete(e.callId);
+       // 只有真的落盘的写入才算改动（2026-10-20 修）：gate 拒绝 / 审批超时 / 执行失败的回执
+       // 同样带 path，旧实现照单全收 ⇒ 一次被拒的 write_file 会在「改动」面凭空多一行、
+       // 顶栏徽标多 1、交付卡把这一轮说成「有改动未验证」——而盘上什么都没发生。
+       // 它也不能推进 lastWriteIndex：否则「验证之后又写盘 ⇒ stale」会被一次没发生的写入触发。
+       if (!e.ok) continue;
+       current.lastWriteIndex = index;
+       // 同一文件轮内多笔只记一次（首次的 change 口径）。
+       if (current.files.some((f) => f.path === call.path)) continue;
+       current.files.push({
+         path: call.path,
+         change: e.change === "created" ? "created" : e.change === "modified" ? "modified" : "unknown",
+         ...(e.snapshotId !== undefined ? { snapshotId: e.snapshotId } : {}),
+       });
+       continue;
+     }
+     if (e.type === "verify_result") {
+       current.verifications.push({
+         index,
+         ok: e.ok,
+         auto: e.auto === true,
+         attempt: e.attempt,
+         maxAttempts: e.maxAttempts,
+         results: e.results.map((r) => ({
+           command: r.command,
+           ok: r.ok,
+           output: r.output,
+           ...(r.cause !== undefined ? { cause: r.cause } : {}),
+           ...(r.exitCode !== undefined ? { exitCode: r.exitCode } : {}),
+         })),
+       });
+     }
+   }
+   finish();
+   return out;
+ }
+
+ export function turnDelivery(events: readonly AgentEvent[]): TurnDelivery[] {
+   // 被显式还原过的文件退出改动面（用户明说"这一项我撤了"）。判定按**最后一次动作**：
+   // 还原之后再被写 ⇒ 重新进改动面（还原只撤掉改动，没撤掉它以后再被改的资格）。
+   const restored = restoredPathsOf(events);
+   return collectTurnDelivery(events).map((turn) => {
+     const files = turn.files.filter((f) => !restored.has(f.path));
+     const fresh = turn.verifications.filter((v) => v.index > turn.lastWriteIndex);
+     const latest = fresh.length > 0 ? fresh[fresh.length - 1]! : (turn.verifications[turn.verifications.length - 1] ?? null);
+     const status: TurnVerificationStatus =
+       files.length === 0
+         ? "not-required"
+         : fresh.length === 0
+           ? turn.verifications.length === 0 ? "absent" : "stale"
+           : latest!.ok ? "verified" : "failed";
+     const unverifiedFiles = status === "verified" || status === "not-required" ? [] : files.map((f) => f.path);
+     const nextAction =
+       status === "failed" ? "修复失败项后重新运行验证"
+       : status === "stale" ? "文件在上次验证后又有改动，请重新运行验证"
+       : status === "absent" ? "本轮有文件改动但还没有验证记录，请运行验证"
+       : status === "verified" ? "改动已验证，可进入审查或继续下一项"
+       : "本轮没有文件改动，可继续下一项";
+     return {
+       round: turn.round,
+       files,
+       verification: {
+         status,
+         attempts: files.length === 0 ? turn.verifications.length : fresh.length,
+         latest: latest === null ? null : {
+           ok: latest.ok,
+           auto: latest.auto,
+           attempt: latest.attempt,
+           maxAttempts: latest.maxAttempts,
+           results: latest.results,
+         },
+       },
+       unverifiedFiles,
+       nextAction,
+     };
+   });
+ }
+
+ /** 批 3 交付卡流尾的条目：有交付的轮出卡。空轮弱行（连续空轮并一行的那个小字条目）
+  *  已于 2026-10-24 按业主反馈整体撤下——空轮不再产出任何内容，序列里只剩卡。 */
+ export type DeliveryTrailItem = { kind: "card"; delivery: TurnDelivery };
+
+ /** 交付卡流尾序列：按轮序只铺「有交付的卡」，轮与轮之间的空轮不占位。 */
+ export function deliveryTrail(deliveries: readonly TurnDelivery[]): DeliveryTrailItem[] {
+   return deliveries.map((delivery) => ({ kind: "card" as const, delivery }));
+ }
+
+ export function turnChanges(events: readonly AgentEvent[]): Array<{
+   round: number;
+   files: TurnDelivery["files"];
+ }> {
+   return turnDelivery(events)
+     .filter((t) => t.files.length > 0)
+     .map((t) => ({ round: t.round, files: t.files }));
+ }
+
+ // 派生层·用量面（纯投影）：事件流 → 用量读数。
+ // I3 契约：只吃 AgentEvent[]，只吐值；不读时钟、不取随机、不做 IO、不留模块级可变态。
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { usageTotals } from "../../../../../src/main/usage-ledger";
+
+ /** 累加全部 usage 事件；缺字段当 0（UsageEvent 字段必在，防御旧日志），并给消费方事件计数。
+  *  v3（状态条对齐原型 renderStatus）：cacheReadTokens = 各事件缓存读之和（缺席不计，不是 0——
+  *  「没量到」不冒充「量到了 0」）；lastInputTokens = 最后一条 usage 的输入（上下文水位≈末轮输入，
+  *  累加值会虚高，不能拿来算上下文百分比）。 */
+ export function usageAggregate(events: readonly AgentEvent[]): {
+   inputTokens: number; outputTokens: number; usageCount: number; cacheReadTokens: number; lastInputTokens: number;
+ } {
+   let inputTokens = 0;
+   let outputTokens = 0;
+   let usageCount = 0;
+   let cacheReadTokens = 0;
+   let lastInputTokens = 0;
+   for (const e of events) {
+     if (e.type !== "usage") continue;
+     usageCount += 1;
+     inputTokens += typeof e.inputTokens === "number" ? e.inputTokens : 0;
+     outputTokens += typeof e.outputTokens === "number" ? e.outputTokens : 0;
+     if (typeof (e as { cacheReadInputTokens?: unknown }).cacheReadInputTokens === "number") {
+       cacheReadTokens += (e as { cacheReadInputTokens: number }).cacheReadInputTokens;
+     }
+     if (typeof e.inputTokens === "number") lastInputTokens = e.inputTokens;
+   }
+   return { inputTokens, outputTokens, usageCount, cacheReadTokens, lastInputTokens };
+ }
+
+ /** 用量统计（2026-10-20 批 130 · 头像菜单的「用量统计」面板读它）。
+  *  口径与主进程跨会话账本**同源**（`src/main/usage-ledger.ts` 的 `usageTotals`，批 131 收口）——
+  *  面板的「当前会话」与「全部会话」不会各算一套、慢慢分叉。
+  *  纯函数 ⇒ 可判卷。 */
+ export interface UsageSummary {
+   inputTokens: number;
+   outputTokens: number;
+   cacheReadTokens: number;
+   usageCount: number;
+   toolSteps: number;
+   rounds: number;
+ }
+
+ export function usageSummary(events: readonly AgentEvent[]): UsageSummary {
+   return usageTotals(events);
+ }
+
+ // 统一 diff（git `worktreeDiff` 的 patch）→ DiffView 的 hunk 视图（纯函数，可单测）。
+ //
+ // 作用：worker 改动预览原本把整段 patch 塞进 <pre>；这里只做**解析**，渲染仍交给既有
+ // DiffView（色盲冗余、行号、截断语义都在那一处）。解析不出来的输入返回 []，调用方回落原文，
+ // 绝不把「没解析」说成「没有差异」。
+ import type { DiffHunkView } from "../../../../src/main/change-diff";
+
+ const HUNK = /^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/u;
+
+ /** worker diff 预览的 UI 帽：core 侧 worktreeDiff 允许到 32MB，整段进 DOM/解析会把渲染层卡死。
+  *  200k 字符足够看多数改动；超帽只截显示，**不假装完整**（界面必须标 truncated）。 */
+ export const DIFF_VIEW_CHAR_CAP = 200_000;
+ export function clipDiff(text: string, cap = DIFF_VIEW_CHAR_CAP): { text: string; truncated: boolean } {
+   if (text.length <= cap) return { text, truncated: false };
+   return { text: text.slice(0, cap), truncated: true };
+ }
+
+ export function parseUnifiedPatch(patch: string): DiffHunkView[] {
+   const out: DiffHunkView[] = [];
+   let cur: DiffHunkView | null = null;
+   let oldNo = 0;
+   let newNo = 0;
+   for (const raw of patch.split("\n")) {
+     const line = raw.endsWith("\r") ? raw.slice(0, -1) : raw;
+     const m = HUNK.exec(line);
+     if (m !== null) {
+       cur = { header: line, lines: [] };
+       out.push(cur);
+       oldNo = Number(m[1]);
+       newNo = Number(m[3]);
+       continue;
+     }
+     if (cur === null) continue; // 文件头（diff --git / --- / +++ / index）不进 hunk
+     if (line.startsWith("\\ No newline")) continue;
+     if (line.startsWith("+")) {
+       cur.lines.push({ kind: "add", text: line.slice(1), oldNo: null, newNo: newNo++ });
+       continue;
+     }
+     if (line.startsWith("-")) {
+       cur.lines.push({ kind: "del", text: line.slice(1), oldNo: oldNo++, newNo: null });
+       continue;
+     }
+     if (line.startsWith(" ")) {
+       cur.lines.push({ kind: "ctx", text: line.slice(1), oldNo: oldNo++, newNo: newNo++ });
+     }
+   }
+   return out;
+ }
+
+ // 草稿落盘的单源（2026-10-18）：键、解析、读取都在这，Composer 写、App 读来给侧栏画“有草稿”标记。
+ // 只存非空文本；home 键（\u0000home）不入侧栏标记（首页没有会话行）。
+ import { sessionKeyOf } from "./state/session-identity";
+
+ export const DRAFTS_KEY = "cairn.composer.drafts.v1";
+ export const HOME_DRAFT_KEY = "\u0000home";
+
+ /** 草稿桶键：会话用「工作区+id」引用键（两个已登记工作区里同秒同 id 的会话不串稿）；
+  *  首页用常量键；工作区未知退回裸 id（与 runKey 同口径，旧行为可用）。 */
+ export function draftKeyFor(workspace: string | null | undefined, sessionId: string | null): string {
+   if (sessionId === null) return HOME_DRAFT_KEY;
+   return sessionKeyOf(workspace, sessionId) ?? sessionId;
+ }
+
+ /** 草稿键里的会话 id：引用键与旧裸 id 都认；home ⇒ null。旧裸 id 桶的懒迁移用。 */
+ export function sessionIdOfDraftKey(key: string): string | null {
+   if (key === HOME_DRAFT_KEY) return null;
+   if (!key.startsWith("[")) return key;
+   try {
+     const parsed: unknown = JSON.parse(key);
+     if (Array.isArray(parsed) && parsed.length === 2 && typeof parsed[1] === "string" && parsed[1] !== "") return parsed[1];
+   } catch { /* 坏键当裸 id */ }
+   return key;
+ }
+
+ /** 从 localStorage 的原始字符串解析出“有非空草稿的桶键”集合（纯函数，判卷用；键的形态见 draftKeyFor）。 */
+ export function draftIdsFrom(raw: string | null): Set<string> {
+   const ids = new Set<string>();
+   if (raw === null) return ids;
+   try {
+     const obj: unknown = JSON.parse(raw);
+     if (obj === null || typeof obj !== "object") return ids;
+     for (const [k, v] of Object.entries(obj as Record<string, unknown>)) {
+       if (k !== HOME_DRAFT_KEY && typeof v === "string" && v.trim() !== "") ids.add(k);
+     }
+   } catch { /* 坏数据当没有 */ }
+   return ids;
+ }
+
+ export function readDraftIds(): Set<string> {
+   if (typeof window === "undefined") return new Set();
+   try {
+     return draftIdsFrom(window.localStorage.getItem(DRAFTS_KEY));
+   } catch {
+     return new Set();
+   }
+ }
+
+ /** 「折叠全部」的轮集：保留最后一轮（正在读/正在跑的那轮不折）。 */
+ export function foldAllButLast(rounds: readonly number[]): ReadonlySet<number> {
+   return new Set(rounds.slice(0, -1));
+ }
+
+
+ // /goal 命令解析（2026-10-18）：斜杠说明一直写着“轮次/美元上限”，但此前只认目标原文。
+ // 语法：/goal [--turns N] [--usd X] <目标…>；参数只认正整数 / 非负小数，其它原样留在目标里。
+ export interface GoalCommand {
+   objective: string;
+   maxTurns?: number;
+   maxUsd?: number;
+ }
+
+ export function parseGoalCommand(text: string): GoalCommand | null {
+   if (!text.startsWith("/goal ")) return null;
+   let rest = text.slice("/goal ".length).trim();
+   let maxTurns: number | undefined;
+   let maxUsd: number | undefined;
+   const take = (re: RegExp): string | null => {
+     const m = rest.match(re);
+     if (m === null || m.index === undefined) return null;
+     rest = `${rest.slice(0, m.index)} ${rest.slice(m.index + m[0].length)}`.trim();
+     return m[1] ?? null;
+   };
+   const turns = take(/(?:^|\s)--turns\s+(\d+)(?=\s|$)/);
+   if (turns !== null) maxTurns = Number(turns);
+   const usd = take(/(?:^|\s)--usd\s+(\d+(?:\.\d+)?)(?=\s|$)/);
+   if (usd !== null) maxUsd = Number(usd);
+   return { objective: rest.replace(/\s+/g, " ").trim(), ...(maxTurns !== undefined ? { maxTurns } : {}), ...(maxUsd !== undefined ? { maxUsd } : {}) };
+ }
+
+ // 已停目标的「隐藏」持久化（2026-10-18）：此前只在内存，重启后已停芯片会重新出现。
+ // 按会话 id 记账（at 只是该会话事件流里的下标，跨会话不可比）。坏数据当没有；只收数字。
+ const KEY = "cairn.goal.dismissed.v1";
+
+ export function dismissedFrom(raw: string | null): Map<string, number> {
+   const out = new Map<string, number>();
+   if (raw === null) return out;
+   try {
+     const obj: unknown = JSON.parse(raw);
+     if (obj === null || typeof obj !== "object") return out;
+     for (const [k, v] of Object.entries(obj as Record<string, unknown>)) {
+       if (typeof v === "number" && Number.isInteger(v)) out.set(k, v);
+     }
+   } catch { /* 坏数据当没有 */ }
+   return out;
+ }
+
+ export function readDismissedGoals(): Map<string, number> {
+   if (typeof window === "undefined") return new Map();
+   try {
+     return dismissedFrom(window.localStorage.getItem(KEY));
+   } catch {
+     return new Map();
+   }
+ }
+
+ export function writeDismissedGoals(m: Map<string, number>): void {
+   if (typeof window === "undefined") return;
+   try {
+     window.localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(m)));
+   } catch { /* 存不下则本会话内生效 */ }
+ }
+
+ // IME 组字守卫（2026-10-28）：**所有**会消费 Enter 的键盘路径共用一条判定。
+ //
+ // 为什么要有这一层：此前只有「发送」那条路径带组字守卫（`composing.current`），
+ // 斜杠菜单与 @mention 菜单的 Enter 分支没有 ⇒ 中文用户在拼音组字期间按 Enter，
+ // 菜单把**正在组字的半成品**当成「选中了第 0 项」，输入框里的字被改写成
+ // `/compact `（真机复现：见 PROGRESS 第 749 页的探针读数）。这不是"回车多按了一次"，
+ // 是**用户正在写的字被系统改掉**——最坏的一类交互缺陷。
+ //
+ // 判定口径（两条都认，任一为真 ⇒ 这次 Enter 归 IME，不给应用）：
+ //   ① `event.nativeEvent.isComposing` —— 浏览器在组字期间给出的标准旗；
+ //   ② 调用方维护的 `composing` 引用 —— compositionstart/end 事件流。
+ // 只有 ① 时，React 的 SyntheticKeyboardEvent 会把它透传为 `nativeEvent.isComposing`；
+ // 这里**同时**读合成事件自身上的 `isComposing`，因为部分 Electron/Chromium 版本
+ // 在 `dispatchEvent` 合成的路径上只把它挂在事件自身。
+ //
+ // 纯函数、无 IO、无时钟 ⇒ 可判卷（不靠"源码里有没有这句"自证）。
+ export interface CompositionKeyEventLike {
+   /** 合成事件自身带的旗（部分路径只有这里有）。 */
+   readonly isComposing?: boolean;
+   /** 浏览器在原生事件上给的旗（标准路径）。 */
+   readonly nativeEvent?: { readonly isComposing?: boolean } | null;
+   /** 传统 IME 信号：组字期间的按键一律报 keyCode 229（Chromium/Safari 都如此）。 */
+   readonly keyCode?: number;
+ }
+
+ /**
+  * 这次 Enter 是不是「IME 组字途中的一次回车」。
+  *
+  * @param event       键盘事件（合成或原生皆可）。
+  * @param composingRef 调用方维护的组字引用（compositionstart/end 驱动）；没有就传 null。
+  * @returns true ⇒ 这次 Enter 归 IME，应用**不应**消费它。
+  */
+ export function isCompositionEnter(
+   event: CompositionKeyEventLike | null | undefined,
+   composingRef: { readonly current: boolean } | null | undefined,
+ ): boolean {
+   if (composingRef?.current === true) return true;
+   if (event === null || event === undefined) return false;
+   if (event.isComposing === true) return true;
+   if (event.nativeEvent?.isComposing === true) return true;
+   // 传统旗：组字期间的按键 keyCode 一律是 229（含部分 Windows 输入法的候选确认）。
+   return event.keyCode === 229;
+ }
+
+ /** 启动时检查器的初始开合。
+  *
+  *  三条输入的优先级必须是**显式偏好 > 恢复内容 > 默认收起**：
+  *  - 用户点过开/关（`prefSet`）⇒ 以那次选择为准，哪怕盘上还有窗格。旧实现写成
+  *    `paneCount > 0 || defaultOpen`，于是「关掉检查器 → 带着窗格重载」会被强行掰开，
+  *    等于把用户的显式选择当成没有。
+  *  - 没点过 + 有恢复窗格 ⇒ 展开（窗格挂在宽度 0 的栏里等于没恢复）。
+  *  - 没点过 + 没窗格 ⇒ 收起（brief 七的默认值）。
+  */
+ export function initialInspectorOpen(s: {
+   prefSet: boolean;
+   defaultOpen: boolean;
+   paneCount: number;
+ }): boolean {
+   if (s.prefSet) return s.defaultOpen;
+   return s.paneCount > 0;
+ }
+
+ /** 启动恢复上次会话的判据 + key 编解码。
+  *
+  *  **为什么要带 workspace**：桌面宿主的会话 id 是分钟级时间戳，两个项目在同一分钟各建一条会话
+  *  会得到同一个 id。只存 id、恢复时按 id 找第一条，会把 A 的转录当 B 恢复，后续 run 也落进 A。
+  *  所以 key 从 v1 的裸 id 升级为 `{id, workspace}`；旧裸 id 仍可读，但**同名多条时不猜**（直接清）。
+  *
+  *  跨工作区是允许的：桌面 `listSessions` 逐根扫描全部已注册工作区并带 `workspace` 字段，
+  *  `openSession` 会切上下文。旧注释「跨区不恢复」与现态相反。
+  *
+  *  三条分支：
+  *  - 用户已经开了会话（activeId 非空）⇒ skip。不许覆盖用户的选择，也不许把 key 清掉；
+  *  - 上次会话按 id + workspace 命中（旧格式且唯一）⇒ restore，调用方走 `openSession(id)`；
+  *  - 找不到 / 有歧义 / 项目已移除 ⇒ clear，回主页并清 key。
+  */
+ export interface LastSessionRef {
+   id: string;
+   /** null = 旧格式（只有 id）。新写入的 key 一律带工作区。 */
+   workspace: string | null;
+ }
+
+ export type LastSessionDecision =
+   | { kind: "skip" }
+   | { kind: "restore"; id: string; workspace: string | null }
+   /** 有记录但这次没命中（项目暂不可见/扫描失败/旧格式歧义）：**保留 key**，下次再试。
+    *  删掉它是不可逆的；留着一个过期 id 的代价只是下次启动多查一次。 */
+   | { kind: "keep" }
+   | { kind: "clear" };
+
+ export function parseLastSession(raw: string | null): LastSessionRef | null {
+   if (raw === null) return null;
+   try {
+     const parsed = JSON.parse(raw) as unknown;
+     if (typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)) {
+       const id = (parsed as { id?: unknown }).id;
+       const workspace = (parsed as { workspace?: unknown }).workspace;
+       if (typeof id !== "string" || id === "") return null;
+       return { id, workspace: typeof workspace === "string" && workspace !== "" ? workspace : null };
+     }
+   } catch {
+     // 看着像对象/数组却不是合法 JSON ⇒ 坏 key，不是「旧格式 id」。
+     // v1 的裸 id 是时间戳/会话名，不会以 `{`/`[` 开头；把它当 id 会拿垃圾去开文件。
+     const text = raw.trim();
+     if (text.startsWith("{") || text.startsWith("[")) return null;
+     return text === "" ? null : { id: text, workspace: null };
+   }
+   return raw.trim() === "" ? null : { id: raw.trim(), workspace: null };
+ }
+
+ export function serializeLastSession(ref: LastSessionRef): string {
+   return JSON.stringify({ id: ref.id, workspace: ref.workspace });
+ }
+
+ export function decideLastSessionRestore(opts: {
+   last: LastSessionRef | null;
+   sessions: readonly { id: string; workspace?: string }[];
+   activeId: string | null;
+ }): LastSessionDecision {
+   if (opts.activeId !== null) return { kind: "skip" };
+   const last = opts.last;
+   if (last === null) return { kind: "clear" };
+   if (last.workspace !== null) {
+     const hit = opts.sessions.find((s) => s.id === last.id && s.workspace === last.workspace);
+     return hit !== undefined
+       ? { kind: "restore", id: hit.id, workspace: hit.workspace ?? last.workspace }
+       : { kind: "keep" };
+   }
+   // 旧格式：id 唯一才恢复；同名跨项目时宁可不恢复，也不打开错的那一份。
+   const hits = opts.sessions.filter((s) => s.id === last.id);
+   if (hits.length === 1) {
+     return { kind: "restore", id: hits[0]!.id, workspace: hits[0]!.workspace ?? null };
+   }
+   return { kind: "keep" };
+ }
