+     });
+   }, []);
+   // 2026-10-18 字号档应用：与主题同一形制——单一事实源写一个 data 属性，tokens.css 消费。
+   // md 档不写属性（让 --rem-scale 保持 :root 的 1），不往 DOM 上堆无意义的状态。
+   useEffect(() => {
