+           confirmLabel={report.global.frozen ? "解除冻结" : "冻结"}
+           onClose={() => { setConfirmGlobalFreeze(false); }}
+           onConfirm={() => {
+             const next = !report.global.frozen;
+             setConfirmGlobalFreeze(false);
