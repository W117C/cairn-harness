+   goalAct: (req: { pause?: boolean | undefined; resume?: boolean | undefined; clear?: boolean | undefined; }) => void;
+   activeIdRef: MutableRefObject<string | null>;
+   setDismissedGoals: Dispatch<SetStateAction<Map<string, number>>>;
