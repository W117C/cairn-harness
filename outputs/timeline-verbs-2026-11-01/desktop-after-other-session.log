+
+       <SettingsSection title="预算" hint={budgetSource(report.budget.source)}>
+         <SettingsRow
+           label="注入"
+           desc={`最多 ${String(report.budget.budget.maxInjectedEntries)} 条 / ${String(report.budget.budget.maxInjectedChars)} 字符`}
