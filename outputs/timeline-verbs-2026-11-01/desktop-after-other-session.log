+   // 依赖里有 activeId：切会话时重算起点（否则切回一个还在跑的会话，秒表会接着别人的起点算）。
+   useEffect(() => {
+     if (!runningActive || activeId === null) return;
+     setElapsedSec(elapsedSecondsFor(runStartBySession.current, activeId, Date.now()));
+     const id = setInterval(
+       () => setElapsedSec(elapsedSecondsFor(runStartBySession.current, activeId, Date.now())),
+       1000,
+     );
