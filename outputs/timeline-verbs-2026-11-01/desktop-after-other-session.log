+ // 上下文摘录（第二十四遍「Tab 想下一条」·业主裁 A②）：Tab 触发单发模型时的会话原料。
+ // 只取**已成终稿**的用户/助手行（live 行还在流，半截话不喂）；最近 8 条、每条截 400 字、
+ // 总量封顶 2000 字（超则从最早整条丢起）——摘录是确定性纯函数（suggest.test 判卷），
+ // 内容生成归模型（src/main/suggest-next），这里一个字的建议都不编。
+ import type { StreamRow } from "./projections";
+
+ export const SUGGEST_CONTEXT_MESSAGES = 8;
+ export const SUGGEST_CONTEXT_PER_MESSAGE = 400;
+ export const SUGGEST_CONTEXT_TOTAL = 2000;
+
+ /** 摘录只关心的行型（收窄用）：用户行 + 已成终稿的助手行。 */
+ type SuggestRow = Extract<StreamRow, { kind: "user" } | { kind: "assistant" }>;
+
+ /** 拼「用户：…／助手：…」摘录；没有可用的行 ⇒ null（调用方给「先聊两句」提示，不硬编）。 */
+ export function buildSuggestContext(rows: readonly StreamRow[]): string | null {
+   const picked = rows
+     .filter((r): r is SuggestRow => r.kind === "user" || (r.kind === "assistant" && r.live !== true))
+     .filter((r) => r.text.trim() !== "")
+     .slice(-SUGGEST_CONTEXT_MESSAGES);
+   if (picked.length === 0) return null;
+   const lines = picked.map((r) => {
+     const t = r.text.trim();
+     const cut = t.length > SUGGEST_CONTEXT_PER_MESSAGE ? `${t.slice(0, SUGGEST_CONTEXT_PER_MESSAGE)}…` : t;
+     return `${r.kind === "user" ? "用户：" : "助手："}${cut}`;
+   });
+   while (lines.length > 1 && lines.join("\n").length > SUGGEST_CONTEXT_TOTAL) lines.shift();
+   return lines.join("\n");
+ }
+
+ /* 主题应用（设计规范 §4.6，Claude 蓝本）：
+    settings.theme（system / light / dark）→ 文档 data-theme 属性（data 属性切换，
+    非两套 class）。system 模式跟随系统并监听变化（matchMedia）。
+    结构与 DOM 壳分离——决策是纯函数（判卷面），壳是可注入环境
+    （产品取浏览器 document/matchMedia；判卷注入 stub，本仓无 jsdom）。 */
+
+ export type ThemePref = "system" | "light" | "dark";
+ export type ActualTheme = "light" | "dark";
+
+ /** 偏好 + 系统暗色事实 → 实际主题（纯函数，唯一决策点）。 */
+ export function actualThemeOf(pref: ThemePref, systemDark: boolean): ActualTheme {
+   if (pref === "system") return systemDark ? "dark" : "light";
+   return pref;
+ }
+
+ /** 壳环境：写属性 / 读系统值 / 订阅系统变化（返回解除函数）。 */
+ export interface ThemeEnv {
+   setDataTheme(value: ActualTheme): void;
+   systemDark(): boolean;
+   watchSystemDark(onChange: () => void): () => void;
+ }
+
+ /** 主题键落位（纯函数，判卷面）：Cairn 用 `data-theme`，官方 CDS 令牌薄按 `data-mode`。
+    两者都要写——只写 data-theme 时 `vendor/cds-official/tokens.css` 的暗色块选不中，
+    整个暗色会静默退回亮色值。返回要写/要摘的属性，使壳可以一次落两步。 */
+ export interface ThemeKeys {
+   /** 写到 documentElement 上的属性。 */
+   readonly attributes: Readonly<Record<"data-theme" | "data-mode", ActualTheme>>;
+   /** 是否给 body 打暗色标记（styles/dsh-claude-style 消费）。 */
+   readonly bodyDark: boolean;
+ }
+
+ export function themeKeysOf(value: ActualTheme): ThemeKeys {
+   return {
+     attributes: { "data-theme": value, "data-mode": value },
+     bodyDark: value === "dark",
+   };
+ }
+
+ /** 产品环境：document + matchMedia。 */
+ export function browserThemeEnv(): ThemeEnv {
+   const mq = window.matchMedia("(prefers-color-scheme: dark)");
+   return {
+     setDataTheme: (v) => {
+       const keys = themeKeysOf(v);
+       for (const [name, value] of Object.entries(keys.attributes)) {
+         document.documentElement.setAttribute(name, value);
+       }
+       document.body.toggleAttribute("data-ds-dark-theme", keys.bodyDark);
+     },
+     systemDark: () => mq.matches,
+     watchSystemDark: (onChange) => {
+       mq.addEventListener("change", onChange);
+       return () => { mq.removeEventListener("change", onChange); };
+     },
+   };
+ }
+
+ /** 应用主题偏好；返回清理函数（切偏好/卸载时调用，解除系统监听）。
+    非 system 偏好不订阅（固定主题下系统翻转与我们无关）。 */
+ export function applyTheme(pref: ThemePref, env: ThemeEnv): () => void {
+   const apply = (): void => { env.setDataTheme(actualThemeOf(pref, env.systemDark())); };
+   apply();
+   if (pref !== "system") return () => undefined;
+   return env.watchSystemDark(apply);
+ }
+
+ type SonnerModule = typeof import("sonner");
+ type ToastKind = "default" | "success" | "error";
+
+ let modulePromise: Promise<SonnerModule> | null = null;
+ let loadedModule: SonnerModule | null = null;
+ let requested = false;
+ const listeners = new Set<(module: SonnerModule) => void>();
+
+ function loadSonner(): Promise<SonnerModule> {
+   if (loadedModule !== null) return Promise.resolve(loadedModule);
+   modulePromise ??= import("sonner").then(
+     (module) => {
+       loadedModule = module;
+       for (const listener of listeners) listener(module);
+       return module;
+     },
+     (err: unknown) => {
+       // 瞬时读取失败不能让本轮进程永久失去提示能力；下一次请求重新试。
+       modulePromise = null;
+       throw err;
+     },
+   );
+   return modulePromise;
+ }
+
+ function show(kind: ToastKind, message: string): void {
+   requested = true;
+   void loadSonner().then(
+     (mod) => {
+       if (kind === "default") mod.toast(message);
+       else mod.toast[kind](message);
+     },
+     (err: unknown) => { console.error("[toast] 提示组件加载失败:", err instanceof Error ? err.message : String(err)); },
+   );
+ }
+
+ /** 轻量提示入口：首次调用时才加载 sonner；调用点不依赖返回 id。 */
+ export const toast = Object.assign(
+   (message: string): void => { show("default", message); },
+   {
+     success: (message: string): void => show("success", message),
+     error: (message: string): void => show("error", message),
+   },
+ );
+
+ /** ToastHost 订阅首次请求；早于订阅发生的请求也会在订阅时立即补触发。 */
+ export function subscribeToastHost(listener: (module: SonnerModule) => void): () => void {
+   listeners.add(listener);
+   if (requested) {
+     if (loadedModule !== null) listener(loadedModule);
+     else void loadSonner().catch(() => undefined);
+   }
+   return () => { listeners.delete(listener); };
+ }
+
+ // 对话导出（2026-10-18，命令面板「复制整段对话」）：把当前会话的用户/助手正文按序拼成
+ // Markdown。只收这两类——工具调用参数、思考正文、元信息不进导出（它们是过程，不是对话；
+ // 需要证据时看交付卡/检查器）。纯函数，无 DOM/IPC，判卷直接钉。
+ import type { AgentEvent } from "../../../../src/main/ipc-protocol";
+ import { isWorkerSubflowEvent, userVisibleText } from "./projections";
+
+ type CopyAttachment = { readonly path: string; readonly kind: "file" | "directory" };
+
+ /** 用户消息的复制文本（2026-10-18）：正文 + 附件清单。整段转录与行级「复制这条消息」
+  *  共用这一份格式——此前行级复制只抄正文，粘出去就不知道这条消息带过哪些文件。 */
+ export function userMessageCopy(text: string, attachments?: readonly CopyAttachment[]): string {
+   const body = text.trim();
+   const files = (attachments ?? []).map((a) => `- ${a.kind === "directory" ? "目录" : "文件"}：\`${a.path}\``);
+   return [body, files.length > 0 ? `附件：\n${files.join("\n")}` : ""].filter((p) => p !== "").join("\n\n");
+ }
+
+ /** 空标题回落到「未命名会话」（导出面不摆空 `#`）。
+  *
+  *  为什么必须收 `assistant_delta`：真实 provider（openai.ts / anthropic.ts）**一轮只发 delta**，
+  *  `assistant_message` 终稿是 mock/demo 通道才有的东西（projections.ts 的 projectStream 早就按
+  *  这个口径分桶）。只认终稿的旧实现在每一个真会话上都会导出一份**只有用户消息**的对话——
+  *  助手的回答整段消失。判据因此走 delta 分桶：同 callId 的 delta 按序拼成一段，
+  *  落定点与 projectStream 同口径（轮界 = 下一条 user_message，停转 = 事件流结束）。
+  *
+  *  思考正文**不进导出**（thinking_delta 是模型自言自语，与导出面"只收对话正文"的既定口径一致）。 */
+ export function transcriptMarkdown(events: readonly AgentEvent[], title: string): string {
+   const head = title.trim() === "" ? "未命名会话" : title.trim();
+   const parts: string[] = [`# ${head}`];
+   // 未结的 delta 桶：callId → 累计正文。落定时才决定要不要成段（空文本 = 只想过没说，不出段）。
+   let pending = new Map<string, string>();
+   const flush = (): void => {
+     for (const text of pending.values()) {
+       const body = text.trim();
+       if (body !== "") parts.push(`## Cairn\n\n${body}`);
+     }
+     pending = new Map();
+   };
+   for (const e of events) {
+     if (isWorkerSubflowEvent(e)) continue;
+     switch (e.type) {
+       case "user_message":
+         flush(); // 轮界：上一轮没被终稿收走的桶在此落定
+         {
+           const block = userMessageCopy(userVisibleText(e), e.attachments);
+           if (block !== "") parts.push(`## 你\n\n${block}`);
+         }
+         break;
+       case "assistant_message":
+         // 终稿到达即取代所有未结桶（它无 callId，无法按桶匹配——与 projectStream 同口径）。
+         pending = new Map();
+         {
+           const body = e.content.trim();
+           if (body !== "") parts.push(`## Cairn\n\n${body}`);
+         }
+         break;
+       case "assistant_delta":
+         pending.set(e.callId, (pending.get(e.callId) ?? "") + e.text);
+         break;
+       default:
+         break; // 工具/思考/元信息：过程，不是对话
+     }
+   }
+   flush(); // 停转：最后一段没被终稿收走的桶在此落定
+   // 每段之间空一行；末尾补一个换行（粘贴进 Markdown 编辑器不会与下一段粘连）。
+   return parts.join("\n\n") + "\n";
+ }
+
+ /** 文件名清洗（导出用）：去掉路径分隔符与 macOS/Windows 非法字符，压掉连续空白，截断 80 字符。
+  *  空标题 → 会话。扩展名由调用方/主进程负责（这里只给 stem）。 */
+ export function transcriptFileName(title: string): string {
+   const cleaned = title
+     .replace(/[\\/:*?"<>|\u0000-\u001f]/g, " ")
+     .replace(/\s+/g, " ")
+     .trim()
+     .slice(0, 80)
+     .trim();
+   return `${cleaned === "" ? "会话" : cleaned}.md`;
+ }
+
+ import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+ import { anchorKeyOf, type AnchoredEvent } from "./state/session-identity";
+
+ type MarkState<Value> = {
+   sessionId: string | null;
+   values: ReadonlyMap<string, Value>;
+   pending: ReadonlySet<string>;
+   loading: boolean;
+ };
+ type MarkSource<Value> = {
+   label: string;
+   load: (sessionId: string) => Promise<ReadonlyMap<string, Value>>;
+   save: (sessionId: string, anchor: AnchoredEvent, value: Value | undefined) => Promise<{ ok: boolean; error?: string }>;
+ };
+ type ReportError = (message: string, sessionId?: string) => void;
+
+ /** 两类消息标记共用归属、读写与逐条回滚；同一条标记有请求时禁止重复提交。 */
+ function useSessionMarks<Value>(sessionId: string | null, source: MarkSource<Value>, onError: ReportError) {
+   const [state, setState] = useState<MarkState<Value>>({ sessionId: null, values: new Map(), pending: new Set(), loading: true });
+   const generation = useRef(0);
+   const locks = useRef(new Set<string>());
+   useEffect(() => {
+     const version = ++generation.current;
+     locks.current.clear();
+     setState({ sessionId, values: new Map(), pending: new Set(), loading: sessionId !== null });
+     if (sessionId !== null) {
+       void source.load(sessionId).then((values) => {
+         if (generation.current === version) setState({ sessionId, values, pending: new Set(), loading: false });
+       }).catch((error: unknown) => {
+         if (generation.current !== version) return;
+         setState({ sessionId, values: new Map(), pending: new Set(), loading: false });
+         onError(`${source.label}读取失败：${error instanceof Error ? error.message : String(error)}。请刷新后重试。`, sessionId);
+       });
+     }
+     return () => { generation.current += 1; };
+   }, [sessionId, source, onError]);
+
+   const set = useCallback(async (anchor: AnchoredEvent, value: Value | undefined): Promise<void> => {
+     const key = anchorKeyOf(anchor);
+     if (sessionId === null || state.sessionId !== sessionId || state.loading || locks.current.has(key)) return;
+     locks.current.add(key); // 同帧连点也只发一次，不依赖 React 下一帧的 disabled。
+     const version = generation.current;
+     const previous = state.values.get(key);
+     const update = (nextValue: Value | undefined, pending: boolean) => {
+       setState((current) => {
+         if (current.sessionId !== sessionId) return current;
+         const values = new Map(current.values);
+         if (nextValue === undefined) values.delete(key); else values.set(key, nextValue);
+         const nextPending = new Set(current.pending);
+         if (pending) nextPending.add(key); else nextPending.delete(key);
+         return { ...current, values, pending: nextPending };
+       });
+     };
+     update(value, true);
+     try {
+       const result = await source.save(sessionId, anchor, value);
+       if (!result.ok) throw new Error(result.error ?? "未知错误");
+       if (generation.current === version) update(value, false);
+     } catch (error: unknown) {
+       if (generation.current !== version) return;
+       update(previous, false);
+       onError(`${source.label}提交失败：${error instanceof Error ? error.message : String(error)}`, sessionId);
+     } finally {
+       if (generation.current === version) locks.current.delete(key);
+     }
+   }, [sessionId, state, source, onError]);
+   const current = state.sessionId === sessionId;
+   return useMemo(() => ({
+     values: current ? state.values : new Map<string, Value>(),
+     busy: (anchor: AnchoredEvent) => !current || state.loading || state.pending.has(anchorKeyOf(anchor)),
+     pending: (anchor: AnchoredEvent) => current && state.pending.has(anchorKeyOf(anchor)),
+     set,
+   }), [current, state, set]);
+ }
+
+ const feedbackSource: MarkSource<"up" | "down"> = {
+   label: "反馈",
+   load: async (sid) => new Map((await window.agent.listFeedback(sid)).map((item) => [anchorKeyOf(item), item.rating])),
+   save: (sid, anchor, value) => window.agent.submitFeedback({ sessionId: sid, eventId: anchor.eventId, rating: value ?? "none", ...(anchor.eventRef !== undefined ? { eventRef: anchor.eventRef } : {}) }),
+ };
+ const pinSource: MarkSource<true> = {
+   label: "置顶",
+   load: async (sid) => new Map((await window.agent.listMessagePins(sid)).map((anchor) => [anchorKeyOf(anchor), true as const])),
+   save: (sid, anchor, value) => window.agent.setMessagePinned({ sessionId: sid, eventId: anchor.eventId, pinned: value === true, ...(anchor.eventRef !== undefined ? { eventRef: anchor.eventRef } : {}) }),
+ };
+
+ export function useMessageAnnotations(sessionId: string | null, onError: ReportError) {
+   const feedback = useSessionMarks(sessionId, feedbackSource, onError);
+   const pins = useSessionMarks(sessionId, pinSource, onError);
+   return useMemo(() => ({
+     feedback: feedback.values,
+     feedbackBusy: feedback.busy,
+     onFeedback: (anchor: AnchoredEvent, rating: "up" | "down" | null) => { void feedback.set(anchor, rating ?? undefined); },
+     pinnedEventIds: new Set(pins.values.keys()),
+     pinBusy: pins.busy,
+     annotationPending: (anchor: AnchoredEvent) => feedback.pending(anchor) || pins.pending(anchor),
+     onPin: (anchor: AnchoredEvent, pinned: boolean) => { void pins.set(anchor, pinned ? true : undefined); },
+   }), [feedback, pins]);
+ }
+
+ // 「N 分钟前」的活时钟（2026-10-18）：页面停留时相对时间不再冻结。
+ // 共用一条 interval + 订阅集合——每个相对时间标签各自开一条 setInterval 会变成 N 条定时器；
+ // 这里 N 个订阅者只共享一条，最后一个订阅者卸载时清掉。
+ // 60s 一档足够：文案最细粒度就是分钟（<60s 才显示「刚刚」）。
+ import { useEffect, useState } from "react";
+
+ type Listener = (nowMs: number) => void;
+ const listeners = new Set<Listener>();
+ let timer: number | null = null;
+
+ function tick(): void {
+   const now = Date.now();
+   for (const l of listeners) l(now);
+ }
+
