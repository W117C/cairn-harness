+           scripts,
+           readmeExists,
+           lastSessionTitle: last?.title ?? null,
+         }),
+         branch: git !== null && git.ok ? git.branch : null,
+       };
+       emptyCache.current.set(ws, surface);
+       setEmptyData(surface);
+     })();
+     return () => { alive = false; };
+   }, [showEmpty, activeWorkspace, sessionsLoaded]);
+
+   // 下沉动画（FLIP）：空屏期间持续记录输入区位置——这就是转场时的「前一帧」。
+   useLayoutEffect(() => {
+     if (!showEmpty) return;
+     const el = composerZoneRef.current;
+     if (el !== null) prevEmptyRect.current = el.getBoundingClientRect();
+   });
+
+   // 空屏 → 对话态：从旧位补 200ms 下沉（transform + opacity）；reduced-motion 直接落位。
+   useLayoutEffect(() => {
+     if (showEmpty) return;
+     const el = composerZoneRef.current;
+     const prev = prevEmptyRect.current;
+     if (el === null || prev === null) return;
+     prevEmptyRect.current = null; // 只在「空屏 → 对话」这一步动画一次
+     const next = el.getBoundingClientRect();
+     const dy = prev.top - next.top;
+     if (Math.abs(dy) < 8) return;
+     if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+     el.animate(
+       [
+         { transform: `translateY(${String(dy)}px)`, opacity: 0.6 },
+         { transform: "translateY(0px)", opacity: 1 },
+       ],
+       { duration: 200, easing: "ease-out" },
+     );
+   }, [showEmpty]);
+
+
+   return {  };
+ }
+
+ // 状态簇·消息级动作（Phase 2 · 批 2.3）。
+ //
+ // 分层契约（见 src/renderer/LAYERING.md）：本层**不含 JSX**、**不 import components/**；
+ // 钩子只吐「状态 + 动作」。搬移口径：代码逐行原样搬过来（判卷钉的是声明行与依赖数组的写法）。
+ //
+ // 装的是哪几样：流里那根操作条的动作——分叉（fork 到该轮）、编辑并重发、回放（fork + 注入原文）、
+ // 朗读（macOS say）、手动压缩（/compact）、目标动作（暂停/继续/清除）、快照还原。
+ // 为什么住一起：它们都作用在**某一条消息/某一轮**上，且共用同两件东西——事件流与当前会话 id。
+ import { useCallback, useState } from "react";
+ import type { AgentEvent } from "../../../../../src/main/ipc-protocol";
+ import { userTextOfRound } from "../projections";
+ import { stripMarkdownForSpeech } from "../speech";
+ import { STR } from "../strings";
+ import { toast } from "../toast";
+
+ export interface MessageActionsDeps {
+   /** 当前会话 id 的镜像 ref（回调在事件时刻读最新值）。 */
+   activeIdRef: React.MutableRefObject<string | null>;
+   /** 事件流的镜像 ref。 */
+   eventsRef: React.MutableRefObject<AgentEvent[]>;
+   /** 会话清单（编辑并重发要取原会话标题）。 */
+   sessions: { id: string; title?: string }[];
+   /** 当前工作区的镜像 ref（建新会话时归属用）。 */
+   activeWorkspaceRef: React.MutableRefObject<string | null>;
+   refreshSessions: () => Promise<void>;
+   openSession: (id: string, workspace?: string) => void;
+   /** 撤回前先停掉原会话的生成（走统一停止通道：陈旧旗自愈在里面）。
+    *  经 ref 晚绑（cancelRunHeal 在 workbench 里声明在本钩子之后——与 revealInspectorRef 同一解法）。 */
+   cancelRunHealRef: React.MutableRefObject<((sid: string) => void) | null>;
+   injectText: (text: string) => void;
+   setEditCtx: (v: { originId: string; originTitle: string; forkId: string; round: number } | null) => void;
+   setLastError: (message: string, sessionId?: string) => void;
+   setEvents: React.Dispatch<React.SetStateAction<AgentEvent[]>>;
+ }
+
+ export interface MessageActionsState {
+   /** 正在朗读的事件 id（按钮点亮态）。 */
+   speakingEventId: number | null;
+   setSpeakingEventId: (v: number | null) => void;
+   handleBranch: (round: number) => void;
+   compactNow: () => void;
+   goalAct: (req: { pause?: boolean; resume?: boolean; clear?: boolean }) => void;
+   handleEditUser: (round: number, text: string) => void;
+   handleRestoreSnapshot: (path: string, snapshotId: string) => void;
+   handleSpeak: (eventId: number, text: string) => void;
+ }
+
+ export function useMessageActions(deps: MessageActionsDeps): MessageActionsState {
+   const {
+     activeIdRef, eventsRef, sessions, activeWorkspaceRef,
+     refreshSessions, openSession, cancelRunHealRef, injectText, setEditCtx, setLastError, setEvents,
+   } = deps;
+
+   // ---- v7 消息操作条：分叉（forkSession 到该轮，P3-1 挪到 user 行）+ 朗读（macOS say）----
+   const [speakingEventId, setSpeakingEventId] = useState<number | null>(null);
+   const handleBranch = useCallback((round: number) => {
+     const sid = activeIdRef.current;
+     if (sid === null) return;
+     void window.agent.forkSession(sid, round, true).then((r) => {
+       if (r.ok !== true || r.id === undefined) { setLastError(`分叉失败：${r.error ?? "未知原因"}`, sid); return; }
+       void refreshSessions();
+       openSession(r.id); // 分叉 = 前 N 轮的全量拷贝；切过去并载入转录/队列（裸 activate 会留旧流）
+     }, (err: unknown) => {
+       setLastError(`分叉失败：${err instanceof Error ? err.message : String(err)}`, sid);
+     });
+   }, [refreshSessions, openSession, setLastError]);
+   /** 手动压缩（2026-10-18）：斜杠 /compact、上下文菜单、命令面板三处共用这一条——
+    *  必须带当前会话 id（旧协议不带，主进程会落到 lastLogPath，压错会话或报无日志）。 */
+   const compactNow = useCallback((): void => {
+     const sid = activeIdRef.current;
+     if (sid === null) { toast.error(STR.composer.compactNoSession); return; }
+     const compact = window.agent.compact;
+     if (compact === undefined) { toast.error(STR.composer.compactUnavailable); return; }
+     void compact(sid).then((r) => {
+       if (!r.ok) { setLastError(r.error ?? "压缩失败", sid); return; }
+       toast.success(STR.composer.compactDone);
+     }, (err: unknown) => {
+       setLastError(STR.composer.compactFail.replace("{reason}", err instanceof Error ? err.message : String(err)), sid);
+     });
+   }, [setLastError, toast]);
+   /** 目标动作（暂停/继续/清除）：只发 IPC；事件由主进程推回，芯片读同一份事件流自更新。 */
+   const goalAct = useCallback((req: { pause?: boolean; resume?: boolean; clear?: boolean }): void => {
+     const sid = activeIdRef.current;
+     if (sid === null) return;
+     void window.agent.setGoal({ sessionId: sid, ...req }).then((r) => {
+       if (!r.ok) setLastError(r.error ?? "目标操作失败", sid);
+     }, (err: unknown) => setLastError(err instanceof Error ? err.message : String(err), sid));
+   }, [setLastError]);
+   const handleEditUser = useCallback((round: number, text: string): void => {
+     const sid = activeIdRef.current;
+     if (sid === null) return;
+     // 撤回语义（2026-10-24 业主）：先把原会话正在跑的生成停下（暂停对话），再 fork 到该轮之前——
+     // 不停的话原会话继续吐 token，fork 出来的「撤回版」与它并行，看起来像没撤。
+     // 走 cancelRunHeal（收编纪律：陈旧旗自愈在那边；直呼 runCancel 会把 runningSet 留成脏状态）。
+     cancelRunHealRef.current?.(sid);
+     const originTitle = sessions.find((s) => s.id === sid)?.title ?? sid;
+     const inject = (id: string): void => {
+       refreshSessions();
+       openSession(id); // 必须载入新会话转录：第 1 轮编辑会建空会话，裸 activate 会把原会话历史留在屏上
+       injectText(text);
+       setEditCtx({ originId: sid, originTitle, forkId: id, round });
+     };
+     if (round <= 1) {
+       void window.agent.createSession(activeWorkspaceRef.current ?? undefined).then((r) => {
+         inject(r.id);
+       }, (err: unknown) => {
+         setLastError(`编辑失败：${err instanceof Error ? err.message : String(err)}`, sid);
+       });
+       return;
+     }
+     void window.agent.forkSession(sid, round - 1, true).then((r) => {
+       if (r.ok !== true || r.id === undefined) { setLastError(`编辑失败：${r.error ?? "未知原因"}`, sid); return; }
+       inject(r.id);
+     }, (err: unknown) => {
+       setLastError(`编辑失败：${err instanceof Error ? err.message : String(err)}`, sid);
+     });
+   }, [refreshSessions, openSession, injectText, setLastError, sessions, cancelRunHealRef]);
+   /** P3-2 检查器「撤销此文件改动」：snapshotRestore（v11 通道，渲染层首个消费者）。
+    *  成功 toast（STR 文案 v11 就位）；失败 fail-visible 原文上屏（不装成功）。
+    *  带上 sessionId：主进程还原成功后要往**这个会话**的事件流落一条 `file_restored`，
+    *  否则改动面（改动 Tab / 变更窗格 / Changes 徽标 / 交付卡的「改动已验证」）还当这个文件没撤。 */
+   const handleRestoreSnapshot = useCallback((path: string, snapshotId: string): void => {
+     const sid = activeIdRef.current;
+     void window.agent.snapshotRestore({
+       path, snapshotId,
+       ...(sid !== null ? { sessionId: sid } : {}),
+     }).then((r) => {
+       if (r.ok !== true) { toast.error(r.error ?? "还原失败"); return; }
+       toast.success(STR.toast.snapshotRestored.replace("{path}", path));
+       // 主进程直接 append 事件日志、不经 run 的事件推流：不本地补一条的话，改动面/徽标/
+       // 交付卡会一直停在“未还原”，直到切走再开（2026-10-20 真机：还原成功、文件已回退，
+       // 但 Inspector 仍显示撤销钮；重开会话才消失）。只补到发起还原的那个会话。
+       if (sid !== null && activeIdRef.current === sid) {
+         setEvents((prev) => [...prev, { type: "file_restored", path, snapshotId } as AgentEvent]);
+       }
+     }, (err: unknown) => {
+       toast.error(err instanceof Error ? err.message : String(err));
+     });
+   }, []);
+   const handleSpeak = useCallback((eventId: number, text: string) => {
+     if (speakingEventId === eventId) {
+       // 再点 = 停止（幂等）
+       setSpeakingEventId(null);
+       void window.agent.stopSpeaking();
+       return;
+     }
+     const clean = stripMarkdownForSpeech(text);
+     setSpeakingEventId(eventId); // 先点亮：say 是 fire-and-return，真实声音随后到
+     void window.agent.speakText(clean).then((r) => {
+       if (!r.ok) {
+         setSpeakingEventId(null); // fail-visible：出错熄灭按钮态，错误照常上屏
+         setLastError(`朗读失败：${r.error ?? "未知原因"}`);
+       }
+     }, (err: unknown) => {
+       setSpeakingEventId(null);
+       setLastError(`朗读失败：${err instanceof Error ? err.message : String(err)}`);
+     });
+   }, [speakingEventId, setLastError]);
+
+   return {
+     speakingEventId,
+     setSpeakingEventId,
+     handleBranch,
+     compactNow,
+     goalAct,
+     handleEditUser,
+     handleRestoreSnapshot,
+     handleSpeak,
+   };
+ }
+
+ /* 减弱动效偏好（2026-10-28 第 758 页 · 对标 Claude 的 `data-reduce-motion` 根属性）
+  *
+  * 一手依据：Claude Desktop 3.6556.2 的渲染层 CSS 里，减弱动效有**两个**入口：
+  *   ① 媒体查询 `@media (prefers-reduced-motion: reduce)`（系统级）；
+  *   ② **根属性** `[data-reduce-motion=true]`——应用自己也能强制降级，
+  *      规则形如 `.cds-root:where([data-reduce-motion=true],[data-reduce-motion=true] *)
+  *      [data-cds-shimmer-clone]) { display: none }`（扫光克隆层直接不画）。
+  *   ⇒ 应用级入口不是「媒体查询的重复」：它让**用户可以在应用里**关掉动效，
+  *      与系统设置无关。
+  *
+  * 本仓原状：只有全局媒体查询那条（styles.css 的 `* { animation-duration: .01ms !important }`）
+  * —— 系统开了就降级，但**应用里没有开关**，用户想在应用内减弱动效做不到。
+  *
+  * 本模块提供那个入口：
+  *   · `motionPref` = "system"（跟系统）/ "reduced"（应用内强制减弱）；
+  *   · 落位：`html[data-reduce-motion="true"]`（与主题同款：写根属性，不加 class）；
+  *   · 持久化：localStorage（键 `cairn.reduceMotion.v1`），与其它窗口级偏好同族。
+  *
+  * 为什么不用 props 串一层：这是**窗口级**偏好（与侧栏宽、界面密度同族），
+  * 落盘在 localStorage、由本模块单点读写；调用方（侧栏「外观」菜单）直接调 setter。
+  */
+
+ /** 偏好：跟系统 / 应用内强制减弱。 */
+ export type MotionPref = "system" | "reduced";
+
+ /** localStorage 键（窗口级偏好，与 `cairn.sidebar.width` 同族）。 */
+ export const MOTION_PREF_KEY = "cairn.reduceMotion.v1";
+
+ /** 决策（纯函数，判卷面）：偏好 + 系统是否要减弱 ⇒ 根属性写什么。 */
+ export function motionPrefOf(pref: MotionPref, systemReduced: boolean): boolean {
+   if (pref === "reduced") return true;
+   return systemReduced;
+ }
+
+ /** 根属性名（与主题的 `data-theme`/`data-mode` 同款：不加 class，只写属性）。 */
+ export const MOTION_ATTR = "data-reduce-motion";
+
+ /** 系统是否要减弱动效（纯读，判卷可注入）。 */
+ export function systemPrefersReducedMotion(): boolean {
+   try {
+     return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+   } catch {
+     return false;
+   }
+ }
+
+ /** 读偏好（缺省 = 跟系统）。 */
+ export function readMotionPref(): MotionPref {
+   try {
+     return window.localStorage.getItem(MOTION_PREF_KEY) === "reduced" ? "reduced" : "system";
+   } catch {
+     return "system";
+   }
+ }
+
+ /** 写根属性：开 ⇒ 写 `data-reduce-motion="true"`；关 ⇒ 摘掉属性（不写 "false"）。 */
+ export function applyMotionPref(reduced: boolean): void {
+   try {
+     if (reduced) document.documentElement.setAttribute(MOTION_ATTR, "true");
+     else document.documentElement.removeAttribute(MOTION_ATTR);
+   } catch { /* 属性写不上时降级为「只有媒体查询那条」 */ }
+ }
+
+ /** 设偏好并立刻落位；返回落位后的**实际**状态（系统也在减弱时，关掉应用开关仍是减弱）。 */
+ export function setMotionPref(pref: MotionPref): boolean {
+   try {
+     window.localStorage.setItem(MOTION_PREF_KEY, pref);
+   } catch { /* 存不下则本会话内生效 */ }
+   const reduced = motionPrefOf(pref, systemPrefersReducedMotion());
+   applyMotionPref(reduced);
+   return reduced;
+ }
+
+ /** 启动时落位：读偏好 + 系统事实 ⇒ 写根属性。系统那一侧的变化也跟着走。 */
+ export function bootMotionPref(): () => void {
+   const mq = (() => {
+     try {
+       return window.matchMedia("(prefers-reduced-motion: reduce)");
+     } catch {
+       return null;
+     }
+   })();
+   const apply = (): void => {
+     applyMotionPref(motionPrefOf(readMotionPref(), mq?.matches === true));
+   };
+   apply();
+   if (mq === null) return () => undefined;
+   const onChange = (): void => { apply(); };
+   mq.addEventListener("change", onChange);
+   return () => { mq.removeEventListener("change", onChange); };
+ }
+
+ import { useCallback, useEffect, useState } from "react";
+ import type { OnboardingGroup } from "../../../../../src/main/onboarding-groups";
+
+ /** 首启「设置检查」的数据面与完成出口。
+  *  标记（onboarded）由 settings 载入面持有；这里只在 false 时取七组，
+  *  并只提供一个完成出口：落 settings.onboarded=true（失败回滚）。 */
+ export function useOnboardingGroups(
+   onboarded: boolean | null,
+   setOnboarded: (value: boolean) => void,
+   setLastError: (message: string) => void,
+ ): { onboarding: readonly OnboardingGroup[]; dismissOnboarding: () => void } {
+   const [onboarding, setOnboarding] = useState<readonly OnboardingGroup[]>([]);
+
+   // 只在还没 onboarded 时取那七组；取不到 ⇒ 空数组 ⇒ 整块不渲染（不摆空壳）。
+   useEffect(() => {
+     if (onboarded !== false) return;
+     let alive = true;
+     void window.agent.getOnboarding().then(
+       (groups) => { if (alive) setOnboarding(groups); },
+       () => { if (alive) setOnboarding([]); },
+     );
+     return () => { alive = false; };
+   }, [onboarded]);
+
+   // 本地先隐藏，写 settings 失败则回滚并留错误；只隐藏不落盘 ⇒ 下次重开又回来。
+   const dismissOnboarding = useCallback(() => {
+     setOnboarded(true);
+     void window.agent.setSettings({ onboarded: true }).catch((err: unknown) => {
+       setOnboarded(false);
+       setLastError(`首启设置检查保存失败：${err instanceof Error ? err.message : String(err)}`);
+     });
+   }, [setOnboarded, setLastError]);
+
+   return { onboarding, dismissOnboarding };
+ }
+
+ // 置顶会话的手工顺序（2026-10-31，R3）：参考库 DraggableSessionList 的 pinnedOrder。
+ // 只排「置顶段」；时间桶仍按时间，跨工作区用 `workspace\0id` 作键（id 可跨项目撞名）。
+ // 持久化走 localStorage（单窗渲染层偏好），不改会话 metadata / IPC——顺序是视图偏好，不是会话事实。
+ export const PINNED_ORDER_KEY = "cairn.sidebar.pinnedOrder";
+
+ export type DropPosition = "before" | "after";
+
+ export interface OrderableSession {
+   id: string;
+   workspace: string;
+   pinned?: boolean;
+   archived?: boolean;
+ }
+
+ export function orderKeyOf(s: { id: string; workspace: string }): string {
+   return `${s.workspace}\u0000${s.id}`;
+ }
+
+ export function parsePinnedOrder(raw: string | null): string[] {
+   if (raw === null || raw === "") return [];
+   try {
+     const parsed: unknown = JSON.parse(raw);
+     if (!Array.isArray(parsed)) return [];
+     return [...new Set(parsed.filter((value): value is string => typeof value === "string" && value !== ""))];
+   } catch {
+     return [];
+   }
+ }
+
+ /** 置顶段按手工顺序排；不在顺序表里的置顶项保持原相对序、排在其后；非置顶项原样。 */
+ export function applyPinnedOrder<T extends OrderableSession>(list: readonly T[], order: readonly string[]): T[] {
+   if (order.length === 0) return [...list];
+   const rank = new Map(order.map((key, index) => [key, index]));
+   return [...list].sort((a, b) => {
+     if (a.pinned !== true || b.pinned !== true) return 0;
+     const ra = rank.get(orderKeyOf(a));
+     const rb = rank.get(orderKeyOf(b));
+     if (ra === undefined && rb === undefined) return 0;
+     if (ra === undefined) return 1;
+     if (rb === undefined) return -1;
+     return ra - rb;
+   });
+ }
+
+ /** 把 dragKey 移到 targetKey 的前/后；两者缺表时先补进表尾，再移动。 */
+ export function moveInOrder(
+   order: readonly string[],
+   dragKey: string,
+   targetKey: string,
+   position: DropPosition,
+ ): string[] {
+   if (dragKey === targetKey) return [...order];
+   const base = [...order];
+   for (const key of [dragKey, targetKey]) {
+     if (!base.includes(key)) base.push(key);
+   }
+   const next = base.filter((key) => key !== dragKey);
+   const at = next.indexOf(targetKey);
+   if (at === -1) return [...next, dragKey];
+   next.splice(position === "before" ? at : at + 1, 0, dragKey);
+   return next;
+ }
+
+ import {
+   useCallback,
+   useEffect,
+   useMemo,
+   useReducer,
+   useRef,
+ } from "react";
+ import type { PluginPanelSnapshot } from "../../../../../src/agent/plugins";
+ import type {
+   InstalledPluginRecord,
+   MarketplaceCatalogReadout,
+   PluginImportRequest,
+   PluginInstallJob,
+   PluginInstallReview,
+   PluginInstallScope,
+   PluginUpdateCheck,
+ } from "../../../../../src/main/ipc-protocol";
+ import {
+   filterPluginRows,
+   loadPluginFavorites,
+   mergePluginRows,
+   pluginUpdateCheckKey,
+   pluginUpdateRows,
+   savePluginFavorites,
+   type PluginCapabilityCategory,
+   type PluginFavoriteStorage,
+   type PluginRowView,
+   type PluginUpdateRow,
+   type PluginView,
+ } from "../derived/plugins";
+
+ export type PluginDataStatus = "idle" | "loading" | "ready" | "error";
+ export type PluginLoadSurface = "catalog" | "installed" | "runtime";
+ export type PluginJobKind = "install" | "import" | "update";
+
+ export interface ScopedPluginReview {
+   readonly review: PluginInstallReview;
+   readonly jobId: string;
+   readonly kind: PluginJobKind;
+   readonly workspace: string | null;
+   readonly instanceId: string;
+ }
+
+ export interface PluginsMarketplaceSnapshot {
+   readonly workspace: string | null;
+   readonly generation: number;
+   readonly catalogGeneration: number;
+   readonly installedGeneration: number;
+   readonly runtimeGeneration: number;
+   readonly catalog: MarketplaceCatalogReadout;
+   readonly catalogStatus: PluginDataStatus;
+   readonly catalogError: string | null;
+   readonly installed: readonly InstalledPluginRecord[];
+   readonly installedStatus: PluginDataStatus;
+   readonly installedError: string | null;
+   readonly runtime: PluginPanelSnapshot | null;
+   readonly runtimeStatus: PluginDataStatus;
+   readonly runtimeError: string | null;
+   readonly review: ScopedPluginReview | null;
+   readonly activeJob: PluginInstallJob | null;
+   readonly activeJobKind: PluginJobKind | null;
+   readonly updateChecks: Readonly<Record<string, PluginUpdateCheck>>;
+   readonly favorites: ReadonlySet<string>;
+   readonly notice: string | null;
+   readonly view: PluginView;
+   readonly query: string;
+   readonly category: PluginCapabilityCategory | "all";
+   readonly favoriteOnly: boolean;
+   readonly selectedId: string | null;
+   readonly scrollTop: number;
+ }
+
+ export type PluginsMarketplaceAction =
+   | { type: "start"; surface: PluginLoadSurface; generation: number }
+   | { type: "catalog"; generation: number; value: MarketplaceCatalogReadout }
+   | { type: "installed"; generation: number; value: readonly InstalledPluginRecord[] }
+   | { type: "runtime"; generation: number; value: PluginPanelSnapshot | null }
+   | { type: "reject"; surface: PluginLoadSurface; generation: number; message: string }
+   | { type: "workspace"; workspace: string | null }
+   | {
+       type: "review";
+       review: PluginInstallReview;
+       jobId: string;
+       workspace: string | null;
+       kind?: PluginJobKind;
+       instanceId?: string;
+     }
+   | { type: "reviewClose"; notice?: string | null }
+   | { type: "jobStart"; job: PluginInstallJob; kind: PluginJobKind }
+   | { type: "job"; job: PluginInstallJob }
+   | { type: "jobClear" }
+   | { type: "updateCheck"; key: string; check: PluginUpdateCheck }
+   | { type: "updateChecksClear" }
+   | { type: "favorites"; ids: ReadonlySet<string> }
+   | { type: "notice"; message: string | null }
+   | { type: "view"; view: PluginView }
+   | { type: "query"; query: string }
+   | { type: "category"; category: PluginCapabilityCategory | "all" }
+   | { type: "favoriteOnly"; value: boolean }
+   | { type: "selection"; id: string | null }
+   | { type: "scroll"; top: number };
+
+ const EMPTY_CATALOG: MarketplaceCatalogReadout = {
+   status: "unavailable",
+   origin: "none",
+   catalog: null,
+   fetchedAt: null,
+   expiresAt: null,
+   stale: false,
+ };
+
+ function generationOf(surface: PluginLoadSurface, state: PluginsMarketplaceSnapshot): number {
+   if (surface === "catalog") return state.catalogGeneration;
+   if (surface === "installed") return state.installedGeneration;
+   return state.runtimeGeneration;
+ }
+
+ function withGeneration(
+   state: PluginsMarketplaceSnapshot,
+   action:
+     | Extract<PluginsMarketplaceAction, { type: "start" }>
+     | Extract<PluginsMarketplaceAction, { type: "catalog" }>
+     | Extract<PluginsMarketplaceAction, { type: "installed" }>
+     | Extract<PluginsMarketplaceAction, { type: "runtime" }>
+     | Extract<PluginsMarketplaceAction, { type: "reject" }>,
+ ): PluginsMarketplaceSnapshot {
+   if (action.type === "catalog") {
+     if (action.generation < state.catalogGeneration) return state;
+     return {
+       ...state,
+       generation: Math.max(state.generation, action.generation),
+       catalogGeneration: action.generation,
+       catalogStatus: "ready",
+       catalogError: null,
+       catalog: action.value,
+     };
+   }
+   if (action.type === "installed") {
+     if (action.generation < state.installedGeneration) return state;
+     return {
+       ...state,
+       generation: Math.max(state.generation, action.generation),
+       installedGeneration: action.generation,
+       installedStatus: "ready",
+       installedError: null,
+       installed: action.value,
+       updateChecks: {},
+     };
+   }
+   if (action.type === "runtime") {
+     if (action.generation < state.runtimeGeneration) return state;
+     return {
+       ...state,
+       generation: Math.max(state.generation, action.generation),
+       runtimeGeneration: action.generation,
+       runtimeStatus: "ready",
+       runtimeError: null,
+       runtime: action.value,
+     };
+   }
+   if (action.generation < generationOf(action.surface, state)) return state;
+   const common = {
+     ...state,
+     generation: Math.max(state.generation, action.generation),
+   };
+   if (action.surface === "catalog") {
+     return action.type === "start"
+       ? { ...common, catalogGeneration: action.generation, catalogStatus: "loading", catalogError: null }
+       : { ...common, catalogGeneration: action.generation, catalogStatus: "error", catalogError: action.message };
+   }
+   if (action.surface === "installed") {
+     return action.type === "start"
+       ? { ...common, installedGeneration: action.generation, installedStatus: "loading", installedError: null }
+       : { ...common, installedGeneration: action.generation, installedStatus: "error", installedError: action.message };
+   }
+   return action.type === "start"
+     ? { ...common, runtimeGeneration: action.generation, runtimeStatus: "loading", runtimeError: null }
+     : { ...common, runtimeGeneration: action.generation, runtimeStatus: "error", runtimeError: action.message };
+ }
+
+ export function createPluginsMarketplaceSnapshot(input: {
+   workspace?: string | null;
+   favorites?: ReadonlySet<string>;
+ } = {}): PluginsMarketplaceSnapshot {
+   return {
+     workspace: input.workspace ?? null,
+     generation: 0,
+     catalogGeneration: 0,
+     installedGeneration: 0,
+     runtimeGeneration: 0,
+     catalog: EMPTY_CATALOG,
+     catalogStatus: "loading",
+     catalogError: null,
+     installed: [],
+     installedStatus: "loading",
+     installedError: null,
+     runtime: null,
+     runtimeStatus: "loading",
+     runtimeError: null,
+     review: null,
+     activeJob: null,
+     activeJobKind: null,
+     updateChecks: {},
+     favorites: input.favorites ?? new Set(),
+     notice: null,
+     view: "discover",
+     query: "",
+     category: "all",
+     favoriteOnly: false,
+     selectedId: null,
+     scrollTop: 0,
+   };
+ }
+
+ export function pluginsMarketplaceReducer(
+   state: PluginsMarketplaceSnapshot,
+   action: PluginsMarketplaceAction,
+ ): PluginsMarketplaceSnapshot {
+   if (action.type === "start" || action.type === "catalog" || action.type === "installed"
+     || action.type === "runtime" || action.type === "reject") {
+     return withGeneration(state, action);
+   }
+   if (action.type === "workspace") {
+     if (action.workspace === state.workspace) return state;
+     return {
+       ...state,
+       workspace: action.workspace,
+       installed: [],
+       installedStatus: "loading",
+       installedError: null,
+       runtime: null,
+       runtimeStatus: "loading",
+       runtimeError: null,
+       review: null,
+       activeJob: null,
+       activeJobKind: null,
+       updateChecks: {},
+       selectedId: null,
+       scrollTop: 0,
+       notice: state.review === null
+         ? "工作区已切换，插件列表已刷新"
+         : "工作区已切换，未提交的插件审查已关闭",
+     };
+   }
+   if (action.type === "review") {
+     if (action.workspace !== state.workspace) {
+       return {
+         ...state,
+         review: null,
+         notice: "工作区已变化，插件审查已关闭",
+       };
+     }
+     const instanceId = action.instanceId ?? action.jobId;
+     if (state.review !== null && state.review.instanceId !== instanceId) return state;
+     return {
+       ...state,
+       notice: null,
+       review: {
+         review: action.review,
+         jobId: action.jobId,
+         kind: action.kind ?? "install",
+         workspace: action.workspace,
+         instanceId,
+       },
+     };
+   }
+   if (action.type === "reviewClose") {
+     return {
+       ...state,
+       review: null,
+       ...(action.notice === undefined ? {} : { notice: action.notice }),
+     };
+   }
+   if (action.type === "jobStart") {
+     return {
+       ...state,
+       activeJob: action.job,
+       activeJobKind: action.kind,
+       review: null,
+       notice: null,
+     };
+   }
+   if (action.type === "job") {
+     if (state.activeJob !== null && state.activeJob.id !== action.job.id) return state;
+     return {
+       ...state,
+       activeJob: action.job,
+       review: action.job.state === "succeeded" || action.job.state === "cancelled"
+         ? null
+         : state.review,
+     };
+   }
+   if (action.type === "jobClear") {
+     return {
+       ...state,
+       activeJob: null,
+       activeJobKind: null,
+       review: null,
+     };
+   }
+   if (action.type === "updateCheck") {
+     return {
+       ...state,
+       updateChecks: { ...state.updateChecks, [action.key]: action.check },
+     };
+   }
+   if (action.type === "updateChecksClear") return { ...state, updateChecks: {} };
+   if (action.type === "favorites") return { ...state, favorites: action.ids };
+   if (action.type === "notice") return { ...state, notice: action.message };
+   if (action.type === "view") return { ...state, view: action.view };
+   if (action.type === "query") return { ...state, query: action.query };
+   if (action.type === "category") return { ...state, category: action.category };
+   if (action.type === "favoriteOnly") return { ...state, favoriteOnly: action.value };
+   if (action.type === "selection") return { ...state, selectedId: action.id };
+   return { ...state, scrollTop: Math.max(0, action.top) };
+ }
+
+ export function pluginJobNeedsPolling(job: PluginInstallJob): boolean {
+   return job.state === "queued"
+     || job.state === "resolving"
+     || job.state === "verifying"
+     || job.state === "installing";
+ }
+
+ function browserFavorites(): PluginFavoriteStorage {
+   if (typeof window === "undefined") {
+     return { getItem: () => null, setItem: () => undefined };
+   }
+   return window.localStorage;
+ }
+
+ function errorText(error: unknown): string {
+   return error instanceof Error ? error.message : String(error);
+ }
+
+ function wait(ms: number): Promise<void> {
+   return new Promise((resolve) => { setTimeout(resolve, ms); });
+ }
+
+ export interface PluginsMarketplaceState extends PluginsMarketplaceSnapshot {
+   readonly rows: readonly PluginRowView[];
+   readonly updates: readonly PluginUpdateRow[];
+   readonly visibleRows: readonly PluginRowView[];
+   refresh(): void;
+   installPlugin(entryId: string, scope: PluginInstallScope): Promise<void>;
+   importPlugin(request: PluginImportRequest, scope: PluginInstallScope): Promise<void>;
+   checkPluginUpdate(row: PluginRowView): Promise<void>;
+   updatePlugin(row: PluginRowView): Promise<void>;
+   setPluginEnabled(row: PluginRowView, enabled: boolean): Promise<void>;
+   uninstallPlugin(row: PluginRowView): Promise<void>;
+   configurePlugin(row: PluginRowView, values: Record<string, string>): Promise<void>;
+   toggleFavorite(id: string): void;
+   commitReview(): Promise<void>;
+   closeReview(): void;
+   reopenReview(): void;
+   cancelReview(): Promise<void>;
+   dismissNotice(): void;
+   setView(view: PluginView): void;
+   setQuery(query: string): void;
+   setCategory(category: PluginCapabilityCategory | "all"): void;
+   setFavoriteOnly(value: boolean): void;
+   select(id: string | null): void;
+   setScrollTop(top: number): void;
+ }
+
+ export function usePluginsMarketplace(input: {
+   workspace: string | null;
+   onError(message: string): void;
+ }): PluginsMarketplaceState {
+   const storage = useRef<PluginFavoriteStorage | null>(null);
+   if (storage.current === null) storage.current = browserFavorites();
+   const initialFavorites = useRef<ReadonlySet<string> | null>(null);
+   if (initialFavorites.current === null) {
+     initialFavorites.current = loadPluginFavorites(storage.current);
+   }
+   const [state, dispatch] = useReducer(
+     pluginsMarketplaceReducer,
+     undefined,
+     () => createPluginsMarketplaceSnapshot({
+       workspace: input.workspace,
+       favorites: initialFavorites.current as ReadonlySet<string>,
+     }),
+   );
+   const stateRef = useRef(state);
+   stateRef.current = state;
+   const errorHandler = useRef(input.onError);
+   errorHandler.current = input.onError;
+   const workspaceRef = useRef(input.workspace);
+   const generations = useRef({ catalog: 0, installed: 0, runtime: 0 });
+   const jobPoll = useRef(0);
+
+   const report = useCallback((message: string): void => {
+     dispatch({ type: "notice", message });
+     errorHandler.current(message);
+   }, []);
+
+   const loadCatalog = useCallback((): void => {
+     const generation = ++generations.current.catalog;
+     dispatch({ type: "start", surface: "catalog", generation });
+     void window.agent.marketplaceCatalog("auto").then((value) => {
+       dispatch({ type: "catalog", generation, value });
+     }).catch((error: unknown) => {
+       dispatch({ type: "reject", surface: "catalog", generation, message: errorText(error) });
+     });
+   }, []);
+
+   const loadInstalled = useCallback((): void => {
+     const generation = ++generations.current.installed;
+     dispatch({ type: "start", surface: "installed", generation });
+     void window.agent.pluginsInstalled().then((value) => {
+       dispatch({ type: "installed", generation, value });
+     }).catch((error: unknown) => {
+       dispatch({ type: "reject", surface: "installed", generation, message: errorText(error) });
+     });
+   }, []);
+
+   const loadRuntime = useCallback((): void => {
+     const generation = ++generations.current.runtime;
+     dispatch({ type: "start", surface: "runtime", generation });
+     void window.agent.getState().then((snapshot) => {
+       dispatch({ type: "runtime", generation, value: snapshot.plugins ?? null });
+     }).catch((error: unknown) => {
+       dispatch({ type: "reject", surface: "runtime", generation, message: errorText(error) });
+     });
+   }, []);
+
+   const refresh = useCallback((): void => {
+     loadCatalog();
+     loadInstalled();
+     loadRuntime();
+   }, [loadCatalog, loadInstalled, loadRuntime]);
+
+   const pollJob = useCallback(async (
+     jobId: string,
+     run: number,
+     kind: PluginJobKind,
+     workspace: string | null,
+   ): Promise<void> => {
+     while (run === jobPoll.current) {
+       const current = await window.agent.marketplacePluginInstallStatus(jobId).catch((error: unknown) => {
+         if (run === jobPoll.current) report(`插件任务状态读取失败：${errorText(error)}`);
+         return null;
+       });
+       if (run !== jobPoll.current) return;
+       if (current === null) {
+         report("插件任务已不存在");
+         return;
+       }
+       dispatch({ type: "job", job: current });
+       if (current.state === "review" && current.review !== undefined) {
+         dispatch({
+           type: "review",
+           review: current.review,
+           jobId: current.id,
+           workspace,
+           kind,
+           instanceId: `${current.id}:${String(run)}`,
+         });
+         return;
+       }
+       if (!pluginJobNeedsPolling(current)) return;
+       await wait(300);
+     }
+   }, [report]);
+
+   const beginJob = useCallback(async (
+     pending: Promise<PluginInstallJob>,
+     kind: PluginJobKind,
+   ): Promise<void> => {
+     const workspace = stateRef.current.workspace;
+     try {
+       const job = await pending;
+       const run = ++jobPoll.current;
+       dispatch({ type: "jobStart", job, kind });
+       await pollJob(job.id, run, kind, workspace);
+     } catch (error) {
+       report(`插件任务启动失败：${errorText(error)}`);
+     }
+   }, [pollJob, report]);
+
+   useEffect(() => {
+     const previous = workspaceRef.current;
+     const previousState = stateRef.current;
+     const scopedReview = previousState.review;
+     const activeJob = previousState.activeJob;
+     if (previous !== input.workspace) {
+       jobPoll.current += 1;
+       dispatch({ type: "workspace", workspace: input.workspace });
+       const cancelId = scopedReview?.jobId
+         ?? (activeJob?.scope === "project" && activeJob.workspace !== input.workspace ? activeJob.id : null);
+       if (cancelId !== null) {
+         void window.agent.marketplacePluginInstallCancel(cancelId).catch((error: unknown) => {
+           report(`旧工作区插件任务取消失败：${errorText(error)}`);
+         });
+       }
+       workspaceRef.current = input.workspace;
+     }
+     refresh();
+   }, [input.workspace, refresh, report]);
+
+   const rows = useMemo(
+     () => mergePluginRows(state.catalog, state.installed, state.runtime, state.favorites),
+     [state.catalog, state.favorites, state.installed, state.runtime],
+   );
+   const updates = useMemo(
+     () => pluginUpdateRows(rows, state.updateChecks),
+     [rows, state.updateChecks],
+   );
+   const visibleRows = useMemo(() => {
+     const filtered = filterPluginRows(rows, state.query, state.category);
+     return state.favoriteOnly ? filtered.filter((row) => row.favorite) : filtered;
+   }, [rows, state.category, state.favoriteOnly, state.query]);
+
+   const toggleFavorite = useCallback((id: string): void => {
+     const next = new Set(stateRef.current.favorites);
+     if (next.has(id)) next.delete(id);
+     else next.add(id);
+     dispatch({ type: "favorites", ids: next });
+     savePluginFavorites(storage.current as PluginFavoriteStorage, next);
+   }, []);
+
+   const installPlugin = useCallback(async (
+     entryId: string,
+     scope: PluginInstallScope,
+   ): Promise<void> => {
+     const workspace = scope === "project" ? stateRef.current.workspace ?? undefined : undefined;
+     await beginJob(window.agent.marketplacePluginInstall(entryId, scope, workspace), "install");
+   }, [beginJob]);
+
+   const importPlugin = useCallback(async (
+     request: PluginImportRequest,
+     scope: PluginInstallScope,
+   ): Promise<void> => {
+     const workspace = scope === "project" ? stateRef.current.workspace ?? undefined : undefined;
+     await beginJob(window.agent.marketplacePluginImport(request, scope, workspace), "import");
+   }, [beginJob]);
+
+   const checkPluginUpdate = useCallback(async (row: PluginRowView): Promise<void> => {
+     const installed = row.installed;
+     if (installed === null) return;
+     const key = pluginUpdateCheckKey(installed.source);
+     dispatch({
+       type: "updateCheck",
+       key,
+       check: {
+         status: "checking",
+         currentVersion: installed.version,
+         nextVersion: null,
+         sourceKind: installed.source.kind,
+       },
+     });
+     try {
+       const check = await window.agent.marketplacePluginCheckUpdate(
+         installed.entryId,
+         installed.scope,
+         installed.scope === "project" ? installed.workspace ?? stateRef.current.workspace ?? undefined : undefined,
+       );
+       dispatch({ type: "updateCheck", key, check });
+     } catch (error) {
+       dispatch({
+         type: "updateCheck",
+         key,
+         check: {
+           status: "failed",
+           currentVersion: installed.version,
+           nextVersion: null,
+           sourceKind: installed.source.kind,
+           detail: errorText(error),
+         },
+       });
+     }
+   }, []);
+
+   const updatePlugin = useCallback(async (row: PluginRowView): Promise<void> => {
+     const installed = row.installed;
+     if (installed === null) return;
+     await beginJob(
+       window.agent.marketplacePluginUpdate(
+         installed.entryId,
+         installed.scope,
+         installed.scope === "project" ? installed.workspace ?? stateRef.current.workspace ?? undefined : undefined,
+       ),
+       "update",
+     );
+   }, [beginJob]);
+
+   const setPluginEnabled = useCallback(async (
+     row: PluginRowView,
+     enabled: boolean,
+   ): Promise<void> => {
+     const installed = row.installed;
+     if (installed === null) return;
+     try {
+       const result = await window.agent.pluginSetEnabled(
+         installed.entryId,
+         installed.scope,
+         enabled,
+         installed.scope === "project" ? installed.workspace ?? stateRef.current.workspace ?? undefined : undefined,
+       );
+       if (!result.ok) {
+         report(result.error ?? "插件状态切换失败");
+         return;
+       }
+       dispatch({ type: "notice", message: enabled ? "插件已启用，将在下一轮生效" : "插件已停用，将在下一轮生效" });
+       loadInstalled();
+     } catch (error) {
+       report(`插件状态切换失败：${errorText(error)}`);
+     }
+   }, [loadInstalled, report]);
+
+   const uninstallPlugin = useCallback(async (row: PluginRowView): Promise<void> => {
+     const installed = row.installed;
+     if (installed === null) return;
+     try {
+       const result = await window.agent.pluginUninstall(
+         installed.entryId,
+         installed.scope,
+         installed.scope === "project" ? installed.workspace ?? stateRef.current.workspace ?? undefined : undefined,
+       );
+       if (!result.ok) {
+         report(result.error ?? "插件卸载失败");
+         return;
+       }
+       dispatch({ type: "notice", message: "插件已卸载" });
+       dispatch({ type: "selection", id: null });
+       loadInstalled();
+       loadRuntime();
+     } catch (error) {
+       report(`插件卸载失败：${errorText(error)}`);
+     }
+   }, [loadInstalled, loadRuntime, report]);
+
+   const configurePlugin = useCallback(async (
+     row: PluginRowView,
+     values: Record<string, string>,
+   ): Promise<void> => {
+     const installed = row.installed;
+     if (installed === null) return;
+     try {
+       const result = await window.agent.pluginConfigureInstalled({
+         entryId: installed.entryId,
+         scope: installed.scope,
+         ...(installed.scope === "project"
+           ? { workspace: installed.workspace ?? stateRef.current.workspace ?? undefined }
+           : {}),
+         values,
+       });
+       if (!result.ok) {
+         report(result.error ?? "插件配置保存失败");
+         return;
+       }
+       dispatch({ type: "notice", message: "插件配置已保存" });
+     } catch (error) {
+       report(`插件配置保存失败：${errorText(error)}`);
+     }
+   }, [report]);
+
+   const commitReview = useCallback(async (): Promise<void> => {
+     const scoped = stateRef.current.review;
+     if (scoped === null) return;
+     try {
+       const result = await window.agent.marketplacePluginInstallCommit(scoped.jobId);
+       if (!result.ok) {
+         report(result.error ?? "插件提交失败");
+         return;
+       }
+       const current = await window.agent.marketplacePluginInstallStatus(scoped.jobId);
+       if (current !== null) dispatch({ type: "job", job: current });
+       dispatch({ type: "reviewClose", notice: scoped.kind === "update" ? "插件已更新，请确认后启用" : "插件已安装，请确认后启用" });
+       loadInstalled();
+       loadRuntime();
+     } catch (error) {
+       report(`插件提交失败：${errorText(error)}`);
+     }
+   }, [loadInstalled, loadRuntime, report]);
+
+   const cancelReview = useCallback(async (): Promise<void> => {
+     const scoped = stateRef.current.review;
+     if (scoped === null) return;
+     try {
+       const result = await window.agent.marketplacePluginInstallCancel(scoped.jobId);
+       if (!result.ok) {
+         report(result.error ?? "插件审查取消失败");
+         return;
+       }
+       dispatch({ type: "jobClear" });
+       dispatch({ type: "notice", message: "插件审查已取消" });
+     } catch (error) {
+       report(`插件审查取消失败：${errorText(error)}`);
+     }
+   }, [report]);
+
+   const closeReview = useCallback((): void => {
+     if (stateRef.current.review === null) return;
+     dispatch({ type: "reviewClose", notice: "插件审查已收起，可继续审查" });
+   }, []);
+
+   const reopenReview = useCallback((): void => {
+     const { activeJob, activeJobKind, workspace } = stateRef.current;
+     if (activeJob?.state !== "review" || activeJob.review === undefined || activeJobKind === null) return;
+     dispatch({
+       type: "review",
+       review: activeJob.review,
+       jobId: activeJob.id,
+       workspace,
+       kind: activeJobKind,
