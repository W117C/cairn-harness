+ // 浮层互斥（2026-10-28 · 第 752 页）：输入卡这一行的几个浮层**共用一个开合槽**。
+ //
+ // 为什么要有这一层：桌面端的浮层此前各自持有 open 态——Composer 有 `menu` 槽
+ // （attach/perm/meter），`ModelPicker` 有自己的 `open`。两处真相 ⇒ 用户在模型菜单开着时
+ // 点用量环，两个浮层**同屏叠放**（真机复现：几何真的重叠，用量浮层盖住模型菜单右半，
+ // 命中测试落在用量浮层上）。规格里没有「同一个角上两个浮层叠着」这种形状。
+ //
+ // 口径：**一个槽一次只装一个层**。开一个 ⇒ 别的让路；再点同一个 ⇒ 关。
+ //
+ // 逐对实测的几何（1440×900，真实 renderer，展开后的实际矩形）：
+ //   · 模型菜单 `left 668, top 397, 300×408`
+ //   · 用量浮层 `left 919, top 496, 258×309`   → 与模型菜单**重叠**
+ //   · 附件菜单 `left 481, top 617, 270×188`   → 与模型菜单**重叠**；与用量浮层不重叠
+ //
+ // 由此得到的**诚实口径**：模型菜单与另两个的重叠是**缺陷本体**（本页修它）；
+ // 而「用量浮层 ↔ 附件菜单」这一对几何上并不重叠——它们仍共用一个槽，是**沿用既有行为**
+ // 的保守选择，不是几何必需。留着这条注记，是为了让下一位知道「这对为什么也没放开」
+ // （要放开得把槽从一层升成一组，是另一笔改动，不在��页范围）。
+ //
+ // 纯函数、无 IO、无时钟 ⇒ 可判卷。
+ //
+ // 注意：这是**渲染层内部**的互斥，与「模态隔离」（`ModalSurface` 的 inert 背景隔离）
+ // 是两件事：模态隔离管「模态 vs 背景」，这里管「浮层 vs 浮层」。
+
+ /** 渲染层已知的浮层层名。 */
+ export type OverlayLayer = "none" | "model" | "meter" | "attach" | "perm";
+
+ /** 浮层的锚点带（读面用：说明每个层出现在输入卡的哪一带）。 */
+ export type OverlayBand = "composer-right" | "composer-left" | "toolbar" | "pane";
+
+ /** 每个层归哪个带。 */
+ const LAYER_BAND: Readonly<Record<Exclude<OverlayLayer, "none">, OverlayBand>> = {
+   model: "composer-right",
+   meter: "composer-right",
+   attach: "composer-left",
+   perm: "composer-left",
+ };
+
+ /** 某带里的全部层（读面用：让"这一带有哪些"只有一个来源）。 */
+ export function overlayLayersAt(band: OverlayBand): readonly Exclude<OverlayLayer, "none">[] {
+   return (Object.keys(LAYER_BAND) as Exclude<OverlayLayer, "none">[])
+     .filter((layer) => LAYER_BAND[layer] === band);
+ }
+
+ /**
+  * 两个层是否互斥。
+  *
+  * 一个槽一次只装一个 ⇒ **任何两个不同的层都互斥**（同层不算：那不是"两个层"）。
+  * 几何上「用量浮层 ↔ 附件菜单」其实不重叠（见上），它们互斥是沿用既有槽行为的保守选择。
+  */
+ export function exclusiveAt(_band: OverlayBand, layer: Exclude<OverlayLayer, "none">): boolean {
+   // 「本层与别的层互斥」= 除自己外还有别的层可开。
+   return overlayLayersAt(LAYER_BAND[layer]).length > 1 || Object.keys(LAYER_BAND).length > 1;
+ }
+
+ /** 这一对是否互斥（对称口径）。 */
+ export function layersExclusive(
+   a: Exclude<OverlayLayer, "none">,
+   b: Exclude<OverlayLayer, "none">,
+ ): boolean {
+   return a !== b;
+ }
+
+ /**
+  * 开某一层时，其它层要让路（返回新槽值）。
+  * 换层 ⇒ 返回新层；同层（再点一次）⇒ 关掉（`none`）。
+  */
+ export function nextOverlay(current: OverlayLayer, target: Exclude<OverlayLayer, "none">): OverlayLayer {
+   if (current === target) return "none";
+   return target;
+ }
+
+ // 窗格行高记忆（批 98）：react-resizable-panels 的 Grid 布局以**轨道 id**为键。
+ // 行轨 id 取窗格 kind（不是行下标）——重排/关开后尺寸跟着窗格走，不会串到邻居；
+ // 关闭的窗格把尺寸留在存储里，重开即回原位（而不是回到均分）。
+ export const PANE_ROWS_KEY = "cairn.paneRows.v1";
+ /** 每格的保底高度（百分比）。Grid 的 minSize 同用这一枚，免得两处各写一个数。 */
+ export const MIN_PANE_PCT = 10;
+
+ export type PaneRowMap = Record<string, number>;
+
+ function isRecord(value: unknown): value is Record<string, unknown> {
+   return typeof value === "object" && value !== null && !Array.isArray(value);
+ }
+
+ /** 存储串 → 行高表；坏 JSON / 非数 / 非正 / 非有限一律丢（不编默认值）。 */
+ export function decodePaneRows(raw: string | null): PaneRowMap {
+   let parsed: unknown;
+   try {
+     parsed = JSON.parse(raw ?? "null");
+   } catch {
+     return {};
+   }
+   if (!isRecord(parsed)) return {};
+   const out: PaneRowMap = {};
+   for (const [kind, value] of Object.entries(parsed)) {
+     if (typeof value !== "number" || !Number.isFinite(value) || value <= 0) continue;
+     out[kind] = Math.min(100, value);
+   }
+   return out;
+ }
+
+ /**
+  * 当前窗格集 → 完整行高表（键 = kind，和 = 100）。
+  * 规则：已知尺寸照旧；新窗格先按保底 10% 计，总和超出时从所有格「保底以上的部分」等比扣
+  * （保存的比例不丢，新格恰好落在保底）；总和不足 100 时等比放大。返回表覆盖每个 present kind。
+  */
+ export function paneRowLayout(tabs: readonly string[], saved: PaneRowMap, min = MIN_PANE_PCT): Record<string, number> {
+   const present = [...new Set(tabs)];
+   const n = present.length;
+   if (n === 0) return {};
+   const floor = Math.min(min, 100 / n);
+   const base = present.map((kind) => Math.max(floor, saved[kind] ?? floor));
+   const sum = base.reduce((acc, v) => acc + v, 0);
+   let values = base;
+   if (sum > 100) {
+     const room = sum - n * floor;
+     const excess = sum - 100;
+     values = excess >= room
+       ? present.map(() => 100 / n)
+       : base.map((v) => floor + (v - floor) * ((room - excess) / room));
+   } else if (sum < 100) {
+     values = base.map((v) => (v * 100) / sum);
+   }
+   const out: Record<string, number> = {};
+   present.forEach((kind, i) => { out[kind] = values[i] ?? 100 / n; });
+   return out;
+ }
+
+ /** 用户拖动后落盘：当前窗格取新值，旧表里**没开着**的窗格原样留着（关了也记得）。 */
+ export function mergePaneRows(previous: PaneRowMap, rows: Record<string, number>, tabs: readonly string[]): PaneRowMap {
+   const out: PaneRowMap = { ...previous };
+   for (const kind of new Set(tabs)) {
+     const value = rows[kind];
+     if (typeof value !== "number" || !Number.isFinite(value) || value <= 0) continue;
+     out[kind] = value;
+   }
+   return out;
+ }
+
+ /** localStorage 读取（SSR 与存储异常都回空表；窗格布局不是致命状态，不弹错）。 */
+ export function loadPaneRows(): PaneRowMap {
+   if (typeof window === "undefined") return {};
+   try {
+     return decodePaneRows(window.localStorage.getItem(PANE_ROWS_KEY));
+   } catch {
+     return {};
+   }
+ }
+
+ export function savePaneRows(rows: PaneRowMap): void {
+   if (typeof window === "undefined") return;
+   try {
+     window.localStorage.setItem(PANE_ROWS_KEY, JSON.stringify(rows));
+   } catch {
+     /* 存不下则本会话内生效（调用方已经拿到新布局） */
+   }
+ }
+
+ // 窗格登记表（Phase 2 · 批 2.3 配套搬移）。
+ //
+ // 为什么从 components/panes.ts 搬出来：**state/** 不许 import components/**（分层契约 I2），
+ // 而「窗格是哪几种、叫什么、怎么重排」是**数据与纯函数**，不是组件——它住在 components/ 只是
+ // 历史偶然。搬到这里之后：state 层拿窗格类型/登记表不用越过组件层，组件层照旧从
+ // components/panes.ts 转出（导出面一字未改，调用点零改动）。
+ export type PaneKind = "changes" | "plan" | "tasks" | "file" | "terminal" | "browser" | "sidechat" | "plugins" | "session";
+
+ export const PANE_META: Record<PaneKind, { label: string }> = {
+   changes: { label: "变更" },
+   plan: { label: "方案" },
+   tasks: { label: "任务" },
+   file: { label: "文件" },
+   terminal: { label: "终端" },
+   browser: { label: "浏览器" },
+   sidechat: { label: "旁路" },
+   plugins: { label: "插件" },
+   session: { label: "会话预览" },
+ };
+
+ /** 顶栏 ⋮ 菜单的列表面（App 消费；保持与 PaneKind 同集）。 */
+ export const PANE_OPENABLE: readonly PaneKind[] = ["changes", "plan", "tasks", "file", "terminal", "browser", "sidechat", "plugins"];
+
+ /** 窗格重排（拖标题栏换位，蓝本 §3.4）：把 from 位的元素移动到 to 位，其余相对次序不变。
+  *  越界/同位原样返回（不抛、不吞——与 send-queue 的越界口径一致）。 */
+ export function movePane<T>(items: readonly T[], from: number, to: number): T[] {
+   if (from === to || from < 0 || to < 0 || from >= items.length || to >= items.length) return [...items];
+   const next = [...items];
+   const [moved] = next.splice(from, 1);
+   next.splice(to, 0, moved!);
+   return next;
+ }
+
+ /** 窗格标签的键盘落点（⌥↑/↓ 排序另算）：←/→ 循环、Home/End 到首尾；其余键 null。
+  *  与检查器 Tab 同一套口径，但窗格标签是 button + aria-pressed（不是 tablist）。 */
+ export function paneTabTargetForKey(key: string, index: number, count: number): number | null {
+   if (count <= 0 || index < 0 || index >= count) return null;
+   if (key === "ArrowRight") return (index + 1) % count;
+   if (key === "ArrowLeft") return (index - 1 + count) % count;
+   if (key === "Home") return 0;
+   if (key === "End") return count - 1;
+   return null;
+ }
+
+ /** ⌘\ 「关闭最近打开的窗格」该关哪一个（2026-10-18 修）：
+  *  旧实现直接 `tabs.slice(0, -1)`——数组尾项。追加开的顺序确实如此，但数组顺序是可变的
+  *  （拖标题栏换位 / ⌥↑⌥↓ 都走 movePane 重排），重排之后尾项就不再是「最近打开」的那个，
+  *  文档承诺与实行为两件事。而空数组时 slice(0,-1) 还是空数组，键被 preventDefault 吃掉，
+  *  按了没反应。
+  *  解法：App 另记一条打开顺序（openOrder，只增不重排），这里从后往前找第一个仍在场的窗格。
+  *  没记/openOrder 为空 ⇒ 退化为数组尾（旧行为，仍是「最后一项」这个合理猜测）。
+  *  全部不在场（已被逐个关掉）⇒ null，让调用方知道「无可关」，别静默吞键。 */
+ export function lastOpenedPane<T>(tabs: readonly T[], openOrder?: readonly T[]): T | null {
+   if (tabs.length === 0) return null;
+   if (openOrder === undefined || openOrder.length === 0) return tabs[tabs.length - 1] ?? null;
+   for (let i = openOrder.length - 1; i >= 0; i--) {
+     const candidate = openOrder[i];
+     if (candidate !== undefined && tabs.includes(candidate)) return candidate;
+   }
+   return tabs[tabs.length - 1] ?? null;
+ }
+
+ // 窗格快捷键的单一事实源（批 100，接「shortcuts.ts 与 App switch 无互锁」）。
+ // 键位、速查表文案、dispatch 落点都从这张表来：改一处两端同时变，不会再出现
+ // 「表里写了、App 没接」或「App 接了、表里没写」。
+ import type { PaneKind } from "./components/panes";
+
+ export interface PaneShortcutSpec {
+   kind: PaneKind;
+   /** 速查表显示的键位。 */
+   keys: string;
+   /** 速查表说明。 */
+   what: string;
+   /** KeyboardEvent.code（物理键位，不受输入法/布局字符影响）。 */
+   code: string;
+   /** "cmd" = ⌘ 或 Ctrl 均可（沿用全局键门的历史口径）；"ctrl" = 只认 Ctrl（终端键 Ctrl+`）。 */
+   mod: "cmd" | "ctrl";
+   shift: boolean;
+   alt: boolean;
+ }
+
+ export const PANE_SHORTCUTS: readonly PaneShortcutSpec[] = [
+   { kind: "changes", keys: "⌘⇧D", what: "变更窗格（审阅本会话改动）", code: "KeyD", mod: "cmd", shift: true, alt: false },
+   { kind: "plan", keys: "⌘⇧P", what: "方案窗格（计划与决议）", code: "KeyP", mod: "cmd", shift: true, alt: false },
+   { kind: "tasks", keys: "⌘⇧T", what: "任务窗格（子任务进度）", code: "KeyT", mod: "cmd", shift: true, alt: false },
+   { kind: "file", keys: "⌘⇧F", what: "文件窗格（工作区文件树）", code: "KeyF", mod: "cmd", shift: true, alt: false },
+   { kind: "browser", keys: "⌘⇧B", what: "浏览器窗格", code: "KeyB", mod: "cmd", shift: true, alt: false },
+   { kind: "terminal", keys: "Ctrl+`", what: "终端窗格", code: "Backquote", mod: "ctrl", shift: false, alt: false },
+   { kind: "sidechat", keys: "⌘;", what: "旁路对话窗格（不回写主会话）", code: "Semicolon", mod: "cmd", shift: false, alt: false },
+   { kind: "plugins", keys: "⌘⇧U", what: "插件窗格（技能/命令/信任）", code: "KeyU", mod: "cmd", shift: true, alt: false },
+ ];
+
+ export interface PaneKeyMods {
+   meta: boolean;
+   ctrl: boolean;
+   shift: boolean;
+   alt: boolean;
+ }
+
+ /** 窗格键位展示文案（tooltip/速查表共用这一处，别在调用点手抄）。 */
+ export function paneShortcutKeys(kind: PaneKind): string {
+   return PANE_SHORTCUTS.find((s) => s.kind === kind)?.keys ?? "";
+ }
+
+ /** 物理键 + 修饰键 → 要开合的窗格；不匹配（含多按了修饰键）返回 null。 */
+ export function paneShortcutFor(code: string, mods: PaneKeyMods): PaneKind | null {
+   for (const s of PANE_SHORTCUTS) {
+     if (s.code !== code || s.shift !== mods.shift || s.alt !== mods.alt) continue;
+     if (s.mod === "cmd") {
+       if (!(mods.meta || mods.ctrl)) continue;
+     } else if (!mods.ctrl || mods.meta) {
+       continue;
+     }
+     return s.kind;
+   }
+   return null;
+ }
