+ /** 问候语按时段分组：0–5 深夜 / 5–11 早上 / 12–17 下午 / 18–23 晚上（越界小时数取模归一）。
+  *  组内多条文案按 rand 轮换（默认 Math.random，传确定值可测）——同一时段不再永远同一句；
+  *  rand 越界（NaN / ≥1）回落到组内第一条。 */
+ export function greetingFor(hour: number, rand: () => number = Math.random): string {
+   const h = ((Math.trunc(hour) % 24) + 24) % 24;
+   const group = h < 5 ? STR.empty.greetingNight
+     : h < 12 ? STR.empty.greetingMorning
+     : h < 18 ? STR.empty.greetingAfternoon
+     : STR.empty.greetingEvening;
+   return group[Math.floor(rand() * group.length)] ?? group[0]!;
+ }
+
+ // 相对时间文案（纯函数，**不**在 derived/ 里）。
+ //
+ // 为什么不住派生层：它用 `new Date(tsMs)` 构造本地日期。从**显式时间戳**构造日期并不读当前时钟
+ // （纯度上没问题），但派生层的 I3 契约是**按 token 静态扫描**的——`new Date` 一律禁。
+ // 保守读法 ⇒ 它留在渲染层顶层，由 projections.ts 门面转发。判据唯一处：relative-time.ts。
+ // （另有一个同名函数在 memory-view.ts，参数序不同：那个吃 ISO 串 + now。）
+ /** 相对时间（语义钉死分界）：<60s "刚刚"；<60m "N 分钟前"；<24h "N 小时前"；<7d "N 天前"；
+  *  否则本地日期 YYYY-MM-DD。未来时间戳（diff 为负）落入第一档显 "刚刚"，不显负数。 */
+ export function relativeTime(nowMs: number, tsMs: number): string {  const diff = nowMs - tsMs;
+   if (diff < 60_000) return "刚刚";
+   if (diff < 60 * 60_000) return `${String(Math.floor(diff / 60_000))} 分钟前`;
+   if (diff < 24 * 60 * 60_000) return `${String(Math.floor(diff / 3_600_000))} 小时前`;
+   if (diff < 7 * 24 * 60 * 60_000) return `${String(Math.floor(diff / 86_400_000))} 天前`;
+   const d = new Date(tsMs);
+   const mm = String(d.getMonth() + 1).padStart(2, "0");
+   const dd = String(d.getDate()).padStart(2, "0");
+   return `${String(d.getFullYear())}-${mm}-${dd}`;
+ }
+
+ // v2.17 运行中可沟通：发送队列（渲染层内存态，按会话各一条表）。
+ // 四条语义各一个出口，组件与 App 不各算一份：
+ //   takeQueued    本轮收束后取队首（FIFO；空队列给 null，调用方据此停表）
+ //   promoteQueued 把某条提到队首（「打断并发送」：先改序再打断，收束后先发的就是它）
+ //   dropQueued    按位移除
+ //   editQueued    改一条的正文（附件/次序不动；空文本不落地）
+ //   moveQueued    上/下移一条（键盘可达的排序，不靠拖拽）
+ // 为什么是纯函数：本仓没有 jsdom（见 render-structure.test.tsx 头注），交互逻辑一律抽成
+ // 纯函数判卷 + 组件走 SSR 结构判卷两面。
+ import type { RunAttachmentReference, SessionQueueEntry } from "../../../../src/main/ipc-protocol";
+
+ export interface QueuedSend {
+   /** 渲染键（进程内自增；只有消息内容落盘，渲染键不落盘）。 */
+   id: number;
+   text: string;
+   attachments: RunAttachmentReference[];
+ }
+
+ /** 本轮收束后出队：队首派下一轮，rest 回写。空队列 head=null。 */
+ export function takeQueued(list: readonly QueuedSend[]): { head: QueuedSend | null; rest: QueuedSend[] } {
+   if (list.length === 0) return { head: null, rest: [] };
+   return { head: list[0] ?? null, rest: list.slice(1) };
+ }
+
+ /** 「打断并发送」：把第 index 条提到队首。越界原样返回（调用点按 index 渲染，越界=坏拍不放大）。 */
+ export function promoteQueued(list: readonly QueuedSend[], index: number): QueuedSend[] {
+   if (index < 0 || index >= list.length) return [...list];
+   const out = [...list];
+   const picked = out.splice(index, 1)[0];
+   if (picked === undefined) return [...list];
+   out.unshift(picked);
+   return out;
+ }
+
+ /** 按位移除；越界原样返回。 */
+ export function dropQueued(list: readonly QueuedSend[], index: number): QueuedSend[] {
+   if (index < 0 || index >= list.length) return [...list];
+   return list.filter((_, i) => i !== index);
+ }
+
+ /** 改一条排队消息的正文：只换 text（附件、id、次序不动）。空文本/越界原样返回——
+  *  队列里没有「发一条空消息」这种东西，清空输入不该把条目变成哑弹。 */
+ export function editQueued(list: readonly QueuedSend[], index: number, text: string): QueuedSend[] {
+   const trimmed = text.trim();
+   if (trimmed === "" || index < 0 || index >= list.length) return [...list];
+   return list.map((item, i) => (i === index ? { ...item, text: trimmed } : item));
+ }
+
+ /** 上移(-1)/下移(+1)一条：越界或原地不动原样返回（ends 不交换成空）。 */
+ export function moveQueued(list: readonly QueuedSend[], index: number, delta: -1 | 1): QueuedSend[] {
+   const to = index + delta;
+   if (index < 0 || index >= list.length || to < 0 || to >= list.length) return [...list];
+   const out = [...list];
+   const picked = out.splice(index, 1)[0];
+   if (picked === undefined) return [...list];
+   out.splice(to, 0, picked);
+   return out;
+ }
+
+ /** 落盘载荷只保留用户消息本身；id 是渲染态，不进磁盘。 */
+ export function toSessionQueueEntries(list: readonly QueuedSend[]): SessionQueueEntry[] {
+   return list.map((item) => ({ text: item.text, attachments: [...item.attachments] }));
+ }
+
+ /** 读回 sidecar 时重建渲染 id；nextId 由 App 的会话内单调序号提供。 */
+ export function fromSessionQueueEntries(entries: readonly SessionQueueEntry[], nextId: () => number): QueuedSend[] {
+   return entries.map((entry) => ({ id: nextId(), text: entry.text, attachments: [...entry.attachments] }));
+ }
+
+ /** 顺序派发（「本轮收束后自动派下一条」的唯一实现）：
+  *  first 起，每轮 run 收束后取队首续派，直到队空或 run 报 false（本轮失败——剩余队列留在表里，
+  *  不吞不掉，下一条要等用户处理）。一次只 await 一条：同会话并发 run 会被 core 拒，这里不制造它。
+  *  takeNext 由调用方提供（App 从 per-session 表出队并回写）；本函数不碰状态。 */
+ export async function drainQueue(
+   first: { text: string; attachments: RunAttachmentReference[] },
+   run: (msg: { text: string; attachments: RunAttachmentReference[] }) => Promise<boolean>,
+   takeNext: () => QueuedSend | null | Promise<QueuedSend | null>,
+ ): Promise<void> {
+   let next: { text: string; attachments: RunAttachmentReference[] } | null = first;
+   while (next !== null) {
+     const keepGoing = await run(next);
+     if (!keepGoing) return;
+     next = await takeNext();
+   }
+ }
+
+ /** 运行中按回车/发送时，这条消息该走哪条路（第 9 点·轮中插话，2026-10-23）。
+  *
+  *  三条路，语义相反，**必须先判再发**：
+  *   · `steer`    —— 送进正在跑的那一轮（不新开 run、不改轮次）；
+  *   · `queue`    —— 排到本轮结束后自动发（用户明确要排队，或主进程说「不在运行」，或带附件）；
+  *   · `run`      —— 空闲，起新一轮。
+  *
+  *  为什么抽成纯函数：这段判据原本内联在 `send()` 里，被「会话是否运行中」与「主进程怎么答」
+  *  两层状态各切一刀，而**离屏界面根本立不住那个状态**（第 681 页记的冒烟失败）。
+  *  把它做成纯函数，三条路的分岔就能不依赖 DOM/运行态被钉死，`send()` 只负责执行。
+  *
+  *  `forceQueue` 是用户显式意图（点「加入队列」钮）：按钮写着「加入队列」却把话插进当前轮，
+  *  就是按钮在说谎——所以它的优先级高于一切插话条件。
+  *  附件同理：附件要过引用校验与装载，属下一轮的入口，半路塞进当前轮会把校验绕开。 */
+ export function steerRouteOf(input: {
+   /** 当前是否有活动会话；空屏（null）只可能是起新一轮。 */
+   sessionId: string | null;
+   /** 渲染层的运行集判据（真值来源见 run-queue 的 keyOf）。 */
+   running: boolean;
+   /** 用户显式要求排队（「加入队列」钮）。 */
+   forceQueue: boolean;
+   /** 本条消息带来的附件数。 */
+   attachmentCount: number;
+ }): "run" | "queue" | "steer" {
+   if (input.sessionId === null) return "run";
+   if (!input.running) return "run";
+   if (input.forceQueue) return "queue";
+   if (input.attachmentCount > 0) return "queue";
+   return "steer";
+ }
+
+ /** 主进程对 `runSteer` 的应答是否等于「真送进去了」（决定要不要落回入队）。 */
+ export function steerAccepted(res: { ok?: boolean }): boolean {
+   // 只认 `ok === true`：协议兜底/桩兜底给 `{}` 时是 `undefined`，
+   // 那必须当成"没送进去"并回落入队——把 undefined 读成成功就是**吞消息**。
+   return res.ok === true;
+ }
+
+ /** 一轮 run 收束后是否继续派队列：用户打断是正常收束，真实失败才停表。 */
+ export function continueAfterRun(res: { ok: boolean; aborted?: boolean }): boolean {
+   return res.ok || res.aborted === true;
+ }
+
+ /** 「打断/停止」点击后的陈旧旗自愈判据（第十三遍）：main 答 {ok:false}（该会话无在跑 controller）
+  *  ＝本实例的「运行中」是陈旧旗（旧 main 无收束推送时代的残影 / 整页重载前的孤儿标记）——
+  *  旧代码 void 掉结果，点了像没点（业主实测「排队中·打断并发送，点击没有反应」）。可摘三道闸：
+  *  ① cancelOk=true ⇒ 真打断了一场 run（正常收束链自会续派）不摘；
+  *  ② 点击后 runGen 已动 ⇒ 收束链已把队列先派起来（同拍竞态），那是真在跑，不碰；
+  *  ③ 旗已不在 ⇒ 收束链已自行摘掉，无事可做。
+  *  纯函数：全是入参，不含时钟与全局。 */
+ export function shouldHealStaleRun(args: {
+   cancelOk: boolean;
+   genAtClick: number;
+   genNow: number;
+   flagPresent: boolean;
+ }): boolean {
+   if (args.cancelOk) return false;
+   if (args.genNow !== args.genAtClick) return false;
+   if (!args.flagPresent) return false;
+   return true;
+ }
+
+ /** Composer 锁因（2026-10-18 收口）：同一个 disabled 布尔此前被 Composer 拿去猜占位文案，
+  *  于是「澄清/方案门未决」被写成「正在创建会话…」——禁用是真的，原因说错了。
+  *  会话读取失败先要求恢复；其余优先级 = 门（要你做决定）> 队列读回 > 创建会话。
+  *  **运行中不在这里**——运行中输入可用（回车排队、⌘↩ 打断并发送）。
+  *  ask（审批）门不进 gateActive：卡在场时输入保持可用（v2.17 口径，v2.18 沿用）。 */
+ export type ComposerLockReason = "gate" | "queue" | "creating" | "session";
+
+ export function composerLockReason(input: {
+   /** 读回发送队列的瞬时加载（App 侧原本以 disabled 的第三项独立 OR 进来）。 */
+   queueLoading?: boolean;
+   /** 正文或队列读取失败；请求结束不等于会话已就绪。 */
+   sessionLoadFailed?: boolean;
+   creating: boolean;
+   gateActive: boolean;
+ }): ComposerLockReason | null {
+   if (input.sessionLoadFailed === true) return "session";
+   if (input.gateActive) return "gate";
+   if (input.queueLoading === true) return "queue";
+   if (input.creating) return "creating";
+   return null;
+ }
+
+ export function composerLocked(input: { creating: boolean; gateActive: boolean }): boolean {
+   return composerLockReason(input) !== null;
+ }
+
+ /** 审批卡归属判定（v2.18 唯一处）：这张卡该不该画在**当前会话**的头上。
+  *  此前 App 只有单一 `ask` 态 ⇒ 谁最后发卡谁上屏，跨会话会串台；core 侧给卡带上 sessionId
+  *  之后（IPC v3），这里成了唯一的筛子——不再是「有没有卡」，是「这张卡是不是本会话的」。
+  *  缺席 sessionId（老载荷／headless 路径）＝ **归属未知**：照旧显示（不静默吞卡，
+  *  否则headless 面永远出不了卡），但也因此不参与任何按会话的回答与锁定。 */
+ export function askBelongsToSession(payload: { sessionId?: string } | null, activeId: string | null): boolean {
+   if (payload === null) return false;
+   const sid = payload.sessionId ?? "";
+   if (sid === "") return true; // 未知 ⇒ 沿用旧行为，不猜也不吞
+   return sid === (activeId ?? "");
+ }
+
+ /** 会话结束自动沉淀的合并审批（agent-runner 双轨②，agent-runner.ts:1492 送审形状）：
+  *  distill 的合并审批 args 带 trigger 标记；手打记忆写入的普通审批同为 tool=remember
+  *  但 args 无 trigger——两者必须分开（后者是用户主动要求写记忆，照常弹卡）。
+  *  「对话优先跳沉」的唯一判据（App 的 onAsk 队列在场即拒 / send 运行中即拒），
+  *  别处不得复制这份字符串比较。 */
+ export function isSessionEndDistillAsk(p: { tool?: string; args?: Record<string, unknown> }): boolean {
+   return p.tool === "remember" && p.args?.trigger === "session_end_distill";
+ }
+
+ // P1 主界面重做：会话侧栏视图纯函数（分组 / 时间桶 / 状态合成 / 段结构）。
+ // groupByWorkspace / OTHER_WORKSPACE / WorkspaceGroup 自 Sidebar.tsx 迁出——判据一字未动
+ // （判卷资产原样保留）；新增面全部纯函数、无 React 依赖、可判卷。
+ import { runKey } from "./state/session-identity";
+ import type { SessionInfoPayload } from "../../../../src/main/ipc-protocol";
+ import { STR } from "./strings";
+
+ /** host.listSessions() 的 desktop 扩展形状：每条带归属工作区（T1 合并清单的归组标记）。 */
+ export type WorkspaceSession = SessionInfoPayload & { workspace: string };
+
+ /** 会话确认目标：running = 请求确认那一刻这条会话是否在跑（只决定文案/按钮）；
+  *  真正执行时各动作会再查一次运行旗，不把陈旧快照当事实。归档/删除同形。 */
+ export type SessionConfirmTarget = WorkspaceSession & { running?: boolean };
+ /** 删除确认目标（保留旧名，形状与归档一致）。 */
+ export type DeleteConfirmTarget = SessionConfirmTarget;
+
+ /** 按 id + workspace 定位会话。id 是分钟级时间戳，跨项目可撞名；给了 workspace 就必须
+  *  两个都对上，**不退回**同名 id（退回 = 打开另一个项目的转录）。缺省 workspace 保持旧行为。 */
+ export function findSessionByRef<T extends { id: string; workspace?: string }>(
+   sessions: readonly T[],
+   id: string,
+   workspace?: string,
+ ): T | undefined {
+   return sessions.find((s) => s.id === id && (workspace === undefined || s.workspace === workspace));
+ }
+
+ export interface WorkspaceGroup {
+   /** 注册工作区的 canonical 绝对路径；「其他」组＝OTHER_WORKSPACE 哨兵。 */
+   workspace: string;
+   sessions: WorkspaceSession[];
+ }
+
+ /** 「其他」组哨兵（P1 起显示名 = 「临时对话」）：真实工作区恒为 canonical 绝对路径
+  *  （project-registry realpath 保证），空串不可能与之相撞；切工作区入口对哨兵组关闭。 */
+ export const OTHER_WORKSPACE = "";
+
+ /** 分组纯函数（判据与迁出前逐字相同）：已注册工作区全列（空组也列、保持注册顺序），
+  *  会话按归属落组；未登记工作区的会话不丢——归「其他」组垫底（防 listProjects 与盘上
+  *  漂移时静默吞数据）。workspaces 重复条目去重（registry 保 path 唯一，纯函数不信任上游）。 */
+ export function groupByWorkspace(
+   sessions: readonly WorkspaceSession[],
+   workspaces: readonly string[],
+ ): WorkspaceGroup[] {
+   // 组内排序（第十四遍，原型 §2.1「置顶于组内」）：置顶恒前；stable sort ⇒ 同层保持输入序（最近活动序）。
+   const pinnedFirst = (list: readonly WorkspaceSession[]): WorkspaceSession[] =>
+     [...list].sort((a, b) => Number(b.pinned === true) - Number(a.pinned === true));
+   const seen = new Set<string>();
+   const groups: WorkspaceGroup[] = [];
+   for (const workspace of workspaces) {
+     if (seen.has(workspace)) continue;
+     seen.add(workspace);
+     groups.push({ workspace, sessions: pinnedFirst(sessions.filter((s) => s.workspace === workspace)) });
+   }
+   const others = sessions.filter((s) => !seen.has(s.workspace));
+   if (others.length > 0) groups.push({ workspace: OTHER_WORKSPACE, sessions: pinnedFirst(others) });
+   return groups;
+ }
+
+ /** 归档分区（2026-10-17）：归档会话移出常规项目组、单列「已归档」分组找回。
+  *  修的是真机实证：归档写入成功但侧栏照常显示（P1 重写把筛选面丢了），
+  *  归档卡上「移出常规列表 / 筛选已归档可找回」两句都成了空话。
+  *  纯函数：保输入序、不修改入参、active 与 archived 互斥且并集等于入参。 */
+ export function splitArchived<T extends { archived?: boolean }>(
+   sessions: readonly T[],
+ ): { active: T[]; archived: T[] } {
+   const active: T[] = [];
+   const archived: T[] = [];
+   for (const s of sessions) {
+     if (s.archived === true) archived.push(s);
+     else active.push(s);
+   }
+   return { active, archived };
+ }
+
+ /** 分组标题＝路径末段（注册工作区）；「其他」组显示固定名。 */
+ export function workspaceLabel(workspace: string): string {
+   if (workspace === OTHER_WORKSPACE) return STR.sidebar.tempChats;
+   return workspace.slice(workspace.lastIndexOf("/") + 1) || workspace;
+ }
+
+ /** 会话归属的**项目名**（行上标签用）。纯函数：查项目清单，把 `projectId` 翻成名字。
+  *  查不到（项目被移除而归属还在）⇒ 退回**原始 id**：如实地显示它还指着什么，
+  *  而不是编一个名字、也不是把标签藏起来（藏起来的归属等于没接）。
+  *  没归属（`projectId` 缺席）⇒ null＝不画标签。 */
+ export function projectLabelFor(
+   session: { projectId?: string },
+   projects: readonly { id: string; name: string }[],
+ ): string | null {
+   const id = session.projectId;
+   if (id === undefined || id === "") return null;
+   return projects.find((p) => p.id === id)?.name ?? id;
+ }
+
+ /** 「归到项目」子菜单的条目。`projectId === null` 那一项是**取消归属**。 */
+ export interface ProjectMenuItem {
+   /** 目标项目 id；取消归属那一条为 null。 */
+   projectId: string | null;
+   label: string;
+ }
+
+ /** 「归到项目」子菜单的条目表。纯函数（菜单是关着的 Radix 弹层，静态渲染里看不见 ⇒ 逻辑必须在这里可判）。
+  *  - 没有可归属的项目 ⇒ 空表（子菜单整个不摆：不摆一个点不动的入口）。
+  *  - 「取消归属」**只在已归属时**才有（没归属时摆它＝摆一个没用的动作）。 */
+ export function projectMenuItems(
+   session: { projectId?: string },
+   projects: readonly { id: string; name: string }[],
+ ): ProjectMenuItem[] {
+   if (projects.length === 0) return [];
+   const items: ProjectMenuItem[] = projects.map((p) => ({ projectId: p.id, label: p.name }));
+   if (session.projectId !== undefined && session.projectId !== "") {
+     items.push({ projectId: null, label: STR.sessionProject.unassign });
+   }
+   return items;
+ }
+
+ // ---- 时间分组（brief 第二节：今天/昨天/过去7天/更早）----
+
+ export type TimeBucket = "today" | "yesterday" | "past7" | "earlier";
+ const TIME_ORDER: readonly TimeBucket[] = ["today", "yesterday", "past7", "earlier"];
+ export const TIME_BUCKET_ORDER = TIME_ORDER;
+
+ const dayStart = (ms: number): number => {
+   const d = new Date(ms);
+   d.setHours(0, 0, 0, 0);
+   return d.getTime();
+ };
+
+ /** 会话的时间锚 = 文件 mtime：事件 append 会刷新它，这**就是**对话活动时间。
+  *  `metadata.updatedAt` 是组织信息的修改时间（置顶/改名/归档/归项目都会写）——拿它当 recency，
+  *  置顶一下就会把一小时前的会话显示成「刚刚」、并把它分进「今天」桶（2026-10-20 真机：
+  *  置顶旧会话后侧栏时间从「1 小时前」跳成「刚刚」，而 JSONL mtime 没变）。 */
+ export function sessionTime(s: WorkspaceSession): number {
+   return s.mtimeMs;
+ }
+
+ /** 桶判据用**日历日**边界（本地时区）：今天 → 昨天 → 过去 7 天 → 更早。 */
+ export function timeBucket(updatedMs: number, nowMs: number): TimeBucket {
+   const today = dayStart(nowMs);
+   if (updatedMs >= today) return "today";
+   if (updatedMs >= dayStart(today - 86_400_000)) return "yesterday";
+   if (updatedMs >= dayStart(today - 7 * 86_400_000)) return "past7";
+   return "earlier";
+ }
+
+ /** 时间分组：空桶不列；桶序固定 今天→昨天→过去7天→更早；桶内保持输入序（stable）。 */
+ export function groupByTime(
+   list: readonly WorkspaceSession[],
+   nowMs: number,
+ ): { bucket: TimeBucket; sessions: WorkspaceSession[] }[] {
+   const buckets = new Map<TimeBucket, WorkspaceSession[]>();
+   for (const s of list) {
+     const b = timeBucket(sessionTime(s), nowMs);
+     const arr = buckets.get(b);
+     if (arr === undefined) buckets.set(b, [s]);
+     else arr.push(s);
+   }
+   return TIME_ORDER
+     .filter((b) => buckets.has(b))
+     .map((b) => ({ bucket: b, sessions: buckets.get(b)! }));
+ }
+
+ // ---- 状态合成（诚实边界：只有本进程可见态；重启后归零是如实行为）----
+
+ export type SessionStatus = "running" | "waiting" | "failed" | "done" | "none";
+
+ /** 状态优先级：running > waiting > failed > done > none（活跃态压过历史态）。
+  *  running/waiting 由 App 运行时集合给；lastOutcome 只记**本进程**观察到的轮末结果——
+  *  会话终态不落盘（内核事件格式不动），重启后图标归零是诚实行为，不写假终态。 */
+ export function sessionStatus(input: { running: boolean; waiting: boolean; lastOutcome: "ok" | "failed" | undefined }): SessionStatus {
+   if (input.running) return "running";
+   if (input.waiting) return "waiting";
+   if (input.lastOutcome === "failed") return "failed";
+   if (input.lastOutcome === "ok") return "done";
+   return "none";
+ }
+
+ // ---- 段结构（置顶恒前；其余按时间桶；判卷锚供侧栏渲染直接消费）----
+
+ export type SessionSection =
+   | { kind: "pinned"; sessions: WorkspaceSession[] }
+   | { kind: "time"; bucket: TimeBucket; sessions: WorkspaceSession[] };
+
+ /** 组内段：有置顶 ⇒ 置顶段（原序）在前，其余进时间桶（空桶不列）。 */
+ export function projectSections(list: readonly WorkspaceSession[], nowMs: number): SessionSection[] {
+   const pinned: WorkspaceSession[] = [];
+   const rest: WorkspaceSession[] = [];
+   for (const s of list) (s.pinned === true ? pinned : rest).push(s);
+   const sections: SessionSection[] = [];
+   if (pinned.length > 0) sections.push({ kind: "pinned", sessions: pinned });
+   for (const g of groupByTime(rest, nowMs)) sections.push({ kind: "time", bucket: g.bucket, sessions: g.sessions });
+   return sections;
+ }
+
+ // ---- 拖拽分流（P1-4；纯函数先行——App 窗口级 drop 与 Composer 落点分流共用）----
+
+ /** drop 分流：目录恒进 projects（拖入即添加项目）；文件按是否在已注册项目内分流。
+  *  路径前缀判定：path === project || path.startsWith(project + "/")（防 /repo/a 误吞 /repo/ab）。 */
+ export function classifyDrop(
+   files: readonly { path: string; isDirectory: boolean }[],
+   projectPaths: readonly string[],
+ ): { projects: string[]; inProject: string[]; outside: string[] } {
+   const projects: string[] = [];
+   const inProject: string[] = [];
+   const outside: string[] = [];
+   const inProjectPath = (p: string): boolean =>
+     projectPaths.some((root) => p === root || p.startsWith(root + "/"));
+   for (const f of files) {
+     if (f.isDirectory) projects.push(f.path);
+     else if (inProjectPath(f.path)) inProject.push(f.path);
+     else outside.push(f.path);
+   }
+   return { projects, inProject, outside };
+ }
+
+ // ---- 会话筛选（自 Sidebar.tsx 迁出；判据一字未动，词面改从 STR 取——值与原字面量相同）----
+ // P1 起侧栏 UI 不再常驻筛选入口（brief：次要操作收进 ⌘K 命令面板，P3-3 接线）；
+ // 纯函数与词表原样保留（判卷资产），词表只列有数据支撑的项。
+
+ export const SESSION_FILTERS = [
+   { id: "all", label: STR.filter.all },
+   { id: "running", label: STR.filter.running },
+   { id: "pinned", label: STR.filter.pinned },
+   { id: "archived", label: STR.filter.archived },
+   { id: "scheduled", label: STR.filter.scheduled },
+ ] as const;
+
+ export type SessionFilterId = (typeof SESSION_FILTERS)[number]["id"];
+
+ export const SESSION_FILTER_NOTE = STR.filter.note;
+
+ export function matchSession(
+   s: { id: string; title?: string; pinned?: boolean; archived?: boolean; origin?: "scheduled"; workspace?: string },
+   input: { search: string; filter: SessionFilterId; running?: ReadonlySet<string> },
+ ): boolean {
+   const q = input.search.trim().toLowerCase();
+   if (q !== "") {
+     const hay = `${s.title ?? ""} ${s.id}`.toLowerCase();
+     if (!hay.includes(q)) return false;
+   }
+   switch (input.filter) {
+     case "all":
+       return true;
+     case "running":
+       return input.running?.has(runKey(s.workspace, s.id)) === true;
+     case "pinned":
+       return s.pinned === true;
+     case "archived":
+       return s.archived === true;
+     case "scheduled":
+       return s.origin === "scheduled";
+   }
+ }
+
+ export function filterSessions<T extends { id: string; title?: string; pinned?: boolean; archived?: boolean; origin?: "scheduled" }>(
+   sessions: readonly T[],
+   input: { search: string; filter: SessionFilterId; running?: ReadonlySet<string> },
+ ): T[] {
+   return sessions.filter((s) => matchSession(s, input));
+ }
+
