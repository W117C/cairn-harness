+  grep: "查找",
+  glob: "找文件",
+  lsp: "查符号",
+  clarify: "提问",
+  propose_plan: "提方案",
+  render_image: "出图",
+  verify: "验证",
+  web_fetch: "抓取",
+  web_search: "搜索",
+  spawn_agent: "派发子任务",
+  // 子任务生命周期（第 917 页）：这几个工具的参数里没有 command/path 一类字段，摘要走 ownSubject
+  // （task/message/agent_ids/thread_id）。没有动词的话，行首仍会把 `wait_for_agents` 这类实现名摆上屏。
+  send_agent: "发消息",
+  wait_for_agents: "等待",
+  cancel_agents: "撤销",
+  list_agents: "列出",
+  resume_agent: "恢复",
+  close_agent: "关闭",
+  read_image: "读图",
