+/* 官方 DSH 的摘要/披露层级，沿用 Cairn 的 Claude Style 色值与字号。 */
+.tool-group-toggle { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; min-height: 30px; max-width: 100%; padding: 3px 6px; border-radius: var(--radius-sm); font-size: var(--fs-caption-sm); color: hsl(var(--text-200)); text-align: left; }
+.tool-group-toggle > span:not([class]) { flex: none; white-space: nowrap; }
+.tool-group-toggle:hover { background: var(--alpha-1); }
+.tool-group-toggle[aria-expanded="true"] > .chev { transform: rotate(90deg); }
+.tool-group-detail { color: hsl(var(--text-400)); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tool-group-failure { color: hsl(var(--color-risk)); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tool-group-body { display: flex; flex-direction: column; gap: 6px; }
+.tool-group-body[hidden] { display: none; }
