[31m+ // ---- 固定回注名单（切点纪律 3：永不压缩、永不进摘要输入）----[39m
[31m+ /** V1 名单 = 全部 user_message（用户目标与中途补充——CC/CL 先例：用户轮次跨压缩存活，[39m
[31m+  *  最近 typed user 消息永不吞因此自然成立）+ 当前 plan（最后一组 plan_proposed/plan_approved）。[39m
[31m+  *  keep-first 按原子单元闭包扩护：单元内任一成员入选，整单元受护。 */[39m
[31m+ export function keepFirstSet(events: AgentEvent[]): Set<number> {[39m
[31m+   const seeds = new Set<number>();[39m
[31m+   // A2（审查）：旧实现 `Math.max(-1, ...events.map(...))` 把全量数组展开为函数实参——长会话[39m
[31m+   // 抛 RangeError，且恰在"会话已大、正需压缩"时调用。改单次循环。[39m
[31m+   let lastPlanProposed = -1;[39m
[31m+   let lastPlanApproved = -1;[39m
