[31m+ // ---- 切点选择 ----[39m
[31m+ export interface CutPlan {[39m
[31m+   /** 被压缩事件 id（升序）；不含 keep-first / 旧压缩排除集 / compaction 事件本体。 */[39m
[31m+   compressedIds: number[];[39m
