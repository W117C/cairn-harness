[31m+ /** 单元迭代（含单例）：按起始 id 升序，覆盖 1..N 全部事件。 */[39m
[31m+ function* iterateUnits(events: AgentEvent[], units: AtomicUnit[]): Generator<{ lo: number; hi: number; ids: number[] }> {[39m
[31m+   let id = 1;[39m
[31m+   let ui = 0;[39m
