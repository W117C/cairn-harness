[31m+ export function selectTruncation(events: AgentEvent[], ctx: CutContext): { compressedIds: number[]; offset: number } | null {[39m
[31m+   const target = Math.floor([39m
[31m+     events.filter((e, i) => {[39m
[31m+       const id = eventIdAt(i);[39m
[31m+       return e.type !== "compaction" && !ctx.excluded.has(id) && !ctx.keepFirst.has(id);[39m
[31m+     }).length * 0.5,[39m
[31m+   );[39m
