[31m+ }[39m
[31m+[39m
[31m+ export interface CutContext {[39m
[31m+   availableTokens: number;[39m
[31m+   factor: number;[39m
[31m+   keepFirst: Set<number>;[39m
[31m+   excluded: Set<number>;[39m
[31m+   lastUserMsgId: number;[39m
