[31m+       // 只落事实不落劝告：摘要规范明写「不要提及压缩过程本身」，行内塞指令会与它打架。[39m
[31m+       lines.push([39m
[31m+         "[Assistant 回复被截断] " +[39m
[31m+           (e.outcome === "output_budget" ? "没写完就被收走（篇幅用尽，停止原因 " : "被内容策略中止（停止原因 ") +[39m
[31m+           e.stop_reason +[39m
[31m+           (e.output_tokens !== undefined ? "，已用 " + String(e.output_tokens) + " 输出 token" : "") +[39m
[31m+           "）",[39m
[31m+       );[39m
[31m+     }[39m
[31m+     // usage / session_meta / compaction：非内容事件，不进摘要输入[39m
