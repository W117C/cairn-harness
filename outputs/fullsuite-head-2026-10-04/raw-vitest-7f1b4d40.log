[31m+   spans.sort((a, b) => a.lo - b.lo);[39m
[31m+   const merged: AtomicUnit[] = [];[39m
[31m+   for (const s of spans) {[39m
[31m+     const last = merged[merged.length - 1];[39m
[31m+     if (last && s.lo <= last.hi) last.hi = Math.max(last.hi, s.hi);[39m
[31m+     else merged.push({ lo: s.lo, hi: s.hi, ids: [] });[39m
[31m+   }[39m
[31m+   // A4（审查根因 5）：merged 按 lo 升序且互不重叠，事件 id 单调递增——指针推进代替每事件[39m
[31m+   // 对全量单元 find（O(n·m) → O(n + m)）。[39m
[31m+   let mi = 0;[39m
[31m+   events.forEach((_, i) => {[39m
[31m+     const id = eventIdAt(i);[39m
[31m+     while (mi < merged.length && id > merged[mi]!.hi) mi++;[39m
[31m+     const u = mi < merged.length && id >= merged[mi]!.lo ? merged[mi] : undefined;[39m
[31m+     if (u) u.ids.push(id);[39m
[31m+   });[39m
[31m+   return merged;[39m
[31m+ }[39m
[31m+[39m
[31m+ /** 单元迭代（含单例）：按起始 id 升序，覆盖 1..N 全部事件。 */[39m
[31m+ function* iterateUnits(events: AgentEvent[], units: AtomicUnit[]): Generator<{ lo: number; hi: number; ids: number[] }> {[39m
[31m+   let id = 1;[39m
[31m+   let ui = 0;[39m
[31m+   while (id <= events.length) {[39m
[31m+     const u = ui < units.length ? units[ui] : undefined;[39m
[31m+     if (u && id >= u.lo) {[39m
[31m+       yield u;[39m
[31m+       id = u.hi + 1;[39m
[31m+       ui++;[39m
[31m+     } else {[39m
[31m+       yield { lo: id, hi: id, ids: [id] };[39m
[31m+       id++;[39m
[31m+     }[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ // ---- 固定回注名单（切点纪律 3：永不压缩、永不进摘要输入）----[39m
[31m+ /** V1 名单 = 全部 user_message（用户目标与中途补充——CC/CL 先例：用户轮次跨压缩存活，[39m
[31m+  *  最近 typed user 消息永不吞因此自然成立）+ 当前 plan（最后一组 plan_proposed/plan_approved）。[39m
[31m+  *  keep-first 按原子单元闭包扩护：单元内任一成员入选，整单元受护。 */[39m
[31m+ export function keepFirstSet(events: AgentEvent[]): Set<number> {[39m
[31m+   const seeds = new Set<number>();[39m
[31m+   // A2（审查）：旧实现 `Math.max(-1, ...events.map(...))` 把全量数组展开为函数实参——长会话[39m
[31m+   // 抛 RangeError，且恰在"会话已大、正需压缩"时调用。改单次循环。[39m
[31m+   let lastPlanProposed = -1;[39m
[31m+   let lastPlanApproved = -1;[39m
[31m+   events.forEach((e, i) => {[39m
[31m+     const id = eventIdAt(i);[39m
[31m+     if (e.type === "user_message") seeds.add(id); // 用户轮次全部受护（用户目标 + 中途补充）[39m
[31m+     else if (e.type === "plan_proposed") lastPlanProposed = id;[39m
[31m+     else if (e.type === "plan_approved") lastPlanApproved = id;[39m
[31m+   });[39m
[31m+   if (lastPlanProposed > 0) seeds.add(lastPlanProposed);[39m
[31m+   if (lastPlanApproved > 0) seeds.add(lastPlanApproved);[39m
[31m+   const units = atomicUnits(events);[39m
[31m+   const out = new Set<number>();[39m
[31m+   // A4（审查根因 5）：units 按 lo 升序互不重叠——二分定位代替每 seed 全量 find。[39m
[31m+   const unitOf = (id: number): AtomicUnit | undefined => {[39m
[31m+     let lo = 0;[39m
[31m+     let hi = units.length - 1;[39m
