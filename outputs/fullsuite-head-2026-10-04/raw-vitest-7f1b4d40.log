[31m+ // ---- 原子单元（切点纪律 1：tool_use/tool_result 对、方案/验证事件对不拆）----[39m
[31m+ export interface AtomicUnit { lo: number; hi: number; ids: number[] }[39m
[31m+[39m
[31m+ /** 按 callId 链接的事件并成单元：tool_call↔tool_result / clarify_requested / plan_proposed↔plan_approved /[39m
[31m+  *  verify_result 同 callId 归一组；区间重叠再合并；不在任何区间的事件是单例。 */[39m
[31m+ export function atomicUnits(events: AgentEvent[]): AtomicUnit[] {[39m
[31m+   const groups = new Map<string, number[]>();[39m
[31m+   events.forEach((e, i) => {[39m
[31m+     const id = eventIdAt(i);[39m
[31m+     let key: string | null = null;[39m
[31m+     if (e.type === "tool_call") key = "c:" + e.id;[39m
[31m+     else if ([39m
[31m+       e.type === "tool_result" ||[39m
[31m+       e.type === "clarify_requested" ||[39m
[31m+       e.type === "plan_proposed" ||[39m
[31m+       e.type === "plan_approved" ||[39m
[31m+       e.type === "verify_result"[39m
[31m+     ) {[39m
[31m+       key = "c:" + e.callId;[39m
[31m+     }[39m
[31m+     if (!key) return;[39m
[31m+     const g = groups.get(key);[39m
[31m+     if (g) g.push(id);[39m
[31m+     else groups.set(key, [id]);[39m
[31m+   });[39m
