[31m+       const mid = (lo + hi) >> 1;[39m
[31m+       const u = units[mid]!;[39m
[31m+       if (id < u.lo) hi = mid - 1;[39m
[31m+       else if (id > u.hi) lo = mid + 1;[39m
[31m+       else return u;[39m
[31m+     }[39m
[31m+     return undefined;[39m
[31m+   };[39m
[31m+   for (const id of seeds) {[39m
[31m+     const u = unitOf(id);[39m
[31m+     if (u) for (const x of u.ids) out.add(x);[39m
[31m+     else out.add(id);[39m
[31m+   }[39m
[31m+   return out;[39m
[31m+ }[39m
[31m+[39m
[31m+ function lastUserMessageId(events: AgentEvent[]): number {[39m
[31m+   let last = 0;[39m
[31m+   events.forEach((e, i) => {[39m
[31m+     if (e.type === "user_message") last = eventIdAt(i);[39m
[31m+   });[39m
[31m+   return last;[39m
[31m+ }[39m
[31m+[39m
[31m+ function eventChars(e: AgentEvent): number {[39m
[31m+   return JSON.stringify(e).length;[39m
[31m+ }[39m
[31m+[39m
[31m+ const clamp = (v: number, lo: number, hi: number): number => Math.min(hi, Math.max(lo, v));[39m
