[31m+ // ---- 切点选择 ----[39m
[31m+ export interface CutPlan {[39m
[31m+   /** 被压缩事件 id（升序）；不含 keep-first / 旧压缩排除集 / compaction 事件本体。 */[39m
[31m+   compressedIds: number[];[39m
[31m+   /** 摘要注入位 = tail 首事件 id（投影在该 id 之前插入摘要消息）。 */[39m
[31m+   offset: number;[39m
[31m+   tailIds: number[];[39m
[31m+ }[39m
[31m+[39m
[31m+ export interface CutContext {[39m
[31m+   availableTokens: number;[39m
[31m+   factor: number;[39m
[31m+   keepFirst: Set<number>;[39m
[31m+   excluded: Set<number>;[39m
[31m+   lastUserMsgId: number;[39m
[31m+   units: AtomicUnit[];[39m
[31m+ }[39m
[31m+[39m
[31m+ /** 摘要路径切点：tail 预算 clamp(可用×0.25, 2k, 15k)（§7.3(b)），再落三纪律。 */[39m
[31m+ export function selectCut(events: AgentEvent[], config: CompactionConfig, ctx: CutContext): CutPlan {[39m
[31m+   const budget = clamp(ctx.availableTokens * config.tailRatio, config.tailMinTokens, config.tailMaxTokens);[39m
[31m+   let acc = 0;[39m
[31m+   let tailStart = events.length + 1; // 空 tail：全部在预算内[39m
[31m+   for (let id = events.length; id >= 1; id--) {[39m
[31m+     const t = estimateTokens(eventChars(events[id - 1]), ctx.factor);[39m
[31m+     if (acc + t > budget) break;[39m
[31m+     acc += t;[39m
