[31m+   }[39m
[31m+   // 纪律 2：最近一条 typed 用户消息永不吞 —— 由 keep-first **结构性**保障：V1 固定回注名单[39m
[31m+   // 把全部 user_message 计入受护集（keepFirstSet），lastUserMsgId 必在其中，tail 切点永不[39m
[31m+   // 覆盖它。旧实现此处的"tail 起点前移"兜底分支恒不可达（A9，审查 P3）：已删，勿再复写。[39m
[31m+   // overflow 路径（半分截断）不查 keepFirst，仍显式引用 lastUserMsgId。[39m
[31m+   // 纪律 1：tailStart 不得落在原子单元内部 → 回退到单元起点（整单元进 tail）[39m
[31m+   // P2-4（审查）：units 按 lo 升序互不重叠（见 atomicUnits）→ 二分定位包含 tailStart 的单元，[39m
[31m+   // 替代每轮 find 的 O(units) 线性扫描（照抄同文件 keepFirstSet 的二分写法，保持风格一致）。[39m
[31m+   // 语义逐位等价：原 find 取「tailStart > lo && tailStart <= hi」的首个单元；非重叠下至多一个命中。[39m
[31m+   const unitContaining = (id: number): AtomicUnit | undefined => {[39m
[31m+     let lo = 0;[39m
[31m+     let hi = ctx.units.length - 1;[39m
[31m+     while (lo <= hi) {[39m
[31m+       const mid = (lo + hi) >> 1;[39m
[31m+       const u = ctx.units[mid]!;[39m
[31m+       if (id <= u.lo) hi = mid - 1;[39m
[31m+       else if (id > u.hi) lo = mid + 1;[39m
