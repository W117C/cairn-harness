[31m+ // ---- 会话序列化（摘要输入；OC serialize 同构，工具结果截断）----[39m
[31m+ function truncate(s: string, max: number): string {[39m
[31m+   return s.length > max ? s.slice(0, max) + "…(截断)" : s;[39m
[31m+ }[39m
[31m+[39m
[31m+ export function serializeConversation([39m
[31m+   events: AgentEvent[],[39m
[31m+   truncateChars: number,[39m
[31m+   toolNameOf?: (callId: string) => string | undefined,[39m
[31m+   argsOf?: (callId: string) => Record<string, unknown> | undefined,[39m
[31m+ ): string {[39m
[31m+   const lines: string[] = [];[39m
[31m+   let deltaBuf = "";[39m
[31m+   let deltaOpen = false;[39m
