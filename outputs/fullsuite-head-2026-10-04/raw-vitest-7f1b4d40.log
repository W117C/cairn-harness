[31m+       if (ctx.keepFirst.has(id) || ctx.excluded.has(id)) return false;[39m
[31m+       if (events[id - 1].type === "compaction") return false;[39m
[31m+       if (id === ctx.lastUserMsgId) return false;[39m
[31m+       return true;[39m
[31m+     });[39m
[31m+     if (!droppable) continue;[39m
[31m+     for (const id of u.ids) dropped.add(id);[39m
[31m+     count += u.ids.length;[39m
[31m+   }[39m
[31m+   if (dropped.size === 0) return null;[39m
[31m+   const compressedIds = [...dropped].sort((a, b) => a - b);[39m
[31m+   return { compressedIds, offset: compressedIds[compressedIds.length - 1] + 1 };[39m
[31m+ }[39m
