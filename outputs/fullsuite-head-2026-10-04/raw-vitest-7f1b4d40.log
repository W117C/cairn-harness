[31m+     deltaBuf = "";[39m
[31m+     deltaOpen = false;[39m
[31m+   };[39m
[31m+   for (const e of events) {[39m
[31m+     // 子流不越界（§4.4.4）在**折叠面**上同样要成立：带 agent_id 的是 worker 的内部转录,[39m
[31m+     // projectContext 已按同一判定把它们挡在父上下文外,但摘要走的是另一条取料路径——[39m
[31m+     // 一旦混进摘要,worker 的过程就以「父会话做过」的形态替掉被排除的旧事件并永久留存。[39m
[31m+     if (hasWorkerAttribution(e)) {[39m
[31m+       flushDelta(); // 主流正文的边界照旧收束,不让两段正文隔着一段子流粘成一段[39m
[31m+       continue;[39m
[31m+     }[39m
[31m+     if (e.type === "assistant_delta") {[39m
[31m+       deltaBuf += e.text;[39m
[31m+       deltaOpen = true;[39m
[31m+     } else if (e.type === "assistant_message") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[Assistant] " + truncate(e.content, truncateChars));[39m
[31m+     } else if (e.type === "user_message") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[User] " + truncate(e.content, truncateChars));[39m
[31m+     } else if (e.type === "tool_call") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[tool call] " + e.name + " " + truncate(JSON.stringify(e.args), truncateChars));[39m
[31m+     } else if (e.type === "tool_result") {[39m
[31m+       flushDelta();[39m
[31m+       // M2b：进摘要输入的工具结果走类型化整形 + 统一 2k 截断（§7.4 = §6.2 同一份规则表）[39m
[31m+       const name = toolNameOf?.(e.callId);[39m
[31m+       let text = e.output;[39m
[31m+       if (name && argsOf) {[39m
[31m+         text = shapeResult(classifyResult(name, argsOf(e.callId) ?? {}, e.output), e.output, truncateChars);[39m
[31m+       }[39m
[31m+       lines.push("[Tool result " + (e.ok ? "ok" : "error") + "] " + summaryTruncate(text));[39m
[31m+     } else if (e.type === "clarify_requested") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[Assistant 澄清提问] " + truncate(JSON.stringify(e.questions), truncateChars));[39m
[31m+     } else if (e.type === "plan_proposed") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[Plan 提案] " + truncate(JSON.stringify(e.plan), truncateChars));[39m
[31m+     } else if (e.type === "plan_approved") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[Plan 决议] " + (e.approved ? "批准" : "拒绝"));[39m
[31m+     } else if (e.type === "verify_result") {[39m
[31m+       flushDelta();[39m
[31m+       lines.push("[Verify] " + (e.ok ? "通过" : "失败") + "（第 " + e.attempt + "/" + e.maxAttempts + " 次）");[39m
[31m+     } else if (e.type === "turn_truncated") {[39m
