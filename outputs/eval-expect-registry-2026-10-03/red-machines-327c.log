[31m+ interface ResourceSample { rssPeakMb: number; procPeak: number; cpuMs: number; samples: number }[39m
[31m+[39m
[31m+ function startResourceSampler(): () => ResourceSample {[39m
[31m+   const pid = process.pid;[39m
[31m+   let rssPeakKb = 0;[39m
[31m+   let procPeak = 0;[39m
[31m+   let samples = 0;[39m
[31m+   const tick = (): void => {[39m
[31m+     try {[39m
[31m+       // 自身 + 后代：ps 的 %cpu/rss 是瞬时的，这里只取 rss 与进程数[39m
[31m+       const r = spawnSync("ps", ["-eo", "pid,ppid,rss,comm"], { encoding: "utf8", timeout: 2_000 });[39m
[31m+       const out = r.stdout ?? "";[39m
[31m+       const lines = out.trim().split("\n").slice(1);[39m
[31m+       const rows = lines.map((l) => l.trim().split(/\s+/)).filter((c) => c.length >= 4);[39m
[31m+       const kids = new Set<number>([pid]);[39m
[31m+       // 一轮传播即可覆盖「本进程 → 直接子进程」；沙箱/子 shell 再深一层靠 comm 含 node 兜住[39m
[31m+       let grew = true;[39m
[31m+       while (grew) {[39m
[31m+         grew = false;[39m
[31m+         for (const c of rows) {[39m
[31m+           const p0 = Number(c[0]);[39m
[31m+           const pp = Number(c[1]);[39m
[31m+           if (kids.has(pp) && !kids.has(p0)) { kids.add(p0); grew = true; }[39m
[31m+         }[39m
[31m+       }[39m
[31m+       let rss = 0;[39m
[31m+       for (const c of rows) {[39m
[31m+         if (!kids.has(Number(c[0]))) continue;[39m
[31m+         const kb = Number(c[2]);[39m
[31m+         if (Number.isFinite(kb)) rss += kb;[39m
[31m+       }[39m
[31m+       if (rss > rssPeakKb) rssPeakKb = rss;[39m
[31m+       if (kids.size > procPeak) procPeak = kids.size;[39m
[31m+       samples += 1;[39m
[31m+     } catch { /* 采样失败不影响评测：它只是读数，不是判据 */ }[39m
[31m+   };[39m
[31m+   tick();[39m
[31m+   const timer = setInterval(tick, 500);[39m
[31m+   return () => {[39m
[31m+     clearInterval(timer);[39m
[31m+     tick();[39m
[31m+     const cpu = process.cpuUsage();[39m
[31m+     return { rssPeakMb: Math.round(rssPeakKb / 1024), procPeak, cpuMs: Math.round((cpu.user + cpu.system) / 1000), samples };[39m
[31m+   };[39m
[31m+ }[39m
