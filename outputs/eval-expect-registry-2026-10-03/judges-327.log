[31m+       while (grew) {[39m
[31m+         grew = false;[39m
[31m+         for (const c of rows) {[39m
[31m+           const p0 = Number(c[0]);[39m
[31m+           const pp = Number(c[1]);[39m
[31m+           if (kids.has(pp) && !kids.has(p0)) { kids.add(p0); grew = true; }[39m
[31m+         }[39m
[31m+       }[39m
[31m+       let rss = 0;[39m
[31m+       for (const c of rows) {[39m
[31m+         if (!kids.has(Number(c[0]))) continue;[39m
[31m+         const kb = Number(c[2]);[39m
[31m+         if (Number.isFinite(kb)) rss += kb;[39m
[31m+       }[39m
