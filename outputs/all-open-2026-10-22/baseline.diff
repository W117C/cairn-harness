-/** 空轮弱行文案（单轮「第 N 轮」；区间「第 M–N 轮」）。 */
-export function formatEmptyTrailNote(from: number, to: number): string {
-  return from === to ? `第 ${String(from)} 轮 · 无文件改动` : `第 ${String(from)}–${String(to)} 轮 · 无文件改动`;
-}
