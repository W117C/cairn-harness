{"type":"tool_result","callId":"call_baf10d57424949d5b6c4b773","ok":true,"output":"// gym case: todo-completed-count\n// BUG: completedCount 统计了全部 todo，而不是只统计已完成（done）的。\nlet nextId = 1;\nconst todos = [];\n\nexport function addTodo(text, defaultDone = false) {\n  const todo = { id: nextId++, text, done: defaultDone };\n  todos.push(todo);\n  return todo;\n}\n\nexport function toggleTodo(id) {\n  const todo = todos.find((t) => t.id === id);\n  if (todo) todo.done = !todo.done;\n  return todo;\n}\n\nexport function completedCount() {\n  return todos.length; // ← BUG：应只统计 done === true 的\n}\n\nexport function listTodos() {\n  return [...todos];\n}","ts":1791088099072}
