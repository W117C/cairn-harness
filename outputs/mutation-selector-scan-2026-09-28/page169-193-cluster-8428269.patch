+  const seenIn = new Map<string, Set<number>>();
+  shards.forEach((sh, i) => {
+    for (const id of sh) {
+      const h = hostOf.get(id);
+      if (h === undefined) continue;
+      const set = seenIn.get(h) ?? new Set<number>();
+      set.add(i);
+      seenIn.set(h, set);
+    }
+  });
+  return [...seenIn.entries()].filter(([, set]) => set.size > 1).map(([h]) => h).sort();
