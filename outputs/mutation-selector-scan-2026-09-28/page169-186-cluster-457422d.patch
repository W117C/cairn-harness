+    if (titles === null || titles === undefined || titles.length === 0) continue;
+    inspected += 1;
+    const hits = titles.filter((t) => t.includes(e.expectFail)).length;
+    if (hits !== 1) problems.push({ id: e.id, test: e.test, hits });
+    else selectableIds.push(e.id);
+  }
