      },
      plan: {
        waitApproval: (id, o) =>
          appPlanGate.waitApproval(id, {
            ...o,
            signal,
            ...(opts.unattended ? { timeoutMs: UNATTENDED_GATE_WAIT_MS } : {}),
          }),
      },
      verify: createVerifyHook(opts.workspace, { exec: verifyExec(opts.sandbox ?? null), trustedRepo: opts.trustedRepo ?? false }),
