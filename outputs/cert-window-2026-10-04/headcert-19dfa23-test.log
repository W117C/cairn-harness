            : `未触发（${pruned.why}）`);
        await pipeline({ type: \"tool_call\", id: \"m2b-map-demo\", name: \"read_file\", args: { path: \"(符号地图演示)\" } });
        await pipeline({ type: \"tool_result\", callId: \"m2b-map-demo\", ok: true, output: body });
