+  });
+  it('本地主机名不放行非网页协议', () => {
+    expect(hostAllowed('file://[::1]/private', new Set())).toBe(false);
+    expect(hostAllowed('ftp://[::1]/private', new Set())).toBe(false);
+  });
+});
