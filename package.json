{
  "name": "cairn-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "files": [
    "src/",
    "bin/",
    "tsconfig.json",
    "fixtures/",
    "apps/desktop/src/",
    "apps/desktop/dist/",
    "apps/desktop/dist-electron/",
    "apps/desktop/package.json",
    "LICENSE",
    "!**/.mimosa/**",
    "!**/.agent/**",
    "fixtures/**/.agent/config.json"
  ],
  "bin": {
    "cairn": "./bin/cairn.mjs"
  },
  "engines": {
    "node": ">=20.11.0 <25"
  },
  "scripts": {
    "gates": "node --import tsx scripts/gates.ts --public",
    "mutate-needles-check": "node --import tsx scripts/mutate-verify.mjs --check-needles",
    "facts": "node --import tsx scripts/facts.ts",
    "perf-summary": "node --import tsx scripts/perf-summarize.ts",
    "prompt-cost": "node --import tsx scripts/prompt-cost.ts",
    "tool-choice": "node --import tsx scripts/tool-choice.ts",
    "observe-surface": "node --import tsx scripts/observe-surface.ts",
    "typecheck": "node --import tsx scripts/typecheck.ts",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:capped": "vitest run --config tests/vitest.config.ts --maxWorkers=2",
    "e2e": "node --import tsx scripts/e2e.ts",
    "agent": "node --import tsx scripts/agent.ts",
    "sandbox:check": "node --import tsx scripts/sandbox-check.ts",
    "fork-check": "node --import tsx scripts/fork-check.ts",
    "provider:check": "node --import tsx scripts/provider-check.ts",
    "gate-check": "node --import tsx scripts/gate-check.ts",
    "autonomy-check": "node --import tsx scripts/autonomy-check.ts",
    "compaction-check": "node --import tsx scripts/compaction-check.ts",
    "tools-check": "node --import tsx scripts/tools-check.ts",
    "map-check": "node --import tsx scripts/map-check.ts",
    "prune-check": "node --import tsx scripts/prune-check.ts",
    "memory-check": "node --import tsx scripts/memory-check.ts",
    "plugins-check": "node --import tsx scripts/plugins-check.ts",
    "security-check": "node --import tsx scripts/security-check.ts",
    "gym-check": "node --import tsx scripts/gym-check.ts",
    "gym-draft": "node --import tsx scripts/gym-draft.ts",
    "routing-check": "node --import tsx scripts/routing-check.ts",
    "supervisor-check": "node --import tsx scripts/supervisor-check.ts",
    "model-surface-check": "node --import tsx scripts/model-surface-check.ts",
    "prefix-churn-check": "node --import tsx scripts/prefix-churn-check.ts",
    "prompt-surface-check": "node --import tsx scripts/prompt-surface-check.ts",
    "replay-determinism-check": "node --import tsx scripts/replay-determinism-check.ts",
    "no-progress-check": "node --import tsx scripts/no-progress-check.ts",
    "web-fetch-check": "node --import tsx scripts/web-fetch-check.ts",
    "cost-per-progress-check": "node --import tsx scripts/cost-per-progress-check.ts",
    "desktop-boundary-check": "node --import tsx scripts/desktop-boundary-check.ts",
    "desktop-test": "pnpm --filter cairn-desktop test",
    "head-import-check": "node --import tsx scripts/head-import-face.ts",
    "head-cert-check": "node --import tsx scripts/head-cert.ts --tree=.worktrees/gate-head-cert",
    "mutate-verify": "node --import tsx scripts/mutate-verify.mjs --in-worktree=.worktrees/gate-mutate-verify",
    "bench": "node --import tsx scripts/loop-eval.ts --tasks fixtures/bench/tasks.json --reps 1 --max-steps 25 --out outputs/bench",
    "eval-report": "node --import tsx scripts/eval/report.ts",
    "bench:long30": "node --import tsx scripts/loop-eval.ts --tasks fixtures/bench/tasks-long30.json --reps 1 --max-steps 35 --out outputs/bench-long30",
    "bench:chain32": "node --import tsx scripts/loop-eval.ts --tasks fixtures/bench/tasks-chain32.json --reps 1 --max-steps 40 --out outputs/bench-chain32",
    "bench:chain48": "node --import tsx scripts/loop-eval.ts --tasks fixtures/bench/tasks-chain48.json --reps 1 --max-steps 55 --out outputs/bench-chain48",
    "bench-judge-spec-check": "node --import tsx scripts/bench-judge-spec.ts --check",
    "renderer-layer-check": "node --import tsx scripts/renderer-layer-check.ts",
    "event-semantics-check": "node --import tsx scripts/event-semantics-check.ts",
    "session-semantics-check": "node --import tsx scripts/session-semantics-check.ts",
    "session-search-check": "node --import tsx scripts/session-search-check.ts",
    "context-quality-eval": "node --import tsx scripts/context-quality-eval.ts",
    "external-bench": "node --import tsx scripts/external-bench.ts",
    "acp-server": "node --import tsx scripts/acp-server.ts",
    "a2a-server": "node --import tsx scripts/a2a-server.ts",
    "lsp-status": "node --import tsx scripts/lsp-status.ts",
    "motion-policy-check": "node --import tsx scripts/motion-policy-check.ts",
    "verify": "node --import tsx scripts/gates.ts --public",
    "gates:all": "node --import tsx scripts/gates.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "croner": "^10.0.1",
    "smol-toml": "1.9.0",
    "tree-sitter-wasms": "0.1.13",
    "tar": "7.5.22",
    "vscode-languageserver-protocol": "^3.18.5",
    "web-tree-sitter": "0.25.10"
  },
  "license": "AGPL-3.0-only",
  "description": "Cairn — a replayable, audit-first AI coding agent (event-sourced core, CLI + macOS desktop).",
  "repository": {
    "type": "git",
    "url": "https://github.com/W117C/cairn-harness.git"
  }
}
