{
  "name": "m0-agent-loop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "gates": "node --import tsx scripts/gates.ts",
    "mutate-needles-check": "node --import tsx scripts/mutate-verify.mjs --check-needles",
    "facts": "node --import tsx scripts/facts.ts",
    "tool-choice": "node --import tsx scripts/tool-choice.ts",
    "typecheck": "node --import tsx scripts/typecheck.ts",
    "test": "vitest run --config tests/vitest.config.ts",
    "e2e": "node --import tsx scripts/e2e.ts",
    "agent": "node --import tsx scripts/agent.ts",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite build && electron .",
    "dist": "electron-vite build && electron-builder --mac",
    "ipc:check": "node --import tsx scripts/ipc-check.ts",
    "ipc-reachability-check": "node --import tsx scripts/ipc-reachability-check.ts",
    "sandbox:check": "node --import tsx scripts/sandbox-check.ts",
    "fork-check": "node --import tsx scripts/fork-check.ts",
    "provider:check": "node --import tsx scripts/provider-check.ts",
    "providers-check": "node --import tsx scripts/providers-check.ts",
    "gate-check": "node --import tsx scripts/gate-check.ts",
    "docs-check": "node --import tsx scripts/docs-check.ts",
    "autonomy-check": "node --import tsx scripts/autonomy-check.ts",
    "compaction-check": "node --import tsx scripts/compaction-check.ts",
    "panels-check": "node --import tsx scripts/panels-check.ts",
    "tools-check": "node --import tsx scripts/tools-check.ts",
    "map-check": "node --import tsx scripts/map-check.ts",
    "prune-check": "node --import tsx scripts/prune-check.ts",
    "memory-check": "node --import tsx scripts/memory-check.ts",
    "plugins-check": "node --import tsx scripts/plugins-check.ts",
    "sidechat-check": "node --import tsx scripts/sidechat-check.ts",
    "security-check": "node --import tsx scripts/security-check.ts",
    "agents-check": "node --import tsx scripts/agents-check.ts",
    "schedule-check": "node --import tsx scripts/schedule-check.ts",
    "commercial-check": "node --import tsx scripts/commercial-check.ts",
    "gym-check": "node --import tsx scripts/gym-check.ts",
    "routing-check": "node --import tsx scripts/routing-check.ts",
    "supervisor-check": "node --import tsx scripts/supervisor-check.ts",
    "renderer-arch-check": "node --import tsx scripts/renderer-arch-check.ts --static out/renderer",
    "model-surface-check": "node --import tsx scripts/model-surface-check.ts",
    "a11y-check": "node --import tsx scripts/a11y-check.ts --static out/renderer",
    "mutate-verify": "node --import tsx scripts/mutate-verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "croner": "^10.0.1",
    "tree-sitter-wasms": "0.1.13",
    "vscode-languageserver-protocol": "^3.18.3",
    "web-tree-sitter": "0.25.10"
  }
}
