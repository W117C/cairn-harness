{
  "name": "cairn-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/main/entry.cjs",
  "scripts": {
    "predev": "pnpm run build:preload",
    "dev": "vite & sleep 2 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "pnpm run build:preload && vite build && tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:layout": "electron scripts/layout-smoke.cjs",
    "smoke:marketplace": "electron scripts/plugin-marketplace-smoke.cjs",
    "smoke:performance": "electron scripts/performance-smoke.cjs",
    "smoke:install": "node scripts/install-smoke.mjs",
    "preview:ui": "pnpm --dir preview dev",
    "preview:ui:build": "pnpm --dir preview build",
    "package": "node scripts/package.mjs",
    "test": "vitest run --config vitest.config.ts && node --import tsx ../../scripts/desktop-boundary-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hardening-smoke": "electron scripts/hardening-smoke.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/themes": "^3.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.18.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
