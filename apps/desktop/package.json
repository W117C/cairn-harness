{
  "name": "cairn-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main/entry.cjs",
  "scripts": {
    "predev": "pnpm run build:preload",
    "dev": "vite & sleep 2 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "pnpm run build:preload && vite build && tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "preview:ui": "pnpm --dir preview dev",
    "preview:ui:build": "pnpm --dir preview build",
    "package": "node scripts/package.mjs",
    "test": "vitest run --config vitest.config.ts && node --import tsx ../../scripts/desktop-boundary-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hardening-smoke": "electron scripts/hardening-smoke.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/themes": "^3.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.0"
  }
}
