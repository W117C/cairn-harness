{
  "name": "m0-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite & sleep 2 && electron .",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --define:import.meta.url=__dshImportMetaUrl --banner:js='var __dshImportMetaUrl = require(\"node:url\").pathToFileURL(__filename).href;' --outfile=dist-electron/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.js",
    "build": "pnpm run build:main && pnpm run build:preload && vite build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
