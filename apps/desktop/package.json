{
  "name": "cairn-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main/entry.cjs",
  "scripts": {
    "predev": "pnpm run build:preload",
    "dev": "vite & sleep 2 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "pnpm run build:preload && vite build && tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "test": "vitest run --config vitest.config.ts && node --import tsx ../../scripts/desktop-boundary-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
