# EditorConfig：跨编辑器统一
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# ── Markdown：行尾两个空格是换行语义，不要 trim ──
[*.md]
trim_trailing_whitespace = false

# ── 锁文件由包管理器生成，不改它 ──
[pnpm-lock.yaml]
insert_final_newline = false
trim_trailing_whitespace = false
indent_size = 2

# ── 取料面：证据文件，按原样保存（内容被门逐字比对） ──
[outputs/**]
insert_final_newline = false
trim_trailing_whitespace = false
